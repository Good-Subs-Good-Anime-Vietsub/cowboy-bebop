Dialogue: 0,0:00:46.13,0:00:50.57,Main,,0,0,0,,{\i1}Hắn chẳng qua\Nchỉ là một kẻ cô độc.{\i0}
Dialogue: 0,0:00:51.89,0:00:55.62,Main,,0,0,0,,{\i1}Hắn là kẻ chỉ có thể \Nbày trò chơi với chính bản thân mình.{\i0}
Dialogue: 0,0:00:56.63,0:00:59.12,Main,,0,0,0,,{\i1}Như thể sống trong một giấc mơ...{\i0}
Dialogue: 0,0:01:00.17,0:01:01.49,Main,,0,0,0,,{\i1}Hắn là một gã như thế đấy.{\i0}
Dialogue: 0,0:01:06.07,0:01:10.05,Main,,0,0,0,,Spike, dậy đi. Dậy mau.
Dialogue: 0,0:01:18.30,0:01:19.77,Main,,0,0,0,,Nghe này.
Dialogue: 0,0:01:21.48,0:01:26.54,Main,,0,0,0,,Cái xã hội này ấy, giống như\Nmột nồi hầm đang sôi sùng sục.
Dialogue: 0,0:01:26.54,0:01:33.05,Main,,0,0,0,,Trong nồi hầm nhừ ấy, chả thứ gì cao quý,\Ncũng chả thứ gì vô dụng.
Dialogue: 0,0:01:33.05,0:01:35.52,Main,,0,0,0,,Tất cả hòa làm một thành món hầm.
Dialogue: 0,0:01:35.52,0:01:38.84,Main,,0,0,0,,Nhưng có một thứ\Ntuyệt đối không được quên.
Dialogue: 0,0:01:39.60,0:01:41.41,Main,,0,0,0,,Mày biết là gì không?
Dialogue: 0,0:01:42.81,0:01:43.91,Main,,0,0,0,,Thịt ạ?
Dialogue: 0,0:01:44.63,0:01:47.59,Main,,0,0,0,,Ai cũng nghĩ thế. Nhưng mà...
Dialogue: 0,0:01:47.59,0:01:51.98,Main,,0,0,0,,Không có gói gia vị hầm\Nthì đâu còn là món hầm.
Dialogue: 0,0:01:51.98,0:01:55.63,Main,,0,0,0,,Cùng nguyên liệu ấy,\Ncó khi lại thành món cà ri đấy.
Dialogue: 0,0:01:55.63,0:01:58.17,Main,,0,0,0,,Nếu là gia vị hầm\Nthì ở kệ đằng kia ạ...
Dialogue: 0,0:01:58.17,0:02:00.09,Main,,0,0,0,,Tao đâu có nói chuyện đó!
Dialogue: 0,0:02:02.15,0:02:04.90,Main,,0,0,0,,Đúng là tên cướp thích dạy đời.
Dialogue: 0,0:02:04.90,0:02:06.35,Main,,0,0,0,,Spike, đi thôi.
Dialogue: 0,0:02:06.90,0:02:09.24,Main,,0,0,0,,Có ba tên.\NTôi sẽ vòng ra cửa sau.
Dialogue: 0,0:02:09.24,0:02:10.42,Main,,0,0,0,,Ô-kê.
Dialogue: 0,0:02:12.15,0:02:17.45,Main,,0,0,0,,Chờ cảnh sát cũng vô ích thôi.\NAn ninh ở đây tao nắm hết rồi.
Dialogue: 0,0:02:17.45,0:02:18.90,Main,,0,0,0,,Mày biết tại sao không?
Dialogue: 0,0:02:18.90,0:02:21.57,Main,,0,0,0,,Renji, làm nhanh lên đi.
Dialogue: 0,0:02:21.57,0:02:24.33,Main,,0,0,0,,Cái công ty an ninh\Ncó logo này này...
Dialogue: 0,0:02:24.33,0:02:26.87,Main,,0,0,0,,Tao từng là nhân viên ở đó đấy.
Dialogue: 0,0:02:26.87,0:02:28.16,Main,,0,0,0,,Dạ...
Dialogue: 0,0:02:28.16,0:02:32.53,Main,,0,0,0,,Bị sa thải nên chuyển nghề\Nsang đi cướp. Buồn cười chưa?
Dialogue: 0,0:02:32.53,0:02:33.88,Main,,0,0,0,,Vâng...
Dialogue: 0,0:02:33.88,0:02:35.16,Main,,0,0,0,,Cười lên đi chứ.
Dialogue: 0,0:02:35.79,0:02:37.65,Main,,0,0,0,,Buồn cười không?
Dialogue: 0,0:02:37.65,0:02:39.40,Main,,0,0,0,,Buồn cười đúng không!
Dialogue: 0,0:02:41.75,0:02:43.51,Main,,0,0,0,,Đây đâu phải chuyện đáng cười!
Dialogue: 0,0:02:47.70,0:02:51.21,Main,,0,0,0,,Này, hôm nay đóng cửa rồi.\NĐi chỗ khác đi.
Dialogue: 0,0:02:57.45,0:03:01.16,Main,,0,0,0,,Hiểu rồi thì mau\Nchuyển tiền vào thẻ này.
Dialogue: 0,0:03:04.07,0:03:06.03,Main,,0,0,0,,Này, thằng kia, mày là ai hả?
Dialogue: 0,0:03:07.42,0:03:09.39,Main,,0,0,0,,Này, mày điếc à?
Dialogue: 0,0:03:10.31,0:03:11.99,Main,,0,0,0,,Tổ sư!
Dialogue: 0,0:03:15.44,0:03:19.92,Main,,0,0,0,,Này, tháo cái đó ra mà nghe đây!
Dialogue: 0,0:03:19.92,0:03:20.80,Main,,0,0,0,,Tính tiền cái này.
Dialogue: 0,0:03:29.12,0:03:29.86,Main,,0,0,0,,{野郎}Thằng chó!
Dialogue: 0,0:03:43.63,0:03:44.37,Main,,0,0,0,,Spike!
Dialogue: 0,0:03:48.46,0:03:51.06,Main,,0,0,0,,Tiền bánh donut\Ncứ tính cho mấy gã này nhé.
Dialogue: 0,0:04:01.98,0:04:03.01,Main,,0,0,0,,Đứng im!
Dialogue: 0,0:04:04.84,0:04:06.01,Main,,0,0,0,,Jet này...
Dialogue: 0,0:04:06.01,0:04:07.40,Main,,0,0,0,,Gì?
Dialogue: 0,0:04:07.40,0:04:09.54,Main,,0,0,0,,Anh bảo có ba tên mà nhỉ.
Dialogue: 0,0:04:09.54,0:04:11.61,Main,,0,0,0,,Vứt súng xuống sàn!
Dialogue: 0,0:04:11.61,0:04:14.36,Main,,0,0,0,,Muốn lừa địch thì\Ntrước tiên phải lừa quân mình.
Dialogue: 0,0:04:14.36,0:04:16.18,Main,,0,0,0,,Lừa thế này để làm gì chứ?
Dialogue: 0,0:04:16.18,0:04:17.20,Main,,0,0,0,,Nghe tao nói này!
Dialogue: 0,0:04:17.20,0:04:19.59,Main,,0,0,0,,Mà mày đi ị lâu quá đấy.
Dialogue: 0,0:04:19.59,0:04:23.03,Main,,0,0,0,,Im mồm! Muốn bà già này chết à?
Dialogue: 0,0:04:31.13,0:04:34.37,Main,,0,0,0,,Có nghe không hả?\NKhông thấy bà già này à?
Dialogue: 0,0:04:34.82,0:04:36.80,Main,,0,0,0,,Xin lỗi bà nhé.
Dialogue: 0,0:04:36.80,0:04:39.92,Main,,0,0,0,,Bọn tôi chả phải cảnh sát\Nhay bảo vệ gì.
Dialogue: 0,0:04:39.92,0:04:43.60,Main,,0,0,0,,Chả có nghĩa vụ gì phải\Nbảo vệ tính mạng người dân cả.
Dialogue: 0,0:04:43.60,0:04:44.63,Main,,0,0,0,,Gì cơ?
Dialogue: 0,0:04:45.23,0:04:47.14,Main,,0,0,0,,Cứ coi như số bà đen đi.
Dialogue: 0,0:04:48.04,0:04:49.19,Main,,0,0,0,,Cao bồi à.
Dialogue: 0,0:04:49.19,0:04:51.53,Main,,0,0,0,,N-này này,\Nanh nói cái gì thế hả?
Dialogue: 0,0:04:51.53,0:04:53.02,Main,,0,0,0,,Đồ máu lạnh!
Dialogue: 0,0:05:04.49,0:05:08.59,Main,,0,0,0,,Cao bồi à?\NRốt cuộc cậu là ai hả?
Dialogue: 0,0:05:13.00,0:05:14.89,Main,,0,0,0,,Chỉ là thợ săn tiền thưởng thôi.
Dialogue: 0,0:07:26.96,0:07:29.22,Main,,0,0,0,,Đi nhanh lên đi, Jet.
Dialogue: 0,0:07:29.22,0:07:30.99,Main,,0,0,0,,Đừng có giục.
Dialogue: 0,0:07:41.23,0:07:43.87,Main,,0,0,0,,Anh có chịu nghĩ chút nào\Nrồi mới đi không đấy?
Dialogue: 0,0:07:43.87,0:07:45.69,Main,,0,0,0,,Nhanh lên đi...
Dialogue: 0,0:07:45.69,0:07:48.70,Main,,0,0,0,,Nghe này, cờ shogi ấy mà,
Dialogue: 0,0:07:48.70,0:07:53.19,Main,,0,0,0,,phải tính trước 100 nước, rồi mới\Nthấy được nước cần đi đầu tiên.
Dialogue: 0,0:07:57.42,0:08:02.91,Main,,0,0,0,,Đánh vào chỗ mà đối thủ muốn đánh.\NĐó mới là tinh túy của shogi.
Dialogue: 0,0:08:02.91,0:08:06.13,Main,,0,0,0,,Đâu phải cứ không nghĩ ngợi\Nmà đi bừa là được...
Dialogue: 0,0:08:06.92,0:08:09.17,Main,,0,0,0,,Tôi muốn đi nước này.
Dialogue: 0,0:08:09.17,0:08:12.63,Main,,0,0,0,,Không được đi lại\Ncũng là luật của shogi mà.
Dialogue: 0,0:08:12.63,0:08:15.93,Main,,0,0,0,,Anh đúng là\Ncái gã tùy tiện hết chỗ nói.
Dialogue: 0,0:08:15.93,0:08:17.49,Main,,0,0,0,,Nghe này, Spike.
Dialogue: 0,0:08:17.49,0:08:21.32,Main,,0,0,0,,Đánh cờ shogi\Nlà bộc lộ tính cách đấy.
Dialogue: 0,0:08:21.32,0:08:25.00,Main,,0,0,0,,Anh lúc nào cũng làm việc kiểu\Nhứng lên nhất thời, đúng không?
Dialogue: 0,0:08:25.00,0:08:26.39,Main,,0,0,0,,Nhanh lên đi.
Dialogue: 0,0:08:26.40,0:08:30.94,Main,,0,0,0,,Lúc đó mà con tin bị bắn\Nthì anh định làm thế nào?
Dialogue: 0,0:08:30.94,0:08:32.70,Main,,0,0,0,,Đến lúc đó hẵng hay.
Dialogue: 0,0:08:32.70,0:08:39.46,Main,,0,0,0,,Thật tình, có cái đầu 1,25 triệu\Nmà rủi ro lớn quá đấy.
Dialogue: 0,0:08:39.46,0:08:43.71,Main,,0,0,0,,Nghề thợ săn tiền thưởng\Nnghe thì oai chứ thực ra tẻ nhạt lắm.
Dialogue: 0,0:08:43.71,0:08:47.90,Main,,0,0,0,,Trước khi cặp với anh,\Ntôi sống ổn định hơn nhiều.
Dialogue: 0,0:08:55.00,0:08:57.78,Main,,0,0,0,,Phải phải,\Ntao cũng định đi nước đó đấy.
Dialogue: 0,0:08:57.78,0:08:59.35,Main,,0,0,0,,Sao hả, Spike?
Dialogue: 0,0:09:02.56,0:09:05.60,Main,,0,0,0,,Phát hiện, phát hiện! Nha nhaa~
Dialogue: 0,0:09:48.15,0:09:50.65,Main,,0,0,0,,Faye Faye ơi, ping pong~!
Dialogue: 0,0:09:50.65,0:09:56.40,Main,,0,0,0,,Để xem nào~ Qua trạm thu phí số 8\Ntrên tuyến 12, đi về phía thành phố rồi~
Dialogue: 0,0:09:57.03,0:10:00.91,Main,,0,0,0,,Ô-kê. Gửi thông tin xe\Nvới đầu treo thưởng qua đây, Ed.
Dialogue: 0,0:10:03.90,0:10:08.17,Main,,0,0,0,,Vị thành niên à.\NMình dở khoản trông trẻ lắm.
Dialogue: 0,0:11:08.68,0:11:10.19,Main,,0,0,0,,Không phải hắn à?
Dialogue: 0,0:12:26.19,0:12:28.67,Main,,0,0,0,,Đã đến giờ bản tin CBC.
Dialogue: 0,0:12:28.67,0:12:30.97,Main,,0,0,0,,Trước tiên là tin nổi bật nhất hôm nay.
Dialogue: 0,0:12:30.97,0:12:34.31,Main,,0,0,0,,Hơn 10 giờ sáng nay, trên\Ncao tốc số 7 thủ đô Alba City,
Dialogue: 0,0:12:34.31,0:12:37.45,Main,,0,0,0,,gần khu Red Hills,\Nmột xe bồn đã phát nổ,
Dialogue: 0,0:12:37.45,0:12:42.50,Main,,0,0,0,,khiến 72 người chết và\N425 người bị thương, gây ra thảm họa.
Dialogue: 0,0:12:42.50,0:12:45.99,Main,,0,0,0,,Sau đây là tường thuật trực tiếp\Ntừ phóng viên Riley tại hiện trường.
Dialogue: 0,0:12:46.49,0:12:48.57,Main,,0,0,0,,Vâng, tôi đang ở hiện trường.
Dialogue: 0,0:12:48.57,0:12:53.50,Main,,0,0,0,,Hiện xe gặp nạn đang được di dời\Nvà hiện trường đang được phun rửa.
Dialogue: 0,0:12:53.50,0:12:57.46,Main,,0,0,0,,Ngay sau vụ tai nạn, những người\Ntrong bán kính khoảng 3km
Dialogue: 0,0:12:57.46,0:13:00.84,Main,,0,0,0,,đã lần lượt bất tỉnh, ngã gục,
Dialogue: 0,0:13:00.84,0:13:04.07,Main,,0,0,0,,khiến cả khu vực có lúc\Nrơi vào hoảng loạn.
Dialogue: 0,0:13:04.07,0:13:08.89,Main,,0,0,0,,Tuy nhiên, giờ đã 3 tiếng trôi qua,\Ntình hình đang dần lắng xuống.
Dialogue: 0,0:13:08.89,0:13:13.85,Main,,0,0,0,,Tức là có khả năng thứ chở\Ntrên xe bồn là chất độc ư?
Dialogue: 0,0:13:13.85,0:13:18.50,Main,,0,0,0,,Vâng. Cảnh sát cho rằng\Ncó thể là vụ nổ do hóa chất,
Dialogue: 0,0:13:18.50,0:13:24.08,Main,,0,0,0,,hoặc thậm chí là vũ khí sinh học,\Nnên đã cấm ra vào khu vực hiện trường.
Dialogue: 0,0:13:24.08,0:13:27.03,Main,,0,0,0,,Đã xác định được\Nnguyên nhân vụ nổ chưa ạ?
Dialogue: 0,0:13:27.03,0:13:29.99,Main,,0,0,0,,Hiện vẫn chưa rõ chi tiết.
Dialogue: 0,0:13:29.99,0:13:35.47,Main,,0,0,0,,Nhưng chiếc xe bồn gặp nạn\Nđã được trình báo mất cắp từ trước,
Dialogue: 0,0:13:35.47,0:13:40.99,Main,,0,0,0,,nên cảnh sát cho rằng nhiều khả năng\Nđây là một vụ khủng bố sinh học.
Dialogue: 0,0:13:40.99,0:13:42.76,Main,,0,0,0,,Trên đây là tường thuật từ hiện trường.
Dialogue: 0,0:13:43.20,0:13:45.41,Main,,0,0,0,,Kênh nào cũng đưa tin này nhỉ.
Dialogue: 0,0:13:46.54,0:13:48.13,Main,,0,0,0,,Déjà vu chăng.
Dialogue: 0,0:13:49.14,0:13:53.85,Main,,0,0,0,,Hình như tối qua\Ncũng ăn mì cốc thì phải.
Dialogue: 0,0:13:54.38,0:13:56.40,Main,,0,0,0,,Đừng có nói mớ.
Dialogue: 0,0:13:56.40,0:14:00.28,Main,,0,0,0,,Hôm qua với hôm kia\Nba bữa đều là mì cốc còn gì.
Dialogue: 0,0:14:00.28,0:14:01.29,Main,,0,0,0,,Anh quên rồi à?
Dialogue: 0,0:14:01.29,0:14:04.52,Main,,0,0,0,,Thế à? Tôi cứ tưởng là mơ cơ.
Dialogue: 0,0:14:04.52,0:14:07.14,Main,,0,0,0,,Muốn đổi món thì còn nhiều loại lắm.
Dialogue: 0,0:14:07.14,0:14:11.91,Main,,0,0,0,,Udon cốc, soba cốc,\Nrút dây là 5 giây sau nóng hổi.
Dialogue: 0,0:14:11.91,0:14:16.52,Main,,0,0,0,,Có cả sushi cốc nữa,\Nnhưng quá hạn chừng một năm rồi.
Dialogue: 0,0:14:16.52,0:14:17.74,Main,,0,0,0,,Không chê thì cứ ăn.
Dialogue: 0,0:14:17.74,0:14:19.63,Main,,0,0,0,,Ăn thôi~!
Dialogue: 0,0:14:29.97,0:14:34.86,Main,,0,0,0,,Con người mà cứ ăn toàn\Ntinh bột thì không ổn lắm nhỉ.
Dialogue: 0,0:14:34.86,0:14:37.22,Main,,0,0,0,,Phải có thêm chất đạm chứ nhỉ.
Dialogue: 0,0:14:37.22,0:14:39.18,Main,,0,0,0,,Anh nói cái gì thế?
Dialogue: 0,0:14:39.18,0:14:41.40,Main,,0,0,0,,Ý tôi là thịt ngon lắm.
Dialogue: 0,0:14:41.40,0:14:46.11,Main,,0,0,0,,Lần này đừng tóm mấy con tép riu nữa,\Nbắt con cá to đi.
Dialogue: 0,0:14:50.65,0:14:52.99,Main,,0,0,0,,Này, Faye. Bên cô sao rồi?
Dialogue: 0,0:14:52.99,0:14:56.08,Main,,0,0,0,,Sao trăng gì nữa. Nghe tôi kể không?
Dialogue: 0,0:14:56.08,0:15:02.00,Main,,0,0,0,,Chả phải cô bảo thằng hacker dễ xơi,\Nđi đua ngựa tiện tay tóm luôn à?
Dialogue: 0,0:15:02.00,0:15:04.85,Main,,0,0,0,,Tôi bị cuốn vào một vụ nổ quái lạ.
Dialogue: 0,0:15:04.85,0:15:07.27,Main,,0,0,0,,A, xin một điếu nhé.
Dialogue: 0,0:15:07.27,0:15:10.45,Main,,0,0,0,,Đua ngựa thì thua,\Nchả được cái gì ra hồn.
Dialogue: 0,0:15:10.45,0:15:13.12,Main,,0,0,0,,A, đây đây.
Dialogue: 0,0:15:13.12,0:15:14.96,Main,,0,0,0,,Cô có mặt ở đó à?
Dialogue: 0,0:15:14.96,0:15:18.60,Main,,0,0,0,,Hê, vụ này lớn phết nhỉ.
Dialogue: 0,0:15:18.60,0:15:22.93,Main,,0,0,0,,Hử? Virus á? Ái chà chà.
Dialogue: 0,0:15:22.93,0:15:26.10,Main,,0,0,0,,Vũ khí hóa học cơ à. Hừm.
Dialogue: 0,0:15:29.00,0:15:31.07,Main,,0,0,0,,Này, làm cái gì thế?
Dialogue: 0,0:15:31.07,0:15:32.70,Main,,0,0,0,,Mấy người kia!
Dialogue: 0,0:15:32.70,0:15:34.06,Main,,0,0,0,,Đến cả Ein cũng...
Dialogue: 0,0:15:34.06,0:15:36.85,Main,,0,0,0,,Eo ơi~ Đồ vi trùng~!
Dialogue: 0,0:15:36.85,0:15:38.17,Main,,0,0,0,,Có vấn đề gì hả?
Dialogue: 0,0:15:40.14,0:15:41.04,Main,,0,0,0,,Thôi đi!
Dialogue: 0,0:15:41.04,0:15:46.63,Main,,0,0,0,,Ngoài ra, chính phủ Sao Hỏa đã thông báo\Ntreo thưởng 300 triệu ô long cho hung thủ.
Dialogue: 0,0:15:46.63,0:15:48.11,Main,,0,0,0,,300 triệu?!
Dialogue: 0,0:15:48.11,0:15:48.88,Main,,0,0,0,,Nya?
Dialogue: 0,0:16:16.96,0:16:18.32,Main,,0,0,0,,Thế này là sao?
Dialogue: 0,0:16:18.32,0:16:19.38,Main,,0,0,0,,Bên đó cũng thế à?
Dialogue: 0,0:16:19.38,0:16:20.22,Main,,0,0,0,,Ờ.
Dialogue: 0,0:16:27.63,0:16:28.66,Main,,0,0,0,,Sao rồi?
Dialogue: 0,0:16:28.66,0:16:32.28,Main,,0,0,0,,Chả ra sao cả.\NChưa từng thấy triệu chứng nào như thế.
Dialogue: 0,0:16:32.28,0:16:35.96,Main,,0,0,0,,Hầu hết bệnh nhân đều có\Ntriệu chứng tăng áp lực nội sọ,
Dialogue: 0,0:16:35.96,0:16:40.56,Main,,0,0,0,,nhưng không có ngoại thương nào.\NHoàn toàn không rõ nguyên nhân.
Dialogue: 0,0:16:40.56,0:16:42.91,Main,,0,0,0,,Tôi thì càng mù tịt.
Dialogue: 0,0:16:42.91,0:16:48.26,Main,,0,0,0,,Lúc mới đưa vào, bệnh nhân nào\Ncũng có lượng tế bào lympho tăng cao,
Dialogue: 0,0:16:48.26,0:16:53.40,Main,,0,0,0,,giờ thì đều về mức bình thường,\Ntriệu chứng lại cứ nặng thêm.
Dialogue: 0,0:16:53.40,0:16:56.80,Main,,0,0,0,,Không phải đậu mùa hay Ebola à?
Dialogue: 0,0:16:56.80,0:17:02.15,Main,,0,0,0,,Cũng chả phải khí độc thần kinh \Nhay virus đã biết. Mà vốn chả xác định nổi.
Dialogue: 0,0:17:02.15,0:17:03.83,Main,,0,0,0,,Thế là sao?
Dialogue: 0,0:17:03.83,0:17:09.92,Main,,0,0,0,,Chả tìm thấy dấu vết gì.\NNgay cả từ thi thể cũng không.
Dialogue: 0,0:17:10.94,0:17:15.21,Main,,0,0,0,,Có thể là một loại virus chủng mới,
Dialogue: 0,0:17:15.21,0:17:18.76,Main,,0,0,0,,hoặc vũ khí sinh học chưa từng biết.
Dialogue: 0,0:17:19.52,0:17:21.92,Main,,0,0,0,,Hoặc là, một sức mạnh\Nkhủng khiếp nào đó...
Dialogue: 0,0:17:34.26,0:17:37.62,Main,,0,0,0,,Xin lỗi.\NTôi bị dị ứng phấn hoa.
Dialogue: 0,0:17:41.88,0:17:47.32,Main,,0,0,0,,À, không... Tôi cứ tưởng dị ứng phấn hoa\Nlà bệnh tuyệt chủng từ lâu rồi chứ.
Dialogue: 0,0:17:47.32,0:17:49.79,Main,,0,0,0,,Khéo cái này cũng là một loại virus gì đó,
Dialogue: 0,0:17:49.79,0:17:54.28,Main,,0,0,0,,có khi do ai đó cố tình phát tán cũng nên.
Dialogue: 0,0:17:54.28,0:17:55.89,Main,,0,0,0,,Ở đây cấm hút thuốc đấy.
Dialogue: 0,0:17:59.72,0:18:01.81,Main,,0,0,0,,Dám giỡn mặt người ta cơ đấy.
Dialogue: 0,0:18:04.43,0:18:06.59,Main,,0,0,0,,Cô chắc là không sao đấy chứ?
Dialogue: 0,0:18:06.59,0:18:09.44,Main,,0,0,0,,Có sao thì đằng nào\Ncũng kéo cả lũ chết chung.
Dialogue: 0,0:18:09.44,0:18:10.99,Main,,0,0,0,,Ra rồi~
Dialogue: 0,0:18:10.99,0:18:12.88,Main,,0,0,0,,Khủng bố sinh học à.
Dialogue: 0,0:18:12.88,0:18:15.52,Main,,0,0,0,,Spike, anh cũng xem đi.
Dialogue: 0,0:18:15.52,0:18:16.83,Main,,0,0,0,,Chả có hứng lắm.
Dialogue: 0,0:18:16.83,0:18:19.60,Main,,0,0,0,,Nói trước nhé,\Nphí thông tin không rẻ đâu.
Dialogue: 0,0:18:19.60,0:18:22.22,Main,,0,0,0,,Biết rồi. Mau cho xem đi.
Dialogue: 0,0:18:22.22,0:18:23.93,Main,,0,0,0,,Thông tin quý lắm đấy.
Dialogue: 0,0:18:23.93,0:18:25.52,Main,,0,0,0,,Ed, chiếu lên đi.
Dialogue: 0,0:18:25.52,0:18:26.66,Main,,0,0,0,,Rõ~
Dialogue: 0,0:18:27.30,0:18:31.36,Main,,0,0,0,,Thằng này là hacker Lee Samson,\Nbị treo thưởng 5 triệu.
Dialogue: 0,0:18:31.36,0:18:36.00,Main,,0,0,0,,Tôi đã lần ra cái thẻ\Nđứng tên giả mà nó dùng.
Dialogue: 0,0:18:36.00,0:18:37.08,Main,,0,0,0,,Bằng cách nào?
Dialogue: 0,0:18:37.08,0:18:39.67,Main,,0,0,0,,Hack vào công ty thẻ đó~
Dialogue: 0,0:18:39.67,0:18:44.17,Main,,0,0,0,,Rồi có người dùng thẻ đó thuê xe này,\Nai ngờ nó nổ cái đùng.
Dialogue: 0,0:18:44.17,0:18:48.13,Main,,0,0,0,,Mà người ngồi trên xe\Nlại không phải Lee. Chắc là đồng bọn.
Dialogue: 0,0:18:48.80,0:18:50.30,Main,,0,0,0,,Đây, chính là gã này.
Dialogue: 0,0:18:51.44,0:18:53.78,Main,,0,0,0,,Chả nhìn rõ gì cả.
Dialogue: 0,0:18:53.78,0:18:58.95,Main,,0,0,0,,Thông tin giá trị ghê.\NCó tấm hình mờ tịt mà đòi bắt hắn à?
Dialogue: 0,0:18:58.95,0:19:03.15,Main,,0,0,0,,Gì chứ, trong đầu tôi\Nvẫn nhớ rõ mồn một đây này.
Dialogue: 0,0:19:03.15,0:19:05.08,Main,,0,0,0,,Đây này~
Dialogue: 0,0:19:05.08,0:19:09.16,Main,,0,0,0,,Dùng bút này vẽ vẽ\Nlên màn hình được đấy~
Dialogue: 0,0:19:09.16,0:19:12.79,Main,,0,0,0,,Mà làm sao biết gã này\Ncó phải hung thủ hay không.
Dialogue: 0,0:19:12.79,0:19:17.57,Main,,0,0,0,,Với lại không đeo mặt nạ mà đứng đó\Nthì hắn phải gục đầu tiên chứ.
Dialogue: 0,0:19:17.57,0:19:19.59,Main,,0,0,0,,Gã đó chưa chết đâu.
Dialogue: 0,0:19:19.59,0:19:21.07,Main,,0,0,0,,Sao cô biết?
Dialogue: 0,0:19:21.07,0:19:23.80,Main,,0,0,0,,Linh cảm của tôi đấy.
Dialogue: 0,0:19:23.80,0:19:26.18,Main,,0,0,0,,Linh cảm cơ đấy.
Dialogue: 0,0:19:26.18,0:19:27.52,Main,,0,0,0,,Xong rồi.
Dialogue: 0,0:19:28.69,0:19:30.27,Main,,0,0,0,,Cái quái gì đây?
Dialogue: 0,0:19:30.27,0:19:33.05,Main,,0,0,0,,Cái mặt này hơi bị\Ntrừu tượng thì phải...
Dialogue: 0,0:19:33.05,0:19:35.10,Main,,0,0,0,,Ha-nya~
Dialogue: 0,0:19:35.10,0:19:40.47,Main,,0,0,0,,Hay đấy chứ. Nhờ bức vẽ này\Nmà bắt được thì tôi tự trả thưởng.
Dialogue: 0,0:19:40.47,0:19:44.53,Main,,0,0,0,,À thế à. Thôi được rồi. Khỏi cần.
Dialogue: 0,0:19:44.53,0:19:46.28,Main,,0,0,0,,Tôi sẽ tự đi bắt một mình.
Dialogue: 0,0:19:47.01,0:19:50.52,Main,,0,0,0,,Chậc chậc, đúng là phí thời gian.
Dialogue: 0,0:19:50.52,0:19:52.92,Main,,0,0,0,,Để thử điều tra từ vụ virus xem sao.
Dialogue: 0,0:19:52.92,0:19:55.52,Main,,0,0,0,,Sao, tự dưng có hứng rồi à?
Dialogue: 0,0:19:55.52,0:19:59.09,Main,,0,0,0,,Linh cảm của phụ nữ ấy mà,\Nkhông xem thường được đâu.
Dialogue: 0,0:19:59.09,0:20:00.13,Main,,0,0,0,,Nhưng mà...
Dialogue: 0,0:20:00.60,0:20:04.39,Main,,0,0,0,,...lâu lâu cũng muốn ăn thứ gì\Nkhông đựng trong cốc nữa.
Dialogue: 0,0:21:14.16,0:21:16.40,Main,,0,0,0,,Hồi xưa bay nhiều ra phết nhỉ.
Dialogue: 0,0:21:16.40,0:21:18.82,Main,,0,0,0,,Ờ, bay suốt, bay suốt.
Dialogue: 0,0:21:18.82,0:21:24.33,Main,,0,0,0,,Lại muốn bay quá đi mất.\NCứ vèo một cái tới tận Sao Thổ ấy.
Dialogue: 0,0:21:24.33,0:21:25.74,Main,,0,0,0,,Đừng có mà chém gió.
Dialogue: 0,0:21:25.74,0:21:30.03,Main,,0,0,0,,Cái ông lái là máy bay cánh quạt\Nphun thuốc trừ sâu ngoài ruộng thôi.
Dialogue: 0,0:21:30.03,0:21:31.75,Main,,0,0,0,,Thế cơ à?
Dialogue: 0,0:21:31.75,0:21:32.85,Main,,0,0,0,,Này, cho hỏi chút.
Dialogue: 0,0:21:33.89,0:21:36.28,Main,,0,0,0,,Tôi có chuyện muốn hỏi.
Dialogue: 0,0:21:36.28,0:21:39.14,Main,,0,0,0,,Bọn tôi lãng tai rồi, chịu thôi.
Dialogue: 0,0:21:40.14,0:21:41.85,Main,,0,0,0,,Mấy ông biết tiệm đậu không?
Dialogue: 0,0:21:41.85,0:21:44.90,Main,,0,0,0,,Đậu thì đâu đâu chả bán.
Dialogue: 0,0:21:44.90,0:21:47.96,Main,,0,0,0,,Tiệm bán thứ đậu\Nkhông phải đâu cũng bán ấy.
Dialogue: 0,0:21:47.96,0:21:50.19,Main,,0,0,0,,Cảnh sát thì miễn tiếp.
Dialogue: 0,0:21:50.19,0:21:51.96,Main,,0,0,0,,Trông tôi giống cảnh sát lắm à?
Dialogue: 0,0:21:51.96,0:21:54.48,Main,,0,0,0,,Nói đúng ra thì giống yakuza hơn.
Dialogue: 0,0:21:54.48,0:21:56.54,Main,,0,0,0,,Thì cũng na ná nhau cả.
Dialogue: 0,0:21:56.54,0:21:58.83,Main,,0,0,0,,Tôi là thợ săn tiền thưởng.
Dialogue: 0,0:21:59.55,0:22:01.48,Main,,0,0,0,,Gì, ra là cao bồi à.
Dialogue: 0,0:22:01.48,0:22:03.82,Main,,0,0,0,,Hồi xưa bọn tôi cũng thế đấy.
Dialogue: 0,0:22:03.82,0:22:05.42,Main,,0,0,0,,Thế thì dễ nói chuyện rồi.
Dialogue: 0,0:22:05.42,0:22:07.31,Main,,0,0,0,,Thế thì càng miễn tiếp.
Dialogue: 0,0:22:25.40,0:22:27.87,Main,,0,0,0,,Cậu là người đang tìm tiệm đậu à?
Dialogue: 0,0:22:35.71,0:22:38.14,Main,,0,0,0,,Có loại đậu nhỏ đến mức\Nmắt không nhìn thấy không?
Dialogue: 0,0:22:38.14,0:22:41.79,Main,,0,0,0,,Đương nhiên. Ở phố Moroccan\Ncái gì cũng có.
Dialogue: 0,0:22:43.51,0:22:45.45,Main,,0,0,0,,Thế nên cậu mới tới đây chứ gì.
Comment: 0,0:22:57.78,0:22:59.37,Main,,0,0,0,,{ハイ ラシード}Chào, Rashid.
Comment: 0,0:22:59.49,0:23:00.24,Main,,0,0,0,,{やあ}Chào.
Comment: 0,0:23:02.50,0:23:04.37,Main,,0,0,0,,{おお ラシード 久し振りだ}Ồ, Rashid, lâu lắm không gặp.
Comment: 0,0:23:04.50,0:23:06.46,Main,,0,0,0,,{元気か マホメッド}Khỏe không, Mohammed?
Comment: 0,0:23:06.58,0:23:07.96,Main,,0,0,0,,{何やってんだ}Đang làm gì đấy?
Comment: 0,0:23:08.08,0:23:09.00,Main,,0,0,0,,{ちょっとな}Có chút việc.
Comment: 0,0:23:09.42,0:23:10.38,Main,,0,0,0,,{おう ラシード}Ô, Rashid.
Comment: 0,0:23:10.50,0:23:11.92,Main,,0,0,0,,{ハイ}Chào.
Comment: 0,0:23:12.96,0:23:13.92,Main,,0,0,0,,{ラシード}Rashid!
Comment: 0,0:23:14.05,0:23:14.88,Main,,0,0,0,,{おう}Ờ!
Comment: 0,0:23:15.01,0:23:16.72,Main,,0,0,0,,{入れ歯どうだ？}Răng giả dùng ổn chứ?
Comment: 0,0:23:17.18,0:23:18.38,Main,,0,0,0,,{ラシードじゃないか}Rashid đấy à!
Comment: 0,0:23:18.72,0:23:20.01,Main,,0,0,0,,{おお ゾーフィか}Ồ, Zofi đấy à.
Comment: 0,0:23:21.30,0:23:22.81,Main,,0,0,0,,{お茶でも飲んでくか？}Vào uống chén trà không?
Comment: 0,0:23:22.93,0:23:24.22,Main,,0,0,0,,{また後でな}Để lúc khác nhé.
Dialogue: 0,0:23:25.76,0:23:27.96,Main,,0,0,0,,Mua hạt dẻ cười không?\NHạnh nhân thì sao?
Dialogue: 0,0:23:29.28,0:23:33.48,Main,,0,0,0,,Đây là đậu Calabar,\Nloại đậu để phán xử vợ ngoại tình.
Dialogue: 0,0:23:33.48,0:23:38.78,Main,,0,0,0,,Người ngay ăn một hơi,\Nsẽ bị sặc nôn ra, nên thoát chết.
Dialogue: 0,0:23:38.78,0:23:42.93,Main,,0,0,0,,Kẻ gian thì sợ sệt ăn từng hạt,\Năn chậm nên ngấm độc, đau đớn mà chết.
Dialogue: 0,0:23:42.93,0:23:44.40,Main,,0,0,0,,Thế nên nhìn là biết ngay.
Dialogue: 0,0:23:44.97,0:23:46.62,Main,,0,0,0,,Tôi làm gì có vợ.
Dialogue: 0,0:23:46.62,0:23:48.86,Main,,0,0,0,,Thế thì cậu có phúc đấy.
Dialogue: 0,0:23:48.86,0:23:50.26,Main,,0,0,0,,Thứ tôi muốn biết là...
Dialogue: 0,0:23:50.26,0:23:54.89,Main,,0,0,0,,Đậu tằm là không được.\NPythagoras chết cũng vì dị ứng đậu đấy.
Dialogue: 0,0:23:54.89,0:23:56.76,Main,,0,0,0,,Đừng có coi thường hạt đậu.
Dialogue: 0,0:24:00.77,0:24:05.47,Main,,0,0,0,,Thứ tôi đang tìm là virus\Nđược dùng trong vụ nổ xe bồn.
Dialogue: 0,0:24:10.25,0:24:12.02,Main,,0,0,0,,Cậu có tin vào ác quỷ không?
Dialogue: 0,0:24:13.02,0:24:15.69,Main,,0,0,0,,Giữa bao nhiêu thứ tồn tại trên đời,
Dialogue: 0,0:24:15.69,0:24:19.78,Main,,0,0,0,,biết vì sao con người lại tưởng tượng\Nra những thứ vượt xa hơn thế không?
Dialogue: 0,0:24:21.27,0:24:26.39,Main,,0,0,0,,Vì sao con người nhớ nhung bầu trời,\Nkhao khát bay vào vũ trụ?
Dialogue: 0,0:24:26.39,0:24:30.97,Main,,0,0,0,,Đó là vì xưa kia\Ncon người từng bay trên trời.
Dialogue: 0,0:24:30.97,0:24:32.72,Main,,0,0,0,,Ở đây bán cả ma túy à?
Dialogue: 0,0:24:34.02,0:24:37.36,Main,,0,0,0,,Thứ gì tưởng tượng ra được\Nthì đều có thể tồn tại.
Dialogue: 0,0:24:37.36,0:24:39.59,Main,,0,0,0,,Dù cho mắt không nhìn thấy.
Dialogue: 0,0:24:40.78,0:24:42.79,Main,,0,0,0,,Vậy là ông có virus đúng không?
Dialogue: 0,0:24:43.94,0:24:45.79,Main,,0,0,0,,Đó đâu phải là virus.
Dialogue: 0,0:25:24.75,0:25:27.87,Main,,0,0,0,,Chào, Rashid.\NTôi mới có một cái bình đẹp lắm.
Dialogue: 0,0:25:27.87,0:25:29.95,Main,,0,0,0,,Cái bình này\Nhợp với ông lắm đấy.
Dialogue: 0,0:25:31.61,0:25:35.04,Main,,0,0,0,,Không, cái bình này\Nhợp với cậu này hơn.
Dialogue: 0,0:25:35.04,0:25:38.09,Main,,0,0,0,,À, cái bình này hợp với cậu đấy.
Dialogue: 0,0:25:38.09,0:25:39.85,Main,,0,0,0,,Hợp với tôi kiểu gì cơ chứ.
Dialogue: 0,0:25:40.37,0:25:42.90,Main,,0,0,0,,Thứ hợp với mình\Nthì nên mua lấy.
Dialogue: 0,0:25:42.90,0:25:46.27,Main,,0,0,0,,Này. Tôi đến đây\Nđâu phải để mua đồ.
Dialogue: 0,0:25:46.27,0:25:49.04,Main,,0,0,0,,Cậu mua được món hời rồi đấy.\NChào nhé.
Dialogue: 0,0:25:49.04,0:25:50.48,Main,,0,0,0,,N-này, khoan đã!
Dialogue: 0,0:25:50.48,0:25:51.91,Main,,0,0,0,,Inshallah.
Dialogue: 0,0:25:51.91,0:25:54.59,Main,,0,0,0,,Này, đứng lại! Này!
Dialogue: 0,0:26:35.72,0:26:38.67,Main,,0,0,0,,Hay thật.\NGame thế kỷ 20 vẫn là nhất.
Dialogue: 0,0:26:38.67,0:26:43.10,Main,,0,0,0,,Nói thật, mấy game thời nay\Ntôi chán ngấy rồi.
Dialogue: 0,0:26:43.10,0:26:46.69,Main,,0,0,0,,Dạo này tôi mê mấy trò\Nhoài cổ thế này lắm.
Dialogue: 0,0:26:46.69,0:26:50.90,Main,,0,0,0,,Mà công nhận hay thật.\NNgày xưa chỉ cỡ này là đủ rồi.
Dialogue: 0,0:26:50.90,0:26:52.63,Main,,0,0,0,,Hacker cũng thế đấy.
Dialogue: 0,0:26:52.63,0:26:55.73,Main,,0,0,0,,Thề luôn. Thời của Captain Crunch\Nmới là thời hoàng kim.
Dialogue: 0,0:26:55.73,0:27:00.17,Main,,0,0,0,,Chỉ làm mấy trò cỏn con\Nlà đã đi vào lịch sử rồi.
Dialogue: 0,0:27:00.17,0:27:05.61,Main,,0,0,0,,Giờ chỗ nào bảo mật cũng chặt,\Nchả làm vụ lớn thì đừng hòng nổi.
Dialogue: 0,0:27:05.61,0:27:09.18,Main,,0,0,0,,Nên tôi biết ơn anh lắm đấy.\NThật luôn.
Dialogue: 0,0:27:09.18,0:27:11.40,Main,,0,0,0,,Tôi muốn thử một lần lắm rồi,
Dialogue: 0,0:27:11.99,0:27:14.11,Main,,0,0,0,,làm khủng bố ấy.
Dialogue: 0,0:27:29.87,0:27:32.71,Main,,0,0,0,,Á, chết mất rồi.
Dialogue: 0,0:27:35.85,0:27:37.53,Main,,0,0,0,,Cho tôi xem bằng lái.
Dialogue: 0,0:27:37.53,0:27:38.38,Main,,0,0,0,,Định đi đâu đấy?
Dialogue: 0,0:27:39.00,0:27:41.55,Main,,0,0,0,,Phía trước toàn là\Nkhu nhà kho thôi mà...
Dialogue: 0,0:27:47.97,0:27:50.31,Main,,0,0,0,,Ây da, chết mất rồi.
Dialogue: 0,0:28:15.30,0:28:20.44,Main,,0,0,0,,Kẻ địch mà nhìn thấy được\Nthì làm cảnh sát cũng nhàn.
Dialogue: 0,0:28:20.44,0:28:24.22,Main,,0,0,0,,Thế? Bên trong xe bồn là thứ gì?
Dialogue: 0,0:28:24.96,0:28:27.72,Main,,0,0,0,,Khổ nỗi là chả tra ra được gì cả.
Dialogue: 0,0:28:27.72,0:28:29.25,Main,,0,0,0,,Thế là sao?
Dialogue: 0,0:28:29.25,0:28:31.06,Main,,0,0,0,,Thì là thế đấy.
Dialogue: 0,0:28:31.06,0:28:35.06,Main,,0,0,0,,Tóm lại là thứ mắt không thấy,\Nmà cũng chưa ai từng thấy.
Dialogue: 0,0:28:47.40,0:28:48.56,Main,,0,0,0,,Còn vụ này?
Dialogue: 0,0:28:48.56,0:28:53.04,Main,,0,0,0,,Ba hôm trước, gần một tiểu hành tinh,\Nngười ta thấy một xe tải vũ trụ.
Dialogue: 0,0:28:53.04,0:28:57.06,Main,,0,0,0,,Tài xế chết tại chỗ,\Ncòn hàng hóa thì trống trơn.
Dialogue: 0,0:28:57.06,0:28:58.87,Main,,0,0,0,,Vụ cướp à?
Dialogue: 0,0:28:58.87,0:29:03.90,Main,,0,0,0,,Chủ của chiếc xe tải\Nlà công ty dược tên Cherious Medical,
Dialogue: 0,0:29:03.90,0:29:07.86,Main,,0,0,0,,nhưng bên đó còn chả thèm báo mất tích.
Dialogue: 0,0:29:07.86,0:29:12.39,Main,,0,0,0,,Đồn ầm lên là chắc xe\Nđang chở thứ gì mờ ám.
Dialogue: 0,0:29:12.39,0:29:15.16,Main,,0,0,0,,Rồi lại đến vụ xe bồn kia, đúng không?
Dialogue: 0,0:29:15.16,0:29:16.54,Main,,0,0,0,,Có mùi rồi đấy.
Dialogue: 0,0:29:16.54,0:29:20.07,Main,,0,0,0,,Công ty dược mà\Ncanh phòng chặt bất thường.
Dialogue: 0,0:29:20.56,0:29:23.24,Main,,0,0,0,,Sao không khám xét mạnh tay đi?
Dialogue: 0,0:29:23.24,0:29:25.93,Main,,0,0,0,,Viện cớ vụ khác cũng vào được mà.
Dialogue: 0,0:29:25.93,0:29:29.10,Main,,0,0,0,,Khác thời anh còn ở đó rồi.
Dialogue: 0,0:29:29.10,0:29:33.46,Main,,0,0,0,,Giờ ISSP chỉ còn cái danh,\Nbên trong rỗng tuếch cả.
Dialogue: 0,0:29:34.28,0:29:37.69,Main,,0,0,0,,Sếp lớn thì chỉ\Nquan tâm chuyện thăng chức,
Dialogue: 0,0:29:37.69,0:29:41.31,Main,,0,0,0,,lính quèn thì nhắm mắt cho yakuza\Nđể kiếm chút cháo.
Dialogue: 0,0:29:41.31,0:29:43.79,Main,,0,0,0,,Bị chọc vào là bên tôi cũng toi.
Dialogue: 0,0:29:43.79,0:29:45.05,Main,,0,0,0,,Mục ruỗng cả rồi.
Dialogue: 0,0:29:47.23,0:29:49.84,Main,,0,0,0,,Có thay đổi gì đâu.
Dialogue: 0,0:29:49.84,0:29:51.26,Main,,0,0,0,,Thế nên tôi mới nghỉ.
Dialogue: 0,0:30:25.88,0:30:27.80,Main,,0,0,0,,Đã bao giờ nghe về Luyện ngục chưa?
Dialogue: 0,0:30:29.80,0:30:32.52,Main,,0,0,0,,Là nơi nằm giữa\NThiên đường và Địa ngục.
Dialogue: 0,0:30:33.75,0:30:39.29,Main,,0,0,0,,Nơi những kẻ không vào được Thiên đường\Nbị bỏ lại, đời đời chịu đày đọa.
Dialogue: 0,0:30:40.11,0:30:41.48,Main,,0,0,0,,Phải,
Dialogue: 0,0:30:41.48,0:30:43.27,Main,,0,0,0,,chính là thế giới này đây.
Dialogue: 0,0:30:46.28,0:30:48.28,Main,,0,0,0,,Chỉ có thế này thôi à?
Dialogue: 0,0:30:49.04,0:30:52.70,Main,,0,0,0,,Trong một viên nang này\Ncó 30.000 hạt.
Dialogue: 0,0:30:52.70,0:30:55.77,Main,,0,0,0,,Mở viên nang ra\Nlà chúng sẽ tự nhân lên.
Dialogue: 0,0:30:56.37,0:30:59.08,Main,,0,0,0,,N-này, cẩn thận chứ!
Dialogue: 0,0:30:59.08,0:31:01.15,Main,,0,0,0,,Thế còn tiền đâu?
Dialogue: 0,0:31:07.22,0:31:10.09,Main,,0,0,0,,Thế này là khác thỏa thuận rồi còn gì?
Dialogue: 0,0:31:10.10,0:31:12.73,Main,,0,0,0,,Nửa còn lại thì\Nđợi bữa tiệc tàn đã.
Dialogue: 0,0:31:13.58,0:31:15.49,Main,,0,0,0,,Sau đó muốn làm gì thì làm.
Dialogue: 0,0:31:17.02,0:31:19.59,Main,,0,0,0,,Thế là tạm biệt\Ncái kiếp sống bần tiện này.
Dialogue: 0,0:31:21.43,0:31:23.48,Main,,0,0,0,,Tôi hỏi một câu được không?
Dialogue: 0,0:31:24.39,0:31:27.24,Main,,0,0,0,,Sao lại là ngày Halloween?
Dialogue: 0,0:31:28.09,0:31:31.10,Main,,0,0,0,,Nghe nói ngày xưa, Halloween
Dialogue: 0,0:31:31.10,0:31:36.11,Main,,0,0,0,,là ngày người ta cầu nguyện để linh hồn\Nở Luyện ngục được lên Thiên đường.
Dialogue: 0,0:31:37.68,0:31:39.83,Main,,0,0,0,,Hãy cầu nguyện đi.
Dialogue: 0,0:31:56.09,0:31:57.80,Main,,0,0,0,,Chào bà con!
Dialogue: 0,0:31:57.80,0:32:02.37,Main,,0,0,0,,3 triệu bà con thợ săn tiền thưởng\Ntrong Hệ Mặt Trời khỏe không nào?
Dialogue: 0,0:32:02.37,0:32:05.86,Main,,0,0,0,,Lại đến giờ của Big Shot\Nquen thuộc rồi đây. Đoàng!
Dialogue: 0,0:32:05.86,0:32:09.65,Main,,0,0,0,,Nào, hôm nay cũng giới thiệu tới\Nbà con thông tin truy nã nóng hổi!
Dialogue: 0,0:32:09.65,0:32:13.95,Main,,0,0,0,,Hôm nay là chương trình đặc biệt,\Nkéo dài hơn mọi khi tận 20 phút đấy.
Dialogue: 0,0:32:13.95,0:32:17.39,Main,,0,0,0,,Tất cả là vì kẻ đang là\Ntâm điểm của thợ săn tiền thưởng,
Dialogue: 0,0:32:17.39,0:32:21.26,Main,,0,0,0,,gã đáng ghét trị giá 300 triệu ô long,\Nhôm nay là chuyên đề về hắn đấy.
Dialogue: 0,0:32:21.26,0:32:24.58,Main,,0,0,0,,Đúng thế, dù sao cũng là\Nmức thưởng cao nhất lịch sử mà.
Dialogue: 0,0:32:24.58,0:32:28.41,Main,,0,0,0,,Chỉ tiếc là hắn là ai, ở đâu,\Nhoàn toàn chưa ai biết.
Dialogue: 0,0:32:28.41,0:32:30.25,Main,,0,0,0,,Không có manh mối gì sao?
Dialogue: 0,0:32:30.25,0:32:33.51,Main,,0,0,0,,Hoàn toàn không!\NThứ bị phát tán là gì cũng chưa rõ,
Dialogue: 0,0:32:33.51,0:32:35.64,Main,,0,0,0,,lại chả có nhân chứng nào còn sống.
Dialogue: 0,0:32:35.64,0:32:38.43,Main,,0,0,0,,Thế thì bọn mình\Ngiới thiệu cái gì đây?
Dialogue: 0,0:32:38.43,0:32:42.57,Main,,0,0,0,,Đúng thế! Nên lần này, bạn nào\Ncung cấp thông tin cho chương trình
Dialogue: 0,0:32:42.57,0:32:45.15,Main,,0,0,0,,sẽ được tặng một món quà tuyệt vời!
Dialogue: 0,0:32:45.15,0:32:50.15,Main,,0,0,0,,Nào, liên hệ ngay tới số này!\NAi nhanh thì được!
Dialogue: 0,0:32:57.66,0:33:00.81,Main,,0,0,0,,Vậy trước mắt,\Nxin mời xem quảng cáo.
Dialogue: 0,0:33:01.66,0:33:04.22,Main,,0,0,0,,Đúng là vô dụng hết chỗ nói.
Dialogue: 0,0:33:04.22,0:33:05.80,Main,,0,0,0,,Faye Faye ơi~
Dialogue: 0,0:33:06.52,0:33:08.40,Main,,0,0,0,,Nhìn này~
Dialogue: 0,0:33:09.41,0:33:11.09,Main,,0,0,0,,Chả phải màn hình ban nãy à?
Dialogue: 0,0:33:18.76,0:33:20.11,Main,,0,0,0,,Hình xăm à?
Dialogue: 0,0:33:20.11,0:33:23.35,Main,,0,0,0,,Đã thử tìm những hình\Ngiống giống cái này rồi đấy~
Dialogue: 0,0:33:24.11,0:33:26.10,Main,,0,0,0,,Là cái nào đây~?
Dialogue: 0,0:33:26.10,0:33:29.62,Main,,0,0,0,,Để xem... không phải cái này.
Dialogue: 0,0:33:30.50,0:33:31.79,Main,,0,0,0,,Cái này chăng?
Dialogue: 0,0:33:31.79,0:33:33.56,Main,,0,0,0,,Nói dối thật không đấy~?
Dialogue: 0,0:33:33.56,0:33:35.79,Main,,0,0,0,,Đúng. Không sai được, là nó.
Dialogue: 0,0:33:38.32,0:33:42.32,Main,,0,0,0,,"Biệt đội 7, Lực lượng Tác chiến Đặc biệt\NLục quân Sao Hỏa"
Dialogue: 0,0:33:42.32,0:33:45.55,Main,,0,0,0,,Phù hiệu lực lượng đặc biệt à.\NLà quân nhân nhỉ.
Dialogue: 0,0:33:45.55,0:33:48.26,Main,,0,0,0,,Giải tán từ 3 năm trước rồi~
Dialogue: 0,0:33:48.26,0:33:50.57,Main,,0,0,0,,Rồi sao? Không có dữ liệu\Ncủa đơn vị này à?
Dialogue: 0,0:33:50.57,0:33:52.09,Main,,0,0,0,,Rõ~
Dialogue: 0,0:33:55.93,0:33:58.94,Main,,0,0,0,,Gì đây,\Nchết gần hết cả rồi còn đâu.
Dialogue: 0,0:33:58.94,0:34:00.18,Main,,0,0,0,,Nyaa~
Dialogue: 0,0:34:00.18,0:34:01.17,Main,,0,0,0,,Tiếp theo đi.
Dialogue: 0,0:34:01.17,0:34:01.88,Main,,0,0,0,,Nya.
Dialogue: 0,0:34:02.64,0:34:04.18,Main,,0,0,0,,Sao thế, Ein?
Dialogue: 0,0:34:05.38,0:34:06.75,Main,,0,0,0,,Không thể nào~!
Dialogue: 0,0:34:06.75,0:34:08.65,Main,,0,0,0,,Gì vậy. Mau qua người tiếp theo đi.
Dialogue: 0,0:34:08.65,0:34:10.82,Main,,0,0,0,,Ein bảo là người này đấy~
Dialogue: 0,0:34:11.38,0:34:13.56,Main,,0,0,0,,Sao Ein biết được chứ.
Dialogue: 0,0:34:13.56,0:34:17.74,Main,,0,0,0,,Này, người này chết trong chiến tranh Titan\Ntừ 2 năm trước rồi còn gì.
Dialogue: 0,0:34:17.74,0:34:21.14,Main,,0,0,0,,Thôi, đủ rồi, nghỉ.\NDọn hết đi.
Dialogue: 0,0:34:21.14,0:34:22.24,Main,,0,0,0,,Nnn~
Dialogue: 0,0:34:22.24,0:34:25.55,Main,,0,0,0,,Việc tẻ nhạt thế này\Nchả hợp với mình tí nào.
Dialogue: 0,0:34:26.42,0:34:27.00,Main,,0,0,0,,Nya?
Dialogue: 0,0:34:27.72,0:34:32.19,Main,,0,0,0,,Chắc phải có cách sống nào\Nnhàn hơn, kiếm bộn hơn hợp với mình chứ.
Dialogue: 0,0:34:32.19,0:34:33.24,Main,,0,0,0,,Faye~
Dialogue: 0,0:34:33.24,0:34:38.46,Main,,0,0,0,,Sao mình phải phí hoài tuổi 20 đẹp đẽ\Nđi đàn đúm với cái lũ này chứ?
Dialogue: 0,0:34:38.46,0:34:39.58,Main,,0,0,0,,Faye Faye ơi~
Dialogue: 0,0:34:39.58,0:34:41.68,Main,,0,0,0,,Rốt cuộc mình sai từ chỗ nào nhỉ.
Dialogue: 0,0:34:41.68,0:34:44.30,Main,,0,0,0,,Anh Lee lại dùng thẻ rồi kìa~
Dialogue: 0,0:34:45.15,0:34:46.39,Main,,0,0,0,,Còn vụ đó nữa nhỉ!
Dialogue: 0,0:34:49.02,0:34:51.37,Main,,0,0,0,,Cái gì thế? Ống nhổ à?
Dialogue: 0,0:34:51.37,0:34:52.40,Main,,0,0,0,,Đại loại thế.
Dialogue: 0,0:34:57.79,0:34:58.40,Main,,0,0,0,,Nya?
Dialogue: 0,0:34:59.03,0:35:00.57,Main,,0,0,0,,Quà lưu niệm bình bẫy bạch tuộc à~
Dialogue: 0,0:35:00.57,0:35:02.90,Main,,0,0,0,,Đại loại thế. Cái này là gì?
Dialogue: 0,0:35:02.90,0:35:06.60,Main,,0,0,0,,Để xem nào~ Ein bảo\Nngười này chính là người này~
Dialogue: 0,0:35:06.60,0:35:08.08,Main,,0,0,0,,Nhưng Faye bảo không phải~
Dialogue: 0,0:35:09.36,0:35:12.58,Main,,0,0,0,,Rồi còn bảo anh ta\Nđi chầu trời rồi nữa~
Dialogue: 0,0:35:12.58,0:35:14.94,Main,,0,0,0,,"Vincent Volaju"
Dialogue: 0,0:35:15.88,0:35:18.09,Main,,0,0,0,,Spike, thu hoạch được gì không?
Dialogue: 0,0:35:21.20,0:35:22.36,Main,,0,0,0,,Cái này á?
Dialogue: 0,0:35:22.36,0:35:24.61,Main,,0,0,0,,Nghe đâu là cái bình\Nhợp với tôi lắm.
Dialogue: 0,0:35:24.61,0:35:25.47,Main,,0,0,0,,Bên anh thì sao?
Dialogue: 0,0:35:27.82,0:35:29.91,Main,,0,0,0,,Phim miền Tây vẫn cứ là hay.
Dialogue: 0,0:35:31.19,0:35:33.94,Main,,0,0,0,,Cho Ed xem với~
Dialogue: 0,0:35:35.51,0:35:36.14,Main,,0,0,0,,Nya.
Dialogue: 0,0:35:38.91,0:35:43.13,Main,,0,0,0,,Người dẻo quá nhỉ.\NBán cho gánh xiếc được đấy.
Dialogue: 0,0:35:43.13,0:35:45.36,Main,,0,0,0,,Tôi đã thử hỏi Bob,
Dialogue: 0,0:35:45.36,0:35:48.90,Main,,0,0,0,,chỉ được mỗi tin\Ncó một công ty dược đáng ngờ.
Dialogue: 0,0:35:48.90,0:35:50.09,Main,,0,0,0,,Công ty dược?
Dialogue: 0,0:35:50.84,0:35:52.65,Main,,0,0,0,,Có gì ở bên trong này.
Dialogue: 0,0:35:55.30,0:35:57.17,Main,,0,0,0,,Cái gì thế?
Dialogue: 0,0:36:09.23,0:36:11.39,Main,,0,0,0,,Hê, khá đấy chứ.
Dialogue: 0,0:36:11.39,0:36:12.56,Main,,0,0,0,,Tới rồi kìa.
Dialogue: 0,0:36:14.86,0:36:16.38,Main,,0,0,0,,Đi một mình à?
Dialogue: 0,0:36:16.38,0:36:18.61,Main,,0,0,0,,Nếu muốn thì chơi cùng cũng được.
Dialogue: 0,0:36:18.61,0:36:22.82,Main,,0,0,0,,Được thôi. Nhưng chị thích hàng thật\Nchứ không phải ảo thế này.
Dialogue: 0,0:36:22.82,0:36:24.20,Main,,0,0,0,,Hàng thật?
Dialogue: 0,0:36:28.21,0:36:31.31,Main,,0,0,0,,Cuối cùng cũng gặp được rồi,\Ncậu nhóc hacker.
Dialogue: 0,0:36:31.31,0:36:34.05,Main,,0,0,0,,Còn 500 điểm nữa thôi mà.
Dialogue: 0,0:36:34.05,0:36:37.16,Main,,0,0,0,,Thế là gặp được Sporky Dorky rồi.
Dialogue: 0,0:36:37.16,0:36:39.34,Main,,0,0,0,,Này, có nghe không đấy?
Dialogue: 0,0:36:39.79,0:36:43.05,Main,,0,0,0,,Tổ sư, hiếm lắm mới gặp được.
Dialogue: 0,0:36:46.02,0:36:49.60,Main,,0,0,0,,Đền thế nào đây,\Nbà chị thợ săn tiền thưởng?
Dialogue: 0,0:36:49.60,0:36:52.31,Main,,0,0,0,,Nhóc có biết\Nmình đang ở tình thế nào không?
Dialogue: 0,0:36:52.31,0:36:54.60,Main,,0,0,0,,Trò chơi kết thúc rồi, nhóc ạ.
Dialogue: 0,0:36:55.53,0:36:58.74,Main,,0,0,0,,Thù của Sporky Dorky\Nđáng sợ lắm đấy nhá~?
Dialogue: 0,0:37:06.53,0:37:08.03,Main,,0,0,0,,Gì? Á!
Dialogue: 0,0:37:09.85,0:37:10.66,Main,,0,0,0,,Khoan đã!
Dialogue: 0,0:37:19.82,0:37:21.42,Main,,0,0,0,,Hự, khoan... Á!
Dialogue: 0,0:37:44.61,0:37:47.55,Main,,0,0,0,,Hình thù lạ ghê~
Dialogue: 0,0:37:48.89,0:37:50.86,Main,,0,0,0,,Thế bên trong là cái gì?
Dialogue: 0,0:37:50.86,0:37:54.09,Main,,0,0,0,,Là lin-lin-lympho đấy~
Dialogue: 0,0:37:54.09,0:37:57.59,Main,,0,0,0,,Tế bào lympho?\NCái thứ có trong máu ấy à?
Dialogue: 0,0:37:57.59,0:38:00.86,Main,,0,0,0,,Nhưng cái này hình thù lạ lắm~
Dialogue: 0,0:38:00.86,0:38:01.96,Main,,0,0,0,,Lạ thế nào?
Dialogue: 0,0:38:02.63,0:38:04.72,Main,,0,0,0,,Chú chả hiểu gì sất.
Dialogue: 0,0:38:05.51,0:38:08.60,Main,,0,0,0,,Bên này là tế bào lympho thật~
Dialogue: 0,0:38:08.60,0:38:12.06,Main,,0,0,0,,Nhưng mà cái này thì hơi khác~
Dialogue: 0,0:38:13.06,0:38:14.72,Main,,0,0,0,,Khác chỗ nào?
Dialogue: 0,0:38:14.72,0:38:16.55,Main,,0,0,0,,Phóng to~
Dialogue: 0,0:38:20.26,0:38:21.63,Main,,0,0,0,,Vẫn chả thấy gì.
Dialogue: 0,0:38:21.63,0:38:24.99,Main,,0,0,0,,Vậy cho vào lò vi sóng\Nquay thử nhé~
Dialogue: 0,0:38:24.99,0:38:29.18,Main,,0,0,0,,Hình thù gì mà lạ ơi là lạ~
Dialogue: 0,0:38:46.15,0:38:47.36,Main,,0,0,0,,Cái gì thế?
Dialogue: 0,0:39:26.12,0:39:29.34,Main,,0,0,0,,À, alô?\NCông ty vệ sinh Tortoise phải không?
Dialogue: 0,0:39:48.74,0:39:50.28,Main,,0,0,0,,Báo cáo đi.
Dialogue: 0,0:39:50.28,0:39:54.35,Main,,0,0,0,,ISSP đang điều tra chuỗi vụ việc\Nlần này theo hướng khủng bố,
Dialogue: 0,0:39:54.35,0:39:59.05,Main,,0,0,0,,nhưng vẫn chưa xác định được nghi phạm.
Dialogue: 0,0:39:59.05,0:40:04.43,Main,,0,0,0,,Về thứ đó, họ cũng chỉ đang\Nphân tích như một loại virus.
Dialogue: 0,0:40:04.43,0:40:08.51,Main,,0,0,0,,Tạm thời chúng chưa làm rõ được đâu.\NNhưng không thể chần chừ.
Dialogue: 0,0:40:08.51,0:40:10.59,Main,,0,0,0,,Mendelo thế nào rồi, Trung úy?
Dialogue: 0,0:40:10.59,0:40:14.96,Main,,0,0,0,,Vâng. Đã có vài lần\Nnhìn thấy ông ta ở phố Moroccan,
Dialogue: 0,0:40:14.96,0:40:19.31,Main,,0,0,0,,tôi đã liên lạc với gián điệp nằm vùng,\Nnhưng Mendelo đã biến mất.
Dialogue: 0,0:40:19.92,0:40:24.86,Main,,0,0,0,,Vụ này phải được dập hoàn toàn\Ntrong phạm vi của chúng ta.
Dialogue: 0,0:40:24.86,0:40:28.53,Main,,0,0,0,,Đây là vấn đề liên quan\Nđến cả sự tồn vong của Sao Hỏa.
Dialogue: 0,0:40:28.53,0:40:33.08,Main,,0,0,0,,Nhưng liệu Vincent\Ncó thật sự dùng thứ đó không?
Dialogue: 0,0:40:34.51,0:40:39.12,Main,,0,0,0,,Thứ đó chính là ác quỷ vô hình.
Dialogue: 0,0:40:39.12,0:40:43.79,Main,,0,0,0,,Là thứ không được phép tồn tại. Và...
Dialogue: 0,0:40:43.79,0:40:48.50,Main,,0,0,0,,Không được phép sống.\NCả Vincent lẫn Mendelo.
Dialogue: 0,0:40:49.79,0:40:51.24,Main,,0,0,0,,Cô hiểu chứ?
Dialogue: 0,0:40:51.24,0:40:52.47,Main,,0,0,0,,Rõ.
Dialogue: 0,0:40:57.38,0:40:59.42,Main,,0,0,0,,Này, có thấy xe của tôi đâu không?
Dialogue: 0,0:41:00.44,0:41:02.57,Main,,0,0,0,,Chả phải ban nãy\Nanh lái ra rồi à?
Dialogue: 0,0:41:47.10,0:41:48.76,Main,,0,0,0,,Giơ hai tay lên.
Dialogue: 0,0:41:53.04,0:41:54.86,Main,,0,0,0,,Trông mặt cô quen quen.
Dialogue: 0,0:41:56.64,0:41:58.64,Main,,0,0,0,,Bộ đồ đó trông cũng được đấy.
Dialogue: 0,0:41:59.63,0:42:01.28,Main,,0,0,0,,Anh thì mặc chả hợp tí nào.
Dialogue: 0,0:42:01.28,0:42:02.15,Main,,0,0,0,,Thế à?
Dialogue: 0,0:42:03.02,0:42:04.55,Main,,0,0,0,,Quay lưng lại.
Dialogue: 0,0:42:24.78,0:42:26.19,Main,,0,0,0,,Anh biết những gì?
Dialogue: 0,0:42:26.19,0:42:30.27,Main,,0,0,0,,Cược không?\NRa mặt ngửa thì tôi khai thật.
Dialogue: 0,0:42:42.34,0:42:46.50,Main,,0,0,0,,Công ty dược mà thuê\Ncô nhân viên văn phòng giỏi võ thế.
Dialogue: 0,0:42:46.50,0:42:49.71,Main,,0,0,0,,Biết quá nhiều thì tổn thọ đấy.
Dialogue: 0,0:42:49.71,0:42:52.50,Main,,0,0,0,,Nhưng phụ nữ mạnh mẽ\Nlại đúng gu tôi.
Dialogue: 0,0:43:24.40,0:43:25.20,Main,,0,0,0,,Đứng lại!
Dialogue: 0,0:44:25.35,0:44:26.60,Main,,0,0,0,,{どかーん}Bùm!
Dialogue: 0,0:44:30.81,0:44:33.28,Main,,0,0,0,,{ん？ 何だ こりゃ}Hử? Gì thế này?
Dialogue: 0,0:44:33.28,0:44:35.74,Main,,0,0,0,,{おい 何だ う うん}Này, gì thế?
Dialogue: 0,0:44:40.24,0:44:42.74,Main,,0,0,0,,{わー 何これー アハハハハ}Oa! Cái gì thế này~
Dialogue: 0,0:44:42.74,0:44:45.25,Main,,0,0,0,,{お おい　何だ これは}N-này! Gì thế này?
Dialogue: 0,0:44:46.23,0:44:50.17,Main,,0,0,0,,"Halloween vui vẻ."\N"Cho kẹo hay bị ghẹo."
Dialogue: 0,0:44:50.75,0:44:53.96,Main,,0,0,0,,"Không cho kẹo thì bị ghẹo đấy."
Dialogue: 0,0:44:53.96,0:44:57.31,Main,,0,0,0,,"Ta nhỏ bé đến mức không ai nhận ra,
Dialogue: 0,0:44:57.31,0:44:59.76,Main,,0,0,0,,và vĩ đại đến mức không ai nhìn thấy.
Dialogue: 0,0:44:59.76,0:45:02.91,Main,,0,0,0,,Đến tận xương tủy,\Ntất cả đều được tạo nên từ nó."
Dialogue: 0,0:45:02.91,0:45:05.33,Main,,0,0,0,,Hắn muốn nói gì thế?
Dialogue: 0,0:45:05.33,0:45:09.28,Main,,0,0,0,,Không rõ lắm, nhưng với một bản tuyên bố\Nthì nghe cũng đầy ẩn ý đấy.
Dialogue: 0,0:45:09.28,0:45:12.88,Main,,0,0,0,,Này, quanh đây có cái mũ\Nxấu hoắc nào rơi không?
Dialogue: 0,0:45:12.88,0:45:17.35,Main,,0,0,0,,Giờ không phải lúc.\NTên bị truy nã kia vừa ra tuyên bố đấy.
Dialogue: 0,0:45:17.35,0:45:18.95,Main,,0,0,0,,Chắc là trò đùa thôi chứ gì?
Dialogue: 0,0:45:18.95,0:45:23.07,Main,,0,0,0,,Chưa thấy thứ trong bình hôm qua\Nthì có khi tôi cũng nghĩ thế.
Dialogue: 0,0:45:23.07,0:45:24.02,Main,,0,0,0,,Bình á?
Dialogue: 0,0:45:26.33,0:45:29.21,Main,,0,0,0,,Thứ trông như tế bào lympho này
Dialogue: 0,0:45:29.21,0:45:33.26,Main,,0,0,0,,thực ra là một khối\Ngồm vô số cỗ máy tí hon.
Dialogue: 0,0:45:33.26,0:45:36.08,Main,,0,0,0,,Nghe bảo thứ này gọi là máy nano.
Dialogue: 0,0:45:36.08,0:45:37.53,Main,,0,0,0,,Máy nano?
Dialogue: 0,0:45:38.80,0:45:39.78,Main,,0,0,0,,Biết thứ đó à?
Dialogue: 0,0:45:39.78,0:45:41.29,Main,,0,0,0,,Chả biết gì cả.
Dialogue: 0,0:45:41.29,0:45:42.80,Main,,0,0,0,,Cái quái gì thế?
Dialogue: 0,0:45:42.80,0:45:46.80,Main,,0,0,0,,Đại khái là robot siêu nhỏ,\Nnhỏ đến mức mắt không thấy được.
Dialogue: 0,0:45:46.80,0:45:49.67,Main,,0,0,0,,Đã thế, nó còn được làm từ protein.
Dialogue: 0,0:45:50.84,0:45:55.90,Main,,0,0,0,,Thứ protein mà anh thích đấy,\Nmỗi tội không ăn được.
Dialogue: 0,0:45:55.90,0:45:58.85,Main,,0,0,0,,Vốn là thứ dùng trong y tế,
Dialogue: 0,0:45:58.85,0:46:01.38,Main,,0,0,0,,thế sao nó lại nằm\Ntrong cái bình đó?
Dialogue: 0,0:46:02.51,0:46:07.94,Main,,0,0,0,,Nói chung, tế bào lympho được tạo ra\Ntừ tủy xương. "Tận xương tủy" đấy.
Dialogue: 0,0:46:07.94,0:46:09.21,Main,,0,0,0,,Thì sao?
Dialogue: 0,0:46:09.21,0:46:13.02,Main,,0,0,0,,Kẻ viết tuyên bố này\Nchắc là đứa hiểu rõ chuyện đó.
Dialogue: 0,0:46:13.02,0:46:14.00,Main,,0,0,0,,Rồi sao nữa?
Dialogue: 0,0:46:14.82,0:46:16.26,Main,,0,0,0,,Chỉ biết đến thế thôi.
Dialogue: 0,0:46:16.26,0:46:20.06,Main,,0,0,0,,Gì chứ? Rốt cuộc\Nchả biết được cái con khỉ gì.
Dialogue: 0,0:46:20.06,0:46:22.22,Main,,0,0,0,,Ôi dào, đúng là phí thời gian.
Dialogue: 0,0:46:23.33,0:46:25.74,Main,,0,0,0,,Bên công ty dược thì sao?
Dialogue: 0,0:46:25.74,0:46:30.53,Main,,0,0,0,,Công ty ghê gớm lắm.\NChắc đang chế thuốc gì kinh khủng lắm.
Dialogue: 0,0:46:30.53,0:46:33.97,Main,,0,0,0,,Bảo vệ đứa nào cũng\Nđược trang bị G21.
Dialogue: 0,0:46:33.97,0:46:37.91,Main,,0,0,0,,Đó là súng máy quân dụng đấy.
Dialogue: 0,0:46:37.91,0:46:40.44,Main,,0,0,0,,Ngoài thị trường đâu có dễ kiếm.
Dialogue: 0,0:46:40.44,0:46:44.75,Main,,0,0,0,,Còn có cả một cô ả có hình xăm\Ngiống hệt Vincent.
Dialogue: 0,0:46:44.75,0:46:47.17,Main,,0,0,0,,Mà cô ả đó lại...
Dialogue: 0,0:46:47.17,0:46:48.24,Main,,0,0,0,,Lại sao?
Dialogue: 0,0:46:48.24,0:46:49.87,Main,,0,0,0,,...khá là xinh nữa.
Dialogue: 0,0:46:52.43,0:46:56.86,Main,,0,0,0,,Nói tóm lại, dính đến quân đội\Nthì chuyện khác hẳn.
Dialogue: 0,0:46:56.86,0:47:01.46,Main,,0,0,0,,Nhưng bí ẩn chẳng những chưa có lời giải\N mà lại càng chồng chất thêm.
Dialogue: 0,0:47:02.64,0:47:05.65,Main,,0,0,0,,Này, anh làm gì đấy?
Dialogue: 0,0:47:05.65,0:47:07.92,Main,,0,0,0,,Mấy lúc thế này\Nthì đi ngủ là nhất.
Dialogue: 0,0:47:08.06,0:47:08.90,Main,,0,0,0,,{おまえ}Anh thật là...
Dialogue: 0,0:47:08.90,0:47:11.16,Main,,0,0,0,,Người xưa bảo\N"cứ ngủ đi, lộc tự khắc đến".
Dialogue: 0,0:47:12.08,0:47:13.97,Main,,0,0,0,,À đúng rồi, quên mất.
Dialogue: 0,0:47:13.97,0:47:16.91,Main,,0,0,0,,Tôi đang tìm cái mũ.\NCó ai thấy không?
Dialogue: 0,0:47:16.91,0:47:18.72,Main,,0,0,0,,Không biết.
Dialogue: 0,0:47:18.72,0:47:20.69,Main,,0,0,0,,Đâu mất rồi nhỉ?
Dialogue: 0,0:47:23.35,0:47:25.57,Main,,0,0,0,,Mùi gì lạ ghê~
Dialogue: 0,0:47:26.48,0:47:27.92,Main,,0,0,0,,Ein, nhận ra không?
Dialogue: 0,0:47:53.46,0:47:55.81,Main,,0,0,0,,Hơ-nya~
Dialogue: 0,0:47:56.74,0:47:57.78,Main,,0,0,0,,Chỗ này à?
Dialogue: 0,0:48:03.85,0:48:07.23,Main,,0,0,0,,Cho cái gì đi,\Nkhông là bị ghẹo đấy~
Dialogue: 0,0:48:07.23,0:48:10.54,Main,,0,0,0,,Ồn ào quá!\NMai mới là Halloween, thằng ranh!
Dialogue: 0,0:48:18.66,0:48:20.27,Main,,0,0,0,,Không phải rồi.
Dialogue: 0,0:48:22.90,0:48:25.62,Main,,0,0,0,,Ghẹo bây giờ đấy~
Dialogue: 0,0:48:26.62,0:48:29.21,Main,,0,0,0,,Ái chà, được thôi~
Dialogue: 0,0:48:29.21,0:48:31.08,Main,,0,0,0,,Cho kẹo điii~
Dialogue: 0,0:48:31.08,0:48:33.93,Main,,0,0,0,,Hay để chị ghẹo em nhé, cậu bé?
Dialogue: 0,0:48:33.93,0:48:35.51,Main,,0,0,0,,Đâu phải cậu bé đâu?
Dialogue: 0,0:48:37.23,0:48:39.47,Main,,0,0,0,,Là con gái đấy~
Dialogue: 0,0:48:39.47,0:48:42.65,Main,,0,0,0,,Chị đây chả có việc gì với con gái.\NVề nhanh lên cho.
Dialogue: 0,0:48:47.22,0:48:48.69,Main,,0,0,0,,Không phải rồi~
Dialogue: 0,0:49:08.54,0:49:10.17,Main,,0,0,0,,Thấy rồi~
Dialogue: 0,0:49:13.56,0:49:15.57,Main,,0,0,0,,{んー はいはいはい}Rồi rồi rồi...
Dialogue: 0,0:49:16.80,0:49:17.83,Main,,0,0,0,,Alô?
Dialogue: 0,0:49:17.83,0:49:19.74,Main,,0,0,0,,Phát hiện, phát hiện~
Dialogue: 0,0:49:20.72,0:49:22.50,Main,,0,0,0,,Ed à? Gì thế?
Dialogue: 0,0:49:22.50,0:49:24.73,Main,,0,0,0,,Để xem~ Phát hiện anh Lee rồi đấy~
Dialogue: 0,0:49:24.73,0:49:26.86,Main,,0,0,0,,Thật á? Giỏi đấy chứ.
Dialogue: 0,0:49:26.86,0:49:30.02,Main,,0,0,0,,Chị biết ngay nhóc không phải\Ndạng vừa mà. Đang ở đâu?
Dialogue: 0,0:49:30.02,0:49:32.47,Main,,0,0,0,,Gửi vị trí hiện tại đây~
Dialogue: 0,0:49:33.07,0:49:35.10,Main,,0,0,0,,Nhớ ở đó canh chừng hắn đấy.
Dialogue: 0,0:49:35.10,0:49:37.56,Main,,0,0,0,,Chị tới ngay,\Ntuyệt đối không được đi đâu đấy.
Dialogue: 0,0:49:37.56,0:49:40.76,Main,,0,0,0,,Ờ, biết rồi~ Bai bai~
Dialogue: 0,0:49:40.76,0:49:47.58,Main - Alt,,0,0,0,,{\i1}Cho kẹo hay bị ghẹo, cho kẹo hay bị ghẹo,\NCho cái gì ngon ngon đi nào.{\i0}
Dialogue: 0,0:49:48.36,0:49:51.71,Main,,0,0,0,,Level 1 xong. Dễ ợt.
Dialogue: 0,0:49:52.81,0:49:56.18,Main,,0,0,0,,Anh chơi trò đó suốt nhỉ.\NVui lắm à?
Dialogue: 0,0:49:56.18,0:49:57.62,Main,,0,0,0,,Trò đó là trò gì thế?
Dialogue: 0,0:50:00.38,0:50:02.62,Main,,0,0,0,,Biết ngay vẫn chỉ là đứa trẻ con mà.
Dialogue: 0,0:50:04.90,0:50:09.35,Main,,0,0,0,,Giời ạ, cái lũ đần này.\NRốt cuộc là tòa nào phòng nào chứ.
Dialogue: 0,0:50:11.18,0:50:15.10,Main,,0,0,0,,Solitaire là trò kẹp các viên bi\Nrồi loại từng viên một.
Dialogue: 0,0:50:15.10,0:50:19.14,Main,,0,0,0,,Và cuối cùng\Nchỉ còn một viên là thắng.
Dialogue: 0,0:50:19.70,0:50:21.84,Main,,0,0,0,,H-hết rồi.
Dialogue: 0,0:50:21.84,0:50:22.99,Main,,0,0,0,,Anh thắng à?
Dialogue: 0,0:50:27.13,0:50:29.37,Main,,0,0,0,,Trò chơi bây giờ mới bắt đầu.
Dialogue: 0,0:50:30.28,0:50:32.09,Main,,0,0,0,,Anh nói gì thế?
Dialogue: 0,0:50:35.34,0:50:37.97,Main,,0,0,0,,Chả lẽ viên bi đó...
Dialogue: 0,0:50:37.97,0:50:39.30,Main,,0,0,0,,Chỉ là trò chơi thôi.
Dialogue: 0,0:50:44.32,0:50:45.29,Main,,0,0,0,,Không lẽ...
Dialogue: 0,0:50:46.29,0:50:47.82,Main,,0,0,0,,Đùa đấy à?
Dialogue: 0,0:50:50.66,0:50:52.77,Main,,0,0,0,,Thứ còn lại sau cùng chỉ có một.
Dialogue: 0,0:51:43.41,0:51:48.41,Main,,0,0,0,,Thế này thì... không gặp được\NSporky Dorky nữa rồi...
Dialogue: 0,0:51:50.75,0:51:54.75,Main,,0,0,0,,Này! Nhóc mà chết\Nthì phiền chị lắm đấy, này!
Dialogue: 0,0:51:55.52,0:51:57.18,Main,,0,0,0,,Reset lại cho tôi đi...
Dialogue: 0,0:53:18.95,0:53:20.76,Main,,0,0,0,,Alpha 1 báo cáo khẩn.
Dialogue: 0,0:53:21.20,0:53:23.59,Main,,0,0,0,,Đã phát hiện Humpty Dumpty.
Dialogue: 0,0:53:23.59,0:53:27.97,Main,,0,0,0,,Vị trí hiện tại 24.15,\Nđang di chuyển bộ.
Dialogue: 0,0:53:27.97,0:53:31.63,Main,,0,0,0,,Tôi tới ngay.\NĐợi tôi tới rồi hãy ra tay.
Dialogue: 0,0:53:32.11,0:53:33.56,Main,,0,0,0,,Ra chân cũng được chứ?
Dialogue: 0,0:53:37.92,0:53:39.98,Main,,0,0,0,,Rời khu 17, đã vào khu 18.
Dialogue: 0,0:53:47.19,0:53:49.33,Main,,0,0,0,,Đang hướng về phía ga Trung tâm.
Dialogue: 0,0:54:08.55,0:54:10.55,Main,,0,0,0,,Lối này. Tôi sẽ đi cùng.
Dialogue: 0,0:54:10.55,0:54:12.00,Main,,0,0,0,,Một mình tôi là đủ.
Dialogue: 0,0:54:12.00,0:54:12.84,Main,,0,0,0,,Nhưng...!
Dialogue: 0,0:54:12.84,0:54:13.97,Main,,0,0,0,,Trông xe giúp tôi.
Dialogue: 0,0:55:37.52,0:55:38.55,Main,,0,0,0,,Vincent.
Dialogue: 0,0:55:40.02,0:55:43.58,Main,,0,0,0,,Dù không biết mặt,\Nnhưng ngửi mùi là biết.
Dialogue: 0,0:55:43.58,0:55:46.85,Main,,0,0,0,,Người mày nồng nặc mùi máu.
Dialogue: 0,0:55:47.69,0:55:49.74,Main,,0,0,0,,Thợ săn tiền thưởng à.
Dialogue: 0,0:55:49.74,0:55:51.78,Main,,0,0,0,,Đừng trách tao.
Dialogue: 0,0:55:51.78,0:55:55.24,Main,,0,0,0,,Có trách thì trách kẻ treo thưởng\Ntận 300 triệu ấy.
Dialogue: 0,0:56:42.78,0:56:44.30,Main,,0,0,0,,Sao không bắn đi?
Dialogue: 0,0:56:44.30,0:56:45.01,Main,,0,0,0,,Gì cơ?
Dialogue: 0,0:56:45.74,0:56:49.22,Main,,0,0,0,,Sao thế?\NChỉ được cái mạnh mồm lúc đầu à?
Dialogue: 0,0:56:51.42,0:56:52.55,Main,,0,0,0,,Làm đi chứ.
Dialogue: 0,0:56:52.55,0:56:56.30,Main,,0,0,0,,Tao không giết mày đâu.\NGiết thì mất trắng tiền thưởng.
Dialogue: 0,0:56:57.00,0:56:59.47,Main,,0,0,0,,Tao không sợ chết.
Dialogue: 0,0:56:59.47,0:57:02.31,Main,,0,0,0,,Chỉ là lặng lẽ chìm vào giấc mơ thôi.
Dialogue: 0,0:57:02.31,0:57:05.11,Main,,0,0,0,,Một giấc mơ kéo dài mãi mãi.
Dialogue: 0,0:57:07.38,0:57:09.11,Main,,0,0,0,,Thằng khốn ngông cuồng.
Dialogue: 0,0:58:17.89,0:58:19.64,Main,,0,0,0,,Hết trò rồi à?
Dialogue: 0,0:59:05.20,0:59:06.60,Main,,0,0,0,,Cho tao biết tên.
Dialogue: 0,0:59:07.33,0:59:10.06,Main,,0,0,0,,Spike Spiegel.
Dialogue: 0,0:59:11.48,0:59:13.29,Main,,0,0,0,,Hẹn gặp lại nơi tận cùng thế giới.
Dialogue: 0,0:59:13.29,0:59:14.53,Main,,0,0,0,,Vincent!
Dialogue: 0,0:59:52.95,0:59:53.98,Main,,0,0,0,,Vincent.
Dialogue: 0,0:59:55.57,0:59:56.78,Main,,0,0,0,,Là em đây...
Dialogue: 0,1:00:37.26,1:00:38.11,Main,,0,0,0,,Tại sao...
Dialogue: 0,1:00:50.47,1:00:51.57,Main,,0,0,0,,Vincent.
Dialogue: 0,1:01:19.20,1:01:21.02,Main,,0,0,0,,Có nghe thấy không, Spike?
Dialogue: 0,1:01:22.88,1:01:25.09,Main,,0,0,0,,Suýt nữa thì không qua khỏi đấy.
Dialogue: 0,1:01:27.22,1:01:29.30,Main,,0,0,0,,Hắn chết rồi.
Dialogue: 0,1:01:29.30,1:01:32.31,Main,,0,0,0,,Không, ngay từ đầu hắn đã chết rồi.
Dialogue: 0,1:01:34.48,1:01:36.24,Main,,0,0,0,,Giống như anh vậy.
Dialogue: 0,1:01:59.84,1:02:03.70,Main,,0,0,0,,Kẻ phó mặc thân mình\Ncho dòng nước cuốn trôi,
Dialogue: 0,1:02:03.70,1:02:06.11,Main,,0,0,0,,đã lọt vào đôi mắt của cậu ấy.
Dialogue: 0,1:02:12.32,1:02:13.65,Main,,0,0,0,,Cảm ơn nhé.
Dialogue: 0,1:02:16.49,1:02:18.52,Main,,0,0,0,,Anh đã thấy gì?
Dialogue: 0,1:02:18.52,1:02:21.31,Main,,0,0,0,,Đôi mắt anh đang dần khép lại.
Dialogue: 0,1:02:23.50,1:02:25.71,Main,,0,0,0,,Tôi đã nằm mơ.
Dialogue: 0,1:02:27.62,1:02:29.30,Main,,0,0,0,,Không,
Dialogue: 0,1:02:29.30,1:02:30.81,Main,,0,0,0,,bên nào mới là mơ đây.
Dialogue: 0,1:02:32.04,1:02:34.22,Main,,0,0,0,,Lần đầu tiên đấy.
Dialogue: 0,1:02:34.22,1:02:37.64,Main,,0,0,0,,Lần đầu tiên tôi nếm trải
Dialogue: 0,1:02:37.64,1:02:39.21,Main,,0,0,0,,nỗi sợ đến rùng mình.
Dialogue: 0,1:02:41.41,1:02:44.43,Main,,0,0,0,,Chỉ cần có gì đó\Nlệch đi một chút thôi,
Dialogue: 0,1:02:46.15,1:02:47.46,Main,,0,0,0,,là tôi đã chết rồi.
Dialogue: 0,1:02:49.75,1:02:54.42,Main,,0,0,0,,Có lẽ với anh,\Nhôm đó chưa phải ngày đẹp để chết.
Dialogue: 0,1:02:59.66,1:03:01.96,Main,,0,0,0,,Hỡi chim bơi.
Dialogue: 0,1:03:02.58,1:03:06.64,Main,,0,0,0,,Đôi mắt xanh này nhìn thấu mọi thứ.
Dialogue: 0,1:03:06.64,1:03:10.80,Main,,0,0,0,,Quá khứ, tương lai, và cả hiện tại.
Dialogue: 0,1:03:11.96,1:03:16.47,Main,,0,0,0,,Tất cả đều trôi chảy,\Ntất cả đều nối liền với nhau.
Dialogue: 0,1:03:16.47,1:03:19.54,Main,,0,0,0,,Đôi mắt này không nhìn thực tại,
Dialogue: 0,1:03:19.54,1:03:22.51,Main,,0,0,0,,mà cảm nhận sự thật.
Dialogue: 0,1:03:24.15,1:03:27.03,Main,,0,0,0,,Hãy mở con mắt sự thật ra mà nhìn.
Dialogue: 0,1:03:27.03,1:03:30.12,Main,,0,0,0,,Không có gì phải sợ cả.
Dialogue: 0,1:03:32.70,1:03:33.61,Main,,0,0,0,,Ờ,
Dialogue: 0,1:03:34.66,1:03:35.88,Main,,0,0,0,,tôi biết mà.
Dialogue: 0,1:03:55.58,1:03:57.16,Main,,0,0,0,,Xem ra anh vẫn còn sống nhỉ.
Dialogue: 0,1:04:01.69,1:04:04.79,Main,,0,0,0,,Hắn... Vincent...
Dialogue: 0,1:04:06.56,1:04:08.55,Main,,0,0,0,,đã biến mất rồi.
Dialogue: 0,1:04:08.55,1:04:11.53,Main,,0,0,0,,Cứ như thể từ đầu\Nhắn chưa từng tồn tại.
Dialogue: 0,1:04:14.00,1:04:18.02,Main,,0,0,0,,Xem ra chúng ta đã thò chân\Nvào một vụ nguy hiểm rồi.
Dialogue: 0,1:04:20.10,1:04:22.65,Main,,0,0,0,,Ngày xưa ông già tôi hay nói,
Dialogue: 0,1:04:22.65,1:04:24.99,Main,,0,0,0,,"Con thuyền một khi đã ra khơi
Dialogue: 0,1:04:24.99,1:04:28.67,Main,,0,0,0,,thì chỉ có tiếp tục hải trình\Nhoặc chìm mà thôi."
Dialogue: 0,1:04:29.85,1:04:32.86,Main,,0,0,0,,Chúng ta chỉ là thợ săn tiền thưởng.
Dialogue: 0,1:04:32.86,1:04:36.67,Main,,0,0,0,,Vụ này đã vượt quá\Nkhả năng của chúng ta rồi.
Dialogue: 0,1:04:37.40,1:04:39.72,Main,,0,0,0,,Giờ rút vẫn còn kịp.
Dialogue: 0,1:04:39.72,1:04:42.19,Main,,0,0,0,,Thôi, đừng dính vào vụ này nữa.
Dialogue: 0,1:04:42.19,1:04:43.41,Main,,0,0,0,,Nghe chưa, Spike?
Dialogue: 0,1:04:51.17,1:04:53.42,Main,,0,0,0,,Đúng là ở đâu cũng ngủ được.
Dialogue: 0,1:04:57.20,1:05:00.12,Main,,0,0,0,,Tại sao cô lại tự ý hành động một mình?
Dialogue: 0,1:05:02.00,1:05:04.48,Main,,0,0,0,,Cô không muốn trả lời à?
Dialogue: 0,1:05:04.48,1:05:07.32,Main,,0,0,0,,Nhưng cô có nghĩ rằng\Nhành động tùy tiện đó
Dialogue: 0,1:05:07.32,1:05:11.63,Main,,0,0,0,,là một trong những lý do\Nkhiến ta không ngăn được vụ này?
Dialogue: 0,1:05:12.64,1:05:13.96,Main,,0,0,0,,Tôi vô cùng xin lỗi.
Dialogue: 0,1:05:14.76,1:05:18.19,Main,,0,0,0,,Cô sẽ bị cấm túc một thời gian.
Dialogue: 0,1:05:18.19,1:05:21.63,Main,,0,0,0,,Sẽ có thông báo sau. Lui ra đi.
Dialogue: 0,1:05:30.66,1:05:32.33,Main,,0,0,0,,Đừng lơ là việc giám sát cô ta.
Dialogue: 0,1:05:33.65,1:05:38.43,Main,,0,0,0,,Từ triệu chứng của nạn nhân,\Nvụ tai nạn tàu một ray hôm qua
Dialogue: 0,1:05:38.43,1:05:42.62,Main,,0,0,0,,được cho là đã dùng chất giống hệt\Nvụ xe bồn hôm trước.
Dialogue: 0,1:05:43.09,1:05:46.93,Main,,0,0,0,,Thế? Vẫn chưa làm rõ được chất đó à?
Dialogue: 0,1:05:46.93,1:05:48.90,Main,,0,0,0,,Hiện đang phân tích ạ.
Dialogue: 0,1:05:48.90,1:05:52.47,Main,,0,0,0,,Về bản tuyên bố,\Ncấu trúc của con virus hẹn giờ
Dialogue: 0,1:05:52.47,1:05:57.72,Main,,0,0,0,,rất giống một con virus trước đây,\Nnên đã xác định là do hacker tên Lee.
Dialogue: 0,1:05:57.72,1:06:01.39,Main,,0,0,0,,Hiện đang rà dữ liệu\Nvà đường truy cập của hắn.
Dialogue: 0,1:06:01.39,1:06:04.46,Main,,0,0,0,,Có khả năng kẻ đó là chủ mưu không?
Dialogue: 0,1:06:04.46,1:06:05.69,Main,,0,0,0,,Có ạ.
Dialogue: 0,1:06:05.69,1:06:10.02,Main,,0,0,0,,Dù sao thì hắn cũng có liên hệ\Nnào đó với nhóm khủng bố.
Dialogue: 0,1:06:10.02,1:06:11.89,Main,,0,0,0,,Mục đích khủng bố là gì?
Dialogue: 0,1:06:11.89,1:06:15.28,Main,,0,0,0,,Tội phạm tư tưởng, hay chỉ vì tiền?
Dialogue: 0,1:06:16.60,1:06:18.37,Main,,0,0,0,,Chúng tôi đang phân tích ạ.
Dialogue: 0,1:06:18.91,1:06:23.15,Main,,0,0,0,,Cái gì cũng là đang phân tích,\Nđang giải mã à?
Dialogue: 0,1:06:23.15,1:06:24.75,Main,,0,0,0,,Định bắt tôi đợi đến bao giờ?
Dialogue: 0,1:06:24.75,1:06:28.18,Main,,0,0,0,,Đến kết quả khám sức khỏe\Ncòn chỉ mất nửa ngày đấy.
Dialogue: 0,1:06:44.52,1:06:46.95,Main,,0,0,0,,Không biết có phải tại tôi không...
Dialogue: 0,1:06:46.95,1:06:48.32,Main,,0,0,0,,Gì thế?
Dialogue: 0,1:06:48.32,1:06:50.37,Main,,0,0,0,,Thấy chân cứ nặng nặng...
Dialogue: 0,1:06:51.44,1:06:52.35,Main,,0,0,0,,Này.
Dialogue: 0,1:06:52.35,1:06:54.64,Main,,0,0,0,,Tìm thấy rồi~!
Dialogue: 0,1:06:56.33,1:07:02.35,Main,,0,0,0,,Tròn tròn là con mắt,\Ntròn tròn là đẹp xinh~
Dialogue: 0,1:07:02.35,1:07:08.78,Main,,0,0,0,,Vị ngọt ngào\Ncủa chùm nho đen~
Dialogue: 0,1:07:08.78,1:07:11.92,Main,,0,0,0,,Có rồi đây~ Cherious Medical~
Dialogue: 0,1:07:12.33,1:07:16.06,Main,,0,0,0,,Tra giúp lô hàng chở bằng xe tải\Nngày 15 tháng 10.
Dialogue: 0,1:07:16.06,1:07:17.98,Main,,0,0,0,,Uii~
Dialogue: 0,1:07:17.98,1:07:19.85,Main,,0,0,0,,Spike, nói trước nhé...
Dialogue: 0,1:07:19.85,1:07:23.04,Main,,0,0,0,,Biết rồi. Chỉ điều tra thôi.
Dialogue: 0,1:07:23.04,1:07:24.79,Main,,0,0,0,,Cứ thấy bứt rứt thì ngủ không được.
Dialogue: 0,1:07:25.60,1:07:27.43,Main,,0,0,0,,Anh thì ngủ quá nhiều rồi.
Dialogue: 0,1:07:36.59,1:07:39.94,Main,,0,0,0,,Xe tải, xe tải,\Nhàng to hàng nhỏ~
Dialogue: 0,1:07:39.94,1:07:43.32,Main,,0,0,0,,Bên trong là hạt mắc ca~
Dialogue: 0,1:07:43.32,1:07:45.16,Main,,0,0,0,,Hạt mắc ca?
Dialogue: 0,1:07:45.16,1:07:47.05,Main,,0,0,0,,Chắc là thứ hạt không ăn được.
Dialogue: 0,1:07:47.05,1:07:49.46,Main,,0,0,0,,Tìm kiếm~
Dialogue: 0,1:07:49.46,1:07:51.81,Main,,0,0,0,,"Phòng Quản lý Hạt mắc ca"
Dialogue: 0,1:07:51.81,1:07:54.90,Main,,0,0,0,,"Phòng Nghiên cứu và Phát triển\NHạt mắc ca"
Dialogue: 0,1:07:54.90,1:07:58.14,Main,,0,0,0,,Chỉ là hạt thôi mà đầu tư ghê nhỉ.
Dialogue: 0,1:07:58.14,1:08:01.09,Main,,0,0,0,,Ed, vào Phòng Nghiên cứu\Nvà Phát triển Hạt mắc ca.
Dialogue: 0,1:08:01.09,1:08:02.09,Main,,0,0,0,,Rõ~
Dialogue: 0,1:08:04.33,1:08:06.56,Main,,0,0,0,,Có biết bộ phận này\Nđã làm gì không?
Dialogue: 0,1:08:06.56,1:08:07.28,Main,,0,0,0,,Nya.
Dialogue: 0,1:08:11.76,1:08:14.41,Main,,0,0,0,,Chương trình hack của Ed\Nhỏng mất tiêu rồi~
Dialogue: 0,1:08:14.41,1:08:16.71,Main,,0,0,0,,Gì? Đến nước này rồi mà?
Dialogue: 0,1:08:16.71,1:08:20.26,Main,,0,0,0,,Ed, thử đường khác\Ntra hồ sơ gã này xem.
Dialogue: 0,1:08:20.26,1:08:21.54,Main,,0,0,0,,Uiii~
Dialogue: 0,1:08:24.49,1:08:26.75,Main,,0,0,0,,"Tiến sĩ Mendelo Al Hedia,
Dialogue: 0,1:08:26.75,1:08:30.55,Main,,0,0,0,,cựu giáo sư SIT, chuyên gia\Nhàng đầu về nghiên cứu máy nano."
Dialogue: 0,1:08:30.55,1:08:34.16,Main,,0,0,0,,Quả nhiên. Đó đâu phải công ty dược.
Dialogue: 0,1:08:34.16,1:08:36.46,Main,,0,0,0,,Chúng lén chế tạo vũ khí máy nano.
Dialogue: 0,1:08:36.88,1:08:41.07,Main,,0,0,0,,Và tên Vincent lẽ ra đã chết\Nlại mang thứ đó ra ngoài à?
Dialogue: 0,1:08:41.07,1:08:46.66,Main,,0,0,0,,Nhớ không nhầm thì dùng máy nano vào\Nquân sự bị Hiệp ước Amsterdam cấm rồi.
Dialogue: 0,1:08:46.66,1:08:51.36,Main,,0,0,0,,Nếu gã này đang mưu tính gì đó,\Nthì quân đội ắt sẽ liều mạng che giấu.
Dialogue: 0,1:08:52.38,1:08:54.94,Main,,0,0,0,,Nhưng hắn vẫn còn sống.
Dialogue: 0,1:09:20.50,1:09:21.80,Main,,0,0,0,,Steve.
Dialogue: 0,1:09:21.80,1:09:24.22,Main,,0,0,0,,Chào, Electra. Có việc gì thế?
Dialogue: 0,1:09:29.46,1:09:31.82,Main,,0,0,0,,Gì đây? Máu của ai à?
Dialogue: 0,1:09:32.85,1:09:34.51,Main,,0,0,0,,Tôi muốn anh bí mật\Nxét nghiệm giúp.
Dialogue: 0,1:09:35.31,1:09:38.15,Main,,0,0,0,,Thế lần này cô nhận lời\Nđi hẹn hò với tôi chứ?
Dialogue: 0,1:09:41.90,1:09:42.65,Main,,0,0,0,,Được thôi.
Dialogue: 0,1:09:43.10,1:09:46.24,Main,,0,0,0,,Tốt! Vậy tôi sẽ đặt bàn\Nbữa tối Halloween nhé?
Dialogue: 0,1:10:17.74,1:10:19.73,Main,,0,0,0,,Chuyện này là sao?
Dialogue: 0,1:10:21.24,1:10:23.24,Main,,0,0,0,,Sao tôi vẫn còn sống?
Dialogue: 0,1:10:24.95,1:10:26.65,Main,,0,0,0,,Anh đã làm gì tôi?
Dialogue: 0,1:10:28.95,1:10:30.46,Main,,0,0,0,,Tôi đã chia máu của mình cho cô.
Dialogue: 0,1:10:32.97,1:10:36.25,Main,,0,0,0,,Giờ dù thế giới này có đảo lộn,\Ncô vẫn sống được.
Dialogue: 0,1:10:37.27,1:10:38.59,Main,,0,0,0,,Giống như tôi vậy.
Dialogue: 0,1:10:39.77,1:10:42.77,Main,,0,0,0,,Thời khắc đó sắp đến rồi.
Dialogue: 0,1:10:50.76,1:10:52.81,Main,,0,0,0,,Đã tìm được thứ mình muốn chưa?
Dialogue: 0,1:10:59.15,1:11:02.05,Main,,0,0,0,,Chưa, toàn thứ không cần thôi.
Dialogue: 0,1:11:02.05,1:11:04.43,Main,,0,0,0,,Đời vốn hay như thế mà.
Dialogue: 0,1:11:04.43,1:11:08.72,Main,,0,0,0,,Nhưng cũng có kẻ cố tình\Ntạo ra những thứ không ai cần.
Dialogue: 0,1:11:09.55,1:11:12.45,Main,,0,0,0,,Có kẻ đã tạo ra nó.\NTạo ra ác quỷ.
Dialogue: 0,1:11:16.71,1:11:19.49,Main,,0,0,0,,Sao ông lại đưa tôi thứ đó?
Dialogue: 0,1:11:19.49,1:11:22.10,Main,,0,0,0,,Vì nó là cái bình hợp với cậu.
Dialogue: 0,1:11:22.10,1:11:24.84,Main,,0,0,0,,Ý tôi là món quà ở bên trong.
Dialogue: 0,1:11:24.84,1:11:27.66,Main,,0,0,0,,Máy nano mang hình dạng tế bào lympho.
Dialogue: 0,1:11:27.66,1:11:28.97,Main,,0,0,0,,Của tiến sĩ Mendelo.
Dialogue: 0,1:11:34.81,1:11:39.22,Main,,0,0,0,,Có một người đàn ông chạy trốn\Nđến thành phố này vào ba năm trước.
Dialogue: 0,1:11:40.06,1:11:45.32,Main,,0,0,0,,Ông ta nói rằng mình đã\Ntạo ra một thứ khủng khiếp.
Dialogue: 0,1:11:45.90,1:11:53.04,Main,,0,0,0,,Thứ đó được lập trình để lây nhiễm\Ntùy ý qua tiếp xúc hay qua không khí.
Dialogue: 0,1:11:53.04,1:11:59.74,Main,,0,0,0,,Rồi xâm nhập vào máu, tự nhân lên,\Ngiả dạng tế bào lympho để di chuyển tự do.
Dialogue: 0,1:11:59.74,1:12:02.85,Main,,0,0,0,,Rồi chui vào não mà phá hủy.
Dialogue: 0,1:12:03.63,1:12:07.94,Main,,0,0,0,,Sau đó tự phân rã,\Nthành protein và bị đào thải,
Dialogue: 0,1:12:07.94,1:12:10.86,Main,,0,0,0,,không để lại chút dấu vết nào.
Dialogue: 0,1:12:10.86,1:12:13.19,Main,,0,0,0,,Nghe nói nó được lập trình như thế.
Dialogue: 0,1:12:14.27,1:12:16.99,Main,,0,0,0,,Tôi chỉ muốn biết đúng một điều.
Dialogue: 0,1:12:18.81,1:12:21.12,Main,,0,0,0,,Sao Vincent vẫn còn sống?
Dialogue: 0,1:12:26.73,1:12:29.24,Main,,0,0,0,,Rốt cuộc anh muốn làm gì?
Dialogue: 0,1:12:30.46,1:12:33.96,Main,,0,0,0,,Vì tiền? Hay có thù oán gì?
Dialogue: 0,1:12:33.96,1:12:36.57,Main,,0,0,0,,Hay anh chỉ đang thấy vui?
Dialogue: 0,1:12:37.48,1:12:41.56,Main,,0,0,0,,Tôi chỉ đang tìm thôi. Một cánh cửa.
Dialogue: 0,1:12:42.67,1:12:43.88,Main,,0,0,0,,Cánh cửa...
Dialogue: 0,1:12:43.88,1:12:48.70,Main,,0,0,0,,Cô đã bao giờ nằm mơ\Nmà biết rõ mình đang mơ,
Dialogue: 0,1:12:48.70,1:12:53.29,Main,,0,0,0,,vậy mà vẫn không thể tỉnh dậy chưa?
Dialogue: 0,1:12:54.94,1:12:56.72,Main,,0,0,0,,Kể từ lúc đó...
Dialogue: 0,1:12:57.47,1:13:00.98,Main,,0,0,0,,từ hồi còn ở Titan,\Ntôi vẫn luôn như thế.
Dialogue: 0,1:13:02.85,1:13:05.82,Main,,0,0,0,,Vincent từng là lính thí nghiệm.
Dialogue: 0,1:13:05.82,1:13:10.76,Main,,0,0,0,,Người đàn ông đó đã cài vào máu Vincent\Nmột loại máy nano đối kháng.
Dialogue: 0,1:13:11.87,1:13:13.99,Main,,0,0,0,,Máy nano đối kháng?
Dialogue: 0,1:13:14.42,1:13:18.22,Main,,0,0,0,,Nó cũng lây nhiễm, lan rộng\Ngiống như máy nano,
Dialogue: 0,1:13:18.22,1:13:20.50,Main,,0,0,0,,rồi làm máy nano ngừng hoạt động.
Dialogue: 0,1:13:20.93,1:13:23.28,Main,,0,0,0,,Tức là một thí nghiệm vắc-xin.
Dialogue: 0,1:13:24.36,1:13:28.53,Main,,0,0,0,,Người lẽ ra phải ngăn cơn cuồng loạn\Nlại chính là kẻ phát cuồng.
Dialogue: 0,1:13:30.02,1:13:32.90,Main,,0,0,0,,Mục đích của Vincent\Nthì tôi không biết.
Dialogue: 0,1:13:32.90,1:13:35.10,Main,,0,0,0,,Có khi hắn chả có mục đích gì cả.
Dialogue: 0,1:13:35.10,1:13:39.46,Main,,0,0,0,,Có lẽ hắn chỉ đang chờ ngày phán xét\Nở nơi tận cùng thế giới.
Dialogue: 0,1:13:42.05,1:13:45.42,Main,,0,0,0,,Chả phải tiến sĩ Mendelo\Nnắm giữ mọi thứ sao?
Dialogue: 0,1:13:45.42,1:13:48.19,Main,,0,0,0,,Cả máy nano lẫn vắc-xin.
Dialogue: 0,1:13:49.06,1:13:54.32,Main,,0,0,0,,Ông ta đã xóa toàn bộ dữ liệu nghiên cứu\Nrồi biến mất khỏi quân đội.
Dialogue: 0,1:13:54.32,1:13:59.28,Main,,0,0,0,,Ông ta nghĩ rằng chẳng ai lại đi dùng\Nthứ chất độc không có thuốc giải.
Dialogue: 0,1:14:00.72,1:14:04.29,Main,,0,0,0,,Ông ta không còn ở đây nữa.\NKhông còn tồn tại.
Dialogue: 0,1:14:05.24,1:14:08.50,Main,,0,0,0,,Không ai có thể ngăn Vincent nữa rồi.
Dialogue: 0,1:14:10.92,1:14:14.29,Main,,0,0,0,,Có hai thứ tôi đã mất ở Titan.
Dialogue: 0,1:14:14.29,1:14:15.92,Main,,0,0,0,,Thứ nhất là quá khứ.
Dialogue: 0,1:14:18.73,1:14:22.76,Main,,0,0,0,,Lúc đó, chẳng phân địch hay ta,
Dialogue: 0,1:14:22.76,1:14:28.23,Main,,0,0,0,,tất cả đều bị giết chỉ để\Nthử nghiệm vũ khí máy nano.
Dialogue: 0,1:14:29.11,1:14:31.32,Main,,0,0,0,,Tôi bị đưa vào làm lính thí nghiệm,
Dialogue: 0,1:14:32.36,1:14:34.69,Main,,0,0,0,,và là người duy nhất sống sót.
Dialogue: 0,1:14:35.96,1:14:39.41,Main,,0,0,0,,Nhưng tôi đã mất trí nhớ.
Dialogue: 0,1:14:40.45,1:14:43.57,Main,,0,0,0,,Đến mình là ai\Ncũng không biết nữa.
Dialogue: 0,1:14:45.72,1:14:48.31,Main,,0,0,0,,Còn thứ kia là gì?
Dialogue: 0,1:14:48.31,1:14:49.87,Main,,0,0,0,,Cô đã thấy lũ bướm rồi chứ.
Dialogue: 0,1:14:52.16,1:14:54.76,Main,,0,0,0,,Tôi đã thấy vô số bươm bướm.
Dialogue: 0,1:14:55.62,1:14:58.13,Main,,0,0,0,,Những con bướm\Nnhư không thuộc về thế gian này.
Dialogue: 0,1:15:06.77,1:15:11.48,Main,,0,0,0,,Nghe nói khi máy nano tới não,\Nngười ta sẽ thấy ánh sáng.
Dialogue: 0,1:15:12.24,1:15:14.53,Main,,0,0,0,,Nó cứ như thể...
Dialogue: 0,1:15:14.53,1:15:17.60,Main,,0,0,0,,loài bướm đẹp nhất thế gian.
Dialogue: 0,1:15:28.00,1:15:29.98,Main,,0,0,0,,Tôi nói dài quá rồi nhỉ.
Dialogue: 0,1:15:32.00,1:15:36.26,Main,,0,0,0,,Rashid, đưa cái này cho\Ntiến sĩ giúp tôi.
Dialogue: 0,1:15:41.42,1:15:43.85,Main,,0,0,0,,Nếu ông có dịp gặp lại.
Dialogue: 0,1:15:44.89,1:15:46.26,Main,,0,0,0,,Được thôi.
Dialogue: 0,1:15:52.63,1:15:55.52,Main,,0,0,0,,Vậy nhé. Inshallah.
Dialogue: 0,1:16:15.91,1:16:18.22,Main,,0,0,0,,Ngài có thể giải thích không, Đại tá?
Dialogue: 0,1:16:18.22,1:16:22.62,Main,,0,0,0,,Người cần giải thích\Nlà cô mới đúng, Trung úy.
Dialogue: 0,1:16:22.62,1:16:26.47,Main,,0,0,0,,Về thứ máy nano đối kháng\Ntrong máu cô ấy.
Dialogue: 0,1:16:27.94,1:16:31.06,Main,,0,0,0,,Đúng là dưới chân đèn thì tối.
Dialogue: 0,1:16:31.60,1:16:37.18,Main,,0,0,0,,Thứ lẽ ra chỉ dùng cho Vincent,\Nsao lại lây sang cô?
Dialogue: 0,1:16:37.18,1:16:39.07,Main,,0,0,0,,Cô đã tiếp xúc với hắn rồi, đúng không?
Dialogue: 0,1:16:40.87,1:16:43.88,Main,,0,0,0,,Để tránh rò rỉ thông tin,\Ncô sẽ bị giam giữ.
Dialogue: 0,1:16:43.88,1:16:46.98,Main,,0,0,0,,Đại tá. Nếu trong người tôi\Ncó vắc-xin,
Dialogue: 0,1:16:46.98,1:16:50.46,Main,,0,0,0,,thì có thể nuôi cấy\Nđể dùng cho dân thường mà.
Dialogue: 0,1:16:50.46,1:16:52.54,Main,,0,0,0,,Cô chả hiểu gì cả.
Dialogue: 0,1:16:53.49,1:17:00.17,Main,,0,0,0,,Tôi đã nói mục đích của chúng ta là\Nxóa sổ mọi thông tin về máy nano mà.
Dialogue: 0,1:17:00.17,1:17:04.93,Main,,0,0,0,,Thứ lẽ ra không có\Nthì không được phép tồn tại.
Dialogue: 0,1:17:16.90,1:17:17.65,Main,,0,0,0,,Chào.
Dialogue: 0,1:17:24.83,1:17:29.25,Main,,0,0,0,,Mối quan hệ như bọn tôi\Nrốt cuộc là gì nhỉ.
Dialogue: 0,1:17:30.70,1:17:33.71,Main,,0,0,0,,Cũng chả phải tình đồng đội gắn bó gì.
Dialogue: 0,1:17:33.71,1:17:36.57,Main,,0,0,0,,Làm gì có thứ gọi là sợi dây gắn kết.
Dialogue: 0,1:17:36.57,1:17:41.14,Main,,0,0,0,,Ai cũng làm theo ý mình,\Nthích thì về.
Dialogue: 0,1:17:41.14,1:17:43.68,Main,,0,0,0,,Còn tôi thì toàn bị\Nxoay như chong chóng.
Dialogue: 0,1:17:44.48,1:17:46.34,Main,,0,0,0,,Tôi chịu đủ lắm rồi.
Dialogue: 0,1:17:46.34,1:17:48.75,Main,,0,0,0,,Nhớ cái thời còn một mình quá đi mất.
Dialogue: 0,1:17:54.69,1:17:58.13,Main,,0,0,0,,Còn một nước nữa là tao thắng rồi.
Dialogue: 0,1:18:04.45,1:18:06.80,Main,,0,0,0,,Á, này, Ein.
Dialogue: 0,1:18:16.50,1:18:18.19,Main,,0,0,0,,Mặc kệ đi.
Dialogue: 0,1:18:18.19,1:18:20.64,Main,,0,0,0,,Lũ đó có không về thì cũng thế.
Dialogue: 0,1:18:22.02,1:18:23.73,Main,,0,0,0,,Ra đúng như ván cược nhỉ.
Dialogue: 0,1:18:24.79,1:18:29.78,Main,,0,0,0,,Lúc đó tôi định nói nốt,\Nra mặt sấp thì đi hẹn hò.
Dialogue: 0,1:18:29.78,1:18:33.35,Main,,0,0,0,,Mà chỗ hẹn hò này\Nthì hơi tẻ nhạt.
Dialogue: 0,1:18:34.97,1:18:36.39,Main,,0,0,0,,Anh không sợ à?
Dialogue: 0,1:18:36.39,1:18:37.33,Main,,0,0,0,,Sợ á?
Dialogue: 0,1:18:38.68,1:18:43.06,Main,,0,0,0,,Khi ra khỏi đây,\Nkhông bị xóa ký ức thì cũng bị giết.
Dialogue: 0,1:18:44.29,1:18:47.08,Main,,0,0,0,,Cuộc đời đến giờ cũng sẽ bị xóa sạch.
Dialogue: 0,1:18:48.66,1:18:51.28,Main,,0,0,0,,Dù có sống cũng như đã chết.
Dialogue: 0,1:18:51.28,1:18:52.78,Main,,0,0,0,,Giống như Vincent à?
Dialogue: 0,1:18:55.06,1:18:58.55,Main,,0,0,0,,Cô vẫn sống sót\Nsau vụ tai nạn tàu một ray,
Dialogue: 0,1:18:58.55,1:19:00.43,Main,,0,0,0,,nghĩa là trong người cô\Ncũng có thứ đó nhỉ?
Dialogue: 0,1:19:00.43,1:19:04.68,Main,,0,0,0,,Cái gì mà máy nano\Nkiểu như vắc-xin ấy.
Dialogue: 0,1:19:04.68,1:19:06.51,Main,,0,0,0,,Cái gì anh cũng biết nhỉ.
Dialogue: 0,1:19:06.51,1:19:08.54,Main,,0,0,0,,Đúng như cô nói đấy.
Dialogue: 0,1:19:10.00,1:19:12.30,Main,,0,0,0,,Biết quá nhiều nên tổn thọ đây này.
Dialogue: 0,1:19:14.88,1:19:19.51,Main,,0,0,0,,Không giống một thợ săn tiền thưởng\Nbình thường chút nào, Spike Spiegel.
Dialogue: 0,1:19:19.51,1:19:22.46,Main,,0,0,0,,Cô mà chỉ làm quân nhân\Nthì cũng phí lắm đấy.
Dialogue: 0,1:19:23.34,1:19:26.42,Main,,0,0,0,,Tôi là Electra. Electra Ovilo.
Dialogue: 0,1:19:27.72,1:19:29.56,Main,,0,0,0,,Thảo nào.
Dialogue: 0,1:19:29.56,1:19:30.95,Main,,0,0,0,,Tên nghe mạnh mẽ đấy.
Dialogue: 0,1:19:38.83,1:19:43.37,Main,,0,0,0,,Tôi chưa từng biết\Ntrong người mình có thứ đó.
Dialogue: 0,1:19:50.01,1:19:51.28,Main,,0,0,0,,Vincent ấy...
Dialogue: 0,1:19:52.62,1:19:56.08,Main,,0,0,0,,Anh ấy từ lúc sinh ra\Nđã chỉ có một mình.
Dialogue: 0,1:19:57.55,1:20:01.29,Main,,0,0,0,,Từ nhỏ, thứ gieo vào đầu anh ấy\Nchỉ có ý chí chiến đấu và lòng thù hận.
Dialogue: 0,1:20:02.08,1:20:04.21,Main,,0,0,0,,Anh ấy chưa từng được ai yêu thương.
Dialogue: 0,1:20:05.94,1:20:09.24,Main,,0,0,0,,Vì vậy tôi muốn cứu anh ấy.
Dialogue: 0,1:20:10.64,1:20:14.65,Main,,0,0,0,,Tôi đã nghĩ mình cứu được.\NNhưng tôi đã lầm.
Dialogue: 0,1:20:15.91,1:20:19.79,Main,,0,0,0,,Lúc đó, trên tàu một ray,\NVincent nhìn tôi
Dialogue: 0,1:20:19.79,1:20:22.86,Main,,0,0,0,,như thể nhìn một người chưa từng gặp.
Dialogue: 0,1:20:25.04,1:20:27.65,Main,,0,0,0,,Tôi đã biến mất khỏi\Ntâm trí anh ấy rồi.
Dialogue: 0,1:20:29.93,1:20:31.52,Main,,0,0,0,,Cô yêu hắn à?
Dialogue: 0,1:20:33.32,1:20:34.98,Main,,0,0,0,,Tôi không biết, nhưng...
Dialogue: 0,1:20:36.51,1:20:41.15,Main,,0,0,0,,Trong lòng dâng trào\Nnhững cảm xúc chưa từng biết,
Dialogue: 0,1:20:41.15,1:20:45.59,Main,,0,0,0,,không hiểu đó là gì,\Nchỉ thấy lồng ngực thắt lại,
Dialogue: 0,1:20:45.59,1:20:47.85,Main,,0,0,0,,anh đã từng như thế chưa?
Dialogue: 0,1:20:48.83,1:20:49.72,Main,,0,0,0,,Có chứ.
Dialogue: 0,1:20:53.52,1:20:56.91,Main,,0,0,0,,Có lẽ người muốn được cứu\Nchính là tôi.
Dialogue: 0,1:20:58.23,1:21:02.48,Main,,0,0,0,,Chuyện lâu lắm rồi,\Nhồi tôi còn trẻ hơn bây giờ.
Dialogue: 0,1:21:04.36,1:21:07.36,Main,,0,0,0,,Tôi chẳng sợ thứ gì.
Dialogue: 0,1:21:07.36,1:21:10.79,Main,,0,0,0,,Kể cả cái chết,\Ntôi cũng không mảy may e sợ.
Dialogue: 0,1:21:11.77,1:21:13.79,Main,,0,0,0,,Tôi từng nghĩ\Nchết lúc nào cũng được.
Dialogue: 0,1:21:15.79,1:21:18.48,Main,,0,0,0,,Nhưng từ khi gặp một người phụ nữ,
Dialogue: 0,1:21:18.48,1:21:21.63,Main,,0,0,0,,tôi bắt đầu muốn được sống tiếp.
Dialogue: 0,1:21:22.59,1:21:26.04,Main,,0,0,0,,Lần đầu tiên, tôi biết sợ cái chết.
Dialogue: 0,1:21:27.01,1:21:29.26,Main,,0,0,0,,Trước đó, tôi chưa từng biết\Nđến cảm xúc như thế.
Dialogue: 0,1:21:32.24,1:21:34.86,Main,,0,0,0,,Giờ người đó đâu rồi?
Dialogue: 0,1:21:34.86,1:21:36.52,Main,,0,0,0,,Cô ấy biến mất đâu đó rồi.
Dialogue: 0,1:21:39.50,1:21:44.16,Main,,0,0,0,,Lạ thật đấy.\NCô là người đầu tiên tôi kể chuyện này.
Dialogue: 0,1:21:46.79,1:21:49.75,Main,,0,0,0,,Sao anh lại tìm Vincent?
Dialogue: 0,1:21:49.75,1:21:52.29,Main,,0,0,0,,Hắn có cùng một mùi với tôi.
Dialogue: 0,1:21:54.09,1:21:56.55,Main,,0,0,0,,Nên tôi mới muốn gặp hắn.
Dialogue: 0,1:22:17.37,1:22:21.66,Main,,0,0,0,,Gã đó, hình như\Ntên là Spike thì phải.
Dialogue: 0,1:22:24.63,1:22:28.13,Main,,0,0,0,,Ra vậy, là đồng bọn của cô à.
Dialogue: 0,1:22:28.13,1:22:29.86,Main,,0,0,0,,Sao anh biết?
Dialogue: 0,1:22:30.66,1:22:32.35,Main,,0,0,0,,Anh định bày trò gì?
Dialogue: 0,1:22:33.20,1:22:36.10,Main,,0,0,0,,Tôi ở đây để kết thúc mọi thứ.
Dialogue: 0,1:22:37.70,1:22:40.22,Main,,0,0,0,,Bữa tiệc cuối cùng sắp bắt đầu.
Dialogue: 0,1:22:41.61,1:22:44.70,Main,,0,0,0,,Trò ghẹo lần này\Nlà loại máy nano đặc chế.
Dialogue: 0,1:22:45.76,1:22:51.11,Main,,0,0,0,,Nó không tự hủy mà lan rộng vô hạn,\Nrồi đến một lúc, cả thế giới...
Dialogue: 0,1:22:51.60,1:22:54.99,Main,,0,0,0,,Định kéo cả thế giới chết chung à?
Dialogue: 0,1:22:54.99,1:22:58.74,Main,,0,0,0,,Anh điên rồi.
Dialogue: 0,1:22:58.74,1:23:00.13,Main,,0,0,0,,Cô nghĩ thế à?
Dialogue: 0,1:23:01.71,1:23:05.08,Main,,0,0,0,,Ranh giới giữa bình thường và bất thường,\Nai vạch ra được?
Dialogue: 0,1:23:06.14,1:23:09.87,Main,,0,0,0,,Ai dám nói rằng chỉ một\Ncơ duyên nhỏ, chúng sẽ không đổi chỗ?
Dialogue: 0,1:23:10.96,1:23:13.00,Main,,0,0,0,,Rồi cô sẽ sớm hiểu thôi.
Dialogue: 0,1:23:13.98,1:23:17.51,Main,,0,0,0,,Thứ điên rồ\Nchắc chắn là thế giới này.
Dialogue: 0,1:23:19.36,1:23:20.65,Main,,0,0,0,,Cô đi cùng tôi chứ?
Dialogue: 0,1:23:23.21,1:23:26.39,Main,,0,0,0,,Sẽ chỉ còn lại tôi và cô.
Dialogue: 0,1:23:26.39,1:23:28.32,Main,,0,0,0,,Đừng có đùa nữa.
Dialogue: 0,1:23:28.32,1:23:32.52,Main,,0,0,0,,Tôi chả biết thế giới sẽ ra sao,\Nnhưng nếu phải sống chỉ có hai ta,
Dialogue: 0,1:23:47.48,1:23:49.72,Main,,0,0,0,,thì anh cứ việc sống một mình đi.
Dialogue: 0,1:24:02.98,1:24:03.97,Main,,0,0,0,,Vincent.
Dialogue: 0,1:24:03.97,1:24:06.41,Main,,0,0,0,,Tao đã bảo mày\Nkhông được đến đây rồi cơ mà.
Dialogue: 0,1:24:06.41,1:24:09.39,Main,,0,0,0,,À, ờ... Jack chuẩn bị xong rồi.
Dialogue: 0,1:24:09.39,1:24:13.99,Main,,0,0,0,,Tôi muốn mau rời khỏi đây.\NCảnh sát cũng bắt đầu lảng vảng rồi.
Dialogue: 0,1:24:13.99,1:24:15.72,Main,,0,0,0,,Nên là, số tiền còn lại ấy...
Dialogue: 0,1:24:15.72,1:24:17.21,Main,,0,0,0,,Mày đã cầu nguyện chưa?
Dialogue: 0,1:24:36.32,1:24:40.88,Main,,0,0,0,,Cây cầu nối trời và đất.\NTôi sẽ ở đó.
Dialogue: 0,1:24:40.88,1:24:46.26,Main,,0,0,0,,Cô hãy ở lại thế gian này một mình \Nmà chứng kiến Luyện ngục đi.
Dialogue: 0,1:24:59.00,1:25:00.47,Main,,0,0,0,,Tôi sẽ thế nào?
Dialogue: 0,1:25:01.26,1:25:04.35,Main,,0,0,0,,Đã là quân nhân thì cô\Ncũng phải chuẩn bị tinh thần rồi chứ?
Dialogue: 0,1:25:09.54,1:25:12.86,Main,,0,0,0,,Này, cho điếu thuốc đi.\NMột điếu thôi cũng được mà.
Dialogue: 0,1:25:12.86,1:25:13.64,Main,,0,0,0,,Tính sao ạ?
Dialogue: 0,1:25:13.64,1:25:14.17,Main,,0,0,0,,Mặc kệ hắn.
Dialogue: 0,1:25:20.36,1:25:22.83,Main,,0,0,0,,K-khoan, khoan! Đừng bắn, đừng bắn!
Dialogue: 0,1:25:22.83,1:25:26.05,Main,,0,0,0,,Vứt súng xuống!\NHarris, mở chỗ này ra.
Dialogue: 0,1:25:27.25,1:25:28.39,Main,,0,0,0,,Tôi lấy nhé.
Dialogue: 0,1:25:35.01,1:25:36.84,Main,,0,0,0,,Thế, địa điểm là ở đâu?
Dialogue: 0,1:25:36.84,1:25:38.79,Main,,0,0,0,,Nhà máy nước ạ.
Dialogue: 0,1:25:38.79,1:25:43.72,Main,,0,0,0,,Trong khi phân tích đường hack của Lee,\Nchúng tôi đã thấy dấu vết hắn xâm nhập.
Dialogue: 0,1:25:43.72,1:25:48.42,Main,,0,0,0,,Ra thế. Chúng định hòa vào nước máy\Nđể rải khắp thành phố.
Dialogue: 0,1:25:48.42,1:25:50.31,Main,,0,0,0,,Điều ngay đội chống khủng bố đến đó.
Dialogue: 0,1:25:50.31,1:25:51.01,Main,,0,0,0,,{はい}Rõ.
Dialogue: 0,1:25:52.16,1:25:53.98,Main,,0,0,0,,Cứ chờ mà xem.
Dialogue: 0,1:25:53.98,1:25:57.00,Main,,0,0,0,,À, nhưng... đã có lệnh\Ncủa Cục trưởng chưa ạ?
Dialogue: 0,1:25:57.00,1:26:00.31,Main,,0,0,0,,Không làm đúng thủ tục\Nthì sau này rắc rối đấy.
Dialogue: 0,1:26:01.20,1:26:03.38,Main,,0,0,0,,Nhân tiện, trong trụ sở\Ncũng cấm hút thuốc.
Dialogue: 0,1:26:05.04,1:26:09.68,Main,,0,0,0,,Cứ nhìn sắc mặt người ta mãi\Nthì chả giải quyết được gì đâu.
Dialogue: 0,1:26:18.39,1:26:20.14,Main,,0,0,0,,Ghé qua chỗ này chút đã.
Dialogue: 0,1:26:21.10,1:26:22.68,Main,,0,0,0,,Máu của cô ở đâu?
Dialogue: 0,1:26:27.52,1:26:28.40,Main,,0,0,0,,Lối này.
Dialogue: 0,1:26:31.78,1:26:32.69,Main,,0,0,0,,Mở rồi.
Dialogue: 0,1:26:33.62,1:26:34.83,Main,,0,0,0,,Đồ bảo hộ...
Dialogue: 0,1:26:34.83,1:26:35.91,Main,,0,0,0,,Không có thời gian đâu.
Dialogue: 0,1:26:36.52,1:26:37.70,Main,,0,0,0,,Chúng đuổi tới rồi.
Dialogue: 0,1:26:41.96,1:26:44.85,Main,,0,0,0,,Vắc-xin của Electra ở đâu?
Dialogue: 0,1:26:44.85,1:26:49.67,Main,,0,0,0,,Đ-đang ở hộp thứ ba... à không,\Nđang nuôi cấy trong hộp thứ hai.
Dialogue: 0,1:26:49.67,1:26:50.54,Main,,0,0,0,,Cái này à?
Dialogue: 0,1:26:50.54,1:26:53.08,Main,,0,0,0,,Phải, gói màu vàng bên trong.
Dialogue: 0,1:26:55.20,1:26:59.48,Main,,0,0,0,,Thật mà!\NChỉ là chưa nuôi cấy xong thôi.
Dialogue: 0,1:27:00.02,1:27:03.66,Main,,0,0,0,,Khoảng 20 tiếng nữa,\Nmỗi gói sẽ được chừng 100.000 con.
Dialogue: 0,1:27:07.32,1:27:08.82,Main,,0,0,0,,Xin lỗi cô, Electra.
Dialogue: 0,1:27:10.14,1:27:12.62,Main,,0,0,0,,Đi qua khu chất thải cấp 3 ấy.
Dialogue: 0,1:27:14.17,1:27:15.01,Main,,0,0,0,,Cảm ơn anh.
Dialogue: 0,1:27:18.02,1:27:19.45,Main,,0,0,0,,Vậy là hẹn hò phải hoãn lại à?
Dialogue: 0,1:28:10.50,1:28:12.02,Main,,0,0,0,,Này, mấy người kia!
Dialogue: 0,1:28:12.02,1:28:15.04,Main,,0,0,0,,ISSP đây. Chúng tôi trưng dụng chỗ này.
Dialogue: 0,1:28:15.58,1:28:17.43,Main,,0,0,0,,Tôi chưa nghe nói gì cả.
Dialogue: 0,1:28:17.43,1:28:20.19,Main,,0,0,0,,Mong ông hợp tác.
Dialogue: 0,1:28:23.87,1:28:27.07,Main,,0,0,0,,Bộ dạng này thì\Nchả dám để ai nhìn thấy.
Dialogue: 0,1:28:31.49,1:28:33.23,Main,,0,0,0,,Siêu thoát đi nhé.
Dialogue: 0,1:28:37.78,1:28:40.15,Main,,0,0,0,,Đang chờ điện thoại à~?
Dialogue: 0,1:28:40.15,1:28:41.85,Main,,0,0,0,,Đâu, có gì đâu.
Dialogue: 0,1:28:42.71,1:28:45.74,Main,,0,0,0,,Chả phải đang đợi Spike\Nvới Faye gọi về à~?
Dialogue: 0,1:28:45.74,1:28:50.41,Main,,0,0,0,,Hử? Nhắc mới nhớ, chả thấy đâu.\NHoàn toàn không để ý luôn.
Dialogue: 0,1:28:52.72,1:28:53.51,Main,,0,0,0,,Alô.
Dialogue: 0,1:28:54.05,1:28:55.81,Main,,0,0,0,,Vincent đi rồi đấy.
Dialogue: 0,1:28:55.81,1:28:58.98,Main,,0,0,0,,Faye, cô lặn mất tăm đi đâu thế hả?
Dialogue: 0,1:28:58.98,1:29:03.13,Main,,0,0,0,,Có vẻ hắn định làm một vố lớn.\NBảo là bữa tiệc sắp bắt đầu.
Dialogue: 0,1:29:03.13,1:29:05.75,Main,,0,0,0,,Sao cô lại biết chuyện đó?
Dialogue: 0,1:29:05.75,1:29:07.02,Main,,0,0,0,,Spike!
Dialogue: 0,1:29:07.02,1:29:09.95,Main,,0,0,0,,Đồ đần này!\NAnh mò đi đâu suốt thế hả?
Dialogue: 0,1:29:11.06,1:29:14.13,Main,,0,0,0,,ISSP hình như đang\Ntới nhà máy nước đấy.
Dialogue: 0,1:29:14.13,1:29:15.37,Main,,0,0,0,,Nhà máy nước?
Dialogue: 0,1:29:44.84,1:29:47.76,Main,,0,0,0,,Đội 4, cổng số 2.\NĐã khám xét xong, không có gì bất thường.
Dialogue: 0,1:29:47.76,1:29:51.21,Main,,0,0,0,,Đội 2, bể số 3.\NKhông phát hiện thứ gì khả nghi.
Dialogue: 0,1:29:51.21,1:29:54.97,Main,,0,0,0,,Đội 3 đây. Phát hiện vật khả nghi\Ngần lối vào nhà máy số 4.
Dialogue: 0,1:29:56.11,1:29:58.25,Main,,0,0,0,,Sẽ cử đội xử lý tới.\NHình dạng thế nào?
Dialogue: 0,1:29:58.25,1:30:00.41,Main,,0,0,0,,V-vâng. Nó là...
Dialogue: 0,1:30:01.12,1:30:03.57,Main,,0,0,0,,...một quả bóng bay hình bí ngô ạ.
Dialogue: 0,1:30:08.28,1:30:12.80,Main,,0,0,0,,Chả phải vô lý à? Ăn mặc như phù thủy\Nmà lại đi tới nhà máy nước?
Dialogue: 0,1:30:13.31,1:30:16.96,Main,,0,0,0,,Hôm nay ở Alba City có\Nlễ diễu hành hóa trang Halloween.
Dialogue: 0,1:30:16.96,1:30:19.71,Main,,0,0,0,,Giấu lá thì giấu trong rừng à.
Dialogue: 0,1:30:19.71,1:30:23.16,Main,,0,0,0,,Hắn định ra tay giữa thành phố à?\NNhưng bằng cách nào?
Dialogue: 0,1:30:23.16,1:30:26.87,Main,,0,0,0,,Đồng bọn của hắn có đến,\Nnói gì đó về việc chuẩn bị Jack.
Dialogue: 0,1:30:26.87,1:30:27.81,Main,,0,0,0,,Jack?
Dialogue: 0,1:30:28.90,1:30:30.03,Main,,0,0,0,,Ra là vậy.
Dialogue: 0,1:30:32.57,1:30:34.54,Main,,0,0,0,,Jack-o'-lantern.
Dialogue: 0,1:30:34.54,1:30:36.39,Main,,0,0,0,,Đèn lồng bí ngô.
Dialogue: 0,1:30:38.67,1:30:40.17,Main,,0,0,0,,Bắt đầu phân tích.
Dialogue: 0,1:30:48.04,1:30:49.22,Main,,0,0,0,,{ばかか}Đần à?
Dialogue: 0,1:30:56.25,1:30:57.29,Main,,0,0,0,,Chuyện gì thế?
Dialogue: 0,1:31:18.83,1:31:20.62,Main,,0,0,0,,Đội A, trả lời đi!
Dialogue: 0,1:31:20.62,1:31:21.72,Main,,0,0,0,,Tổ sư!
Dialogue: 0,1:31:21.72,1:31:23.95,Main,,0,0,0,,Liên lạc với đội bên dưới,\Nbáo tình hình cho tôi.
Dialogue: 0,1:31:23.95,1:31:24.58,Main,,0,0,0,,{はっ}Rõ.
Dialogue: 0,1:31:25.86,1:31:26.67,Main,,0,0,0,,Sếp!
Dialogue: 0,1:31:26.67,1:31:27.12,Main,,0,0,0,,Gì thế?
Dialogue: 0,1:31:28.48,1:31:30.10,Main,,0,0,0,,Đây là lục quân đấy!
Dialogue: 0,1:31:31.63,1:31:32.81,Main,,0,0,0,,Đệch!
Dialogue: 0,1:31:32.81,1:31:33.88,Main,,0,0,0,,Sếp!
Dialogue: 0,1:31:35.73,1:31:37.41,Main,,0,0,0,,Ai là chỉ huy ở đây?
Dialogue: 0,1:31:37.41,1:31:40.39,Main,,0,0,0,,Tôi chưa nghe nói\Ncó yêu cầu quân đội hỗ trợ đấy!
Dialogue: 0,1:31:40.39,1:31:41.67,Main,,0,0,0,,Đây là nhiệm vụ tối mật.
Dialogue: 0,1:31:43.53,1:31:45.45,Main,,0,0,0,,Quân đội sẽ tiếp quản nơi này.
Dialogue: 0,1:31:45.45,1:31:47.43,Main,,0,0,0,,Gì? Nhiệm vụ gì?
Dialogue: 0,1:31:47.43,1:31:48.86,Main,,0,0,0,,Chúng tôi không cần phải nói.
Dialogue: 0,1:31:48.86,1:31:50.06,Main,,0,0,0,,Cái gì?
Dialogue: 0,1:31:50.06,1:31:51.41,Main,,0,0,0,,Có kết quả phân tích rồi!
Dialogue: 0,1:31:55.45,1:31:57.25,Main,,0,0,0,,Kết quả! Mau đưa kết quả đây.
Dialogue: 0,1:31:57.25,1:31:59.39,Main,,0,0,0,,Đã bảo các người lui ra cơ mà...
Dialogue: 0,1:31:59.39,1:32:00.42,Main,,0,0,0,,Ồn ào quá! Này!
Dialogue: 0,1:32:00.42,1:32:05.10,Main,,0,0,0,,Thành phần gồm nitơ, oxy,\Ncùng một lượng nhỏ CO2,
Dialogue: 0,1:32:05.10,1:32:07.16,Main,,0,0,0,,argon, neon, krypton...
Dialogue: 0,1:32:07.16,1:32:10.08,Main,,0,0,0,,Tóm lại chỉ là không khí bình thường.
Dialogue: 0,1:32:16.14,1:32:20.06,Main,,0,0,0,,Nhưng cả thành phố toàn đèn lồng.\NTìm kiểu gì đây?
Dialogue: 0,1:32:20.06,1:32:23.99,Main,,0,0,0,,Hắn bảo là\N"ở cây cầu nối trời và đất".
Dialogue: 0,1:32:23.99,1:32:25.10,Main,,0,0,0,,Cái gì cơ?
Dialogue: 0,1:32:25.10,1:32:28.81,Main,,0,0,0,,Jet, chuẩn bị máy bay giúp tôi.\NĐể xem, chừng 20 đến 30 chiếc.
Dialogue: 0,1:32:28.81,1:32:31.81,Main,,0,0,0,,Gì cơ? Anh định làm gì?
Dialogue: 0,1:32:31.81,1:32:33.56,Main,,0,0,0,,Tôi sẽ đi trước bằng Swordfish.
Dialogue: 0,1:32:33.56,1:32:35.18,Main,,0,0,0,,Này, khoan đã!
Dialogue: 0,1:32:40.73,1:32:43.58,Main,,0,0,0,,Faye, cô tới\NTrung tâm Kiểm soát Khí tượng đi.
Dialogue: 0,1:32:43.58,1:32:45.58,Main,,0,0,0,,Này, đợi đã!
Dialogue: 0,1:32:45.58,1:32:49.79,Main,,0,0,0,,Dù thế giới có diệt vong, hắn vẫn sống!\NThắng kiểu gì được chứ!
Dialogue: 0,1:32:49.79,1:32:51.91,Main,,0,0,0,,Tôi còn món nợ với hắn.
Dialogue: 0,1:32:51.91,1:32:53.17,Main,,0,0,0,,Liều quá rồi đấy.
Dialogue: 0,1:32:53.79,1:32:58.23,Main,,0,0,0,,Nếu hắn chỉ muốn hủy diệt thế giới\Nthì đã làm từ lâu rồi.
Dialogue: 0,1:32:59.13,1:33:04.18,Main,,0,0,0,,Đây là thiệp mời của hắn.\NKhách không đến thì tiệc chưa bắt đầu.
Dialogue: 0,1:33:04.60,1:33:08.43,Main,,0,0,0,,Đi đi. Cô mà không ra tay\Nthì buổi tiệc này chả ra gì đâu.
Dialogue: 0,1:33:10.02,1:33:11.00,Main,,0,0,0,,Trông cả vào cô đấy.
Dialogue: 0,1:33:14.40,1:33:16.39,Main,,0,0,0,,Đần thì đến chết cũng không khỏi.
Dialogue: 0,1:33:23.10,1:33:25.78,Main,,0,0,0,,Chậc, cái lũ quân đội rảnh việc.
Dialogue: 0,1:33:47.35,1:33:50.35,Main,,0,0,0,,Tao không có thời gian\Nchơi với chúng mày đâu.
Dialogue: 0,1:34:38.11,1:34:41.53,Main,,0,0,0,,Đang khẩn cấp đấy!\NLàm ơn xoay xở giúp đi.
Dialogue: 0,1:34:41.53,1:34:44.36,Main,,0,0,0,,Ông nói thế thì cũng...
Dialogue: 0,1:34:44.36,1:34:49.15,Main,,0,0,0,,Máy bay chiến đấu đều bị\Ncác nơi mượn hết, chả còn chiếc nào.
Dialogue: 0,1:34:49.15,1:34:53.29,Main,,0,0,0,,Không có thời gian đâu.\NThứ gì cũng được, miễn bay được!
Dialogue: 0,1:34:55.61,1:34:57.20,Main,,0,0,0,,Thứ gì cũng được hả?
Dialogue: 0,1:35:10.86,1:35:12.81,Main,,0,0,0,,Vẫn còn sớm để đi dự tiệc đấy.
Dialogue: 0,1:36:51.91,1:36:56.19,Main,,0,0,0,,Chà, máy bay kiểu cổ\Nthế này cũng ra gì đấy chứ.
Dialogue: 0,1:36:56.19,1:36:58.36,Main,,0,0,0,,Thứ này bay được thật à?
Dialogue: 0,1:37:00.71,1:37:04.94,Main,,0,0,0,,Cứ để đấy cho bọn tôi.\NRải thứ này từ trên trời là được chứ gì.
Dialogue: 0,1:37:04.94,1:37:07.87,Main,,0,0,0,,Già rồi thì đừng cố quá nhé.
Dialogue: 0,1:37:07.87,1:37:10.50,Main,,0,0,0,,Bay đến đâu? Tận Sao Thổ à?
Dialogue: 0,1:37:10.50,1:37:14.62,Main,,0,0,0,,Nói linh tinh. Phun thuốc trừ sâu\Nmà đi vũ trụ làm gì.
Dialogue: 0,1:37:14.62,1:37:18.04,Main,,0,0,0,,Trong thành phố.\NChỉ đến Alba City thôi.
Dialogue: 0,1:37:18.04,1:37:20.21,Main,,0,0,0,,Biết rồi, đùa thôi mà.
Dialogue: 0,1:37:39.23,1:37:42.15,Main,,0,0,0,,Ồ, bay được thật này.
Dialogue: 0,1:37:43.34,1:37:48.96,Main,,0,0,0,,Đồ cổ để trưng bày mà.\NMấy chục năm nay có bay đâu.
Dialogue: 0,1:39:11.89,1:39:13.88,Main,,0,0,0,,Ê này, đồ sắt vụn!
Dialogue: 0,1:39:42.02,1:39:43.83,Main,,0,0,0,,Này, taxi!
Dialogue: 0,1:39:45.61,1:39:47.57,Main,,0,0,0,,Ai là người có chức to nhất ở đây?
Dialogue: 0,1:39:48.90,1:39:50.31,Main,,0,0,0,,Cô là ai thế?
Dialogue: 0,1:39:51.33,1:39:54.76,Main,,0,0,0,,Nhìn là thấy, chỉ là\Nmột tên khủng bố quèn thôi.
Dialogue: 0,1:39:59.40,1:40:01.14,Main,,0,0,0,,Cô định làm gì ở đây?
Dialogue: 0,1:40:01.14,1:40:03.00,Main,,0,0,0,,Y-yêu cầu là gì?
Dialogue: 0,1:40:03.00,1:40:05.00,Main,,0,0,0,,Tôi muốn trời đổ mưa.
Dialogue: 0,1:40:06.35,1:40:07.10,Main,,0,0,0,,Tại sao?
Dialogue: 0,1:40:07.82,1:40:09.05,Main,,0,0,0,,Để xem nào...
Dialogue: 0,1:40:10.43,1:40:12.11,Main,,0,0,0,,Vì đang có lễ hội chăng?
Dialogue: 0,1:41:38.22,1:41:39.94,Main,,0,0,0,,Chịu, hết cách rồi.
Dialogue: 0,1:41:40.88,1:41:43.82,Main,,0,0,0,,Hôm nay có diễu hành\Nnên đường nào cũng tắc.
Dialogue: 0,1:41:48.34,1:41:50.46,Main,,0,0,0,,Cây cầu nối trời và đất...
Dialogue: 0,1:41:55.65,1:41:58.21,Main,,0,0,0,,Ơ, khoan đã! Tiền taxi!
Dialogue: 0,1:43:09.48,1:43:11.45,Main,,0,0,0,,Bữa tiệc bắt đầu rồi à?
Dialogue: 0,1:43:13.93,1:43:15.91,Main,,0,0,0,,Bắt đầu từ ngay bây giờ.
Dialogue: 0,1:43:22.68,1:43:26.93,Main,,0,0,0,,Chà, làm tôi nhớ lại\Nvụ đánh chìm thiết giáp hạm Bismarck.
Dialogue: 0,1:43:26.93,1:43:30.55,Main,,0,0,0,,Bốc phét, đó là\Nhồi Thế chiến thứ hai còn gì.
Dialogue: 0,1:43:30.55,1:43:33.43,Main,,0,0,0,,Sắp tới thành phố rồi.\NBắt đầu thôi.
Dialogue: 0,1:44:22.47,1:44:25.53,Main,,0,0,0,,Tao biết mày sẽ tới mà,\Nthợ săn tiền thưởng.
Dialogue: 0,1:44:26.17,1:44:30.03,Main,,0,0,0,,Lúc đó, mày đã né được\Nchỗ hiểm trong gang tấc, đúng không?
Dialogue: 0,1:44:31.06,1:44:34.03,Main,,0,0,0,,Xem ra mắt mày\Ncũng không đến nỗi mù nhỉ.
Dialogue: 0,1:45:42.41,1:45:45.83,Main,,0,0,0,,Đến để cứu thế giới à?
Dialogue: 0,1:45:45.83,1:45:47.87,Main,,0,0,0,,Nhưng muộn mất rồi.
Dialogue: 0,1:45:48.69,1:45:52.93,Main,,0,0,0,,Tiếc thật.\NTao chỉ là thợ săn tiền thưởng.
Dialogue: 0,1:45:52.93,1:45:55.28,Main,,0,0,0,,Thế giới này ra sao tao cóc quan tâm.
Dialogue: 0,1:45:55.92,1:45:59.79,Main,,0,0,0,,Tao chỉ đến để trả nợ mày thôi.
Dialogue: 0,1:46:00.40,1:46:02.60,Main,,0,0,0,,Mày nghĩ tao dọa à?
Dialogue: 0,1:46:02.60,1:46:04.00,Main,,0,0,0,,Tao làm thật đấy.
Dialogue: 0,1:46:04.00,1:46:05.50,Main,,0,0,0,,Làm đi.
Dialogue: 0,1:47:54.49,1:47:57.22,Main,,0,0,0,,Trước khi mạng mày tàn,\Nhãy cho tao biết.
Dialogue: 0,1:47:58.64,1:48:01.40,Main,,0,0,0,,Có phải tao đã chết\Nở Titan từ lâu rồi,
Dialogue: 0,1:48:02.37,1:48:06.97,Main,,0,0,0,,và thế giới này chỉ là giấc mơ\Nmà lũ bướm đang cho tao thấy?
Dialogue: 0,1:48:08.79,1:48:13.44,Main,,0,0,0,,Hay thế giới có lũ bướm\Nmới là hiện thực,
Dialogue: 0,1:48:13.44,1:48:16.02,Main,,0,0,0,,còn thế giới tao từng sống\Nmới là giấc mơ?
Dialogue: 0,1:48:18.54,1:48:20.12,Main,,0,0,0,,Tao không biết nữa.
Dialogue: 0,1:48:21.70,1:48:23.01,Main,,0,0,0,,Vincent.
Dialogue: 0,1:48:26.14,1:48:29.02,Main,,0,0,0,,Lần này em sẽ không để anh thoát.
Dialogue: 0,1:48:33.36,1:48:35.90,Main,,0,0,0,,Không được, Electra.
Dialogue: 0,1:48:38.11,1:48:40.50,Main,,0,0,0,,Chúng ta... cùng đi thôi.
Dialogue: 0,1:48:54.86,1:48:56.02,Main,,0,0,0,,Vincent!
Dialogue: 0,1:49:00.71,1:49:03.56,Main,,0,0,0,,Sao mày không bắn?
Dialogue: 0,1:49:05.96,1:49:07.41,Main,,0,0,0,,Tao nhớ ra rồi.
Dialogue: 0,1:49:08.59,1:49:10.81,Main,,0,0,0,,Cô ấy là người phụ nữ tao từng yêu.
Dialogue: 0,1:49:13.91,1:49:17.25,Main,,0,0,0,,Suốt bấy lâu nay\N tao chỉ muốn thoát khỏi nơi này
Dialogue: 0,1:49:17.25,1:49:21.07,Main,,0,0,0,,Lúc nào cũng kiếm tìm \Nmột cánh cửa để rời khỏi thế giới này.
Dialogue: 0,1:49:22.35,1:49:27.43,Main,,0,0,0,,Giờ thì tao hiểu rồi.\NLàm gì có cánh cửa nào.
Dialogue: 0,1:49:28.84,1:49:31.44,Main,,0,0,0,,Lẽ ra mày phải biết từ lâu rồi.
Dialogue: 0,1:49:31.44,1:49:35.70,Main,,0,0,0,,Mày chỉ sợ phải mở mắt ra thôi.
Dialogue: 0,1:49:35.70,1:49:36.59,Main,,0,0,0,,Ờ...
Dialogue: 0,1:49:37.57,1:49:39.62,Main,,0,0,0,,Electra...
Dialogue: 0,1:49:39.62,1:49:43.85,Main,,0,0,0,,Trong cả cuộc đời anh,\Nchỉ những lúc ở bên em
Dialogue: 0,1:49:43.85,1:49:45.91,Main,,0,0,0,,anh mới thấy như là hiện thực.
Dialogue: 0,1:49:50.72,1:49:54.88,Main,,0,0,0,,Phút cuối còn được gặp lại em, thật tốt quá.
Dialogue: 0,1:50:15.89,1:50:17.88,Main,,0,0,0,,Mưa đã làm gì thế?
Dialogue: 0,1:50:18.55,1:50:22.58,Main,,0,0,0,,Nó lây nhiễm, lan rộng\Nnhanh hơn cả máy nano,
Dialogue: 0,1:50:22.58,1:50:25.13,Main,,0,0,0,,chắc đã thành cơn mưa cứu rỗi rồi.
Dialogue: 0,1:50:25.96,1:50:28.65,Main,,0,0,0,,Mưa tạnh thì sẽ có cầu vồng nhỉ.
Dialogue: 0,1:50:29.88,1:50:30.80,Main,,0,0,0,,Này.
Dialogue: 0,1:50:30.80,1:50:31.84,Main,,0,0,0,,Hả?
Dialogue: 0,1:50:31.84,1:50:33.14,Main,,0,0,0,,Đi xem đua ngựa không?
Dialogue: 0,1:50:36.36,1:50:38.90,Main,,0,0,0,,Cô đúng là không biết chừa.
Dialogue: 0,1:54:29.08,1:54:32.58,Main,,0,0,0,,{\i1}Hắn chẳng qua\Nchỉ là một kẻ cô độc.{\i0}
Dialogue: 0,1:54:34.37,1:54:37.27,Main,,0,0,0,,{\i1}Hắn là kẻ chỉ có thể \Nbày trò chơi với chính bản thân mình.{\i0}
Dialogue: 0,1:54:38.52,1:54:40.27,Main,,0,0,0,,{\i1}Như thể sống trong một giấc mơ...{\i0}
Dialogue: 0,1:54:41.93,1:54:43.40,Main,,0,0,0,,{\i1}Hắn là một gã như thế đấy.{\i0}
Comment: 0,1:54:52.32,1:55:01.23,Main,,0,0,0,,======================================
Comment: 0,0:05:16.14,0:05:22.14,OST,,0,0,0,,♪ シートベルツ (The Seatbelts) (Ft. Raj Ramayya) - Ask DNA
Comment: 0,0:05:37.99,0:05:42.91,OST,,0,0,0,,Bế tắc, mụ mẫm và chẳng thể quyết định
Comment: 0,0:05:43.17,0:05:48.21,OST,,0,0,0,,Có cầu nguyện bao nhiêu cũng vô ích, trốn tránh sao được
Comment: 0,0:05:48.34,0:05:52.38,OST,,0,0,0,,Cứ tỏ ra thật ngầu hoặc cứ bật khóc
Comment: 0,0:05:52.51,0:05:56.60,OST,,0,0,0,,Làm sai, không làm gì cả, hay làm cho thật đúng
Comment: 0,0:05:58.64,0:06:03.35,OST,,0,0,0,,Chẳng ai nợ bạn điều gì, cũng chẳng thể trách cứ ai
Comment: 0,0:06:03.64,0:06:08.65,OST,,0,0,0,,Ngoại trừ đổ lỗi cho bộ gen hay DNA tồi
Comment: 0,0:06:08.98,0:06:13.11,OST,,0,0,0,,Hãy tự hỏi lương tâm vì sao và bằng cách nào
Comment: 0,0:06:13.24,0:06:16.45,OST,,0,0,0,,Lúc đó làm, khi nào làm, nhưng hãy làm ngay lúc này
Comment: 0,0:06:18.37,0:06:23.21,OST,,0,0,0,,Sao thế hả cưng?
Comment: 0,0:06:23.41,0:06:28.63,OST,,0,0,0,,Thế rốt cuộc ai mới sành điệu cơ chứ?
Comment: 0,0:06:28.75,0:06:34.42,OST,,0,0,0,,Các cô gái Trái Đất vốn dễ dãi mà
Comment: 0,0:06:34.97,0:06:37.34,OST,,0,0,0,,Cậu định làm gì đây, chàng cao bồi bé nhỏ?
Comment: 0,0:06:37.47,0:06:39.64,OST,,0,0,0,,(Này, tốt nhất là cậu nên hỏi xin cô ấy cho tử tế!)
Comment: 0,0:06:40.18,0:06:42.81,OST,,0,0,0,,Tất cả những gì cậu cần làm, hỡi tên ngốc vui vẻ,
Comment: 0,0:06:42.93,0:06:47.06,OST,,0,0,0,,là về hỏi mẹ cậu đi
Comment: 0,0:09:37.32,0:09:40.40,OST,,0,0,0,,♪シートベルツ (The Seatbelts) (Ft. Reynada Hill) - Cosmic Dare (Pretty with a Pistol)
Dialogue: 0,0:09:40.53,0:09:44.15,OST,,0,0,0,,Anh và em đang đánh cược qua từng lời nói
Dialogue: 0,0:09:44.53,0:09:48.15,OST,,0,0,0,,Anh và em đang lang bạt khắp các thế giới
Dialogue: 0,0:10:09.72,0:10:11.18,OST,,0,0,0,,Anh có tin em không?
Dialogue: 0,0:10:11.18,0:10:15.19,OST,,0,0,0,,Em vẫn ngồi đây mĩ miều với khẩu súng lục trên tay
Dialogue: 0,0:10:15.19,0:10:18.66,OST,,0,0,0,,Sống là để yêu anh, liệu anh có nguyện làm người đàn ông của em?
Dialogue: 0,0:10:18.66,0:10:22.19,OST,,0,0,0,,Nếu em cầu xin, nếu em van nài
Dialogue: 0,0:10:22.19,0:10:27.74,OST,,0,0,0,,Liệu anh có, có, có làm em thỏa mãn không?
Dialogue: 0,0:10:27.74,0:10:31.49,OST,,0,0,0,,Mọi điều đều có thể xảy ra trong ván cược vũ trụ này
Dialogue: 0,0:10:31.49,0:10:34.91,OST,,0,0,0,,Mọi điều đều có thể, nên hãy cẩn thận nhé
Dialogue: 0,0:10:34.91,0:10:39.46,OST,,0,0,0,,Anh có cảm nhận được tim em đập vì những lời dối trá của anh?
Dialogue: 0,0:10:39.46,0:10:43.59,OST,,0,0,0,,Hãy lắng nghe cho thật kỹ, tình yêu ngọt ngào của em
Comment: 0,0:20:04.98,0:20:10.99,OST,,0,0,0,,♪ シートベルツ (The Seatbelts) (Ft. Steve Conte) - Diggin’
Dialogue: 0,0:20:19.46,0:20:22.20,OST,,0,0,0,,Em biết đấy, bố tôi đã dành cả cuộc đời để đào cổng
Dialogue: 0,0:20:22.20,0:20:24.08,OST,,0,0,0,,Và ông chẳng biết làm việc gì khác cả
Dialogue: 0,0:20:24.73,0:20:27.08,OST,,0,0,0,,Và bố ông cũng cặm cụi đào như ông nội tôi
Dialogue: 0,0:20:27.08,0:20:29.68,OST,,0,0,0,,Người đã bắt đầu đào từ trước thời chiến
Dialogue: 0,0:20:29.68,0:20:32.34,OST,,0,0,0,,Và dẫu bà chẳng thể biết cho đến khi tôi chào đời
Dialogue: 0,0:20:32.34,0:20:36.72,OST,,0,0,0,,Người mẹ đáng thương của tôi, mong Chúa cho linh hồn bà yên nghỉ
Dialogue: 0,0:20:37.21,0:20:39.72,OST,,0,0,0,,Rằng giống như họ, tôi sinh ra với nghiệp đào bới
Dialogue: 0,0:20:44.31,0:20:47.14,OST,,0,0,0,,Có phải vì tôi đã thấy chán chường và cô độc
Dialogue: 0,0:20:49.39,0:20:53.02,OST,,0,0,0,,Có phải vì tôi chỉ là gã ngốc nghếch và rạo rực
Dialogue: 0,0:20:54.16,0:20:59.95,OST,,0,0,0,,Có phải vì Nữ thần May mắn đã mỉm cười với tôi
Comment: 0,1:45:00.32,1:45:06.04,OST,,0,0,0,,======================================
Comment: 0,1:45:00.52,1:45:05.94,OST,,0,0,0,,Không muốn làm gấu bông của em nổi điên với tôi đâu, cô gái à
Comment: 0,1:50:38.90,1:50:41.08,OST,,0,0,0,,シートベルツ (The Seatbelts) (Ft. 山根麻以 (Mai Yamane)) - Gotta Knock A Little Harder
Comment: 0,1:50:38.90,1:50:41.08,OST,,0,0,0,,Hạnh phúc với tôi chỉ là chữ nghĩa
Comment: 0,1:50:41.21,1:50:43.13,OST,,0,0,0,,Và có lẽ nó đã mang đôi chút ý nghĩa
Comment: 0,1:50:43.25,1:50:46.25,OST,,0,0,0,,Nếu tôi hiểu được sự khác biệt
Comment: 0,1:50:47.71,1:50:49.97,OST,,0,0,0,,Trống rỗng, một màn giễu nhại cô độc
Comment: 0,1:50:50.09,1:50:52.05,OST,,0,0,0,,Và đời tôi, tựa nòng súng vừa nhả đạn
Comment: 0,1:50:52.18,1:50:55.76,OST,,0,0,0,,Là minh chứng cho sự thờ ơ
Comment: 0,1:50:56.81,1:50:58.85,OST,,0,0,0,,Luôn giấu mình chốn an toàn
Comment: 0,1:50:58.97,1:51:01.06,OST,,0,0,0,,Nơi chưa từng ai có cơ hội
Comment: 0,1:51:01.19,1:51:04.19,OST,,0,0,0,,Xuyên thấu và bước vào trong
Comment: 0,1:51:05.86,1:51:07.78,OST,,0,0,0,,Thật ra cũng vài người từng thử
Comment: 0,1:51:07.90,1:51:09.99,OST,,0,0,0,,Nhưng tôi lại đóng sầm cửa chặt
Comment: 0,1:51:10.11,1:51:13.61,OST,,0,0,0,,Đến mức chẳng ai bước vào được
Comment: 0,1:51:17.53,1:51:20.12,OST,,0,0,0,,Khóa chặt vẻ ngoài lạnh lùng
Comment: 0,1:51:20.25,1:51:21.50,OST,,0,0,0,,Và chưa từng rơi một giọt lệ
Comment: 0,1:51:21.62,1:51:25.25,OST,,0,0,0,,Thêm minh chứng cho cảnh ngộ này
Comment: 0,1:51:26.17,1:51:29.34,OST,,0,0,0,,Sợ tình yêu, hay sự phù phiếm cay đắng
Comment: 0,1:51:29.46,1:51:30.66,OST,,0,0,0,,Khiến tôi cứ mãi trốn chạy
Comment: 0,1:51:30.66,1:51:33.72,OST,,0,0,0,,Trọng tâm của lời thú tội này
Comment: 0,1:51:35.47,1:51:37.88,OST,,0,0,0,,Tôi quấn chặt xích quanh cửa
Comment: 0,1:51:37.88,1:51:40.17,OST,,0,0,0,,Đủ khiến nỗi nhục nhã của Cain
Comment: 0,1:51:40.17,1:51:42.81,OST,,0,0,0,,Phải cúi đầu nhượng bộ mù quáng
Comment: 0,1:51:44.52,1:51:46.52,OST,,0,0,0,,Bóng ma rực lửa vô danh
Comment: 0,1:51:46.65,1:51:48.65,OST,,0,0,0,,Vẫn không ngừng cất tiếng gọi
Comment: 0,1:51:48.77,1:51:52.07,OST,,0,0,0,,Nhưng tôi quyết bỏ ngoài tai
Comment: 0,1:51:55.91,1:51:58.74,OST,,0,0,0,,Càng chần chừ, tôi càng trườn xa
Comment: 0,1:51:58.87,1:52:01.37,OST,,0,0,0,,Càng trườn xa, tôi càng ngã đau
Comment: 0,1:52:01.50,1:52:06.25,OST,,0,0,0,,Tôi đang trườn dần vào ngọn lửa
Comment: 0,1:52:07.42,1:52:10.21,OST,,0,0,0,,Càng thấy nhiều, tôi càng ngã đau
Comment: 0,1:52:10.34,1:52:12.76,OST,,0,0,0,,Càng ngã đau, tôi càng lết thấp
Comment: 0,1:52:12.88,1:52:17.80,OST,,0,0,0,,Cứ thế tôi chìm vào ngọn lửa
Comment: 0,1:52:26.52,1:52:29.06,OST,,0,0,0,,Chìm vào ngọn lửa
Comment: 0,1:52:37.73,1:52:40.33,OST,,0,0,0,,Chìm trong ngọn lửa
Comment: 0,1:52:44.62,1:52:47.00,OST,,0,0,0,,Rồi chợt tôi nhận ra
Comment: 0,1:52:47.12,1:52:48.71,OST,,0,0,0,,Việc mải miết chạy trốn và nấp mình
Comment: 0,1:52:48.83,1:52:51.92,OST,,0,0,0,,Đã hủy hoại cả sự tồn tại này
Comment: 0,1:52:52.92,1:52:55.26,OST,,0,0,0,,Bất cứ điều gì ở phía bên kia
Comment: 0,1:52:55.38,1:52:57.38,OST,,0,0,0,,Cùng lắm chỉ tệ đến thế này thôi
Comment: 0,1:52:57.51,1:53:00.55,OST,,0,0,0,,Nhưng liệu tôi có dám đi đến cùng
Comment: 0,1:53:01.72,1:53:03.89,OST,,0,0,0,,Đối mặt cánh cửa và nỗi hổ thẹn
Comment: 0,1:53:04.02,1:53:06.14,OST,,0,0,0,,Giật tung từng đoạn dây xích
Comment: 0,1:53:06.27,1:53:09.23,OST,,0,0,0,,Cho đến khi chúng đứt rời
Comment: 0,1:53:10.44,1:53:12.48,OST,,0,0,0,,Nhưng dù cố gắng nhường nào
Comment: 0,1:53:12.61,1:53:14.53,OST,,0,0,0,,Phía bên kia vẫn khóa quá chặt
