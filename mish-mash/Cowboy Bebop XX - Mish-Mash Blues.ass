Dialogue: 0,0:01:57.34,0:02:01.22,Main,,0,0,0,,Chả có gì là mãi mãi.\NMọi thứ rồi cũng tới lúc kết thúc.
Dialogue: 0,0:02:01.22,0:02:03.77,Main,,0,0,0,,Cái đó gọi là quy luật tự nhiên.
Dialogue: 0,0:02:03.77,0:02:06.30,Main,,0,0,0,,Hơi đột ngột,\Nnhưng hôm nay là tập cuối.
Dialogue: 0,0:02:06.30,0:02:07.32,Main,,0,0,0,,Thế nên lần này,
Dialogue: 0,0:02:07.32,0:02:10.74,Main,,0,0,0,,tôi muốn nhớ lại mấy chuyện đã qua\Nrồi ngẫm nghĩ đủ thứ một chút.
Dialogue: 0,0:02:24.49,0:02:26.50,Main,,0,0,0,,Đói thế nhờ~
Dialogue: 0,0:02:29.37,0:02:31.67,Main,,0,0,0,,Cả mi nữa à.
Dialogue: 0,0:02:40.94,0:02:42.72,Main,,0,0,0,,Đồ ăn rất quan trọng.
Dialogue: 0,0:02:42.72,0:02:45.94,Main,,0,0,0,,Dù gì thì cơ thể con người\Ncũng được tạo nên từ thứ họ ăn.
Dialogue: 0,0:02:45.94,0:02:48.66,Main,,0,0,0,,Giả sử có một bản sao vô tính của tôi,
Dialogue: 0,0:02:48.66,0:02:51.73,Main,,0,0,0,,và gã đó chưa từng ăn thứ gì\Nngoài hamburger.
Dialogue: 0,0:02:51.73,0:02:54.16,Main,,0,0,0,,Dù gã đó với tôi\Ngiống hệt nhau về gen,
Dialogue: 0,0:02:54.16,0:02:56.78,Main,,0,0,0,,thì chắc chắn vẫn sẽ là\Nhai con người hoàn toàn khác.
Dialogue: 0,0:02:56.78,0:03:00.41,Main,,0,0,0,,Có khi "Spike Hamburger"\Ndễ nổi nóng hơn tôi,
Dialogue: 0,0:03:00.41,0:03:03.45,Main,,0,0,0,,hay có khi lại là kiểu người\Nchủ nhật nào cũng đi lễ nhà thờ.
Dialogue: 0,0:03:03.45,0:03:05.95,Main,,0,0,0,,Có khi là một kẻ bị treo thưởng\Nhung tợn,
Dialogue: 0,0:03:05.95,0:03:09.28,Main,,0,0,0,,hay là kiểu người lúc nào\Ncũng là phẳng sơ mi rồi mới mặc.
Dialogue: 0,0:03:10.21,0:03:14.54,Main,,0,0,0,,Dù sao đi nữa, "Spike Hamburger"\Nvẫn là một người khác với tôi.
Dialogue: 0,0:03:14.54,0:03:20.97,Main,,0,0,0,,Nói tóm lại, khi chọn đồ ăn \Nthì phải suy nghĩ cho thật kỹ.
Dialogue: 0,0:03:20.97,0:03:23.76,Main,,0,0,0,,Tôi sẽ gọi món tôm hùm hầm miso, với...
Dialogue: 0,0:03:25.05,0:03:26.47,Main,,0,0,0,,{\i1}Cảm ơn quý khách đã gọi món.{\i0}
Dialogue: 0,0:03:30.60,0:03:34.27,Main,,0,0,0,,Bonsai thâm sâu lắm.\NĐâu phải cứ cắt tỉa là xong.
Dialogue: 0,0:03:34.27,0:03:40.37,Main,,0,0,0,,Mỗi cây bonsai có một cá tính riêng,\Nvà phải biết làm cho nó tỏa sáng.
Dialogue: 0,0:03:40.37,0:03:44.95,Main,,0,0,0,,Người đần độn thì cái gì\Ncũng muốn tỉa cho đều như nhau.
Dialogue: 0,0:03:44.95,0:03:49.00,Main,,0,0,0,,Chỉ biết cắt, cắt, cắt\Nhết những chỗ chĩa ra.
Dialogue: 0,0:03:49.00,0:03:53.34,Main,,0,0,0,,Nhưng chính chỗ chĩa ra đó\Nmới là cá tính, là cái độc đáo.
Dialogue: 0,0:03:53.63,0:03:57.50,Main,,0,0,0,,Đến thế mà cũng không hiểu\Nthì đừng có cầm kéo.
Dialogue: 0,0:03:57.50,0:04:01.39,Main,,0,0,0,,Tội nghiệp mấy cây bonsai thật.
Dialogue: 0,0:04:01.39,0:04:03.06,Main,,0,0,0,,Biết điều cơ bản của chiến đấu\Nlà gì không?
Dialogue: 0,0:04:16.44,0:04:19.44,Main,,0,0,0,,Tôi ghét đàn ông không có chính kiến.
Dialogue: 0,0:04:19.44,0:04:22.91,Main,,0,0,0,,Nhưng còn ghét hơn đàn ông\Nđem chính kiến ép lên người khác.
Dialogue: 0,0:04:23.35,0:04:25.25,Main,,0,0,0,,Ghét cả đàn ông bị viêm nướu.
Dialogue: 0,0:04:26.28,0:04:29.36,Main,,0,0,0,,Đàn ông hôi miệng thì\Nđến hôn còn chả được.
Dialogue: 0,0:04:30.75,0:04:32.47,Main,,0,0,0,,Tôi thích đàn ông nguy hiểm.
Dialogue: 0,0:04:33.54,0:04:36.67,Main,,0,0,0,,Nhưng nguy hiểm quá\Nthì cũng nên cân nhắc chút.
Dialogue: 0,0:04:37.80,0:04:41.09,Main,,0,0,0,,Tôi ghét đàn ông nhát gan.
Dialogue: 0,0:04:41.09,0:04:44.24,Main,,0,0,0,,Tôi thích đàn ông\Nbiết điểm yếu của bản thân.
Dialogue: 0,0:04:45.26,0:04:47.60,Main,,0,0,0,,Tôi thích đàn ông lạc quan.
Dialogue: 0,0:04:48.68,0:04:53.20,Main,,0,0,0,,Đoán trước đời mình rồi sống bi quan,\Ntôi chả hiểu nổi kiểu đó.
Dialogue: 0,0:04:54.52,0:04:58.99,Main,,0,0,0,,Cuộc đời này dù có xoay vần ra sao, \Nchắc cái gì đến cũng sẽ đến thôi.
Dialogue: 0,0:05:01.24,0:05:03.95,Main,,0,0,0,,Đúng rồi, vì Ed là Ed mà~
Dialogue: 0,0:05:18.13,0:05:19.38,Main,,0,0,0,,Ed đây.
Dialogue: 0,0:05:19.38,0:05:21.71,Main,,0,0,0,,Vũ trụ rộng lắm.
Dialogue: 0,0:05:21.71,0:05:25.59,Main,,0,0,0,,Ed đang đi khắp nơi\Nđể tìm chân lý của vũ trụ.
Dialogue: 0,0:05:25.59,0:05:28.81,Main,,0,0,0,,Đi chân đất thì thấy rần rần.
Dialogue: 0,0:05:28.81,0:05:33.68,Main,,0,0,0,,Biển mạng rộng mênh mông,\Ncó đủ loại cá, nhìn tròn cả mắt.
Dialogue: 0,0:05:33.68,0:05:37.90,Main,,0,0,0,,Đội đồ lên đầu thì háo hức lắm.
Dialogue: 0,0:05:37.90,0:05:40.65,Main,,0,0,0,,Nghĩ là có chân lý rồi đi tìm\Nthì không thấy,
Dialogue: 0,0:05:40.65,0:05:44.15,Main,,0,0,0,,nghĩ là không có rồi đi tìm\Nthì đúng là không thấy thật.
Dialogue: 0,0:05:44.15,0:05:49.87,Main,,0,0,0,,Thứ mình muốn thì chẳng có được, \Nnhưng thứ mình cần thì lại tìm thấy rồi.
Dialogue: 0,0:05:51.84,0:05:53.62,Main,,0,0,0,,Dựa vào mắt hơi bị nhiều rồi đấy.
Dialogue: 0,0:05:53.62,0:05:55.12,Main,,0,0,0,,Có phải tắc kè hoa quái đâu.
Dialogue: 0,0:05:55.12,0:05:56.79,Main,,0,0,0,,Còn lâu mới nhìn được mọi góc độ.
Dialogue: 0,0:06:00.92,0:06:03.76,Main,,0,0,0,,Con người sống nhờ nhịp đập của tim.
Dialogue: 0,0:06:03.76,0:06:06.47,Main,,0,0,0,,Nhịp đập là sự lặp lại đều đặn,
Dialogue: 0,0:06:06.47,0:06:08.18,Main,,0,0,0,,nói cách khác, là nhịp điệu.
Dialogue: 0,0:06:08.18,0:06:11.77,Main,,0,0,0,,Phải, dù làm gì đi nữa,\Nthì nhịp điệu vẫn là quan trọng nhất.
Dialogue: 0,0:06:11.93,0:06:12.93,Main,,0,0,0,,Lúc bước đi,
Dialogue: 0,0:06:12.93,0:06:14.14,Main,,0,0,0,,lúc đánh nhau,
Dialogue: 0,0:06:14.14,0:06:15.35,Main,,0,0,0,,lúc ăn cơm,
Dialogue: 0,0:06:15.35,0:06:16.48,Main,,0,0,0,,lúc ân ái,
Dialogue: 0,0:06:16.48,0:06:17.81,Main,,0,0,0,,lúc nói thoại,
Dialogue: 0,0:06:17.81,0:06:20.06,Main,,0,0,0,,nhịp điệu đều rất quan trọng.
Dialogue: 0,0:06:24.40,0:06:25.69,Main,,0,0,0,,Này, Ein.
Dialogue: 0,0:06:25.69,0:06:26.78,Main,,0,0,0,,Này, này, Ein.
Dialogue: 0,0:06:27.29,0:06:29.70,Main,,0,0,0,,Sao lông lá nhiều thế?
Dialogue: 0,0:06:29.70,0:06:33.37,Main,,0,0,0,,Dạ~! Là vì sợ lạnh đấy~
Dialogue: 0,0:06:33.87,0:06:35.04,Main,,0,0,0,,Này, Ein.
Dialogue: 0,0:06:35.04,0:06:36.59,Main,,0,0,0,,Mà này, Ein.
Dialogue: 0,0:06:36.59,0:06:39.42,Main,,0,0,0,,Sao chả bao giờ cười ha hả?
Dialogue: 0,0:06:39.42,0:06:41.67,Main,,0,0,0,,Ồ~ Là vì bất cần đời đấy~
Dialogue: 0,0:06:42.75,0:06:45.84,Main,,0,0,0,,Này, Ein. Rốt cuộc, Ein.
Dialogue: 0,0:06:45.84,0:06:47.60,Main,,0,0,0,,Sao lại hạnh phúc thế?
Dialogue: 0,0:06:48.47,0:06:52.76,Main,,0,0,0,,Vâng~ Chắc là vì\NEd đang hạnh phúc đấy~
Dialogue: 0,0:06:54.02,0:06:55.88,Main,,0,0,0,,Charlie nói,
Dialogue: 0,0:06:55.88,0:06:58.14,Main,,0,0,0,,"Chỉ có tay mới rửa được cho tay,
Dialogue: 0,0:06:58.14,0:07:01.06,Main,,0,0,0,,muốn nhận thì phải cho."
Dialogue: 0,0:07:01.06,0:07:02.94,Main,,0,0,0,,Có biết như thế nghĩa là gì không?
Dialogue: 0,0:07:02.94,0:07:06.23,Main,,0,0,0,,Là Charlie bảo cứ chơi đi đó.
Dialogue: 0,0:07:06.23,0:07:07.74,Main,,0,0,0,,Chuẩn chưa?
Dialogue: 0,0:07:08.03,0:07:11.28,Main,,0,0,0,,Charlie Parker mà trích lời Goethe à?
Dialogue: 0,0:07:15.41,0:07:20.75,Main,,0,0,0,,"Sự tôn trọng lớn nhất mà tác giả\Ncó thể dành cho độc giả,
Dialogue: 0,0:07:20.75,0:07:24.39,Main,,0,0,0,,là không viết bất cứ thứ gì\Nhọ mong đợi."
Dialogue: 0,0:07:24.39,0:07:26.43,Main,,0,0,0,,Goethe đã nói thế đấy.
Dialogue: 0,0:07:26.43,0:07:28.31,Main,,0,0,0,,Ông ta còn nói thế này:
Dialogue: 0,0:07:28.31,0:07:32.31,Main,,0,0,0,,"Dù là công trình của con người\Nhay công trình của tự nhiên,
Dialogue: 0,0:07:32.31,0:07:37.69,Main,,0,0,0,,điều chúng ta đặc biệt phải chú ý\Nchính là ý đồ ban đầu của nó."
Dialogue: 0,0:07:37.97,0:07:40.98,Main,,0,0,0,,Ông ta nói chí lý thật.
Dialogue: 0,0:07:40.98,0:07:45.78,Main,,0,0,0,,Ai mà ngờ được tôi lại bỏ nghề cảnh sát\Nđi làm thợ săn tiền thưởng chứ?
Dialogue: 0,0:07:46.17,0:07:48.64,Main,,0,0,0,,Đám bạn cũ ai cũng ngạc nhiên,
Dialogue: 0,0:07:48.64,0:07:51.95,Main,,0,0,0,,bảo tôi đúng là\Nchả làm gì như người ta mong đợi.
Dialogue: 0,0:07:51.95,0:07:56.37,Main,,0,0,0,,Nhưng thế cũng tốt. \NTôi muốn làm điều mà chả ai nghĩ tới.
Dialogue: 0,0:07:56.37,0:08:00.13,Main,,0,0,0,,Những thứ chưa từng thấy,\Nnhững chuyện chưa từng nghe.
Dialogue: 0,0:08:00.13,0:08:04.63,Main,,0,0,0,,Còn đám đồng đội hiện giờ\Nthì lại khá khoái chuyện đó.
Dialogue: 0,0:08:08.81,0:08:11.14,Main,,0,0,0,,Tôi ghét mấy lời đẹp đẽ suông.
Dialogue: 0,0:08:11.14,0:08:13.15,Main,,0,0,0,,Cũng ghét cả kiểu ưa sạch sẽ.
Dialogue: 0,0:08:13.76,0:08:18.27,Main,,0,0,0,,Hơi bẩn một chút thì cả căn phòng\N lẫn cuộc đời mới dễ sống hơn chứ.
Dialogue: 0,0:08:19.27,0:08:21.52,Main,,0,0,0,,Người ta bảo\N"nhất trắng che tam xấu",
Dialogue: 0,0:08:21.52,0:08:23.18,Main,,0,0,0,,nhưng tôi cũng ghét giấu giếm.
Dialogue: 0,0:08:23.77,0:08:24.81,Main,,0,0,0,,Vết nám,
Dialogue: 0,0:08:24.81,0:08:26.21,Main,,0,0,0,,tàn nhang,
Dialogue: 0,0:08:26.21,0:08:27.20,Main,,0,0,0,,có sao đâu chứ.
Dialogue: 0,0:08:27.77,0:08:30.40,Main,,0,0,0,,Nếu ai cũng cùng một làn da,\Ncùng một gương mặt,
Dialogue: 0,0:08:30.40,0:08:32.91,Main,,0,0,0,,thì còn biết đâu mới là mình nữa.
Dialogue: 0,0:08:33.87,0:08:36.74,Main,,0,0,0,,Đã thế tôi vốn còn\Nchả biết mình là ai.
Dialogue: 0,0:08:36.74,0:08:39.92,Main,,0,0,0,,Nên không được giấu\Nnhững manh mối đi.
Dialogue: 0,0:08:41.20,0:08:44.80,Main,,0,0,0,,Vì tất cả đều là\Nbiển chỉ đường về chính mình.
Dialogue: 0,0:08:44.80,0:08:47.17,Main,,0,0,0,,Phụ nữ nhìn bề ngoài\Nlàm sao mà đoán được.
Dialogue: 0,0:08:54.93,0:08:56.97,Main,,0,0,0,,Laughing Bull đã nói:
Dialogue: 0,0:08:56.97,0:09:01.14,Main,,0,0,0,,"Hỡi chim bơi, anh có biết\Nthân thể mình làm từ gì không?"
Dialogue: 0,0:09:01.14,0:09:02.35,Main,,0,0,0,,Tôi đáp:
Dialogue: 0,0:09:02.35,0:09:03.78,Main,,0,0,0,,"Ai biết.
Dialogue: 0,0:09:03.78,0:09:07.15,Main,,0,0,0,,Chắc là phân chim\Nvương vãi đâu đó thôi."
Dialogue: 0,0:09:07.15,0:09:08.36,Main,,0,0,0,,Bull nói:
Dialogue: 0,0:09:08.36,0:09:12.78,Main,,0,0,0,,"Hỡi chim bơi, anh có biết\Nlinh hồn mình làm từ gì không?"
Dialogue: 0,0:09:12.78,0:09:14.12,Main,,0,0,0,,Tôi đáp:
Dialogue: 0,0:09:14.12,0:09:15.33,Main,,0,0,0,,"Ai biết.
Dialogue: 0,0:09:15.33,0:09:18.62,Main,,0,0,0,,Chắc là mớ bụi bông\Nvương vãi đâu đó thôi."
Dialogue: 0,0:09:18.62,0:09:20.03,Main,,0,0,0,,Bull nói:
Dialogue: 0,0:09:20.03,0:09:23.04,Main,,0,0,0,,"Câu trả lời đó vừa sai lại vừa đúng.
Dialogue: 0,0:09:23.04,0:09:27.71,Main,,0,0,0,,Thân thể anh gắn liền với cả vũ trụ,\Nvậy mà chỉ có thể là anh.
Dialogue: 0,0:09:28.25,0:09:33.05,Main,,0,0,0,,Linh hồn anh chứa cả vũ trụ,\Nvậy mà chỉ có thể là anh.
Dialogue: 0,0:09:33.05,0:09:36.72,Main,,0,0,0,,Với ta cũng thế, và với bất kỳ ai.
Dialogue: 0,0:09:36.72,0:09:40.56,Main,,0,0,0,,Nếu anh căm ghét ai đó,\Nlà anh đang căm ghét chính mình.
Dialogue: 0,0:09:40.56,0:09:44.40,Main,,0,0,0,,Nếu anh yêu ai đó,\Nlà anh đang yêu chính mình."
Dialogue: 0,0:09:45.06,0:09:46.94,Main,,0,0,0,,Tôi đáp:
Dialogue: 0,0:09:46.94,0:09:49.81,Main,,0,0,0,,"Tôi chả cảm thấy gì với ai cả."
Dialogue: 0,0:09:49.81,0:09:51.45,Main,,0,0,0,,Bull nói:
Dialogue: 0,0:09:51.45,0:09:55.44,Main,,0,0,0,,"Đó là điều bất hạnh nhất\Ntrên thế gian này."
Dialogue: 0,0:10:14.75,0:10:17.01,Main,,0,0,0,,Nghe nói cho em bé ăn toàn đồ ngọt
Dialogue: 0,0:10:17.01,0:10:18.56,Main,,0,0,0,,thì nó sẽ chỉ đòi mỗi thứ đó,
Dialogue: 0,0:10:18.56,0:10:22.06,Main,,0,0,0,,rồi chả chịu ăn những bữa bổ dưỡng\N thật sự cần thiết nữa.
Dialogue: 0,0:10:22.06,0:10:26.02,Main,,0,0,0,,Suy cho cùng, mấy thứ như kẹo đường\N mới thật sự độc hại.
Dialogue: 0,0:10:26.02,0:10:28.57,Main,,0,0,0,,Mà tôi đâu chỉ nói chuyện đồ ăn.
Dialogue: 0,0:10:28.57,0:10:31.11,Main,,0,0,0,,Cuộc đời này toàn kẹo đường cả.
Dialogue: 0,0:10:31.11,0:10:32.85,Main,,0,0,0,,Cứ xem mấy thứ đó suốt
Dialogue: 0,0:10:32.85,0:10:35.28,Main,,0,0,0,,thì não thối ra\Nthành sữa chua mất đấy.
Dialogue: 0,0:10:37.09,0:10:40.20,Main,,0,0,0,,Chà, nấu nướng ấy mà, thâm sâu lắm.
Dialogue: 0,0:10:40.20,0:10:42.83,Main,,0,0,0,,Đâu phải cứ nêm bừa\Nlà xong đâu.
Dialogue: 0,0:10:42.83,0:10:46.00,Main,,0,0,0,,Người đần độn thì\Nnêm nếm vô tội vạ,
Dialogue: 0,0:10:46.00,0:10:49.30,Main,,0,0,0,,làm ra món mà chả phân biệt nổi\N là thịt bò hay thịt gà.
Dialogue: 0,0:10:49.30,0:10:53.38,Main,,0,0,0,,Mấy người như thế\Nthì đừng có cầm chảo.
Dialogue: 0,0:10:53.38,0:10:55.42,Main,,0,0,0,,Cái vị vốn có của nguyên liệu...
Dialogue: 0,0:10:55.42,0:10:56.46,Main,,0,0,0,,Tức là...
Dialogue: 0,0:10:56.46,0:11:00.55,Main,,0,0,0,,là thịt bò thì phải để cái chất\Nriêng của thịt bò tỏa sáng,
Dialogue: 0,0:11:00.55,0:11:03.39,Main,,0,0,0,,không thì thịt bò cũng buồn đấy.
Dialogue: 0,0:11:03.76,0:11:06.14,Main,,0,0,0,,Tay làm hàm nhai,\Ntay quai miệng trễ.
Dialogue: 0,0:11:06.14,0:11:09.02,Main,,0,0,0,,Tự thân vận động kiếm ăn đi.
Dialogue: 0,0:11:09.69,0:11:11.27,Main,,0,0,0,,Tao thì không cần.
Dialogue: 0,0:11:11.27,0:11:13.98,Main,,0,0,0,,Phụ nữ chỉ cần thở thôi\Nlà vĩ đại rồi.
Dialogue: 0,0:11:17.49,0:11:20.91,Main,,0,0,0,,Việc của mình thì tự làm,\Nkhông dựa dẫm vào ai.
Dialogue: 0,0:11:22.08,0:11:24.04,Main,,0,0,0,,Chả biết ai dạy,
Dialogue: 0,0:11:24.04,0:11:27.54,Main,,0,0,0,,mà từ lúc nào chả hay,\Ntôi đã nghĩ như vậy.
Dialogue: 0,0:11:27.54,0:11:29.50,Main,,0,0,0,,Cũng chả phải chuyện gì to tát,
Dialogue: 0,0:11:30.21,0:11:34.42,Main,,0,0,0,,nhưng người ta trông cậy vào mình\N mà không giúp được thì khó chịu lắm,
Dialogue: 0,0:11:34.42,0:11:38.97,Main,,0,0,0,,còn dù có giúp được đi nữa, tôi lại cứ băn khoăn\N liệu làm vậy có thực sự tốt cho họ không.
Dialogue: 0,0:11:39.95,0:11:44.82,Main,,0,0,0,,Rốt cuộc thì,\Nvận may của mình phải tự nắm lấy.
Dialogue: 0,0:11:46.10,0:11:51.02,Main,,0,0,0,,Phụ nữ thì dễ phản bội,\Ncòn đàn ông thì sống chết vì nghĩa khí.
Dialogue: 0,0:11:51.02,0:11:52.07,Main,,0,0,0,,Nghĩa khí ha.
Dialogue: 0,0:11:52.60,0:11:55.03,Main,,0,0,0,,Đó là điều tôi tin tưởng.
Dialogue: 0,0:12:00.11,0:12:02.24,Main,,0,0,0,,Hoài nghi mọi thứ,
Dialogue: 0,0:12:02.24,0:12:03.91,Main,,0,0,0,,đó là điều quan trọng.
Dialogue: 0,0:12:03.91,0:12:06.20,Main,,0,0,0,,Thông tin rốt cuộc cũng chỉ là thông tin.
Dialogue: 0,0:12:06.20,0:12:09.54,Main,,0,0,0,,Tưởng TV nói gì cũng là thật\Nthì sai bét rồi.
Dialogue: 0,0:12:09.54,0:12:13.55,Main,,0,0,0,,Mở to mắt, ngoáy sạch tai,\N để mà nhìn, mà nghe thế giới.
Dialogue: 0,0:12:14.00,0:12:16.99,Main,,0,0,0,,Và dùng chính bộ não mình\Nđể suy nghĩ.
Dialogue: 0,0:12:16.99,0:12:19.64,Main,,0,0,0,,Chính sau khi đã hoài nghi tất cả,
Dialogue: 0,0:12:19.64,0:12:22.47,Main,,0,0,0,,ta mới có thể thật sự\Ntin vào điều gì đó.
Dialogue: 0,0:12:22.47,0:12:23.06,Main,,0,0,0,,Phải.
Dialogue: 0,0:12:23.43,0:12:26.29,Main,,0,0,0,,Hoài nghi tất cả để có thể tin.
Dialogue: 0,0:12:27.27,0:12:29.98,Main,,0,0,0,,Khó gì nữa,
Dialogue: 0,0:12:29.98,0:12:31.48,Main,,0,0,0,,là bất khả thi luôn ấy.
Dialogue: 0,0:12:31.48,0:12:34.85,Main,,0,0,0,,Khác gì đi đánh bóng chày\Nmà không cầm gậy.
Dialogue: 0,0:12:34.85,0:12:36.03,Main,,0,0,0,,Này, Spike.
Dialogue: 0,0:12:36.86,0:12:39.69,Main,,0,0,0,,Tôi lại thích mấy vụ thế này đấy.
Dialogue: 0,0:12:44.41,0:12:46.95,Main,,0,0,0,,Cái hay của nghề săn tiền thưởng
Dialogue: 0,0:12:46.95,0:12:48.80,Main,,0,0,0,,là chả có luật lệ gì cả.
Dialogue: 0,0:12:48.80,0:12:50.54,Main,,0,0,0,,Để bắt kẻ bị treo thưởng,
Dialogue: 0,0:12:50.54,0:12:54.92,Main,,0,0,0,,chả có quy định nào bảo\Nphải làm thế này thế kia.
Dialogue: 0,0:12:54.92,0:12:58.63,Main,,0,0,0,,Nhưng cứ làm theo ý mình\N là y như rằng bị phàn nàn,
Dialogue: 0,0:12:58.63,0:13:01.43,Main,,0,0,0,,hay bị mắng là phạm luật.
Dialogue: 0,0:13:01.43,0:13:06.39,Main,,0,0,0,,Bọn họ cứ tưởng mình đang sống\Ntheo luật lệ của thế giới này,
Dialogue: 0,0:13:06.39,0:13:09.02,Main,,0,0,0,,nhưng luật đó rốt cuộc\Nlà ai đặt ra chứ?
Dialogue: 0,0:13:10.10,0:13:13.77,Main,,0,0,0,,Chúng ta đâu phải sinh ra\Nđể nghe lệnh ai.
Dialogue: 0,0:13:13.77,0:13:17.69,Main,,0,0,0,,Dù bị dọa hay bị dụ dỗ,\Ncũng không bán linh hồn.
Dialogue: 0,0:13:17.69,0:13:22.28,Main,,0,0,0,,Tiếc là linh hồn của kẻ tự do\Nlà đồ cổ.
Dialogue: 0,0:13:22.28,0:13:24.82,Main,,0,0,0,,Hở? Nghĩa là sao?
Dialogue: 0,0:13:24.82,0:13:27.26,Main,,0,0,0,,Đắt giá tới mức tiền bạc không mua nổi.
Dialogue: 0,0:13:28.91,0:13:32.79,Main,,0,0,0,,Bài học, bài học.\NGặp người lạ thì hãy đi theo nhé!
Dialogue: 0,0:13:39.76,0:13:42.84,Main,,0,0,0,,Ed chưa từng phải vất vả bao giờ.
Dialogue: 0,0:13:43.59,0:13:48.85,Main,,0,0,0,,Biết đâu thật ra là có,\Nnhưng hoàn toàn chả nhớ gì.
Dialogue: 0,0:13:49.47,0:13:55.98,Main,,0,0,0,,Tại sao á? Là vì chỉ làm\Nnhững chuyện trông vui vui thôi,
Dialogue: 0,0:13:55.98,0:13:58.23,Main,,0,0,0,,mà kể cả trong những chuyện\Ntrông chán ngắt,
Dialogue: 0,0:13:58.23,0:14:00.20,Main,,0,0,0,,cũng tìm ra một tí ti vui,\Nrồi thấy rần rần.
Dialogue: 0,0:14:00.90,0:14:05.20,Main,,0,0,0,,Nhưng mà nếu vẫn chán thì đi ngủ.
Dialogue: 0,0:14:05.20,0:14:08.66,Main,,0,0,0,,Ngủ rồi thì trong mơ\Nvui lăn lông lốc.
Dialogue: 0,0:14:08.66,0:14:09.58,Main,,0,0,0,,Hết.
Dialogue: 0,0:14:13.25,0:14:15.87,Main,,0,0,0,,Tôi có gồng chỗ nào đâu.
Dialogue: 0,0:14:15.87,0:14:18.88,Main,,0,0,0,,Chỉ lợi dụng chỗ lực thừa của cậu thôi.
Dialogue: 0,0:14:18.88,0:14:21.76,Main,,0,0,0,,Kiểm soát dòng chảy của sức mạnh.
Dialogue: 0,0:14:21.76,0:14:25.18,Main,,0,0,0,,Để làm được thế,\Nphải thả lỏng toàn thân
Dialogue: 0,0:14:25.18,0:14:27.48,Main,,0,0,0,,để ứng biến với mọi đòn...
Dialogue: 0,0:14:27.48,0:14:29.06,Main,,0,0,0,,Đúng vậy.
Dialogue: 0,0:14:29.06,0:14:31.43,Main,,0,0,0,,Tức là trở thành như nước.
Dialogue: 0,0:14:36.00,0:14:38.51,Main,,0,0,0,,Nghe nói Lý Tiểu Long\Ntừng nói thế này:
Dialogue: 0,0:14:38.51,0:14:44.03,Main,,0,0,0,,"Hãy để tâm trí trống rỗng, bỏ đi \Nmọi hình thái, mọi khuôn khổ, hãy như nước.
Dialogue: 0,0:14:44.03,0:14:46.87,Main,,0,0,0,,Rót nước vào cốc,\Nnước sẽ thành cái cốc.
Dialogue: 0,0:14:47.37,0:14:50.58,Main,,0,0,0,,Rót nước vào ấm trà,\Nnước sẽ thành ấm trà.
Dialogue: 0,0:14:51.29,0:14:55.54,Main,,0,0,0,,Nước có thể chảy trôi,\Ncũng có thể va đập dữ dội.
Dialogue: 0,0:14:55.54,0:14:59.50,Main,,0,0,0,,Thế nên, bạn tôi ơi, hãy như nước."
Dialogue: 0,0:15:01.21,0:15:04.59,Main,,0,0,0,,Thầy trong lòng tôi có khác,\Nnói câu nào ra câu nấy.
Dialogue: 0,0:15:04.59,0:15:05.76,Main,,0,0,0,,Ông ấy còn nói thế này:
Dialogue: 0,0:15:06.93,0:15:09.95,Main,,0,0,0,,"Thứ tôi dạy không phải là\Nthuật phòng thân,
Dialogue: 0,0:15:09.95,0:15:13.18,Main,,0,0,0,,hay cách hạ đối thủ,\Nhay những thứ đại loại thế,
Dialogue: 0,0:15:13.18,0:15:18.52,Main,,0,0,0,,mà là làm sao thể hiện bản thân\Nthông qua chuyển động.
Dialogue: 0,0:15:18.99,0:15:22.91,Main,,0,0,0,,Dù đó là cơn giận, là quyết tâm,\Nhay bất cứ thứ gì.
Dialogue: 0,0:15:22.91,0:15:28.45,Main,,0,0,0,,Nói cách khác, là cách biểu đạt \Ncơ thể con người thông qua võ thuật."
Dialogue: 0,0:15:29.49,0:15:35.12,Main,,0,0,0,,Đủ thấy Lý Tiểu Long đâu chỉ là một \Nngôi sao điện ảnh hay một võ sĩ bình thường.
Dialogue: 0,0:15:35.73,0:15:37.25,Main,,0,0,0,,Xích dài ghê nhỉ.
Dialogue: 0,0:15:37.50,0:15:39.21,Main,,0,0,0,,Mẫu "Mãnh long quá giang" à?
Dialogue: 0,0:15:39.50,0:15:40.79,Main,,0,0,0,,Ồ, anh biết à?
Dialogue: 0,0:15:45.21,0:15:50.18,Main,,0,0,0,,Nếu trên đời này có Thượng Đế,\Ntôi muốn cầu xin một điều.
Dialogue: 0,0:15:50.18,0:15:55.60,Main,,0,0,0,,Xin hãy giáng thiên phạt\Nxuống những kẻ bóp nghẹt tự do.
Dialogue: 0,0:16:00.16,0:16:01.55,Main,,0,0,0,,Đôi khi tôi nghĩ,
Dialogue: 0,0:16:01.55,0:16:03.75,Main,,0,0,0,,tính mình đúng là thiệt thòi.
Dialogue: 0,0:16:03.75,0:16:05.72,Main,,0,0,0,,Lắm lúc tôi lại nghĩ,
Dialogue: 0,0:16:05.72,0:16:08.32,Main,,0,0,0,,cứ thế này thì\Nđàn ông tốt chạy mất dép.
Dialogue: 0,0:16:09.13,0:16:14.00,Main,,0,0,0,,Nhưng mà, tôi là thế\Nthì biết làm sao được.
Dialogue: 0,0:16:14.00,0:16:16.00,Main,,0,0,0,,Giả vờ làm người khác, kiểu
Dialogue: 0,0:16:16.00,0:16:18.96,Main,,0,0,0,,"Trông thế này thôi chứ\Nem đảm việc nhà lắm đấy~",
Dialogue: 0,0:16:18.96,0:16:22.29,Main,,0,0,0,,nói mấy câu đại loại thế,\Ndù có êm xuôi được một thời gian,
Dialogue: 0,0:16:22.29,0:16:24.76,Main,,0,0,0,,thì về sau chỉ khổ... à nhầm, nói lại,
Dialogue: 0,0:16:24.76,0:16:27.25,Main,,0,0,0,,chỉ có hối hận thôi.
Dialogue: 0,0:16:27.25,0:16:32.22,Main,,0,0,0,,Phải là người thích tôi\Nđúng như con người tôi mới chịu.
Dialogue: 0,0:16:32.22,0:16:35.81,Main,,0,0,0,,Mà, chiều được tôi\Nchắc cũng vất vả lắm đây,
Dialogue: 0,0:16:35.81,0:16:40.44,Main,,0,0,0,,nhưng đâu đó trong vũ trụ\Nchắc cũng có gã xui xẻo như thế.
Dialogue: 0,0:16:40.44,0:16:44.28,Main,,0,0,0,,Chà~ Thổi blues-harp hay quá!\NHay quá thể đáng!
Dialogue: 0,0:16:44.56,0:16:46.74,Main,,0,0,0,,Tôi tưởng anh mê jazz?
Dialogue: 0,0:16:47.07,0:16:48.61,Main,,0,0,0,,Vớ vẩn.
Dialogue: 0,0:16:48.61,0:16:53.28,Main,,0,0,0,,Tôi thậm chí còn bú ra nhạc\Nlúc bú tí mẹ đó.
Dialogue: 0,0:16:53.28,0:16:55.20,Main,,0,0,0,,Còn bé mà khéo quá nhề.
Dialogue: 0,0:17:00.25,0:17:05.42,Main,,0,0,0,,Hơn một thế kỷ trước,\Ncó một tay thổi sax tên Charlie Parker.
Dialogue: 0,0:17:05.79,0:17:10.34,Main,,0,0,0,,Nghe đâu hắn là người đầu tiên\Nchơi nhạc không đúng theo bản nhạc.
Dialogue: 0,0:17:10.34,0:17:11.34,Main,,0,0,0,,Nghĩa là,
Dialogue: 0,0:17:11.34,0:17:13.81,Main,,0,0,0,,chỉ chơi theo khuôn thôi thì chưa đủ,
Dialogue: 0,0:17:14.21,0:17:18.69,Main,,0,0,0,,nên hắn ngẫu hứng,\Nthổi theo phong cách của riêng mình.
Dialogue: 0,0:17:19.22,0:17:24.13,Main,,0,0,0,,Thứ âm nhạc hắn khởi xướng\Nvề sau được gọi là bebop.
Dialogue: 0,0:17:24.13,0:17:26.15,Main,,0,0,0,,Phải. Đó là...
Dialogue: 0,0:17:26.15,0:17:29.73,Main,,0,0,0,,nguồn gốc tên con tàu này đấy.
Dialogue: 0,0:17:35.78,0:17:41.45,Main,,0,0,0,,Chúng ta ai cũng vừa ngủ vừa thức,\Nvừa thức vừa ngủ.
Dialogue: 0,0:17:41.45,0:17:42.67,Main,,0,0,0,,Quá khứ là sự thật ư?
Dialogue: 0,0:17:43.52,0:17:44.67,Main,,0,0,0,,Ký ức là chân thực ư?
Dialogue: 0,0:17:46.21,0:17:49.88,Main,,0,0,0,,Giấc mơ... \Ntính từ ranh giới nào mới gọi là mơ?
Dialogue: 0,0:17:49.88,0:17:52.89,Main,,0,0,0,,Giấc mơ khi ngủ,\Ngiấc mơ khi thức.
Dialogue: 0,0:17:53.90,0:17:55.56,Main,,0,0,0,,Cả hai đều như nhau.
Dialogue: 0,0:17:56.43,0:17:59.68,Main,,0,0,0,,Kẻ nói mình không nằm mơ\Nchỉ là không nhớ thôi.
Dialogue: 0,0:17:59.68,0:18:03.40,Main,,0,0,0,,Kẻ nói mình không có ước mơ\Ncũng chỉ là chưa nhận ra.
Dialogue: 0,0:18:03.40,0:18:04.23,Main,,0,0,0,,Họ hèn nhát thôi.
Dialogue: 0,0:18:05.09,0:18:09.40,Main,,0,0,0,,Muốn thấy lắm,\Nnhưng lại cố tình không nhìn.
Dialogue: 0,0:18:10.26,0:18:12.95,Main,,0,0,0,,Và đây chỉ là ảo ảnh.
Dialogue: 0,0:18:13.59,0:18:15.52,Main,,0,0,0,,Bị một bàn tay vô hình thao túng,
Dialogue: 0,0:18:15.52,0:18:18.99,Main,,0,0,0,,sự thật vẫn bị phủ\Ndưới tấm màn dày.
Dialogue: 0,0:18:18.99,0:18:25.04,Main,,0,0,0,,Nhưng nó vẫn lặng lẽ tồn tại,\Nâm thầm như mặt trăng của Titan,
Dialogue: 0,0:18:25.04,0:18:29.83,Main,,0,0,0,,rồi một ngày, khi bão cát qua đi,\Nnó sẽ hiện ra.
Dialogue: 0,0:18:30.84,0:18:32.40,Main,,0,0,0,,Vậy nên...
Dialogue: 0,0:18:32.40,0:18:36.53,Main,,0,0,0,,thôi thì đừng chấp nhặt\Nmấy trò giải trí cỏn con nữa.
Dialogue: 0,0:18:36.53,0:18:40.38,Main,,0,0,0,,Đây không phải trò đùa.\NCũng chẳng phải hư cấu.
Dialogue: 0,0:18:40.38,0:18:44.68,Main,,0,0,0,,Hay là... tôi chỉ đang mơ\Nmột giấc mơ xấu?
Dialogue: 0,0:18:48.87,0:18:50.89,Main,,0,0,0,,Nghe đâu một tay chơi blues nào đó
Dialogue: 0,0:18:50.89,0:18:54.32,Main,,0,0,0,,khi được hỏi blues là gì\Nđã đáp thế này:
Dialogue: 0,0:18:54.32,0:18:56.01,Main,,0,0,0,,"Blues ấy mà...
Dialogue: 0,0:18:56.01,0:18:59.19,Main,,0,0,0,,là những rắc rối \Nchẳng biết phải xoay xở làm sao."
