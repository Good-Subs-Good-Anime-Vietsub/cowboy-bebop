Dialogue: 0,0:00:02.17,0:00:09.18,Default,,0,0,0,,（教会の鐘の音）
Dialogue: 0,0:00:49.22,0:00:55.64,Default,,0,0,0,,♪～
Dialogue: 0,0:02:11.71,0:02:18.78,Default,,0,0,0,,～♪
Dialogue: 0,0:03:09.15,0:03:10.28,Default,,0,0,0,,（ジェット）おい スパイク
Dialogue: 0,0:03:10.40,0:03:11.65,Default,,0,0,0,,（スイッチを押す音）
Dialogue: 0,0:03:12.61,0:03:14.03,Default,,0,0,0,,（ジェット）あがったぞ
Dialogue: 0,0:03:14.15,0:03:15.53,Default,,0,0,0,,（スパイク）こっちもあがりだ
Dialogue: 0,0:03:15.66,0:03:16.49,Default,,0,0,0,,メニューは？
Dialogue: 0,0:03:16.87,0:03:18.87,Default,,0,0,0,,特製チンジャオロース
Dialogue: 0,0:03:27.79,0:03:29.55,Default,,0,0,0,,（ジェット）\Nアシモフ･ソーレンサン
Dialogue: 0,0:03:29.67,0:03:31.38,Default,,0,0,0,,こいつが次の賞金首だ
Dialogue: 0,0:03:32.84,0:03:33.84,Default,,0,0,0,,ジェットさんよ
Dialogue: 0,0:03:34.05,0:03:37.59,Default,,0,0,0,,アステロイド一帯を仕切る\N組織の幹部なんだがな
Dialogue: 0,0:03:37.72,0:03:39.89,Default,,0,0,0,,（スパイク）\Nチンジャオロースっつったよな
Dialogue: 0,0:03:40.01,0:03:42.98,Default,,0,0,0,,アシモフ･ソーレンサンだよ\N何 聞いてんだ
Dialogue: 0,0:03:43.48,0:03:45.69,Default,,0,0,0,,（スパイク）肉のない\Nチンジャオロースなんてのは―
Dialogue: 0,0:03:46.19,0:03:49.02,Default,,0,0,0,,チンジャオロースとは\N言わねんじゃねえのかな
Dialogue: 0,0:03:50.23,0:03:51.65,Default,,0,0,0,,いや 言うね
Dialogue: 0,0:03:52.11,0:03:53.40,Default,,0,0,0,,言わねえよ
Dialogue: 0,0:03:53.53,0:03:55.78,Default,,0,0,0,,金がないときは言うんだよ
Dialogue: 0,0:03:55.90,0:03:58.99,Default,,0,0,0,,この間の賞金 100万ウーロンは\Nどこいったんだよ
Dialogue: 0,0:03:59.53,0:04:01.70,Default,,0,0,0,,お前が壊した機体の修理と―
Dialogue: 0,0:04:02.29,0:04:04.75,Default,,0,0,0,,お前が壊した店の修理と―
Dialogue: 0,0:04:04.87,0:04:07.29,Default,,0,0,0,,お前が\Nケガさせた警官の治療費で―
Dialogue: 0,0:04:07.46,0:04:08.29,Default,,0,0,0,,パーだ！
Dialogue: 0,0:04:11.25,0:04:13.38,Default,,0,0,0,,３日前 こいつの組織と―
Dialogue: 0,0:04:13.51,0:04:15.88,Default,,0,0,0,,敵対する組織との\N抗争があったんだが―
Dialogue: 0,0:04:16.68,0:04:19.22,Default,,0,0,0,,こいつは仲間を殺して\Nとんずらしやがった
Dialogue: 0,0:04:19.76,0:04:23.06,Default,,0,0,0,,やつはティワナの女の所に\N逃げ込んだらしい
Dialogue: 0,0:04:23.35,0:04:25.73,Default,,0,0,0,,（スパイク）\Nあんな所 雑魚の行く所だよ
Dialogue: 0,0:04:25.85,0:04:28.94,Default,,0,0,0,,雑魚の割に賞金は250万だ
Dialogue: 0,0:04:29.06,0:04:30.61,Default,,0,0,0,,（スパイク）乗らねえな
Dialogue: 0,0:04:30.73,0:04:33.03,Default,,0,0,0,,ティワナか　あそこの牛は―
Dialogue: 0,0:04:33.40,0:04:35.15,Default,,0,0,0,,うまいわな
Dialogue: 0,0:04:36.74,0:04:41.78,Default,,0,0,0,,（ゲートアナウンスの声）
Dialogue: 0,0:04:42.91,0:04:47.08,Default,,0,0,0,,（ゲートアナウンスの声）
Dialogue: 0,0:04:49.04,0:04:52.09,Default,,0,0,0,,（ゲートアナウンス）\N間もなくゲートに到着いたします
Dialogue: 0,0:04:52.25,0:04:54.92,Default,,0,0,0,,またのご利用を\Nお待ちしております
Dialogue: 0,0:04:55.30,0:04:59.84,Default,,0,0,0,,ゲートを通過しましたら\N料金所に１列でお並びください
Dialogue: 0,0:05:00.30,0:05:01.76,Default,,0,0,0,,クレジットセンサーを―
Dialogue: 0,0:05:01.89,0:05:04.43,Default,,0,0,0,,引き落としモードにして\N通過してください
Dialogue: 0,0:05:15.23,0:05:17.61,Default,,0,0,0,,（口笛）
Dialogue: 0,0:05:17.74,0:05:20.86,Default,,0,0,0,,（ジェット）とりあえず こっちは\N警察筋にあたってから行く
Dialogue: 0,0:05:20.99,0:05:21.91,Default,,0,0,0,,（スパイク）じゃあこっちは
Dialogue: 0,0:05:22.32,0:05:24.58,Default,,0,0,0,,ブルのおっさん所でも\N行ってみるわ
Dialogue: 0,0:05:24.91,0:05:27.16,Default,,0,0,0,,（ジェット）\N当てになんのかねえ あのおやじ
Dialogue: 0,0:05:27.29,0:05:30.71,Default,,0,0,0,,（スパイクの口笛）
Dialogue: 0,0:05:31.29,0:05:36.96,Default,,0,0,0,,（口笛）
Dialogue: 0,0:05:37.34,0:05:43.47,Default,,0,0,0,,（口笛）
Dialogue: 0,0:05:44.14,0:05:50.14,Default,,0,0,0,,（口笛）
Dialogue: 0,0:05:50.27,0:05:56.07,Default,,0,0,0,,（口笛）
Dialogue: 0,0:05:56.40,0:05:58.07,Default,,0,0,0,,のんきな曲だぜ
Dialogue: 0,0:06:20.47,0:06:21.72,Default,,0,0,0,,（男性）泥棒！
Dialogue: 0,0:06:31.89,0:06:34.77,Default,,0,0,0,,（アントニオ）\Nまただ 畜生 この野郎
Dialogue: 0,0:06:34.90,0:06:37.86,Default,,0,0,0,,お前らそうやって俺のこと\Nカモにしてっけどな
Dialogue: 0,0:06:38.03,0:06:40.40,Default,,0,0,0,,今 こうやって\Nここに住んでられるってのも―
Dialogue: 0,0:06:40.53,0:06:44.36,Default,,0,0,0,,俺が一生懸命\Nゲート 掘ったおかげなんだぞ
Dialogue: 0,0:06:44.49,0:06:47.45,Default,,0,0,0,,（カルロス）\Nおめえは負けると いっつもそれだ
Dialogue: 0,0:06:47.70,0:06:50.62,Default,,0,0,0,,ゲートは俺たち みんなで\N掘ったんだろう
Dialogue: 0,0:06:51.00,0:06:54.63,Default,,0,0,0,,（ジョビン）掘ったな\N死に物狂いで掘ったな
Dialogue: 0,0:06:54.75,0:06:55.88,Default,,0,0,0,,ばか野郎 この野郎　うん？
Dialogue: 0,0:06:55.88,0:06:57.17,Default,,0,0,0,,（ドアが開く音）\Nばか野郎 この野郎　うん？
Dialogue: 0,0:07:04.68,0:07:05.93,Default,,0,0,0,,（ドアが閉まる音）
Dialogue: 0,0:07:11.56,0:07:12.89,Default,,0,0,0,,（アシモフ）ビールをくれ
Dialogue: 0,0:07:13.02,0:07:15.65,Default,,0,0,0,,（カテリーナ）\N私はブラッディマリーを\Nひと吹きお願い
Dialogue: 0,0:07:18.82,0:07:22.11,Default,,0,0,0,,ウオッカはあるが あいにく\Nトマトジュースを切らしててね
Dialogue: 0,0:07:22.90,0:07:26.07,Default,,0,0,0,,奥に１缶くらい\Nあるんじゃないか？
Dialogue: 0,0:07:27.53,0:07:29.08,Default,,0,0,0,,見てみよう
Dialogue: 0,0:07:39.88,0:07:41.96,Default,,0,0,0,,レッド･アイの最上級品だ
Dialogue: 0,0:07:42.09,0:07:43.42,Default,,0,0,0,,売人なら分かるだろ
Dialogue: 0,0:07:43.84,0:07:46.64,Default,,0,0,0,,まさか… ブラッディ･アイ！
Dialogue: 0,0:07:51.26,0:07:52.93,Default,,0,0,0,,（３人）おお
Dialogue: 0,0:07:55.10,0:07:57.90,Default,,0,0,0,,本物かどうか 見せてもらおうか
Dialogue: 0,0:08:06.78,0:08:11.70,Default,,0,0,0,,（心臓の鼓動）
Dialogue: 0,0:08:11.83,0:08:13.58,Default,,0,0,0,,（アシモフ）ううう…！
Dialogue: 0,0:08:22.63,0:08:25.05,Default,,0,0,0,,よーく見ておくんだな
Dialogue: 0,0:08:27.59,0:08:29.01,Default,,0,0,0,,うおっ…
Dialogue: 0,0:08:31.22,0:08:32.18,Default,,0,0,0,,いやー
Dialogue: 0,0:08:43.48,0:08:44.57,Default,,0,0,0,,（アシモフ）ふっ！
Dialogue: 0,0:08:48.24,0:08:49.74,Default,,0,0,0,,うはあ… うお…
Dialogue: 0,0:08:58.87,0:08:59.96,Default,,0,0,0,,うわっ
Dialogue: 0,0:09:11.39,0:09:12.72,Default,,0,0,0,,（殴る音）
Dialogue: 0,0:09:17.64,0:09:18.85,Default,,0,0,0,,（倒れる音）
Dialogue: 0,0:09:30.20,0:09:33.33,Default,,0,0,0,,これもいいけど\Nなんか食いもんねえの？
Dialogue: 0,0:09:34.20,0:09:35.70,Default,,0,0,0,,（スパイクの腹が鳴る音）
Dialogue: 0,0:09:36.62,0:09:39.12,Default,,0,0,0,,はあー あっそ
Dialogue: 0,0:09:42.33,0:09:46.76,Default,,0,0,0,,（ブル）北の街はずれに\N赤い目のコヨーテは現れる
Dialogue: 0,0:09:46.88,0:09:48.59,Default,,0,0,0,,そう出ている
Dialogue: 0,0:09:48.97,0:09:50.88,Default,,0,0,0,,（スパイク）赤い目のコヨーテね
Dialogue: 0,0:09:51.01,0:09:53.26,Default,,0,0,0,,（ブル）泳ぐ鳥よ\N（スパイク）うん？
Dialogue: 0,0:09:53.68,0:09:55.89,Default,,0,0,0,,お前は女に出会う
Dialogue: 0,0:09:56.01,0:09:58.73,Default,,0,0,0,,お前は女に狙われる
Dialogue: 0,0:09:58.89,0:09:59.68,Default,,0,0,0,,そして―
Dialogue: 0,0:10:00.19,0:10:01.23,Default,,0,0,0,,死ぬ
Dialogue: 0,0:10:02.31,0:10:03.65,Default,,0,0,0,,またかよ
Dialogue: 0,0:10:04.02,0:10:05.19,Default,,0,0,0,,また？
Dialogue: 0,0:10:05.32,0:10:07.53,Default,,0,0,0,,（スパイク）\N俺は１回 死んでるんだよ
Dialogue: 0,0:10:07.82,0:10:09.44,Default,,0,0,0,,女に殺されてね
Dialogue: 0,0:10:09.61,0:10:12.11,Default,,0,0,0,,（ブル）\Nお前は女を甘く見ておる
Dialogue: 0,0:10:12.74,0:10:14.12,Default,,0,0,0,,（スパイク）お邪魔さん
Dialogue: 0,0:10:16.66,0:10:19.04,Default,,0,0,0,,ワカン･タンカの恵みあれ
Dialogue: 0,0:10:19.29,0:10:20.41,Default,,0,0,0,,ふう
Dialogue: 0,0:10:26.88,0:10:28.05,Default,,0,0,0,,（ドアが閉まる音）
Dialogue: 0,0:10:31.09,0:10:32.80,Default,,0,0,0,,（ジェット）プレシデンテか
Dialogue: 0,0:10:33.30,0:10:35.14,Default,,0,0,0,,一杯おごってもらうぜ
Dialogue: 0,0:10:35.30,0:10:36.68,Default,,0,0,0,,（車がとまる音）
Dialogue: 0,0:10:36.81,0:10:37.60,Default,,0,0,0,,うん？
Dialogue: 0,0:10:41.02,0:10:44.15,Default,,0,0,0,,（ギャングＡ）\Nったく アシモフの野郎\Nキレまくってんぜ
Dialogue: 0,0:10:44.27,0:10:45.65,Default,,0,0,0,,（ギャングＢ）やっべえな
Dialogue: 0,0:10:45.77,0:10:48.11,Default,,0,0,0,,サツが動き出す前に\N何とかしねえと
Dialogue: 0,0:10:48.36,0:10:50.36,Default,,0,0,0,,（ギャングＡ）\Nいっそサツに任せるか？
Dialogue: 0,0:10:50.53,0:10:52.45,Default,,0,0,0,,やつは例の目薬 使ってんだ
Dialogue: 0,0:10:53.03,0:10:53.91,Default,,0,0,0,,かなわねえ
Dialogue: 0,0:10:54.03,0:10:56.91,Default,,0,0,0,,だから そのブラッディ･アイを\N取り返さねえと―
Dialogue: 0,0:10:57.03,0:10:58.62,Default,,0,0,0,,話になんねんだろうが
Dialogue: 0,0:10:58.74,0:10:59.79,Default,,0,0,0,,だってよお
Dialogue: 0,0:11:00.50,0:11:01.33,Default,,0,0,0,,（ジェット）よう
Dialogue: 0,0:11:01.45,0:11:02.12,Default,,0,0,0,,ああ？
Dialogue: 0,0:11:02.25,0:11:02.83,Default,,0,0,0,,うおっ
Dialogue: 0,0:11:03.04,0:11:03.79,Default,,0,0,0,,なっ
Dialogue: 0,0:11:03.96,0:11:05.04,Default,,0,0,0,,ああっ くっ
Dialogue: 0,0:11:05.17,0:11:07.59,Default,,0,0,0,,詳しく聞きたいねえ
Dialogue: 0,0:11:16.14,0:11:17.80,Default,,0,0,0,,腹減ったなあ
Dialogue: 0,0:11:17.93,0:11:19.22,Default,,0,0,0,,（電子音）\N（スパイク）うん？
Dialogue: 0,0:11:20.89,0:11:22.39,Default,,0,0,0,,（スパイク）お前もかよ
Dialogue: 0,0:11:25.90,0:11:31.94,Default,,0,0,0,,（スパイクの口笛）
Dialogue: 0,0:11:32.07,0:11:34.07,Default,,0,0,0,,（足音）
Dialogue: 0,0:11:38.70,0:11:42.37,Default,,0,0,0,,（荒い息）
Dialogue: 0,0:11:51.30,0:11:52.92,Default,,0,0,0,,（ドアが開く音）
Dialogue: 0,0:12:00.39,0:12:02.10,Default,,0,0,0,,（手を洗う音）
Dialogue: 0,0:12:02.81,0:12:05.06,Default,,0,0,0,,水 流したほうがいいっすよ
Dialogue: 0,0:12:05.81,0:12:07.27,Default,,0,0,0,,（水道の蛇口を閉める音）
Dialogue: 0,0:12:08.94,0:12:10.32,Default,,0,0,0,,（スパイク）詰まるから
Dialogue: 0,0:12:11.23,0:12:16.99,Default,,0,0,0,,（口笛）
Dialogue: 0,0:12:17.49,0:12:18.53,Default,,0,0,0,,はあ
Dialogue: 0,0:12:18.66,0:12:24.20,Default,,0,0,0,,（スパイクの口笛）
Dialogue: 0,0:12:28.58,0:12:29.96,Default,,0,0,0,,（カテリーナ）あっ\N（スパイク）うわ
Dialogue: 0,0:12:30.09,0:12:30.71,Default,,0,0,0,,（スパイク）おっと
Dialogue: 0,0:12:30.84,0:12:32.80,Default,,0,0,0,,（カテリーナ）\Nあっ ごめんなさい
Dialogue: 0,0:12:37.30,0:12:38.39,Default,,0,0,0,,ありがとう
Dialogue: 0,0:12:38.51,0:12:39.14,Default,,0,0,0,,あら？
Dialogue: 0,0:12:39.76,0:12:40.85,Default,,0,0,0,,あの…
Dialogue: 0,0:12:41.30,0:12:42.22,Default,,0,0,0,,ん？
Dialogue: 0,0:12:46.35,0:12:47.56,Default,,0,0,0,,すいません
Dialogue: 0,0:12:47.85,0:12:50.69,Default,,0,0,0,,嫌！ もういらない あげるわよ
Dialogue: 0,0:12:51.82,0:12:53.15,Default,,0,0,0,,ラッキー
Dialogue: 0,0:12:57.07,0:12:58.11,Default,,0,0,0,,フッ
Dialogue: 0,0:12:59.61,0:13:01.49,Default,,0,0,0,,（スパイク）\Nハハ いやあ 失敬失敬
Dialogue: 0,0:13:01.62,0:13:03.37,Default,,0,0,0,,おなかと背中が\Nくっつきそうだったもんで
Dialogue: 0,0:13:03.49,0:13:05.95,Default,,0,0,0,,（カテリーナ）まあ　アッハハハ\N（スパイク）ハハハハ
Dialogue: 0,0:13:10.46,0:13:11.67,Default,,0,0,0,,（カテリーナ）いい機体ね
Dialogue: 0,0:13:11.79,0:13:13.13,Default,,0,0,0,,（スパイク）古い型さ
Dialogue: 0,0:13:13.25,0:13:14.80,Default,,0,0,0,,10年来の相棒だ
Dialogue: 0,0:13:15.09,0:13:16.88,Default,,0,0,0,,随分 ムチャやってるみたい
Dialogue: 0,0:13:17.55,0:13:19.59,Default,,0,0,0,,あちこち旅してるからなあ
Dialogue: 0,0:13:20.39,0:13:22.47,Default,,0,0,0,,本当は旅芸人なんだ
Dialogue: 0,0:13:23.18,0:13:26.93,Default,,0,0,0,,フフッ　冗談か本気か\N分からない人ね
Dialogue: 0,0:13:27.56,0:13:28.98,Default,,0,0,0,,よく言われるよ
Dialogue: 0,0:13:29.89,0:13:31.31,Default,,0,0,0,,（カテリーナ）火星にも行った？
Dialogue: 0,0:13:31.48,0:13:32.77,Default,,0,0,0,,（スパイク）火星生まれだ
Dialogue: 0,0:13:33.40,0:13:35.57,Default,,0,0,0,,（カテリーナ）\Nあそこは何でもあるんでしょう
Dialogue: 0,0:13:35.86,0:13:37.36,Default,,0,0,0,,こんな所と違って―
Dialogue: 0,0:13:37.53,0:13:40.45,Default,,0,0,0,,いろんな人がいて\Nいろんな物があって―
Dialogue: 0,0:13:40.57,0:13:42.82,Default,,0,0,0,,幸せに暮らしてるって
Dialogue: 0,0:13:43.45,0:13:45.20,Default,,0,0,0,,（スパイク）\N金があるやつだけさ
Dialogue: 0,0:13:45.95,0:13:48.66,Default,,0,0,0,,じゃあ きっと幸せになれるわ
Dialogue: 0,0:13:55.05,0:13:56.42,Default,,0,0,0,,（スパイク）\N火星へ逃げるつもりか？
Dialogue: 0,0:13:56.55,0:13:57.26,Default,,0,0,0,,えっ
Dialogue: 0,0:13:57.46,0:14:00.63,Default,,0,0,0,,（スパイク）逃げ回っても\Nどこまで行けるかな
Dialogue: 0,0:14:00.76,0:14:01.84,Default,,0,0,0,,（カテリーナ）誰なの？
Dialogue: 0,0:14:02.39,0:14:04.47,Default,,0,0,0,,時代遅れのカウボーイさ
Dialogue: 0,0:14:05.39,0:14:06.68,Default,,0,0,0,,賞金稼ぎね
Dialogue: 0,0:14:07.27,0:14:08.31,Default,,0,0,0,,ご名答
Dialogue: 0,0:14:09.23,0:14:10.73,Default,,0,0,0,,捕まえないの？
Dialogue: 0,0:14:11.31,0:14:13.90,Default,,0,0,0,,（スパイク）あんたの連れは\N体を かなりやられてる
Dialogue: 0,0:14:14.02,0:14:16.48,Default,,0,0,0,,弱ってる雑魚は相手にしないんだ
Dialogue: 0,0:14:17.44,0:14:18.82,Default,,0,0,0,,（カテリーナ）それが利口だわ
Dialogue: 0,0:14:19.03,0:14:19.69,Default,,0,0,0,,うおっ
Dialogue: 0,0:14:21.61,0:14:22.82,Default,,0,0,0,,雑魚はお前だ
Dialogue: 0,0:14:23.03,0:14:24.82,Default,,0,0,0,,あああーっ
Dialogue: 0,0:14:25.78,0:14:26.58,Default,,0,0,0,,（アシモフ）うーん ああ
Dialogue: 0,0:14:26.83,0:14:28.29,Default,,0,0,0,,ああっ
Dialogue: 0,0:14:29.66,0:14:31.25,Default,,0,0,0,,アシモフ もう十分よ
Dialogue: 0,0:14:34.67,0:14:36.13,Default,,0,0,0,,（スパイク）うっ ああ…
Dialogue: 0,0:14:37.50,0:14:38.71,Default,,0,0,0,,（車のドアが開く音）
Dialogue: 0,0:14:43.39,0:14:45.22,Default,,0,0,0,,アディオス カウボーイ
Dialogue: 0,0:14:58.48,0:14:59.69,Default,,0,0,0,,（アシモフ）なぜ止めた？
Dialogue: 0,0:14:59.82,0:15:00.53,Default,,0,0,0,,（カテリーナ）えっ？
Dialogue: 0,0:15:01.03,0:15:04.61,Default,,0,0,0,,あいつの息を止めるなんざ\N１秒でできた
Dialogue: 0,0:15:04.74,0:15:06.20,Default,,0,0,0,,（カテリーナ）あんた疲れてるわ
Dialogue: 0,0:15:06.49,0:15:07.33,Default,,0,0,0,,これ以上…
Dialogue: 0,0:15:07.45,0:15:09.49,Default,,0,0,0,,（アシモフ）\N若くて いい男だったな
Dialogue: 0,0:15:12.29,0:15:16.38,Default,,0,0,0,,私 あんたが迎えに来てくれるの\Nずっと待ってた
Dialogue: 0,0:15:17.21,0:15:20.05,Default,,0,0,0,,やっと ここの暮らしから\N抜け出せるんじゃない
Dialogue: 0,0:15:21.63,0:15:23.88,Default,,0,0,0,,火星で幸せに暮らせるのよ
Dialogue: 0,0:15:30.22,0:15:34.64,Default,,0,0,0,,（足音）
Dialogue: 0,0:15:36.56,0:15:38.48,Default,,0,0,0,,昼寝とは優雅だな
Dialogue: 0,0:15:38.90,0:15:40.11,Default,,0,0,0,,いい夢見たぜ
Dialogue: 0,0:15:40.36,0:15:42.15,Default,,0,0,0,,（ジェット）ああ それは結構
Dialogue: 0,0:15:42.28,0:15:45.95,Default,,0,0,0,,じゃあ その続きでも\Nビバップに戻ってゆっくり見てくれ
Dialogue: 0,0:15:46.07,0:15:47.95,Default,,0,0,0,,今回は俺も諦めた
Dialogue: 0,0:15:48.12,0:15:50.08,Default,,0,0,0,,やつを捕まえるのは無理だ
Dialogue: 0,0:15:50.54,0:15:52.50,Default,,0,0,0,,かなうわけないわな
Dialogue: 0,0:15:52.62,0:15:56.33,Default,,0,0,0,,アシモフは組織を逃げ出すときに\Nある物を持ち出したんだ
Dialogue: 0,0:15:56.75,0:15:58.46,Default,,0,0,0,,組織の資金源となってた―
Dialogue: 0,0:15:58.59,0:16:02.05,Default,,0,0,0,,非合法目薬ん中でも\N飛び切りの上物だ
Dialogue: 0,0:16:02.17,0:16:06.51,Default,,0,0,0,,そいつを全部 持って\N逃げたもんだから 連中は大騒ぎよ
Dialogue: 0,0:16:06.63,0:16:09.39,Default,,0,0,0,,捕まえようにも\N死人ばっか増えちまう
Dialogue: 0,0:16:09.76,0:16:13.73,Default,,0,0,0,,アシモフは使ってるからよ\Nその目薬
Dialogue: 0,0:16:13.85,0:16:15.23,Default,,0,0,0,,ブラッディ･アイをな
Dialogue: 0,0:16:15.56,0:16:17.73,Default,,0,0,0,,やつらは火星に行くつもりだぜ
Dialogue: 0,0:16:17.85,0:16:18.81,Default,,0,0,0,,（ジェット）火星？
Dialogue: 0,0:16:18.94,0:16:20.94,Default,,0,0,0,,その前に こいつを売りさばく
Dialogue: 0,0:16:21.57,0:16:23.03,Default,,0,0,0,,（ジェット）うん？ それは…
Dialogue: 0,0:16:23.15,0:16:25.28,Default,,0,0,0,,（スパイク）\Nやつの懐から頂戴した
Dialogue: 0,0:16:25.40,0:16:27.53,Default,,0,0,0,,（ジェット）お前 会ったのか
Dialogue: 0,0:16:27.86,0:16:29.20,Default,,0,0,0,,悪い夢さ
Dialogue: 0,0:16:29.53,0:16:31.70,Default,,0,0,0,,ふっ やられたな
Dialogue: 0,0:16:31.95,0:16:36.04,Default,,0,0,0,,赤い目のコヨーテは\N北の街はずれに現れるそうだ
Dialogue: 0,0:16:44.76,0:16:46.09,Default,,0,0,0,,（パトカーのサイレン）\N（アシモフ）ん？
Dialogue: 0,0:16:51.60,0:16:52.81,Default,,0,0,0,,（アシモフ）はあ
Dialogue: 0,0:16:56.52,0:16:59.10,Default,,0,0,0,,（アントニオ）\Nまたかよ 畜生この野郎
Dialogue: 0,0:16:59.77,0:17:02.86,Default,,0,0,0,,お前ら そうやって俺のこと\Nカモにしてっけどな
Dialogue: 0,0:17:02.98,0:17:05.44,Default,,0,0,0,,この辺りの店で\Nうまいもん食えるのも―
Dialogue: 0,0:17:05.57,0:17:09.36,Default,,0,0,0,,俺が仲間と一緒に\Nこの土地 耕したおかげなんだぞ
Dialogue: 0,0:17:09.49,0:17:11.49,Default,,0,0,0,,そりゃ俺たちだっつうの
Dialogue: 0,0:17:11.62,0:17:15.95,Default,,0,0,0,,耕したな　死に物狂いで種まいた
Dialogue: 0,0:17:16.08,0:17:19.42,Default,,0,0,0,,おめえは別の種まいてたもんさな
Dialogue: 0,0:17:21.25,0:17:22.17,Default,,0,0,0,,（アントニオ）おっ？
Dialogue: 0,0:17:25.46,0:17:28.09,Default,,0,0,0,,（足音）
Dialogue: 0,0:17:31.89,0:17:33.81,Default,,0,0,0,,ブラッディマリーはあるか？
Dialogue: 0,0:17:33.93,0:17:35.39,Default,,0,0,0,,（スパイク）ビールしかないな
Dialogue: 0,0:17:36.14,0:17:37.81,Default,,0,0,0,,（アシモフ）\Nトマトジュースならある
Dialogue: 0,0:17:38.06,0:17:39.14,Default,,0,0,0,,（スパイク）いくらだ？
Dialogue: 0,0:17:39.27,0:17:40.81,Default,,0,0,0,,（アシモフ）30万ウーロンだ
Dialogue: 0,0:17:40.94,0:17:42.19,Default,,0,0,0,,50袋ある
Dialogue: 0,0:17:42.31,0:17:44.11,Default,,0,0,0,,（スパイク）1500万ウーロンか
Dialogue: 0,0:17:44.23,0:17:45.53,Default,,0,0,0,,急いでる
Dialogue: 0,0:17:45.65,0:17:47.07,Default,,0,0,0,,駄目なら他をあたる
Dialogue: 0,0:17:47.86,0:17:48.86,Default,,0,0,0,,（スパイク）見せてくれ
Dialogue: 0,0:17:51.45,0:17:52.49,Default,,0,0,0,,あっ
Dialogue: 0,0:17:52.95,0:17:53.74,Default,,0,0,0,,これかい？
Dialogue: 0,0:17:55.83,0:17:58.41,Default,,0,0,0,,あんた自分の値段 知ってるか？
Dialogue: 0,0:17:58.66,0:17:59.46,Default,,0,0,0,,何？
Dialogue: 0,0:17:59.87,0:18:02.71,Default,,0,0,0,,たったの250万ウーロンだぜ
Dialogue: 0,0:18:02.83,0:18:04.50,Default,,0,0,0,,安い男だな
Dialogue: 0,0:18:07.46,0:18:08.51,Default,,0,0,0,,ご無沙汰
Dialogue: 0,0:18:08.63,0:18:10.26,Default,,0,0,0,,（アシモフ）\Nいつから売人になった？
Dialogue: 0,0:18:10.38,0:18:12.14,Default,,0,0,0,,賞金稼ぎは諦めたか
Dialogue: 0,0:18:12.51,0:18:15.18,Default,,0,0,0,,安い賞金首じゃ\N張り合いなくてね
Dialogue: 0,0:18:15.89,0:18:18.18,Default,,0,0,0,,お前は盗っ人が向いてるようだな
Dialogue: 0,0:18:18.47,0:18:19.64,Default,,0,0,0,,返してもらおう
Dialogue: 0,0:18:20.27,0:18:22.85,Default,,0,0,0,,返すとも　あんたには借りがある
Dialogue: 0,0:18:23.44,0:18:24.44,Default,,0,0,0,,（銃声）
Dialogue: 0,0:18:24.56,0:18:25.48,Default,,0,0,0,,ちっ
Dialogue: 0,0:18:29.86,0:18:31.20,Default,,0,0,0,,うわっ！　うっ…
Dialogue: 0,0:18:31.57,0:18:32.49,Default,,0,0,0,,ああー
Dialogue: 0,0:18:38.95,0:18:40.83,Default,,0,0,0,,目に頼り過ぎなんだよ
Dialogue: 0,0:18:40.96,0:18:42.54,Default,,0,0,0,,カメレオンじゃねえんだ
Dialogue: 0,0:18:42.67,0:18:43.92,Default,,0,0,0,,あちこち見えねえのさ
Dialogue: 0,0:18:45.96,0:18:46.92,Default,,0,0,0,,うわっ
Dialogue: 0,0:18:48.76,0:18:50.38,Default,,0,0,0,,あっ あう…
Dialogue: 0,0:18:51.51,0:18:52.55,Default,,0,0,0,,ぐあっ
Dialogue: 0,0:18:55.72,0:18:56.35,Default,,0,0,0,,うわ
Dialogue: 0,0:19:01.06,0:19:02.77,Default,,0,0,0,,（戦闘機の音）\N（カテリーナ）あっ？
Dialogue: 0,0:19:05.90,0:19:07.15,Default,,0,0,0,,（アシモフ）うっ 行くぞ
Dialogue: 0,0:19:08.23,0:19:09.40,Default,,0,0,0,,（ギャングＣ）あっちだー
Dialogue: 0,0:19:11.90,0:19:13.53,Default,,0,0,0,,あっちだ あっち　うわあっ
Dialogue: 0,0:19:13.70,0:19:14.95,Default,,0,0,0,,何だ てめえ　うわっ
Dialogue: 0,0:19:15.07,0:19:15.99,Default,,0,0,0,,うおっ
Dialogue: 0,0:19:16.20,0:19:17.37,Default,,0,0,0,,（カテリーナ）動かないで！\N（男性）おお…
Dialogue: 0,0:19:17.58,0:19:19.74,Default,,0,0,0,,（カテリーナ）いい？\Nそのまま じっとしてるのよ
Dialogue: 0,0:19:19.87,0:19:22.29,Default,,0,0,0,,（戦闘機の音）
Dialogue: 0,0:19:22.62,0:19:23.62,Default,,0,0,0,,（カテリーナ）あっ…
Dialogue: 0,0:19:25.21,0:19:25.79,Default,,0,0,0,,ああ
Dialogue: 0,0:19:27.42,0:19:28.84,Default,,0,0,0,,うっ ああ！
Dialogue: 0,0:19:29.50,0:19:30.71,Default,,0,0,0,,ばか野郎！
Dialogue: 0,0:19:31.13,0:19:34.05,Default,,0,0,0,,こいつが潰れたら終わりなんだ\N気をつけろ
Dialogue: 0,0:19:37.14,0:19:39.76,Default,,0,0,0,,（スパイク）\Nこのっ しつけえんだっつうの
Dialogue: 0,0:19:41.27,0:19:42.73,Default,,0,0,0,,（一同）うわーっ
Dialogue: 0,0:19:46.56,0:19:47.69,Default,,0,0,0,,うおおっ
Dialogue: 0,0:19:47.86,0:19:49.11,Default,,0,0,0,,いやー
Dialogue: 0,0:19:52.44,0:19:54.49,Default,,0,0,0,,ふん お待たせ
Dialogue: 0,0:19:54.82,0:19:56.41,Default,,0,0,0,,おせえぞ ジェット！
Dialogue: 0,0:19:56.53,0:19:57.12,Default,,0,0,0,,あっ
Dialogue: 0,0:19:57.49,0:19:58.49,Default,,0,0,0,,いっけね
Dialogue: 0,0:20:07.25,0:20:09.50,Default,,0,0,0,,（アシモフ）うう… うう…\N（カテリーナ）アシモフ
Dialogue: 0,0:20:35.86,0:20:38.24,Default,,0,0,0,,やめて！\Nもう これ以上 ムチャよ
Dialogue: 0,0:20:39.07,0:20:39.82,Default,,0,0,0,,駄目！
Dialogue: 0,0:20:39.95,0:20:40.62,Default,,0,0,0,,（アシモフ）うわっ
Dialogue: 0,0:21:00.05,0:21:02.01,Default,,0,0,0,,もう逃げきれないわ
Dialogue: 0,0:21:02.89,0:21:04.72,Default,,0,0,0,,逃げきれやしない
Dialogue: 0,0:21:11.52,0:21:13.11,Default,,0,0,0,,（銃声）\N（スパイク）はっ！
Dialogue: 0,0:21:27.46,0:21:28.50,Default,,0,0,0,,アディオス
Dialogue: 0,0:21:46.68,0:21:49.10,Default,,0,0,0,,おい スパイク あがったぞ
Dialogue: 0,0:21:49.60,0:21:50.27,Default,,0,0,0,,うん？
Dialogue: 0,0:22:14.84,0:22:16.09,Default,,0,0,0,,（ジェット）あがったぞ
Dialogue: 0,0:22:16.21,0:22:17.13,Default,,0,0,0,,（スパイク）メニューは？
Dialogue: 0,0:22:17.59,0:22:20.09,Default,,0,0,0,,特製チンジャオロースだ
Dialogue: 0,0:22:37.19,0:22:44.19,Default,,0,0,0,,♪～
Dialogue: 0,0:24:05.07,0:24:12.08,Default,,0,0,0,,～♪
Dialogue: 0,0:24:13.30,0:24:15.51,Default,,0,0,0,,（スパイク）まあ そういうわけで\Nようやく始まった この番組
Dialogue: 0,0:24:15.63,0:24:16.88,Default,,0,0,0,,（ジェット）\Nこりゃ どういうわけだよ
Dialogue: 0,0:24:17.01,0:24:19.43,Default,,0,0,0,,（スパイク）来週は思い切って\Nファミリーアニメに大変身だ
Dialogue: 0,0:24:19.55,0:24:20.55,Default,,0,0,0,,（ジェット）そんな話だっけか？
Dialogue: 0,0:24:20.80,0:24:22.43,Default,,0,0,0,,（スパイク）\N愉快な動物たちが大暴れ
Dialogue: 0,0:24:22.56,0:24:23.14,Default,,0,0,0,,（ジェット）何？
Dialogue: 0,0:24:23.26,0:24:24.89,Default,,0,0,0,,（スパイク）と言っても\Nムツゴロウさんは出てこないぞ
Dialogue: 0,0:24:25.02,0:24:26.98,Default,,0,0,0,,動物好きの子供から\Nお年寄りまで…
Dialogue: 0,0:24:27.10,0:24:28.52,Default,,0,0,0,,（ジェット）\Nおい ちょっと待てよ スパイク
Dialogue: 0,0:24:28.64,0:24:30.23,Default,,0,0,0,,（スパイク）\Nみんな そろって見てくれよ
Dialogue: 0,0:24:30.35,0:24:32.23,Default,,0,0,0,,（ジェット）\Nそんなこと言って本当 大丈夫か？
Dialogue: 0,0:24:32.57,0:24:33.48,Default,,0,0,0,,俺 知らねえぞ
Dialogue: 0,0:24:33.61,0:24:35.19,Default,,0,0,0,,（スパイク）\Nでも ここで一つ\Nお願いがあるんだ
Dialogue: 0,0:24:35.32,0:24:37.49,Default,,0,0,0,,良い子のみんなは\Nテレビから離れて見てくれ
Dialogue: 0,0:24:37.61,0:24:39.32,Default,,0,0,0,,（ジェット）お前なあ\N（スパイク）１キロぐらいな
Dialogue: 0,0:24:39.45,0:24:40.53,Default,,0,0,0,,（ジェット）離れすぎだよ
Dialogue: 0,0:24:40.66,0:24:41.91,Default,,0,0,0,,（スパイク）800メートル？
