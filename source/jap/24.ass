Dialogue: 0,0:00:01.50,0:00:07.92,Default,,0,0,0,,♪～
Dialogue: 0,0:01:23.91,0:01:31.04,Default,,0,0,0,,～♪
Dialogue: 0,0:02:08.27,0:02:11.82,Default,,0,0,0,,（フェイ）なっ！ ああ あんた\Nいつから そこに？
Dialogue: 0,0:02:12.19,0:02:14.07,Default,,0,0,0,,（エド）みじゅ ざー
Dialogue: 0,0:02:14.20,0:02:16.57,Default,,0,0,0,,え？ 知ってるの？ これ
Dialogue: 0,0:02:16.70,0:02:19.95,Default,,0,0,0,,知ってるような　知らないような
Dialogue: 0,0:02:20.08,0:02:26.00,Default,,0,0,0,,知ってるのを知らないような\N知らないのに知ってるような
Dialogue: 0,0:02:28.13,0:02:29.54,Default,,0,0,0,,どっちなの？
Dialogue: 0,0:02:29.88,0:02:31.55,Default,,0,0,0,,（寝息）
Dialogue: 0,0:02:31.67,0:02:32.80,Default,,0,0,0,,こら！
Dialogue: 0,0:02:35.59,0:02:36.64,Default,,0,0,0,,ううー
Dialogue: 0,0:02:58.37,0:03:00.45,Default,,0,0,0,,（大きな物音）
Dialogue: 0,0:03:00.58,0:03:03.08,Default,,0,0,0,,（アインがほえる声と\Nジェットのうめき声）
Dialogue: 0,0:03:03.20,0:03:05.41,Default,,0,0,0,,（ジェット）おい スパイク\Nここは どこだ？
Dialogue: 0,0:03:05.54,0:03:06.62,Default,,0,0,0,,（スパイク）地球だろ
Dialogue: 0,0:03:06.75,0:03:07.75,Default,,0,0,0,,（ジェット）地球？
Dialogue: 0,0:03:08.25,0:03:10.63,Default,,0,0,0,,おい 火星に\N向かってたはずの船が―
Dialogue: 0,0:03:10.75,0:03:12.84,Default,,0,0,0,,どうして いきなり\N地球にいるんだよ？
Dialogue: 0,0:03:12.96,0:03:13.51,Default,,0,0,0,,（スパイク）さあ
Dialogue: 0,0:03:13.63,0:03:16.05,Default,,0,0,0,,（ジェット）\Nああ くそ 冗談じゃねえ
Dialogue: 0,0:03:16.17,0:03:18.26,Default,,0,0,0,,こんなことしてる間に\Nせっかくの首が
Dialogue: 0,0:03:18.39,0:03:22.31,Default,,0,0,0,,久々の大物だってのに\N大体 何でまた こんなとこ…
Dialogue: 0,0:03:22.43,0:03:23.14,Default,,0,0,0,,（スパイク）ジェット
Dialogue: 0,0:03:23.27,0:03:24.22,Default,,0,0,0,,うん？
Dialogue: 0,0:03:24.64,0:03:25.98,Default,,0,0,0,,（スパイク）女どもがいない
Dialogue: 0,0:03:26.10,0:03:27.10,Default,,0,0,0,,（ジェット）ああん？
Dialogue: 0,0:03:31.44,0:03:32.15,Default,,0,0,0,,（フェイ）いい？
Dialogue: 0,0:03:32.27,0:03:35.40,Default,,0,0,0,,ちゃんと その“みじゅ ざー”の\Nある所に案内してれたら―
Dialogue: 0,0:03:35.53,0:03:36.65,Default,,0,0,0,,いいものあげる
Dialogue: 0,0:03:36.78,0:03:38.36,Default,,0,0,0,,（エド）いいもの 何？
Dialogue: 0,0:03:38.49,0:03:41.37,Default,,0,0,0,,ものすごく とっても\N素晴らしく いいものよ
Dialogue: 0,0:03:41.49,0:03:42.37,Default,,0,0,0,,えへへ
Dialogue: 0,0:03:42.99,0:03:47.66,Default,,0,0,0,,ものすごーく とーっても\Nすーばらしく いいものー
Dialogue: 0,0:03:50.21,0:03:56.63,Default,,0,0,0,,♪～
Dialogue: 0,0:04:24.41,0:04:26.29,Default,,0,0,0,,（アップルデリー）\Nあちーい！ エホッ
Dialogue: 0,0:04:26.41,0:04:28.33,Default,,0,0,0,,あち あち あちー！
Dialogue: 0,0:04:34.54,0:04:41.55,Default,,0,0,0,,～♪
Dialogue: 0,0:04:41.68,0:04:42.76,Default,,0,0,0,,（エド）これー
Dialogue: 0,0:04:44.39,0:04:46.77,Default,,0,0,0,,水 じゃー　アハハハハ
Dialogue: 0,0:04:50.44,0:04:53.98,Default,,0,0,0,,（フェイ）\Nまあ あんたを当てにした\N私が間違ってたわ
Dialogue: 0,0:04:55.40,0:04:56.23,Default,,0,0,0,,あっ
Dialogue: 0,0:04:59.78,0:05:01.49,Default,,0,0,0,,あ エド 見っけ
Dialogue: 0,0:05:01.61,0:05:04.49,Default,,0,0,0,,ほあ？ エド 見っけられっけ？
Dialogue: 0,0:05:04.62,0:05:06.54,Default,,0,0,0,,何？ 知り合い？
Dialogue: 0,0:05:06.66,0:05:08.87,Default,,0,0,0,,（少年１）さんじゅうごてん\Nよんじゅうはってんご…
Dialogue: 0,0:05:09.00,0:05:11.50,Default,,0,0,0,,（少年２）これ～\Nこれ これ これ
Dialogue: 0,0:05:11.62,0:05:13.46,Default,,0,0,0,,ねえ 爪ちょうだい？
Dialogue: 0,0:05:13.58,0:05:14.13,Default,,0,0,0,,爪？
Dialogue: 0,0:05:14.25,0:05:16.50,Default,,0,0,0,,集めてんの　ちょうだい
Dialogue: 0,0:05:16.63,0:05:18.13,Default,,0,0,0,,小指のでいいから
Dialogue: 0,0:05:18.26,0:05:19.01,Default,,0,0,0,,うあっ
Dialogue: 0,0:05:19.13,0:05:21.05,Default,,0,0,0,,（子供たちの騒ぐ声）
Dialogue: 0,0:05:21.17,0:05:22.68,Default,,0,0,0,,何なの？ あんたたち
Dialogue: 0,0:05:22.80,0:05:24.01,Default,,0,0,0,,（クララ）こーらー！
Dialogue: 0,0:05:24.14,0:05:25.89,Default,,0,0,0,,（子供たち）うぇっ わあああ
Dialogue: 0,0:05:26.01,0:05:26.85,Default,,0,0,0,,うっ…
Dialogue: 0,0:05:29.35,0:05:30.56,Default,,0,0,0,,（蛇口を閉める音）
Dialogue: 0,0:05:31.43,0:05:32.48,Default,,0,0,0,,うん？
Dialogue: 0,0:05:32.81,0:05:34.98,Default,,0,0,0,,あっ！ エド
Dialogue: 0,0:05:35.11,0:05:36.52,Default,,0,0,0,,エヘヘヘ
Dialogue: 0,0:05:36.86,0:05:38.23,Default,,0,0,0,,まさか
Dialogue: 0,0:05:38.69,0:05:40.24,Default,,0,0,0,,エドなのか？
Dialogue: 0,0:05:51.29,0:05:53.46,Default,,0,0,0,,（クララ）すまなかったねえ
Dialogue: 0,0:05:53.58,0:05:57.88,Default,,0,0,0,,子供に言うこと聞かせるには\Nあれが一番なんだ
Dialogue: 0,0:05:58.00,0:05:59.17,Default,,0,0,0,,（フェイ）いいのよ
Dialogue: 0,0:06:01.01,0:06:03.47,Default,,0,0,0,,エドって ここの子なの？
Dialogue: 0,0:06:03.59,0:06:07.47,Default,,0,0,0,,（クララ）５年ほど前\Nふらっと迷い込んできてな
Dialogue: 0,0:06:07.60,0:06:11.68,Default,,0,0,0,,気が付いたら\N当たり前の顔して飯 食ってたんだ
Dialogue: 0,0:06:11.93,0:06:15.52,Default,,0,0,0,,で ３年ほど前\Nふらっといなくなった
Dialogue: 0,0:06:15.69,0:06:17.94,Default,,0,0,0,,まるで猫か何かみたいにね
Dialogue: 0,0:06:18.69,0:06:22.49,Default,,0,0,0,,今頃 どこで どうしているのかって\N思ってたんだけど―
Dialogue: 0,0:06:22.65,0:06:25.11,Default,,0,0,0,,いきなり現れるなんてね
Dialogue: 0,0:06:26.11,0:06:27.70,Default,,0,0,0,,よし！ 飯にするぞ
Dialogue: 0,0:06:27.82,0:06:29.03,Default,,0,0,0,,（子供たち）わあああ！
Dialogue: 0,0:06:33.46,0:06:34.66,Default,,0,0,0,,（せきばらい）
Dialogue: 0,0:06:35.37,0:06:38.88,Default,,0,0,0,,天にまします われらの父よ…\N以下省略
Dialogue: 0,0:06:39.00,0:06:40.34,Default,,0,0,0,,いただきます！
Dialogue: 0,0:06:40.46,0:06:42.38,Default,,0,0,0,,（子供たち）いただきまーす！
Dialogue: 0,0:06:48.68,0:06:51.60,Default,,0,0,0,,（フェイ）\Nあっ 私 もう行かないと
Dialogue: 0,0:06:51.72,0:06:53.68,Default,,0,0,0,,なんだい　まだ いいだろ？
Dialogue: 0,0:06:53.81,0:06:55.48,Default,,0,0,0,,（フェイ）\Nちょっと探し物があって
Dialogue: 0,0:06:55.60,0:06:56.81,Default,,0,0,0,,エドが知ってるよ
Dialogue: 0,0:06:56.94,0:06:57.48,Default,,0,0,0,,（フェイ）えっ？
Dialogue: 0,0:06:57.60,0:07:00.98,Default,,0,0,0,,ここには ちょっと\Nご飯 食べに来てただけなの
Dialogue: 0,0:07:01.90,0:07:03.49,Default,,0,0,0,,く… あんたね
Dialogue: 0,0:07:04.03,0:07:07.07,Default,,0,0,0,,（エド）ちゃーんと いいもの\Nちょうだいねー
Dialogue: 0,0:07:07.24,0:07:08.24,Default,,0,0,0,,そうだ エド
Dialogue: 0,0:07:08.87,0:07:12.20,Default,,0,0,0,,そこの机\N引き出しに いいもんが入ってる
Dialogue: 0,0:07:12.33,0:07:13.50,Default,,0,0,0,,いいもの？
Dialogue: 0,0:07:13.62,0:07:14.79,Default,,0,0,0,,取ってきな
Dialogue: 0,0:07:15.08,0:07:16.87,Default,,0,0,0,,いいものだー
Dialogue: 0,0:07:17.00,0:07:18.71,Default,,0,0,0,,（クララ）そこの引き出しの中だ
Dialogue: 0,0:07:18.83,0:07:20.92,Default,,0,0,0,,（エド）うーん
Dialogue: 0,0:07:22.00,0:07:22.55,Default,,0,0,0,,にゃ？
Dialogue: 0,0:07:22.67,0:07:24.51,Default,,0,0,0,,（クララ）それじゃなくて
Dialogue: 0,0:07:25.05,0:07:25.67,Default,,0,0,0,,にゃにゃ
Dialogue: 0,0:07:25.80,0:07:28.09,Default,,0,0,0,,（クララ）そう それだ\N開けてみな
Dialogue: 0,0:07:30.72,0:07:31.55,Default,,0,0,0,,にっ
Dialogue: 0,0:07:32.64,0:07:33.81,Default,,0,0,0,,にゃー？
Dialogue: 0,0:07:34.18,0:07:35.23,Default,,0,0,0,,父親だ
Dialogue: 0,0:07:35.35,0:07:36.98,Default,,0,0,0,,えっ 誰の？
Dialogue: 0,0:07:37.69,0:07:41.56,Default,,0,0,0,,（クララ）ほんの２か月ほど前\Nエドを捜しに来たんだよ
Dialogue: 0,0:07:41.69,0:07:44.73,Default,,0,0,0,,託児所に預けといたのを\N忘れてたんだとさ
Dialogue: 0,0:07:44.86,0:07:46.40,Default,,0,0,0,,それから７年―
Dialogue: 0,0:07:46.53,0:07:50.12,Default,,0,0,0,,あちこち転々としながら\N捜してるって言ってた
Dialogue: 0,0:07:50.99,0:07:56.91,Default,,0,0,0,,会えるといいんだけどね\N人間 絆ってのは大事にしないと
Dialogue: 0,0:08:10.47,0:08:11.80,Default,,0,0,0,,イエイ
Dialogue: 0,0:08:27.40,0:08:28.28,Default,,0,0,0,,はあ
Dialogue: 0,0:08:28.40,0:08:30.11,Default,,0,0,0,,（サリー）あなた フェイ？
Dialogue: 0,0:08:30.24,0:08:30.82,Default,,0,0,0,,ん？
Dialogue: 0,0:08:32.70,0:08:33.83,Default,,0,0,0,,うそ
Dialogue: 0,0:08:34.62,0:08:36.20,Default,,0,0,0,,（サリー）本当に？\N（フェイ）あっ
Dialogue: 0,0:08:36.33,0:08:38.33,Default,,0,0,0,,（サリー）私よ サリー･ユー
Dialogue: 0,0:08:38.91,0:08:41.04,Default,,0,0,0,,ハイスクールのときの同級の
Dialogue: 0,0:08:45.17,0:08:46.96,Default,,0,0,0,,（サリーのせき）
Dialogue: 0,0:08:47.09,0:08:48.38,Default,,0,0,0,,あ 大丈夫？
Dialogue: 0,0:08:50.76,0:08:55.51,Default,,0,0,0,,ふー びっくりしたわ\N幽霊かと思った
Dialogue: 0,0:08:55.64,0:08:57.60,Default,,0,0,0,,昔のままなんだもの
Dialogue: 0,0:08:57.72,0:09:01.73,Default,,0,0,0,,ほら 未練のある場所に\N出るって言うでしょ
Dialogue: 0,0:09:02.23,0:09:03.98,Default,,0,0,0,,そうそう 思い出したわ
Dialogue: 0,0:09:04.15,0:09:07.48,Default,,0,0,0,,あのときの事故で\Nコールドスリープしてたのよね
Dialogue: 0,0:09:07.61,0:09:09.28,Default,,0,0,0,,それで昔のまんまで
Dialogue: 0,0:09:09.40,0:09:10.32,Default,,0,0,0,,（フェイ）事故？
Dialogue: 0,0:09:10.45,0:09:13.57,Default,,0,0,0,,（サリー）フェイ 覚えてないの？
Dialogue: 0,0:09:15.37,0:09:16.33,Default,,0,0,0,,私…
Dialogue: 0,0:09:17.66,0:09:20.04,Default,,0,0,0,,おばあちゃーん！
Dialogue: 0,0:09:24.08,0:09:26.13,Default,,0,0,0,,おばあちゃん もう戻らなきゃ
Dialogue: 0,0:09:26.25,0:09:27.80,Default,,0,0,0,,（サリー）まあ もうそんな時間？
Dialogue: 0,0:09:28.21,0:09:28.92,Default,,0,0,0,,あっ
Dialogue: 0,0:09:32.84,0:09:34.93,Default,,0,0,0,,この人 誰だか分かる？
Dialogue: 0,0:09:35.05,0:09:36.10,Default,,0,0,0,,うーん？
Dialogue: 0,0:09:36.55,0:09:39.56,Default,,0,0,0,,分からないでしょ？\N実は彼女はね
Dialogue: 0,0:09:39.68,0:09:41.06,Default,,0,0,0,,幽霊なのよ
Dialogue: 0,0:09:41.18,0:09:42.56,Default,,0,0,0,,（２人）えっ？
Dialogue: 0,0:09:42.69,0:09:43.85,Default,,0,0,0,,♪～\Nフッ
Dialogue: 0,0:09:43.85,0:09:43.98,Default,,0,0,0,,♪～
Dialogue: 0,0:09:43.98,0:09:45.94,Default,,0,0,0,,さよなら　元気で\N♪～
Dialogue: 0,0:09:45.94,0:09:49.69,Default,,0,0,0,,♪～
Dialogue: 0,0:10:08.17,0:10:14.84,Default,,0,0,0,,～♪
Dialogue: 0,0:10:18.51,0:10:20.39,Default,,0,0,0,,（ドアが開く音）
Dialogue: 0,0:10:20.52,0:10:21.77,Default,,0,0,0,,（ジェット）あ お前ら！
Dialogue: 0,0:10:21.89,0:10:23.98,Default,,0,0,0,,勝手に針路 変えやがって
Dialogue: 0,0:10:24.56,0:10:27.23,Default,,0,0,0,,おかげで こっちの予定は\N狂いっぱなしだ
Dialogue: 0,0:10:27.36,0:10:29.90,Default,,0,0,0,,勝手なことされちゃ 困るんだよ
Dialogue: 0,0:10:31.82,0:10:32.78,Default,,0,0,0,,うん？
Dialogue: 0,0:10:36.78,0:10:37.78,Default,,0,0,0,,うーん？
Dialogue: 0,0:10:42.91,0:10:44.12,Default,,0,0,0,,（アインの鳴き声）
Dialogue: 0,0:10:46.17,0:10:48.63,Default,,0,0,0,,とってもいいもの 嗅ぐ？
Dialogue: 0,0:10:48.75,0:10:49.79,Default,,0,0,0,,（ほえる声）
Dialogue: 0,0:11:05.39,0:11:09.86,Default,,0,0,0,,（ジェット）全く あいつら\N勝手に こそこそ何やってんだ？
Dialogue: 0,0:11:09.98,0:11:11.02,Default,,0,0,0,,ほっとけよ
Dialogue: 0,0:11:11.15,0:11:13.90,Default,,0,0,0,,腹の減りすぎかもしれんな
Dialogue: 0,0:11:14.11,0:11:17.74,Default,,0,0,0,,人間 食うもん食わなきゃ\Nおかしくもなるってもんだ
Dialogue: 0,0:11:17.86,0:11:19.12,Default,,0,0,0,,5000万か
Dialogue: 0,0:11:19.24,0:11:20.16,Default,,0,0,0,,（ジェット）うん？
Dialogue: 0,0:11:20.62,0:11:22.70,Default,,0,0,0,,おおー 大物だな
Dialogue: 0,0:11:22.83,0:11:26.58,Default,,0,0,0,,アップルデリー･シニズ･\Nヘサップ･リュトフェンか
Dialogue: 0,0:11:35.30,0:11:37.88,Default,,0,0,0,,（アップルデリー）\N君も吸うかね？ マッケンロー君
Dialogue: 0,0:11:38.01,0:11:41.97,Default,,0,0,0,,（マッケンタイア）\Nマッケンタイアです\N結構です アップルデリーさん
Dialogue: 0,0:11:42.10,0:11:44.39,Default,,0,0,0,,（アップルデリー）\Nそうかね　卵はいいぞ
Dialogue: 0,0:11:44.52,0:11:48.02,Default,,0,0,0,,いわゆるパワーアンドチャージ\Nそれがインポータントなんだ
Dialogue: 0,0:11:48.14,0:11:49.27,Default,,0,0,0,,マッキントッシュ君
Dialogue: 0,0:11:49.40,0:11:51.06,Default,,0,0,0,,マッケンタイアです
Dialogue: 0,0:11:51.19,0:11:52.44,Default,,0,0,0,,どうして いつまでたっても―
Dialogue: 0,0:11:52.57,0:11:54.73,Default,,0,0,0,,助手の名前を\N覚えてくれないんですか？
Dialogue: 0,0:11:54.86,0:11:57.86,Default,,0,0,0,,うん？ へっ\N細かいことは気にせんことだ
Dialogue: 0,0:11:57.99,0:11:58.57,Default,,0,0,0,,ハッハッハッハ
Dialogue: 0,0:11:58.57,0:11:59.24,Default,,0,0,0,,（隕石が落ちる音）\Nハッハッハッハ
Dialogue: 0,0:11:59.24,0:11:59.36,Default,,0,0,0,,（隕石が落ちる音）
Dialogue: 0,0:11:59.36,0:11:59.99,Default,,0,0,0,,うん？\N（隕石が落ちる音）
Dialogue: 0,0:12:01.12,0:12:03.45,Default,,0,0,0,,（鶏が騒ぐ声）
Dialogue: 0,0:12:03.58,0:12:05.12,Default,,0,0,0,,急げ！ マッキンマック君
Dialogue: 0,0:12:05.24,0:12:06.45,Default,,0,0,0,,マッケンタイアです！
Dialogue: 0,0:13:29.54,0:13:31.41,Default,,0,0,0,,（トイレが流れる音）
Dialogue: 0,0:13:32.75,0:13:33.79,Default,,0,0,0,,（フェイ）あっ\N（スパイク）うわっ
Dialogue: 0,0:13:33.92,0:13:35.50,Default,,0,0,0,,何だよ 危ねえな
Dialogue: 0,0:13:37.00,0:13:38.71,Default,,0,0,0,,あっ あ あ…
Dialogue: 0,0:13:39.09,0:13:40.17,Default,,0,0,0,,あっ あ…
Dialogue: 0,0:13:40.30,0:13:41.09,Default,,0,0,0,,（スパイク）おい
Dialogue: 0,0:13:41.92,0:13:42.76,Default,,0,0,0,,ごめん
Dialogue: 0,0:13:43.55,0:13:44.72,Default,,0,0,0,,“ごめん”？
Dialogue: 0,0:13:45.22,0:13:46.05,Default,,0,0,0,,あ…
Dialogue: 0,0:13:46.68,0:13:47.76,Default,,0,0,0,,私…
Dialogue: 0,0:13:53.94,0:13:55.27,Default,,0,0,0,,行かなきゃ
Dialogue: 0,0:13:57.69,0:14:00.53,Default,,0,0,0,,（走る音）
Dialogue: 0,0:14:07.49,0:14:09.33,Default,,0,0,0,,（エド）お出掛けさーん\N（フェイ）うっ
Dialogue: 0,0:14:09.45,0:14:10.70,Default,,0,0,0,,どこ行くの？
Dialogue: 0,0:14:13.71,0:14:16.17,Default,,0,0,0,,自分の居場所 思い出したの
Dialogue: 0,0:14:16.29,0:14:17.63,Default,,0,0,0,,居場所？
Dialogue: 0,0:14:17.75,0:14:21.13,Default,,0,0,0,,あんたも\N待ってる人がいるんだから…
Dialogue: 0,0:14:21.26,0:14:24.63,Default,,0,0,0,,居場所があるんだから\N探して行くといいわ
Dialogue: 0,0:14:25.01,0:14:26.26,Default,,0,0,0,,（エド）うん？
Dialogue: 0,0:14:26.80,0:14:28.01,Default,,0,0,0,,それが―
Dialogue: 0,0:14:28.43,0:14:30.52,Default,,0,0,0,,一番いいものなんだから
Dialogue: 0,0:14:41.44,0:14:45.99,Default,,0,0,0,,（ジェット）今回は楽勝だぞ\N5000万は もうすぐ そこだ
Dialogue: 0,0:14:47.24,0:14:49.95,Default,,0,0,0,,肉入りのすき焼きでも食やあ\Nあいつらも…
Dialogue: 0,0:14:50.08,0:14:51.70,Default,,0,0,0,,フェイなら出てったぜ
Dialogue: 0,0:14:51.83,0:14:54.58,Default,,0,0,0,,またか？ おい 今度はどこへ？
Dialogue: 0,0:14:56.54,0:14:58.04,Default,,0,0,0,,はあーっ
Dialogue: 0,0:14:58.17,0:15:01.75,Default,,0,0,0,,女心とガニメデの空ってやつか
Dialogue: 0,0:15:07.84,0:15:09.80,Default,,0,0,0,,（ジェット）アップルデリーだな？
Dialogue: 0,0:15:11.31,0:15:12.93,Default,,0,0,0,,一緒に来てもらおうか
Dialogue: 0,0:15:13.06,0:15:15.64,Default,,0,0,0,,ケガしたくなかったら\Nおとなしくしてくれ
Dialogue: 0,0:15:16.23,0:15:19.06,Default,,0,0,0,,何だ？ あんたたち\N仕事の邪魔しないでくれ
Dialogue: 0,0:15:19.19,0:15:20.11,Default,,0,0,0,,仕事？
Dialogue: 0,0:15:20.23,0:15:22.61,Default,,0,0,0,,混乱が支配する この地球で―
Dialogue: 0,0:15:22.73,0:15:25.86,Default,,0,0,0,,われわれがピース的な平和と\Nノン混乱を取り戻すには―
Dialogue: 0,0:15:25.99,0:15:27.66,Default,,0,0,0,,何が必要だと思う？
Dialogue: 0,0:15:27.82,0:15:28.57,Default,,0,0,0,,（スパイク）はあ？
Dialogue: 0,0:15:28.70,0:15:31.08,Default,,0,0,0,,それはマップ　地図だ
Dialogue: 0,0:15:31.20,0:15:34.29,Default,,0,0,0,,そう 幸せは\N地図に乗ってやってくるのだ
Dialogue: 0,0:15:34.41,0:15:38.54,Default,,0,0,0,,僕たちは この地球を救うために\N地図を作っているんです
Dialogue: 0,0:15:38.67,0:15:40.92,Default,,0,0,0,,地図ったってえな
Dialogue: 0,0:15:41.04,0:15:42.92,Default,,0,0,0,,ここじゃ しょっちゅう\N隕石が降ってきて―
Dialogue: 0,0:15:43.05,0:15:44.76,Default,,0,0,0,,地形が変わってるぞ
Dialogue: 0,0:15:45.55,0:15:48.47,Default,,0,0,0,,（アップルデリー）\Nだから われわれは\N全ての隕石を追いかけて―
Dialogue: 0,0:15:48.59,0:15:50.30,Default,,0,0,0,,地球を巡っているのだ
Dialogue: 0,0:15:50.43,0:15:53.22,Default,,0,0,0,,（マッケンタイア）\N全ての隕石が地球に落ち尽くすまで
Dialogue: 0,0:15:56.64,0:15:57.85,Default,,0,0,0,,ご託は結構だ！
Dialogue: 0,0:15:58.90,0:15:59.90,Default,,0,0,0,,（ジェット）うおお
Dialogue: 0,0:16:01.11,0:16:01.77,Default,,0,0,0,,野郎！
Dialogue: 0,0:16:05.82,0:16:07.20,Default,,0,0,0,,意外とやるな
Dialogue: 0,0:16:28.34,0:16:29.13,Default,,0,0,0,,うわっ
Dialogue: 0,0:16:32.30,0:16:33.01,Default,,0,0,0,,エドか
Dialogue: 0,0:16:33.14,0:16:34.60,Default,,0,0,0,,もういい！ 止まれ
Dialogue: 0,0:16:44.61,0:16:48.07,Default,,0,0,0,,はっ！ フランソワーズ！
Dialogue: 0,0:16:48.19,0:16:49.53,Default,,0,0,0,,ふふう あは
Dialogue: 0,0:16:50.15,0:16:51.49,Default,,0,0,0,,にゃー
Dialogue: 0,0:16:51.61,0:16:53.41,Default,,0,0,0,,（エド）あははー あはは\N（アップルデリー）イエー ハッハ
Dialogue: 0,0:16:53.53,0:16:56.62,Default,,0,0,0,,（アップルデリー）\Nそーれ そーれ それ ハハハハ
Dialogue: 0,0:16:56.74,0:16:59.21,Default,,0,0,0,,（エド）にゃー　ほー\N（アップルデリー）そうらー ハハ
Dialogue: 0,0:16:59.33,0:17:02.67,Default,,0,0,0,,（２人の笑い声）
Dialogue: 0,0:17:04.96,0:17:06.63,Default,,0,0,0,,これは父の人
Dialogue: 0,0:17:07.34,0:17:09.09,Default,,0,0,0,,父って…
Dialogue: 0,0:17:09.47,0:17:10.97,Default,,0,0,0,,父親か？
Dialogue: 0,0:17:12.55,0:17:14.60,Default,,0,0,0,,いたのか？ そんなの
Dialogue: 0,0:17:14.72,0:17:17.77,Default,,0,0,0,,これはスパイクの人とジェットの人
Dialogue: 0,0:17:17.89,0:17:18.85,Default,,0,0,0,,（アップルデリー）そうか
Dialogue: 0,0:17:22.77,0:17:25.23,Default,,0,0,0,,違うよ 父　いい人だよ
Dialogue: 0,0:17:25.36,0:17:27.02,Default,,0,0,0,,うん？ そうか
Dialogue: 0,0:17:27.53,0:17:29.36,Default,,0,0,0,,息子が世話になった
Dialogue: 0,0:17:29.49,0:17:32.11,Default,,0,0,0,,うん？ 娘だったか？
Dialogue: 0,0:17:32.41,0:17:34.37,Default,,0,0,0,,まあ どちらでも良し
Dialogue: 0,0:17:35.45,0:17:36.83,Default,,0,0,0,,それは礼だ
Dialogue: 0,0:17:37.45,0:17:41.29,Default,,0,0,0,,じゃあ エド 賞金を懸けたのも\Nまさか お前…
Dialogue: 0,0:17:42.37,0:17:47.21,Default,,0,0,0,,50.000000
Dialogue: 0,0:17:48.34,0:17:50.67,Default,,0,0,0,,たったの50ウーロン？
Dialogue: 0,0:17:50.80,0:17:53.26,Default,,0,0,0,,どうだ？ お前も一緒に来るか？
Dialogue: 0,0:17:53.38,0:17:54.39,Default,,0,0,0,,にー？
Dialogue: 0,0:17:56.35,0:17:57.60,Default,,0,0,0,,（隕石が落ちる音）
Dialogue: 0,0:17:57.72,0:17:58.89,Default,,0,0,0,,（マッケンタイア）ああー！
Dialogue: 0,0:18:01.14,0:18:02.39,Default,,0,0,0,,（アップルデリー）うおおお
Dialogue: 0,0:18:03.77,0:18:06.15,Default,,0,0,0,,急げー！ マイケルダック君
Dialogue: 0,0:18:06.27,0:18:07.65,Default,,0,0,0,,マッケンタイアです！
Dialogue: 0,0:18:07.77,0:18:08.86,Default,,0,0,0,,（ジェット）おおい 待てよ！
Dialogue: 0,0:18:10.48,0:18:11.86,Default,,0,0,0,,父ー！
Dialogue: 0,0:18:22.25,0:18:24.17,Default,,0,0,0,,行っちゃった
Dialogue: 0,0:18:42.64,0:18:46.31,Default,,0,0,0,,（フェイの荒い息）
Dialogue: 0,0:19:33.78,0:19:40.41,Default,,0,0,0,,♪～
Dialogue: 0,0:20:26.20,0:20:27.37,Default,,0,0,0,,（アインの鳴き声）
Dialogue: 0,0:20:28.54,0:20:30.54,Default,,0,0,0,,おい 飯だぞ
Dialogue: 0,0:20:30.67,0:20:31.21,Default,,0,0,0,,うん？
Dialogue: 0,0:20:40.47,0:20:42.18,Default,,0,0,0,,スパイク 飯だ
Dialogue: 0,0:21:22.76,0:21:24.64,Default,,0,0,0,,（アインがほえる声）
Dialogue: 0,0:21:26.47,0:21:29.85,Default,,0,0,0,,（アインの鳴き声）\N（エド）\Nついてきちゃ駄目だよ アイン
Dialogue: 0,0:21:29.85,0:21:31.06,Default,,0,0,0,,（アインの鳴き声）
Dialogue: 0,0:21:31.19,0:21:34.31,Default,,0,0,0,,エドは 遠い遠いとこへ行くんだよ
Dialogue: 0,0:21:34.48,0:21:37.36,Default,,0,0,0,,もう戻ってこないかも\Nしれないんだよ
Dialogue: 0,0:21:38.48,0:21:41.74,Default,,0,0,0,,だからアインは\Nおうちに帰るんだよ
Dialogue: 0,0:21:45.66,0:21:47.33,Default,,0,0,0,,エドと一緒に行きたい？
Dialogue: 0,0:21:47.45,0:21:48.33,Default,,0,0,0,,（アインがほえる声）
Dialogue: 0,0:22:07.22,0:22:09.64,Default,,0,0,0,,（アインの鳴き声）
Dialogue: 0,0:22:10.89,0:22:12.35,Default,,0,0,0,,行こう アイン
Dialogue: 0,0:22:12.48,0:22:13.35,Default,,0,0,0,,（ほえる声）
Dialogue: 0,0:22:22.40,0:22:29.41,Default,,0,0,0,,～♪
Dialogue: 0,0:22:31.40,0:22:38.40,Default,,0,0,0,,♪～
Dialogue: 0,0:23:58.73,0:24:05.74,Default,,0,0,0,,～♪
Dialogue: 0,0:24:07.32,0:24:10.90,Default,,0,0,0,,（ジェット）\Nどんなものにも始まりがあり\Nそして終わりがある
Dialogue: 0,0:24:11.03,0:24:13.28,Default,,0,0,0,,人生は その繰り返しだ
Dialogue: 0,0:24:13.41,0:24:15.49,Default,,0,0,0,,来てほしくない終わりもあるが―
Dialogue: 0,0:24:15.62,0:24:18.66,Default,,0,0,0,,避けられない終わりを\N経験していくこと
Dialogue: 0,0:24:18.79,0:24:21.62,Default,,0,0,0,,それが\N大人になっていくってことなんだ
Dialogue: 0,0:24:22.21,0:24:25.17,Default,,0,0,0,,早いもんでビバップも\N残り あと２回だが―
Dialogue: 0,0:24:25.29,0:24:28.50,Default,,0,0,0,,その終わりを\Nちゃんと見届けてくれよ
Dialogue: 0,0:24:28.63,0:24:32.17,Default,,0,0,0,,次回「ザ･リアル･\Nフォークブルース（前編）」
