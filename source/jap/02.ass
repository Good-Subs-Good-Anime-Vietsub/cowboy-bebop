Dialogue: 0,0:00:01.49,0:00:07.91,Default,,0,0,0,,♪～
Dialogue: 0,0:01:23.91,0:01:31.04,Default,,0,0,0,,～♪
Dialogue: 0,0:01:43.89,0:01:46.39,Default,,0,0,0,,（男１）\N出てこい　もう逃げられんぞ
Dialogue: 0,0:01:46.68,0:01:47.31,Default,,0,0,0,,（男２）撃つぞ
Dialogue: 0,0:01:47.64,0:01:49.77,Default,,0,0,0,,（男１）諦めろ\Nアブドゥル･ハキム
Dialogue: 0,0:01:50.85,0:01:51.52,Default,,0,0,0,,うあっ
Dialogue: 0,0:01:53.98,0:01:54.86,Default,,0,0,0,,やる気か？
Dialogue: 0,0:01:54.98,0:01:55.90,Default,,0,0,0,,貴様
Dialogue: 0,0:02:10.66,0:02:16.17,Default,,0,0,0,,（ゲートアナウンスの声）
Dialogue: 0,0:02:16.34,0:02:23.30,Default,,0,0,0,,（ゲートアナウンスの声）
Dialogue: 0,0:02:47.24,0:02:48.58,Default,,0,0,0,,（パンチ）アミーゴ！
Dialogue: 0,0:02:48.70,0:02:51.96,Default,,0,0,0,,太陽系30万の賞金稼ぎのみんな\N元気かい？
Dialogue: 0,0:02:52.08,0:02:55.71,Default,,0,0,0,,（ジュディ）\N指名手配者情報をお伝えする\Nビッグショットの時間よ
Dialogue: 0,0:02:55.88,0:02:59.51,Default,,0,0,0,,（パンチ）さてさて\N今日のトップバッターは この男だ
Dialogue: 0,0:02:59.63,0:03:01.38,Default,,0,0,0,,アブドゥル･ハキム
Dialogue: 0,0:03:01.51,0:03:04.72,Default,,0,0,0,,もともと彼は\N連続ペット窃盗犯なんだってよ
Dialogue: 0,0:03:04.84,0:03:08.60,Default,,0,0,0,,今回は とある研究機関から\N実験動物を奪って逃走中なんだ
Dialogue: 0,0:03:08.76,0:03:13.44,Default,,0,0,0,,（ジュディ）\Nうーん　グッドニュースは\N賞金が驚きの800万ってことね
Dialogue: 0,0:03:13.56,0:03:17.65,Default,,0,0,0,,（パンチ）\N条件は いつものように賞金首を\N生きたまま連れてくることだ
Dialogue: 0,0:03:17.82,0:03:19.53,Default,,0,0,0,,殺したら賞金はパーよ
Dialogue: 0,0:03:19.90,0:03:20.78,Default,,0,0,0,,（パンチ）久しぶりの大物だ\N頑張ってゲットしてくれたまえ
Dialogue: 0,0:03:20.78,0:03:23.24,Default,,0,0,0,,（足音）\N（パンチ）久しぶりの大物だ\N頑張ってゲットしてくれたまえ
Dialogue: 0,0:03:23.36,0:03:24.41,Default,,0,0,0,,（スパイク）どうだ？
Dialogue: 0,0:03:24.70,0:03:26.03,Default,,0,0,0,,（ジェット）寿命だ
Dialogue: 0,0:03:26.49,0:03:28.24,Default,,0,0,0,,どれもこれも全く
Dialogue: 0,0:03:28.37,0:03:29.62,Default,,0,0,0,,（電子音）
Dialogue: 0,0:03:30.58,0:03:31.54,Default,,0,0,0,,（ドクター）いよう
Dialogue: 0,0:03:31.66,0:03:33.46,Default,,0,0,0,,（スパイク）ドクター 情報か？
Dialogue: 0,0:03:33.58,0:03:35.12,Default,,0,0,0,,ネタはアブドゥル･ハキム
Dialogue: 0,0:03:35.71,0:03:36.33,Default,,0,0,0,,いただき
Dialogue: 0,0:03:36.50,0:03:40.30,Default,,0,0,0,,300にまけといてやる\N物は整形後の写真だ
Dialogue: 0,0:03:40.42,0:03:42.09,Default,,0,0,0,,（スパイク）高い　20ダウン
Dialogue: 0,0:03:42.21,0:03:46.68,Default,,0,0,0,,はあー 280\Nその代わり 一つ条件がある
Dialogue: 0,0:03:47.18,0:03:47.97,Default,,0,0,0,,なんだ？
Dialogue: 0,0:03:48.10,0:03:52.43,Default,,0,0,0,,（ドクター）１発 殴っといてくれ\Nあいつ 踏み倒していきやがった
Dialogue: 0,0:03:52.60,0:03:54.85,Default,,0,0,0,,何なら10発くれてやってもいい
Dialogue: 0,0:04:18.93,0:04:21.22,Default,,0,0,0,,（ハキム）例のブツがここにある
Dialogue: 0,0:04:21.35,0:04:23.76,Default,,0,0,0,,今回は上物のはずだ
Dialogue: 0,0:04:24.43,0:04:26.73,Default,,0,0,0,,（ハキム）では６時間後に\N（通話が切れた音）
Dialogue: 0,0:04:27.27,0:04:30.15,Default,,0,0,0,,（ドクター）\N妙に目立つスーツケースを\N持ってたな
Dialogue: 0,0:04:30.27,0:04:32.23,Default,,0,0,0,,（スパイク）\Nその情報は料金内だな？
Dialogue: 0,0:04:32.57,0:04:33.77,Default,,0,0,0,,まけといてやる
Dialogue: 0,0:04:34.32,0:04:36.99,Default,,0,0,0,,小柄な女くらいなら\N運べそうなやつだ
Dialogue: 0,0:04:37.11,0:04:38.15,Default,,0,0,0,,お宝か？
Dialogue: 0,0:04:38.28,0:04:39.20,Default,,0,0,0,,どうだかな
Dialogue: 0,0:04:40.11,0:04:42.66,Default,,0,0,0,,扱いは\Nとてもそんな感じじゃなかったがな
Dialogue: 0,0:04:45.58,0:04:46.66,Default,,0,0,0,,（ドアが開く音）
Dialogue: 0,0:04:50.96,0:04:51.88,Default,,0,0,0,,（ドアが閉まる音）
Dialogue: 0,0:04:52.75,0:04:57.72,Default,,0,0,0,,（店主）\Nニーライラ　お客さん\Nニンジン餅茶 一気が10万よ
Dialogue: 0,0:04:57.84,0:04:59.55,Default,,0,0,0,,１週間持つよ
Dialogue: 0,0:04:59.68,0:05:02.51,Default,,0,0,0,,疲れてんならサトウキビ餅茶よ
Dialogue: 0,0:05:02.64,0:05:05.31,Default,,0,0,0,,食べ過ぎだったら\Nパイナップル餅茶よ
Dialogue: 0,0:05:05.60,0:05:06.81,Default,,0,0,0,,（ハキム）ラオチュウだ
Dialogue: 0,0:05:06.93,0:05:07.81,Default,,0,0,0,,（店主）シェイシェイ
Dialogue: 0,0:05:08.27,0:05:09.35,Default,,0,0,0,,はいよ
Dialogue: 0,0:05:10.56,0:05:13.02,Default,,0,0,0,,（チンピラＡ）\Nうおーっと　すまねえ
Dialogue: 0,0:05:13.15,0:05:14.94,Default,,0,0,0,,すまなかったな 兄ちゃん
Dialogue: 0,0:05:16.78,0:05:18.94,Default,,0,0,0,,謝ってるじゃねえか
Dialogue: 0,0:05:19.24,0:05:21.32,Default,,0,0,0,,なんか言ったらどうだい　おうおう
Dialogue: 0,0:05:21.32,0:05:22.28,Default,,0,0,0,,（虫が動く音）\Nなんか言ったらどうだい　おうおう
Dialogue: 0,0:05:23.99,0:05:26.83,Default,,0,0,0,,ううっ なっ 何だい\Nやろうってのかい
Dialogue: 0,0:05:29.33,0:05:30.50,Default,,0,0,0,,俺のおごりだ
Dialogue: 0,0:05:31.00,0:05:32.71,Default,,0,0,0,,ええっ？ うおおっ うっ
Dialogue: 0,0:05:32.83,0:05:36.05,Default,,0,0,0,,（うめき声）
Dialogue: 0,0:05:36.71,0:05:37.59,Default,,0,0,0,,飲め
Dialogue: 0,0:05:37.92,0:05:39.72,Default,,0,0,0,,（チンピラＡ）\Nうおっ　がーっ うはーっはっ
Dialogue: 0,0:05:39.84,0:05:42.01,Default,,0,0,0,,うえー うえー
Dialogue: 0,0:05:42.76,0:05:43.76,Default,,0,0,0,,（ハキム）うん？\N（ドアが開く音）
Dialogue: 0,0:05:56.11,0:05:57.07,Default,,0,0,0,,ふんっ
Dialogue: 0,0:05:58.53,0:06:01.20,Default,,0,0,0,,（チンピラＢ）ふえー　へへへっと
Dialogue: 0,0:06:02.03,0:06:04.49,Default,,0,0,0,,さてと お宝お宝
Dialogue: 0,0:06:07.79,0:06:09.95,Default,,0,0,0,,（動物のうなり声）\N（チンピラＢ）ああ？
Dialogue: 0,0:06:10.25,0:06:11.25,Default,,0,0,0,,うわあっ
Dialogue: 0,0:06:13.58,0:06:14.17,Default,,0,0,0,,えいっ
Dialogue: 0,0:06:31.48,0:06:34.35,Default,,0,0,0,,（スパイク）\N機体全部 オーバーホールしても\N釣りがくるな
Dialogue: 0,0:06:34.85,0:06:36.61,Default,,0,0,0,,北京ダックでも食うか
Dialogue: 0,0:06:37.11,0:06:40.48,Default,,0,0,0,,“孵(かえ)る前のひなを数えるな”って\N格言があるぜ
Dialogue: 0,0:06:42.44,0:06:43.82,Default,,0,0,0,,今回は固いさ
Dialogue: 0,0:06:43.95,0:06:45.70,Default,,0,0,0,,（ジェット）まっ 頑張ってくれ
Dialogue: 0,0:06:54.71,0:06:56.50,Default,,0,0,0,,（男Ａ）３人とも やられたのか
Dialogue: 0,0:06:56.63,0:06:57.84,Default,,0,0,0,,（男Ｂ）そのようで
Dialogue: 0,0:06:57.96,0:06:59.75,Default,,0,0,0,,ハキムはこの辺りだな
Dialogue: 0,0:06:59.88,0:07:01.00,Default,,0,0,0,,そのようで
Dialogue: 0,0:07:01.51,0:07:03.84,Default,,0,0,0,,たく 本当の価値も知らんくせに
Dialogue: 0,0:07:04.63,0:07:06.09,Default,,0,0,0,,（イレズミ男）\Nペットショップだと？
Dialogue: 0,0:07:06.93,0:07:08.80,Default,,0,0,0,,（スパイク）それも非合法のね
Dialogue: 0,0:07:09.60,0:07:10.94,Default,,0,0,0,,なあ兄ちゃんよ
Dialogue: 0,0:07:11.15,0:07:14.61,Default,,0,0,0,,この火星じゃ\N何だって金で買えるんだ
Dialogue: 0,0:07:14.74,0:07:17.86,Default,,0,0,0,,鉄砲から人の命から 何だってな
Dialogue: 0,0:07:17.99,0:07:20.28,Default,,0,0,0,,情報が欲しいんなら\N出すもん出しな
Dialogue: 0,0:07:20.45,0:07:21.91,Default,,0,0,0,,（スパイク）鎖が長いな
Dialogue: 0,0:07:22.03,0:07:23.54,Default,,0,0,0,,ウェイ･オブ･\Nザ･ドラゴンモデルか
Dialogue: 0,0:07:23.69,0:07:27.11,Default,,0,0,0,,あっ 分かる？\N30年代のレアもんだよ そりゃあ
Dialogue: 0,0:07:28.28,0:07:29.99,Default,,0,0,0,,そいつは骨董(こっとう)品だな
Dialogue: 0,0:07:30.83,0:07:32.58,Default,,0,0,0,,カイホンロードのはずれの―
Dialogue: 0,0:07:32.70,0:07:35.50,Default,,0,0,0,,アニマルトレジャーって店に\N行ってみな
Dialogue: 0,0:07:35.83,0:07:37.96,Default,,0,0,0,,何か分かるだろうさ
Dialogue: 0,0:07:42.96,0:07:46.93,Default,,0,0,0,,（オーナー）見るだけは見るけど\N買い取るかどうかは その後よ
Dialogue: 0,0:07:47.05,0:07:48.18,Default,,0,0,0,,（チンピラＢ）そりゃ もう
Dialogue: 0,0:07:54.56,0:07:55.35,Default,,0,0,0,,ニーッ
Dialogue: 0,0:07:55.52,0:07:57.35,Default,,0,0,0,,えっ？ イヒヒ
Dialogue: 0,0:08:00.69,0:08:01.48,Default,,0,0,0,,ああっ
Dialogue: 0,0:08:01.61,0:08:04.94,Default,,0,0,0,,整形のやり過ぎで\N金がなくなったか？ ハキム
Dialogue: 0,0:08:05.07,0:08:06.28,Default,,0,0,0,,ちょっ ちょっと待って
Dialogue: 0,0:08:06.60,0:08:10.24,Default,,0,0,0,,（スパイク）おっと 動くなよ\Nたく ころころ顔 変えやがって
Dialogue: 0,0:08:10.37,0:08:11.62,Default,,0,0,0,,落ち着かないやつだ
Dialogue: 0,0:08:11.74,0:08:12.33,Default,,0,0,0,,何？
Dialogue: 0,0:08:12.87,0:08:17.21,Default,,0,0,0,,ちょっと いざこざ ごめんよ\Nうちの子みんな繊細なんだから
Dialogue: 0,0:08:17.33,0:08:18.83,Default,,0,0,0,,（スパイク）あんたが開けろ
Dialogue: 0,0:08:19.17,0:08:20.17,Default,,0,0,0,,どうして？
Dialogue: 0,0:08:20.71,0:08:21.92,Default,,0,0,0,,なんか勘違いして…
Dialogue: 0,0:08:22.30,0:08:22.80,Default,,0,0,0,,早く
Dialogue: 0,0:08:24.92,0:08:25.84,Default,,0,0,0,,うーん
Dialogue: 0,0:08:27.88,0:08:29.01,Default,,0,0,0,,分かったわよ
Dialogue: 0,0:08:31.97,0:08:34.77,Default,,0,0,0,,（ダイヤルを回す音）
Dialogue: 0,0:08:41.69,0:08:42.90,Default,,0,0,0,,あーら
Dialogue: 0,0:08:45.48,0:08:46.24,Default,,0,0,0,,犬？
Dialogue: 0,0:08:46.53,0:08:48.07,Default,,0,0,0,,（オーナー）\Nウェルシュ･コーギーね
Dialogue: 0,0:08:48.20,0:08:52.03,Default,,0,0,0,,かわいいけど ありふれてて\N珍しい種類じゃないわね
Dialogue: 0,0:08:52.28,0:08:54.41,Default,,0,0,0,,で この犬の値段は？
Dialogue: 0,0:08:54.66,0:08:57.12,Default,,0,0,0,,スーツケース込みで こんなもん
Dialogue: 0,0:08:57.25,0:08:58.12,Default,,0,0,0,,（チンピラＢ）20万？
Dialogue: 0,0:08:58.25,0:08:59.41,Default,,0,0,0,,200よ 200
Dialogue: 0,0:08:59.54,0:09:00.79,Default,,0,0,0,,（チンピラＢ）ちょっ ちょっと
Dialogue: 0,0:09:00.92,0:09:04.13,Default,,0,0,0,,それが嫌なら自分で始末すんのね\N食っちゃえば？
Dialogue: 0,0:09:04.25,0:09:05.88,Default,,0,0,0,,（スパイク）赤犬だしな
Dialogue: 0,0:09:06.30,0:09:07.09,Default,,0,0,0,,邪魔したな
Dialogue: 0,0:09:07.21,0:09:08.72,Default,,0,0,0,,続けてくれ
Dialogue: 0,0:09:09.51,0:09:10.68,Default,,0,0,0,,ああ…
Dialogue: 0,0:09:17.14,0:09:19.14,Default,,0,0,0,,北京ダックは ふかし過ぎたな
Dialogue: 0,0:09:19.60,0:09:21.10,Default,,0,0,0,,（チンピラＢ）せめて300くらい
Dialogue: 0,0:09:21.23,0:09:22.23,Default,,0,0,0,,（オーナー）駄目
Dialogue: 0,0:09:22.35,0:09:24.23,Default,,0,0,0,,（チンピラＢ）280\N（オーナー）駄目 駄目
Dialogue: 0,0:09:24.65,0:09:25.61,Default,,0,0,0,,250…
Dialogue: 0,0:09:25.73,0:09:27.94,Default,,0,0,0,,（ハキム）０だ　返してもらおう
Dialogue: 0,0:09:28.74,0:09:31.00,Default,,0,0,0,,またなの？ 今度は何？
Dialogue: 0,0:09:34.62,0:09:35.88,Default,,0,0,0,,（うなり声）
Dialogue: 0,0:09:36.04,0:09:36.71,Default,,0,0,0,,（銃声）
Dialogue: 0,0:09:37.21,0:09:37.84,Default,,0,0,0,,うん？
Dialogue: 0,0:09:39.63,0:09:43.05,Default,,0,0,0,,あーっ 誰かうちの子 捕まえて\Nあー 嫌
Dialogue: 0,0:09:43.38,0:09:44.55,Default,,0,0,0,,（男Ｂ）いました！\N（男Ａ）よし！
Dialogue: 0,0:09:46.39,0:09:49.56,Default,,0,0,0,,♪～
Dialogue: 0,0:09:50.39,0:09:51.98,Default,,0,0,0,,あっ ハキム
Dialogue: 0,0:09:52.52,0:09:54.39,Default,,0,0,0,,ちくしょう どうなってんだ？
Dialogue: 0,0:10:36.35,0:10:37.94,Default,,0,0,0,,（スパイク）どいた どいた
Dialogue: 0,0:10:38.23,0:10:39.40,Default,,0,0,0,,待て 待てー
Dialogue: 0,0:10:40.76,0:10:41.65,Default,,0,0,0,,おいおい なんだよ
Dialogue: 0,0:10:56.04,0:10:59.38,Default,,0,0,0,,賞金稼ぎか？\N動物愛護マフィアか？
Dialogue: 0,0:10:59.76,0:11:01.71,Default,,0,0,0,,泣かせる話じゃないか
Dialogue: 0,0:11:01.84,0:11:04.42,Default,,0,0,0,,たかが200ウーロンの犬のために\N命懸けか？
Dialogue: 0,0:11:04.59,0:11:05.51,Default,,0,0,0,,何だと？
Dialogue: 0,0:11:05.80,0:11:07.18,Default,,0,0,0,,俺が欲しいのは―
Dialogue: 0,0:11:07.30,0:11:10.47,Default,,0,0,0,,あんたの首にぶら下がってる\N800万ウーロンさ
Dialogue: 0,0:11:22.82,0:11:23.98,Default,,0,0,0,,やるじゃねえか
Dialogue: 0,0:11:24.57,0:11:25.11,Default,,0,0,0,,うん？
Dialogue: 0,0:11:25.28,0:11:25.90,Default,,0,0,0,,（スパイク）何っ？
Dialogue: 0,0:11:27.24,0:11:28.03,Default,,0,0,0,,～♪\N（スパイク）しまった\N（ハキム）ううーん
Dialogue: 0,0:11:28.03,0:11:29.61,Default,,0,0,0,,～♪
Dialogue: 0,0:11:29.61,0:11:30.87,Default,,0,0,0,,（叫び声）\N～♪
Dialogue: 0,0:11:30.87,0:11:31.99,Default,,0,0,0,,～♪
Dialogue: 0,0:11:39.50,0:11:43.04,Default,,0,0,0,,（鳴き声）
Dialogue: 0,0:11:43.17,0:11:46.17,Default,,0,0,0,,うるせえや\N俺は今 機嫌が悪いんだ
Dialogue: 0,0:12:00.02,0:12:03.31,Default,,0,0,0,,（ジェット）よーしよし\N首輪を付けてやろうな
Dialogue: 0,0:12:04.19,0:12:06.15,Default,,0,0,0,,アヒルのはずが犬とはな
Dialogue: 0,0:12:06.28,0:12:08.95,Default,,0,0,0,,（スパイク）そんなことより\N分かったのかよ？
Dialogue: 0,0:12:09.07,0:12:12.07,Default,,0,0,0,,ああ こいつはな\Nウェルシュ･コーギー
Dialogue: 0,0:12:12.20,0:12:13.74,Default,,0,0,0,,完璧な駄犬だ
Dialogue: 0,0:12:14.03,0:12:14.99,Default,,0,0,0,,完璧な？
Dialogue: 0,0:12:15.16,0:12:18.08,Default,,0,0,0,,完璧な　タダも同然だ
Dialogue: 0,0:12:18.50,0:12:21.25,Default,,0,0,0,,くっそお　胸くそ悪い
Dialogue: 0,0:12:21.37,0:12:23.59,Default,,0,0,0,,それもこれも\N全部 この駄犬のせい
Dialogue: 0,0:12:23.75,0:12:24.84,Default,,0,0,0,,だあーっ！
Dialogue: 0,0:12:25.00,0:12:26.38,Default,,0,0,0,,（痛がる声）
Dialogue: 0,0:12:26.50,0:12:29.72,Default,,0,0,0,,犬に価値はなくても\N飼い主には価値がある
Dialogue: 0,0:12:29.84,0:12:30.38,Default,,0,0,0,,（スパイク）ああ？
Dialogue: 0,0:12:30.51,0:12:33.34,Default,,0,0,0,,まあ せいぜい\Nこいつと仲良くなることだな
Dialogue: 0,0:12:33.51,0:12:36.56,Default,,0,0,0,,（スパイク）けっ\Nガキと けだもんは嫌いなんだよ
Dialogue: 0,0:12:36.68,0:12:38.73,Default,,0,0,0,,世話が焼けるったらねえぜ
Dialogue: 0,0:12:40.35,0:12:42.06,Default,,0,0,0,,（子供１）あっ かかった！
Dialogue: 0,0:12:42.19,0:12:44.81,Default,,0,0,0,,（子供２）ああ よし いいぞ\Nでかいぞ
Dialogue: 0,0:12:44.94,0:12:46.52,Default,,0,0,0,,（子供１）来たぞ\N（子供２）引け 引けー
Dialogue: 0,0:12:46.65,0:12:47.23,Default,,0,0,0,,（子供１）あっ
Dialogue: 0,0:12:47.86,0:12:48.99,Default,,0,0,0,,うわあっ
Dialogue: 0,0:12:49.15,0:12:52.24,Default,,0,0,0,,（子供たちのおびえる声）
Dialogue: 0,0:12:52.36,0:12:53.66,Default,,0,0,0,,今 何時だ？
Dialogue: 0,0:12:55.45,0:12:57.49,Default,,0,0,0,,ああっ ４時ですが
Dialogue: 0,0:12:58.45,0:13:00.00,Default,,0,0,0,,２時間後か
Dialogue: 0,0:13:00.58,0:13:01.46,Default,,0,0,0,,（子供たち）うわあ
Dialogue: 0,0:13:01.80,0:13:04.78,Default,,0,0,0,,（男Ａ）\Nあのハキムと一緒にいた男は\N仲間か
Dialogue: 0,0:13:05.13,0:13:06.67,Default,,0,0,0,,（男Ｂ）そのようで
Dialogue: 0,0:13:06.80,0:13:09.88,Default,,0,0,0,,（男Ａ）手がかりもないのか\N早く手を打たんと
Dialogue: 0,0:13:10.01,0:13:12.48,Default,,0,0,0,,あれが警察に渡ったら\Nまずいことになる
Dialogue: 0,0:13:12.60,0:13:13.52,Default,,0,0,0,,そのようで
Dialogue: 0,0:13:13.89,0:13:17.40,Default,,0,0,0,,（男Ａ）\Nわれわれの研究が明るみに出たら\N今までの苦労が台なしだ
Dialogue: 0,0:13:17.52,0:13:18.23,Default,,0,0,0,,そのようで
Dialogue: 0,0:13:18.57,0:13:21.74,Default,,0,0,0,,大体あのデータ犬に\Nいくらつぎ込んでると思ってるんだ
Dialogue: 0,0:13:22.82,0:13:24.78,Default,,0,0,0,,（スパイク）なんで そちらさんが\Nやらねんだよ
Dialogue: 0,0:13:24.95,0:13:27.24,Default,,0,0,0,,ばあちゃんに\N“やりかけたことは―”
Dialogue: 0,0:13:27.37,0:13:29.78,Default,,0,0,0,,“最後までやり通せ”って\N言われなかったか？
Dialogue: 0,0:13:30.55,0:13:32.20,Default,,0,0,0,,俺が生まれる前に死んでたよ
Dialogue: 0,0:13:32.33,0:13:33.50,Default,,0,0,0,,（子供たちの歓声）\N（ジェット）ああ そりゃ失礼
Dialogue: 0,0:13:33.50,0:13:33.62,Default,,0,0,0,,（子供たちの歓声）
Dialogue: 0,0:13:33.62,0:13:36.75,Default,,0,0,0,,（子供たちの歓声）\Nまっ とにかくジョーカーは\Nこっちが持ってるんだ
Dialogue: 0,0:13:36.92,0:13:39.00,Default,,0,0,0,,作戦どおり頼むぜ
Dialogue: 0,0:13:39.38,0:13:41.92,Default,,0,0,0,,（ハキム）\Nコードネーム･スヌープを頼む
Dialogue: 0,0:13:43.38,0:13:46.93,Default,,0,0,0,,そうだ 私だ　トラブルがあった
Dialogue: 0,0:13:48.26,0:13:50.81,Default,,0,0,0,,いや 大したことはないんだが…\Nうん？
Dialogue: 0,0:13:51.06,0:13:54.06,Default,,0,0,0,,（子供３）おい 待てよ マイケル\N（犬の鳴き声）
Dialogue: 0,0:13:54.48,0:13:57.35,Default,,0,0,0,,（ハキム）\N取引の時間を延ばしてもらいたい
Dialogue: 0,0:13:57.69,0:13:59.77,Default,,0,0,0,,いや 大したトラブルでは…
Dialogue: 0,0:14:01.60,0:14:03.65,Default,,0,0,0,,無理だと？ なぜだ？\Nおい 待て
Dialogue: 0,0:14:04.19,0:14:04.90,Default,,0,0,0,,（通話が切れた音）
Dialogue: 0,0:14:05.90,0:14:06.91,Default,,0,0,0,,（ハキム）うーん
Dialogue: 0,0:14:11.78,0:14:13.82,Default,,0,0,0,,これが作戦ねぇ
Dialogue: 0,0:14:18.16,0:14:23.00,Default,,0,0,0,,（親父）そこのあんた\Nずばり知りたいことがあるね？
Dialogue: 0,0:14:23.37,0:14:25.04,Default,,0,0,0,,いやいや 待たれい
Dialogue: 0,0:14:25.17,0:14:29.17,Default,,0,0,0,,うちのピーコちゃんが\N何でもお答えしようぞ
Dialogue: 0,0:14:29.84,0:14:32.76,Default,,0,0,0,,お客さん\N分からないことがあるじゃろ
Dialogue: 0,0:14:33.21,0:14:36.26,Default,,0,0,0,,ほーら ピーコちゃんが言っておる
Dialogue: 0,0:14:36.43,0:14:40.22,Default,,0,0,0,,あんたには\N探し物か尋ね人があるとな
Dialogue: 0,0:14:44.60,0:14:48.77,Default,,0,0,0,,さあーて\N犬のいる所にハキムありと
Dialogue: 0,0:14:49.65,0:14:51.11,Default,,0,0,0,,感度良好
Dialogue: 0,0:14:51.94,0:14:54.19,Default,,0,0,0,,頼んだぜ ワンちゃんよ
Dialogue: 0,0:14:55.20,0:14:57.74,Default,,0,0,0,,（男Ａ）やむを得ん\N犬笛を使うぞ
Dialogue: 0,0:14:57.86,0:14:59.91,Default,,0,0,0,,しかし あれは面倒なことに
Dialogue: 0,0:15:00.03,0:15:00.87,Default,,0,0,0,,（男Ａ）構わん
Dialogue: 0,0:15:01.03,0:15:02.24,Default,,0,0,0,,目立ちますよ
Dialogue: 0,0:15:02.45,0:15:03.70,Default,,0,0,0,,（男Ａ）背に腹は代えられん
Dialogue: 0,0:15:03.83,0:15:04.87,Default,,0,0,0,,やりますか？
Dialogue: 0,0:15:05.00,0:15:06.00,Default,,0,0,0,,やってくれ
Dialogue: 0,0:15:14.71,0:15:16.17,Default,,0,0,0,,何も聞こえないぞ
Dialogue: 0,0:15:16.30,0:15:18.72,Default,,0,0,0,,だから人間には聞こえないんですよ
Dialogue: 0,0:15:18.89,0:15:20.76,Default,,0,0,0,,そうか　そうだった
Dialogue: 0,0:15:21.14,0:15:24.14,Default,,0,0,0,,気のなげえ話だよな たく
Dialogue: 0,0:15:25.10,0:15:27.73,Default,,0,0,0,,こんなんで本当に寄ってくんのかね
Dialogue: 0,0:15:28.06,0:15:28.77,Default,,0,0,0,,あっ
Dialogue: 0,0:15:32.15,0:15:33.44,Default,,0,0,0,,（親父）ほおーっ
Dialogue: 0,0:15:33.69,0:15:36.82,Default,,0,0,0,,動き出した　何かが動き出したよ
Dialogue: 0,0:15:39.07,0:15:42.83,Default,,0,0,0,,ああ ちょっと あんたたち\Nどうしたっていうの？
Dialogue: 0,0:15:44.29,0:15:46.41,Default,,0,0,0,,ああっ おい 待て！
Dialogue: 0,0:15:46.58,0:15:51.92,Default,,0,0,0,,（犬たちの鳴き声）
Dialogue: 0,0:15:52.09,0:15:53.46,Default,,0,0,0,,逃げた！ ジェット
Dialogue: 0,0:15:53.67,0:15:55.46,Default,,0,0,0,,ああっ？ ハキムが？
Dialogue: 0,0:15:55.59,0:15:56.42,Default,,0,0,0,,（スパイク）犬だ！
Dialogue: 0,0:15:56.59,0:16:00.93,Default,,0,0,0,,近い！ 近いよ\N探し物は もうすぐ そこじゃ
Dialogue: 0,0:16:01.18,0:16:04.01,Default,,0,0,0,,本当にすぐ目の前に
Dialogue: 0,0:16:04.72,0:16:05.47,Default,,0,0,0,,うん？
Dialogue: 0,0:16:06.21,0:16:07.92,Default,,0,0,0,,ああ ちょっと！ お代は？
Dialogue: 0,0:16:08.08,0:16:09.00,Default,,0,0,0,,（ハキム）出世払いだ
Dialogue: 0,0:16:09.13,0:16:10.67,Default,,0,0,0,,ええ？ そんな…
Dialogue: 0,0:16:18.47,0:16:20.64,Default,,0,0,0,,ちくしょう\N何が起こったってんだ？
Dialogue: 0,0:16:20.76,0:16:23.48,Default,,0,0,0,,（拍手）
Dialogue: 0,0:16:26.85,0:16:27.94,Default,,0,0,0,,（新郎）幸せかい？
Dialogue: 0,0:16:28.06,0:16:29.73,Default,,0,0,0,,（新婦）ええ とっても
Dialogue: 0,0:16:30.19,0:16:30.86,Default,,0,0,0,,（新郎）うん？
Dialogue: 0,0:16:32.33,0:16:33.15,Default,,0,0,0,,（新郎）あの…\N（ハキム）どけ
Dialogue: 0,0:16:33.15,0:16:34.07,Default,,0,0,0,,（新婦の悲鳴）
Dialogue: 0,0:16:37.94,0:16:40.16,Default,,0,0,0,,あなた 何をしますか？
Dialogue: 0,0:16:43.23,0:16:43.93,Default,,0,0,0,,（スパイク）ハキム！
Dialogue: 0,0:16:45.87,0:16:46.75,Default,,0,0,0,,うわっ
Dialogue: 0,0:16:52.92,0:16:53.71,Default,,0,0,0,,しまった！
Dialogue: 0,0:16:55.82,0:16:57.49,Default,,0,0,0,,しょせんは犬か
Dialogue: 0,0:17:02.96,0:17:03.87,Default,,0,0,0,,ハキム
Dialogue: 0,0:17:06.00,0:17:08.67,Default,,0,0,0,,（ジェット）スパイク\Nやつは第６インターに向かってるぜ
Dialogue: 0,0:17:08.84,0:17:12.01,Default,,0,0,0,,（スパイク）上等だ\N逃げられるもんなら逃げてみろ
Dialogue: 0,0:17:12.13,0:17:13.76,Default,,0,0,0,,あんまり熱くなるなよ
Dialogue: 0,0:17:14.05,0:17:15.93,Default,,0,0,0,,俺のどこが熱くなってるよ
Dialogue: 0,0:17:20.89,0:17:21.68,Default,,0,0,0,,いやがった
Dialogue: 0,0:17:39.33,0:17:40.66,Default,,0,0,0,,さっきのお返しだ
Dialogue: 0,0:17:49.85,0:17:52.17,Default,,0,0,0,,何しやがる！ こいつは俺のもんだ
Dialogue: 0,0:17:57.03,0:17:57.64,Default,,0,0,0,,（ほえる声）
Dialogue: 0,0:17:57.76,0:17:58.68,Default,,0,0,0,,（ハキム）うおっ
Dialogue: 0,0:18:01.42,0:18:02.17,Default,,0,0,0,,何だ？
Dialogue: 0,0:18:02.63,0:18:03.30,Default,,0,0,0,,今だ！
Dialogue: 0,0:18:06.43,0:18:07.14,Default,,0,0,0,,（ハキム）やめろ
Dialogue: 0,0:18:09.31,0:18:10.31,Default,,0,0,0,,くそお
Dialogue: 0,0:18:11.06,0:18:11.89,Default,,0,0,0,,（鳴き声）
Dialogue: 0,0:18:13.64,0:18:14.27,Default,,0,0,0,,くそお
Dialogue: 0,0:18:14.98,0:18:17.11,Default,,0,0,0,,だから けだもんは嫌いなんだよ
Dialogue: 0,0:18:29.20,0:18:33.87,Default,,0,0,0,,（叫び声）
Dialogue: 0,0:18:38.88,0:18:40.13,Default,,0,0,0,,アミーゴ！
Dialogue: 0,0:18:40.25,0:18:43.51,Default,,0,0,0,,太陽系30万の賞金稼ぎのみんな\N元気かい？
Dialogue: 0,0:18:43.63,0:18:47.55,Default,,0,0,0,,（ジュディ）\N指名手配者情報をお伝えする\Nビッグショットの時間よ
Dialogue: 0,0:18:47.68,0:18:50.97,Default,,0,0,0,,（パンチ）さて 先週ひどーく\N派手な方法で自首した
Dialogue: 0,0:18:51.10,0:18:53.06,Default,,0,0,0,,アブドゥル･ハキムのことは\N覚えてるよな？
Dialogue: 0,0:18:53.18,0:18:54.77,Default,,0,0,0,,（ジュディ）うーん もちろんよ！
Dialogue: 0,0:18:54.89,0:18:56.31,Default,,0,0,0,,（パンチ）彼が盗んだのは
Dialogue: 0,0:18:56.44,0:18:59.23,Default,,0,0,0,,ある研究機関が\N非合法に育てていた―
Dialogue: 0,0:18:59.36,0:19:02.02,Default,,0,0,0,,データ犬って\N犬だったらしいってことだそうだ
Dialogue: 0,0:19:02.15,0:19:03.94,Default,,0,0,0,,（ジュディ）うわっ 何それ？
Dialogue: 0,0:19:04.07,0:19:05.78,Default,,0,0,0,,（パンチ）\Nああ 俺もよく分かんないけど
Dialogue: 0,0:19:05.90,0:19:08.95,Default,,0,0,0,,要するに とっても頭のいい\Nワンちゃんってことかな
Dialogue: 0,0:19:09.07,0:19:12.66,Default,,0,0,0,,何でもコレクターの間では\N天文学的な値段がついてるそうだ
Dialogue: 0,0:19:12.83,0:19:14.58,Default,,0,0,0,,あーら びっくり
Dialogue: 0,0:19:14.70,0:19:17.50,Default,,0,0,0,,そんなワンちゃんなら\N私が飼ってみたいわ
Dialogue: 0,0:19:17.62,0:19:20.00,Default,,0,0,0,,あー でも\N行方不明のままなんだって
Dialogue: 0,0:19:20.17,0:19:22.09,Default,,0,0,0,,（ジュディ）一体どこへ\N行っちゃったのかしらねえ
Dialogue: 0,0:19:22.21,0:19:24.88,Default,,0,0,0,,（パンチ）全くだ\Nさて ＣＭタイムだ
Dialogue: 0,0:19:25.01,0:19:26.22,Default,,0,0,0,,ああ？
Dialogue: 0,0:19:27.30,0:19:28.76,Default,,0,0,0,,まさかね
Dialogue: 0,0:19:29.09,0:19:33.56,Default,,0,0,0,,ほらほら 掃除が済んだら\Nコモドドラゴンちゃんにご飯よ
Dialogue: 0,0:19:34.22,0:19:36.10,Default,,0,0,0,,きりっきり働いて頂戴！
Dialogue: 0,0:19:36.23,0:19:37.23,Default,,0,0,0,,へーい
Dialogue: 0,0:19:38.39,0:19:39.06,Default,,0,0,0,,あーあ
Dialogue: 0,0:19:39.23,0:19:41.27,Default,,0,0,0,,（犬の鳴き声）\N（ジェット）おいおい
Dialogue: 0,0:19:44.18,0:19:46.32,Default,,0,0,0,,おい そこに上がるなっつうの
Dialogue: 0,0:19:47.28,0:19:48.15,Default,,0,0,0,,冷てっ
Dialogue: 0,0:19:49.82,0:19:52.91,Default,,0,0,0,,だから こんな駄犬\N放り出しちまおうって言ったんだ
Dialogue: 0,0:19:53.03,0:19:55.45,Default,,0,0,0,,（ジェット）\N連れてきたのはお前だろ
Dialogue: 0,0:19:55.58,0:19:58.25,Default,,0,0,0,,とにかく ダニを何とかしないとな
Dialogue: 0,0:19:58.92,0:20:02.46,Default,,0,0,0,,くそーっ　塩振って食っちまうぞ
Dialogue: 0,0:20:03.13,0:20:05.34,Default,,0,0,0,,それでは また\Nシーユーネクストタイム！
Dialogue: 0,0:20:05.51,0:20:07.26,Default,,0,0,0,,グッドラック
Dialogue: 0,0:20:10.81,0:20:17.81,Default,,0,0,0,,♪～
Dialogue: 0,0:21:38.51,0:21:45.52,Default,,0,0,0,,～♪
Dialogue: 0,0:21:48.28,0:21:51.04,Default,,0,0,0,,（フェイ）\N諸行無常がこの世のおきて
Dialogue: 0,0:21:52.34,0:21:54.54,Default,,0,0,0,,盛者必衰の鐘が鳴る
Dialogue: 0,0:21:54.92,0:21:57.25,Default,,0,0,0,,金は天下の回り物だが―
Dialogue: 0,0:21:58.01,0:22:00.67,Default,,0,0,0,,いつの日からか借金の山
Dialogue: 0,0:22:02.15,0:22:06.89,Default,,0,0,0,,流れ流れて宇宙のかなた\N出会いましたはカウボーイ
Dialogue: 0,0:22:07.56,0:22:11.81,Default,,0,0,0,,調子っぱずれのメロディーで\N奏でるセッション
