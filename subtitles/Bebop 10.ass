Comment: 0,0:22:34.94,0:26:36.50,Main,,0,0,0,,========= ED =========
Dialogue: 0,0:22:46.80,0:22:52.27,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}Cứ mải than thân trách phận, cho mối tình xưa,
Dialogue: 0,0:22:52.27,0:22:57.69,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}dòng thời gian vẫn lẳng lặng trôi, đã bao lâu rồi?
Dialogue: 0,0:22:58.77,0:23:04.32,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}Vết bỏng hằn sâu trong tim, nào có nguôi đi,
Dialogue: 0,0:23:04.32,0:23:09.53,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}gió chẳng thể xoa dịu cho tôi, chỉ biết thổi thôi.
Dialogue: 0,0:23:10.79,0:23:20.05,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}Với con ngươi khô, với tròng mắt cạn, ai đó ơi, giúp tôi đổ lệ đi!
Dialogue: 0,0:23:21.67,0:23:25.22,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}Giai điệu Folk Blues đích thực!
Dialogue: 0,0:23:21.67,0:23:25.22,GT,,0,0,0,,{\fad(0,300)\bord0\shad0\blur0.67}(Blues còn có nghĩa là u sầu, buồn bã)
Dialogue: 0,0:23:25.22,0:23:28.76,ED-Vie,,0,0,0,,{\fad(300,0)\blur0.67}Đâu là thật đây?
Dialogue: 0,0:23:29.47,0:23:33.81,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}Tôi chỉ muốn biết đâu là u sầu thật sự.
Dialogue: 0,0:23:33.81,0:23:37.35,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}Toàn thân lấm lem phù sa.
Dialogue: 0,0:23:37.35,0:23:40.77,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}Ngụp lặn giữa sông.
Dialogue: 0,0:23:41.44,0:23:45.95,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}Sống như vậy cũng đâu đến nỗi tệ,
Dialogue: 0,0:23:45.95,0:23:54.79,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}miễn sao chỉ phải... cam chịu một lần.
Comment: 0,0:01:31.03,0:01:31.07,Main,,0,0,0,,========= Dialogue =========
Dialogue: 0,0:01:45.04,0:01:46.74,Main,,0,0,0,,{\i1}Câm mồm!{\i0}
Dialogue: 0,0:02:02.83,0:02:04.40,Main,,0,0,0,,Ui da...
Dialogue: 0,0:02:22.49,0:02:23.57,Main,,0,0,0,,C-Cái gì—?
Dialogue: 0,0:03:04.41,0:03:05.45,Main,,0,0,0,,Này, Jet.
Dialogue: 0,0:03:06.80,0:03:09.23,Main,,0,0,0,,Tôi hỏi là\Nbao lâu nữa thì hạ cánh đấy.
Dialogue: 0,0:03:12.75,0:03:14.82,Main,,0,0,0,,Anh đứng đó từ bao giờ thế?
Dialogue: 0,0:03:14.82,0:03:16.60,Main,,0,0,0,,Từ nãy rồi.
Dialogue: 0,0:03:16.60,0:03:17.62,Main,,0,0,0,,Vậy à.
Dialogue: 0,0:03:17.62,0:03:19.17,Main,,0,0,0,,Ngẩn ngơ gì thế?
Dialogue: 0,0:03:19.83,0:03:21.89,Main,,0,0,0,,Tiền thưởng của tôi đâu?
Dialogue: 0,0:03:21.89,0:03:25.75,Main,,0,0,0,,Mau hạ cánh để còn giao nộp\Ncái gã nhìn đã thấy ngột ngạt kia đi chứ.
Dialogue: 0,0:03:26.71,0:03:29.64,Main,,0,0,0,,Này, anh còn chưa xin phép hạ cánh à?
Dialogue: 0,0:03:30.10,0:03:33.43,Main,,0,0,0,,Biết rồi. Mấy người lắm mồm thật.
Dialogue: 0,0:03:33.43,0:03:35.39,Main,,0,0,0,,Đừng có cuống lên thế.
Dialogue: 0,0:03:36.33,0:03:37.86,Main,,0,0,0,,Phía sân bay nhờ anh đấy.
Dialogue: 0,0:03:40.65,0:03:43.36,Main,,0,0,0,,{\i1}Ganymede là quê của anh đúng không?{\i0}
Dialogue: 0,0:03:43.88,0:03:47.87,Main,,0,0,0,,Chắc là đang nhớ lại\Ncô nào anh từng làm cho khóc chứ gì?
Dialogue: 0,0:03:53.49,0:03:56.09,Main,,0,0,0,,Hay là cô nào từng làm anh khóc?
Dialogue: 0,0:03:56.09,0:03:58.37,Main,,0,0,0,,Không nghe tôi bảo im đi à!
Dialogue: 0,0:03:58.37,0:03:59.07,Main,,0,0,0,,{\i1}A lô.{\i0}
Dialogue: 0,0:04:00.63,0:04:02.26,Main,,0,0,0,,{\i1}Cảnh sát Ganymede đây.{\i0}
Dialogue: 0,0:04:04.53,0:04:05.82,Main,,0,0,0,,Donelly?
Dialogue: 0,0:04:05.82,0:04:08.01,Main,,0,0,0,,{\i1}Ồ, Jet! Là Jet đấy à!{\i0}
Dialogue: 0,0:04:08.70,0:04:10.60,Main,,0,0,0,,{\i1}Ôi chao, đúng là cậu rồi.{\i0}
Dialogue: 0,0:04:10.60,0:04:14.53,Main,,0,0,0,,{\i1}Đầu tóc thì trống trơn rồi,\Nnhưng đúng là Jet thật.{\i0}
Dialogue: 0,0:04:14.53,0:04:16.98,Main,,0,0,0,,Lâu rồi không gặp, Donelly.
Dialogue: 0,0:04:16.98,0:04:20.69,Main,,0,0,0,,{\i1}Ngạc nhiên đấy.\NLần cuối cậu còn làm ở đây là...{\i0}
Dialogue: 0,0:04:21.45,0:04:23.59,Main,,0,0,0,,{\i1}7, 8 năm trước nhỉ?{\i0}
Dialogue: 0,0:04:23.59,0:04:26.16,Main,,0,0,0,,{\i1}Có chuyện gì mà đột ngột về thế?{\i0}
Dialogue: 0,0:04:26.16,0:04:28.62,Main,,0,0,0,,Tôi muốn giao nộp một kẻ bị truy nã.
Dialogue: 0,0:04:28.62,0:04:32.90,Main,,0,0,0,,Mã truy nã EX41285. Baker Panchorero.
Dialogue: 0,0:04:34.18,0:04:37.09,Main,,0,0,0,,{\i1}Hừm, cậu giờ lại đi săn tiền thưởng à.{\i0}
Dialogue: 0,0:04:38.46,0:04:40.91,Main,,0,0,0,,{\i1}Cậu, con chó dại\Nđã cắn là không nhả,{\i0}
Dialogue: 0,0:04:40.91,0:04:43.67,Main,,0,0,0,,{\i1}biệt danh người ta gọi là "Chó Mực" ấy à?{\i0}
Dialogue: 0,0:04:43.67,0:04:46.93,Main,,0,0,0,,Tôi lại tưởng ông nghỉ hưu từ lâu rồi chứ.
Dialogue: 0,0:04:46.93,0:04:50.35,Main,,0,0,0,,{\i1}Cái gì? Tôi đây vẫn còn đương chức nhá!{\i0}
Dialogue: 0,0:04:50.35,0:04:54.30,Main,,0,0,0,,{\i1}Đừng lấy tốc độ của cậu ra mà đo thời gian,\Nđồ Từ Thức về trần này.{\i0}
Dialogue: 0,0:04:54.30,0:04:56.67,Main - Alt,,0,0,0,,Ví von ngược rồi đấy!
Dialogue: 0,0:04:54.30,0:04:58.20,Main,,0,0,0,,Hả? Hóa ra từng là cớm à? Thảo nào...
Dialogue: 0,0:04:56.67,0:05:00.01,Main - Alt,,0,0,0,,{\i1}Sao cũng được.\NThấy cậu khỏe mạnh là mừng rồi.{\i0}
Dialogue: 0,0:04:58.20,0:04:59.05,Main,,0,0,0,,Sao thế?
Dialogue: 0,0:05:00.01,0:05:02.49,Main,,0,0,0,,...tôi thấy không hợp với anh ấy.
Dialogue: 0,0:05:00.01,0:05:02.49,Main - Alt,,0,0,0,,Ông cũng thế.
Dialogue: 0,0:05:02.49,0:05:05.25,Main,,0,0,0,,{\i1}À phải, cô ấy tên gì nhỉ...{\i0}
Dialogue: 0,0:05:06.31,0:05:07.27,Main,,0,0,0,,{\i1}Cái cô...{\i0}
Dialogue: 0,0:05:08.32,0:05:09.33,Main,,0,0,0,,{\i1}Phải rồi! Alisa!{\i0}
Dialogue: 0,0:05:17.60,0:05:21.88,Main,,0,0,0,,{\i1}Cô ấy mở quán ở cảng Marvis đấy.{\i0}
Dialogue: 0,0:05:21.88,0:05:25.45,Main,,0,0,0,,{\i1}Một quán rượu nhỏ tên là "La Fin".{\i0}
Dialogue: 0,0:05:25.45,0:05:30.75,Main,,0,0,0,,{\i1}Nhưng thời buổi khó khăn,\Nnghe nói cô ấy nợ nần chồng chất.{\i0}
Dialogue: 0,0:05:30.75,0:05:36.31,Main,,0,0,0,,{\i1}Phụ nữ sống một thân một mình\Nthì kiểu gì cũng vất vả mà.{\i0}
Dialogue: 0,0:06:25.19,0:06:27.72,Main,,0,0,0,,Sến quá đi mất.
Dialogue: 0,0:06:27.72,0:06:30.23,Main,,0,0,0,,Lâu lâu mới về quê,\Nghé thăm cũng phải thôi.
Dialogue: 0,0:06:30.87,0:06:35.42,Main,,0,0,0,,Nghĩ người yêu cũ đến giờ\Nvẫn còn nhớ mình thì sai bét.
Dialogue: 0,0:06:37.15,0:06:41.22,Main,,0,0,0,,Nghĩ phụ nữ ai cũng như mình\Nthì mới sai bét đấy.
Dialogue: 0,0:06:41.22,0:06:43.88,Main,,0,0,0,,Sến súa, sến súa, sến sẩm, sến sẩm~
Dialogue: 0,0:06:46.15,0:06:47.85,Main,,0,0,0,,Đàn ông đúng là...
Dialogue: 0,0:06:53.42,0:06:56.28,Main,,0,0,0,,một lũ lãng mạn hết thuốc chữa.
Dialogue: 0,0:06:59.18,0:07:02.27,Main,,0,0,0,,Này này, sao chị bôi bôi trát trát thế?
Dialogue: 0,0:07:02.95,0:07:07.89,Main,,0,0,0,,Muốn giữ làn da đẹp là phải kiên trì\N làm mấy việc tưởng như vô ích đấy.
Dialogue: 0,0:07:07.89,0:07:08.69,Main,,0,0,0,,Hiểu chưa?
Dialogue: 0,0:07:12.45,0:07:15.36,Main,,0,0,0,,Hiểu rồi! Vô ích! Vô ích~!
Dialogue: 0,0:07:32.99,0:07:33.89,Main,,0,0,0,,Đây là
Dialogue: 0,0:07:34.93,0:07:36.46,Main,,0,0,0,,quán La Fin phải không?
Dialogue: 0,0:07:37.75,0:07:39.77,Main,,0,0,0,,Ờ. Anh là ai?
Dialogue: 0,0:07:42.00,0:07:43.23,Main,,0,0,0,,Người quen cũ.
Dialogue: 0,0:07:44.04,0:07:46.19,Main,,0,0,0,,Lâu lắm mới ghé qua đây.
Dialogue: 0,0:07:47.00,0:07:49.40,Main,,0,0,0,,Alisa... không có ở đây.
Dialogue: 0,0:07:51.19,0:07:51.90,Main,,0,0,0,,Jet?
Dialogue: 0,0:07:54.33,0:07:55.62,Main,,0,0,0,,Không lẽ...
Dialogue: 0,0:07:55.62,0:07:57.20,Main,,0,0,0,,là Jet thật sao?
Dialogue: 0,0:07:59.64,0:08:00.33,Main,,0,0,0,,Rhint,
Dialogue: 0,0:08:00.89,0:08:03.28,Main,,0,0,0,,anh ấy là khách của em.
Dialogue: 0,0:08:03.95,0:08:04.79,Main,,0,0,0,,Không sao đâu.
Dialogue: 0,0:08:10.91,0:08:12.26,Main,,0,0,0,,Thế có sao không?
Dialogue: 0,0:08:12.26,0:08:13.23,Main,,0,0,0,,Không đâu.
Dialogue: 0,0:08:14.07,0:08:15.24,Main,,0,0,0,,Mà này,
Dialogue: 0,0:08:15.78,0:08:17.56,Main,,0,0,0,,anh uống một cốc chứ?
Dialogue: 0,0:08:24.11,0:08:26.35,Main,,0,0,0,,Anh là vị khách cuối cùng đấy.
Dialogue: 0,0:08:27.72,0:08:28.94,Main,,0,0,0,,Em đóng cửa quán rồi.
Dialogue: 0,0:08:29.71,0:08:33.22,Main,,0,0,0,,Tàu thuyền ít dần,\Nquanh đây cũng vắng vẻ đi nhiều.
Dialogue: 0,0:08:33.22,0:08:35.50,Main,,0,0,0,,Em định chuyển đến một thị trấn mới.
Dialogue: 0,0:08:36.85,0:08:38.33,Main,,0,0,0,,Liệu có ổn không?
Dialogue: 0,0:08:39.50,0:08:43.31,Main,,0,0,0,,Ở các thành phố nổi mới,\Ntiền thuê mặt bằng cũng cao,
Dialogue: 0,0:08:43.90,0:08:45.25,Main,,0,0,0,,chắc vất vả lắm nhỉ?
Dialogue: 0,0:08:49.01,0:08:51.76,Main,,0,0,0,,Anh vẫn thế, cứ lo mấy chuyện đó.
Dialogue: 0,0:08:53.35,0:08:55.38,Main,,0,0,0,,Em muốn đổi gió ở thị trấn mới.
Dialogue: 0,0:08:56.45,0:08:58.94,Main,,0,0,0,,Đừng lo. Còn có Rhint nữa mà.
Dialogue: 0,0:09:02.60,0:09:04.19,Main,,0,0,0,,Gã ban nãy à?
Dialogue: 0,0:09:04.19,0:09:05.31,Main,,0,0,0,,Anh để tâm à?
Dialogue: 0,0:09:06.75,0:09:07.90,Main,,0,0,0,,Có chứ.
Dialogue: 0,0:09:07.90,0:09:10.40,Main,,0,0,0,,Thật ra em có ba đứa con rồi.
Dialogue: 0,0:09:13.04,0:09:14.91,Main,,0,0,0,,Đùa thôi, đùa đấy.
Dialogue: 0,0:09:15.48,0:09:17.42,Main,,0,0,0,,Rhint chỉ là người yêu thôi.
Dialogue: 0,0:09:18.37,0:09:20.43,Main,,0,0,0,,Còn anh dạo này thế nào?
Dialogue: 0,0:09:20.43,0:09:21.74,Main,,0,0,0,,Lấy vợ chưa?
Dialogue: 0,0:09:21.74,0:09:24.64,Main,,0,0,0,,Anh sống lang bạt\Ncùng một lũ dở hơi.
Dialogue: 0,0:09:25.60,0:09:28.00,Main,,0,0,0,,Làm cái nghề thợ săn tiền thưởng quèn.
Dialogue: 0,0:09:38.09,0:09:39.51,Main,,0,0,0,,Còn nhớ không?
Dialogue: 0,0:09:46.49,0:09:47.35,Main,,0,0,0,,{\i1}Jet đâu?{\i0}
Dialogue: 0,0:09:47.93,0:09:49.90,Main,,0,0,0,,Đi lo chút việc riêng rồi.
Dialogue: 0,0:09:49.90,0:09:52.02,Main,,0,0,0,,{\i1}Cậu là cộng sự của Jet phải không?{\i0}
Dialogue: 0,0:09:52.02,0:09:52.68,Main,,0,0,0,,Ờ.
Dialogue: 0,0:09:54.05,0:09:56.22,Main,,0,0,0,,{\i1}Có tin về một kẻ bị truy nã.{\i0}
Dialogue: 0,0:09:57.12,0:09:58.91,Main,,0,0,0,,{\i1}Tin này còn chưa công bố đâu.{\i0}
Dialogue: 0,0:10:03.47,0:10:05.56,Main,,0,0,0,,{\i1}Rhint Celonius,{\i0}
Dialogue: 0,0:10:05.56,0:10:08.37,Main,,0,0,0,,{\i1}một tên du côn ở cảng Marvis.{\i0}
Dialogue: 0,0:10:08.37,0:10:11.67,Main,,0,0,0,,{\i1}Tối qua... \N một gã môi giới tài chính tên là Lorenzo...{\i0}
Dialogue: 0,0:10:11.67,0:10:13.63,Main,,0,0,0,,{\i1}Vốn gã này cũng là loại chả ra gì,{\i0}
Dialogue: 0,0:10:14.81,0:10:15.90,Main,,0,0,0,,{\i1}đã bị hắn giết rồi.{\i0}
Dialogue: 0,0:10:16.47,0:10:17.60,Main,,0,0,0,,Rồi sao?
Dialogue: 0,0:10:19.09,0:10:21.31,Main,,0,0,0,,{\i1}Rhint là nhân tình của Alisa.{\i0}
Dialogue: 0,0:10:22.97,0:10:24.97,Main,,0,0,0,,{\i1}Tôi nghĩ nên báo cho các cậu biết.{\i0}
Dialogue: 0,0:10:27.15,0:10:29.35,Main,,0,0,0,,Thế tiền thưởng bao nhiêu?
Dialogue: 0,0:11:35.15,0:11:38.30,Main,,0,0,0,,Hồi đó, mỗi khi anh đi làm về,
Dialogue: 0,0:11:38.73,0:11:41.11,Main,,0,0,0,,em luôn đợi anh.
Dialogue: 0,0:11:41.11,0:11:44.26,Main,,0,0,0,,Với anh, thế là đủ rồi.
Dialogue: 0,0:11:48.01,0:11:49.54,Main,,0,0,0,,Nhưng hôm đó...
Dialogue: 0,0:11:54.48,0:11:58.38,Main,,0,0,0,,khi anh về nhà, \Nchỉ còn lại chiếc đồng hồ này,
Dialogue: 0,0:11:59.28,0:12:03.87,Main,,0,0,0,,cùng một lá thư\Nvỏn vẹn hai chữ "Vĩnh biệt".
Dialogue: 0,0:12:06.31,0:12:10.49,Main,,0,0,0,,Lạ thay, anh lại không thấy buồn.
Dialogue: 0,0:12:11.23,0:12:12.83,Main,,0,0,0,,Chỉ là...
Dialogue: 0,0:12:12.83,0:12:14.95,Main,,0,0,0,,mọi chuyện cứ như không có thật.
Dialogue: 0,0:12:16.22,0:12:22.39,Main,,0,0,0,,Rồi dần dần, anh cảm thấy\Ncó gì đó trong mình tê liệt đi.
Dialogue: 0,0:12:25.27,0:12:27.97,Main,,0,0,0,,Nửa năm sau,\N anh tự đánh cược với mình.
Dialogue: 0,0:12:28.56,0:12:33.35,Main,,0,0,0,,Nếu đến khi chiếc đồng hồ này dừng lại\Nmà em vẫn chưa về,
Dialogue: 0,0:12:34.52,0:12:36.86,Main,,0,0,0,,anh sẽ rời khỏi hành tinh này.
Dialogue: 0,0:12:39.13,0:12:41.68,Main,,0,0,0,,Anh không đến đây để trách em.
Dialogue: 0,0:12:41.68,0:12:44.42,Main,,0,0,0,,Anh chỉ muốn biết...
Dialogue: 0,0:12:46.02,0:12:48.97,Main,,0,0,0,,vì sao ngày đó em bỏ đi.
Dialogue: 0,0:12:52.08,0:12:53.74,Main,,0,0,0,,Trong anh,
Dialogue: 0,0:12:55.21,0:12:58.07,Main,,0,0,0,,thời gian ở Ganymede\Nvẫn như ngừng trôi vậy.
Dialogue: 0,0:13:01.11,0:13:03.10,Main,,0,0,0,,Chuyện xa xưa rồi.
Dialogue: 0,0:13:05.70,0:13:08.25,Main,,0,0,0,,Em... đã quên mất rồi.
Dialogue: 0,0:13:12.37,0:13:14.33,Main,,0,0,0,,Thời gian không trôi thì em không cần.
Dialogue: 0,0:13:16.42,0:13:18.49,Main,,0,0,0,,Vĩnh biệt, Jet.
Dialogue: 0,0:14:23.23,0:14:25.01,Main,,0,0,0,,Thợ săn tiền thưởng ư?
Dialogue: 0,0:14:25.01,0:14:26.26,Main,,0,0,0,,Không lẽ...
Dialogue: 0,0:14:27.88,0:14:28.94,Main,,0,0,0,,Rhint...
Dialogue: 0,0:14:28.94,0:14:30.49,Main,,0,0,0,,Hắn đến để dò la anh!
Dialogue: 0,0:14:31.03,0:14:33.78,Main,,0,0,0,,Khốn thật, mình bị treo thưởng rồi sao...
Dialogue: 0,0:14:34.96,0:14:37.68,Main,,0,0,0,,Hết thật rồi!
Dialogue: 0,0:14:40.69,0:14:42.47,Main,,0,0,0,,Không phải lỗi của anh.
Dialogue: 0,0:14:42.47,0:14:46.26,Main,,0,0,0,,Là tại em trót vay tiền của gã đó,
Dialogue: 0,0:14:47.76,0:14:50.02,Main,,0,0,0,,anh chỉ tìm cách bảo vệ em thôi mà.
Dialogue: 0,0:14:50.90,0:14:52.65,Main,,0,0,0,,Bị bắt là coi như xong đời đấy!
Dialogue: 0,0:14:53.74,0:14:54.60,Main,,0,0,0,,Anh đã...
Dialogue: 0,0:14:56.16,0:14:57.93,Main,,0,0,0,,giết người đấy.
Dialogue: 0,0:15:00.39,0:15:01.46,Main,,0,0,0,,Mình trốn đi.
Dialogue: 0,0:15:03.30,0:15:05.42,Main,,0,0,0,,Trốn đi, chỉ hai ta thôi!
Dialogue: 0,0:15:36.00,0:15:39.08,Main,,0,0,0,,Ăn ở tốt có khác.
Dialogue: 0,0:15:43.64,0:15:45.00,Main,,0,0,0,,Xin lỗi nhé, làm ăn mà.
Dialogue: 0,0:16:01.09,0:16:02.02,Main,,0,0,0,,Cầm lái hộ anh!
Dialogue: 0,0:16:38.33,0:16:39.97,Main,,0,0,0,,{\i1}Này, sao thế?{\i0}
Dialogue: 0,0:16:39.97,0:16:42.29,Main,,0,0,0,,Tôi đang đuổi theo\Nmột kẻ đáng giá 1,8 triệu.
Dialogue: 0,0:16:42.29,0:16:43.41,Main,,0,0,0,,{\i1}Cái gì?{\i0}
Dialogue: 0,0:16:43.41,0:16:44.73,Main,,0,0,0,,{\i1}Tôi gửi qua bên đó đây.{\i0}
Dialogue: 0,0:16:45.98,0:16:48.10,Main,,0,0,0,,Hắn bị truy nã à?
Dialogue: 0,0:16:48.10,0:16:50.85,Main,,0,0,0,,{\i1}Ờ, tin mật từ Donelly.{\i0}
Dialogue: 0,0:16:50.85,0:16:52.80,Main,,0,0,0,,{\i1}Hình như hắn giết một tên cho vay nặng lãi.{\i0}
Dialogue: 0,0:16:54.55,0:16:55.66,Main,,0,0,0,,Bà mẹ!
Dialogue: 0,0:17:01.76,0:17:04.16,Main,,0,0,0,,{\i1}Vụ này để tôi lo. Anh quay về đi.{\i0}
Dialogue: 0,0:17:06.44,0:17:09.03,Main,,0,0,0,,Không định tha cho hắn đấy chứ?
Dialogue: 0,0:17:09.03,0:17:11.59,Main,,0,0,0,,{\i1}Đây là nơi tôi từng làm cảnh sát đấy.{\i0}
Dialogue: 0,0:17:12.36,0:17:15.05,Main,,0,0,0,,Tôi là Chó Mực,\Nđã cắn là không nhả.
Dialogue: 0,0:17:17.63,0:17:21.77,Main,,0,0,0,,{\i1}Với cô ấy tôi chẳng còn vương vấn,\Nnhưng chuyện trên địa bàn này để tôi tự dứt điểm.{\i0}
Dialogue: 0,0:17:23.30,0:17:25.81,Main,,0,0,0,,Đúng là sến thật đấy.
Dialogue: 0,0:17:31.43,0:17:32.40,Main,,0,0,0,,{\i1}Nghe thấy không?{\i0}
Dialogue: 0,0:17:33.56,0:17:35.36,Main,,0,0,0,,{\i1}Dừng thuyền lại ngay!{\i0}
Dialogue: 0,0:17:36.03,0:17:37.36,Main,,0,0,0,,Jet?
Dialogue: 0,0:19:44.40,0:19:45.40,Main,,0,0,0,,Đừng lại đây!
Dialogue: 0,0:19:48.17,0:19:50.16,Main,,0,0,0,,Xin anh, tha cho bọn em!
Dialogue: 0,0:19:53.63,0:19:57.34,Main,,0,0,0,,Kẻ bị truy nã đâu chỉ có mình anh ấy!
Dialogue: 0,0:19:58.85,0:20:00.54,Main,,0,0,0,,Dù anh có tha,
Dialogue: 0,0:20:01.84,0:20:04.06,Main,,0,0,0,,sớm muộn cũng sẽ có người khác đến.
Dialogue: 0,0:20:04.06,0:20:06.16,Main,,0,0,0,,Bỏ trốn cùng hắn,\Nem cũng thành đồng phạm đấy.
Dialogue: 0,0:20:06.16,0:20:06.81,Main,,0,0,0,,Đừng lại đây!
Dialogue: 0,0:20:08.74,0:20:10.68,Main,,0,0,0,,Bây giờ vẫn còn kịp.
Dialogue: 0,0:20:10.68,0:20:12.19,Main,,0,0,0,,Đừng bận tâm đến em nữa!
Dialogue: 0,0:20:26.50,0:20:28.16,Main,,0,0,0,,Hồi đó cũng vậy...
Dialogue: 0,0:20:29.84,0:20:31.66,Main,,0,0,0,,Chuyện gì cũng anh quyết,
Dialogue: 0,0:20:32.12,0:20:34.20,Main,,0,0,0,,và lúc nào anh cũng đúng.
Dialogue: 0,0:20:35.07,0:20:39.00,Main,,0,0,0,,Khi ở bên anh,\Nem chẳng bao giờ phải làm gì cả.
Dialogue: 0,0:20:39.75,0:20:44.64,Main,,0,0,0,,Em chỉ cần vô tư như một đứa trẻ,\Nbám lấy cánh tay anh là đủ.
Dialogue: 0,0:20:47.48,0:20:51.31,Main,,0,0,0,,Em muốn tự mình quyết định\Ncách mình sống.
Dialogue: 0,0:20:52.97,0:20:55.55,Main,,0,0,0,,Dù cho đó có là sai lầm.
Dialogue: 0,0:21:13.47,0:21:16.50,Main,,0,0,0,,Buông ra! Tao không muốn đi tù! Buông ra!
Dialogue: 0,0:21:16.95,0:21:19.50,Main,,0,0,0,,Cứu anh! Cứu anh với, xin em!
Dialogue: 0,0:21:26.45,0:21:27.86,Main,,0,0,0,,Mạnh mẽ lên,
Dialogue: 0,0:21:28.56,0:21:31.54,Main,,0,0,0,,và bảo vệ cô ấy.
Dialogue: 0,0:21:47.02,0:21:49.47,Main,,0,0,0,,Có vẻ sẽ xử theo hướng tự vệ chính đáng.
Dialogue: 0,0:21:54.01,0:21:55.60,Main,,0,0,0,,Giờ em định thế nào?
Dialogue: 0,0:21:56.27,0:21:58.17,Main,,0,0,0,,Em sẽ không đi đâu nữa.
Dialogue: 0,0:21:59.96,0:22:02.92,Main,,0,0,0,,Em sẽ ở quán đợi Rhint.
Dialogue: 0,0:22:04.12,0:22:05.88,Main,,0,0,0,,Có lẽ sẽ không lâu đâu,
Dialogue: 0,0:22:06.76,0:22:09.22,Main,,0,0,0,,vì thời gian vẫn đang trôi mà.
Dialogue: 0,0:24:10.51,0:24:14.09,Main,preview,0,0,0,,{\i1}Nỗi kinh hoàng chưa từng có\Ntấn công phi hành đoàn Bebop.{\i0}
Dialogue: 0,0:24:14.90,0:24:18.68,Main,preview,0,0,0,,{\i1}Sa vào nanh độc của kẻ thù vô hình,\Nlại thêm một nạn nhân gục ngã.{\i0}
Dialogue: 0,0:24:19.83,0:24:24.35,Main,preview,0,0,0,,{\i1}Kẻ thù đáng sợ không chịu lộ diện\Nrốt cuộc là ai?{\i0}
Dialogue: 0,0:24:25.68,0:24:30.29,Main,preview,0,0,0,,{\i1}Bản giao hưởng rùng rợn\Nsẽ đẩy bạn xuống tận đáy sâu của nỗi sợ!{\i0}
Dialogue: 0,0:24:30.29,0:24:33.98,Main,preview,0,0,0,,{\i1}Kỳ tới, "Điệu Heavy Rock trong đêm tối".{ĐỒ CHƠI TRÊN GÁC MÁI}{\i0}
Dialogue: 0,0:24:33.98,0:24:38.61,Main,preview,0,0,0,,{\i1}Một khi đã bật kênh này,\Nbạn sẽ không còn đường thoát...{\i0}
