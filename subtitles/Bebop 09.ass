Comment: 0,0:22:28.43,0:26:29.74,Main,,0,0,0,,========= ED =========
Dialogue: 0,0:22:40.09,0:22:45.51,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}Cứ mải than thân trách phận, cho mối tình xưa,
Dialogue: 0,0:22:45.51,0:22:50.93,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}dòng thời gian vẫn lẳng lặng trôi, đã bao lâu rồi?
Dialogue: 0,0:22:52.02,0:22:57.56,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}Vết bỏng hằn sâu trong tim, nào có nguôi đi,
Dialogue: 0,0:22:57.56,0:23:02.78,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}gió chẳng thể xoa dịu cho tôi, chỉ biết thổi thôi.
Dialogue: 0,0:23:04.03,0:23:13.29,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}Với con ngươi khô, với tròng mắt cạn, ai đó ơi, giúp tôi đổ lệ đi!
Dialogue: 0,0:23:14.91,0:23:18.46,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}Giai điệu Folk Blues đích thực!
Dialogue: 0,0:23:14.91,0:23:18.46,GT,,0,0,0,,{\fad(0,300)\bord0\shad0\blur0.67}(Blues còn có nghĩa là u sầu, buồn bã)
Dialogue: 0,0:23:18.46,0:23:22.01,ED-Vie,,0,0,0,,{\fad(300,0)\blur0.67}Đâu là thật đây?
Dialogue: 0,0:23:22.71,0:23:27.05,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}Tôi chỉ muốn biết đâu là u sầu thật sự.
Dialogue: 0,0:23:27.05,0:23:30.60,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}Toàn thân lấm lem phù sa.
Dialogue: 0,0:23:30.60,0:23:34.02,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}Ngụp lặn giữa sông.
Dialogue: 0,0:23:34.68,0:23:39.19,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}Sống như vậy cũng đâu đến nỗi tệ,
Dialogue: 0,0:23:39.19,0:23:48.03,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}miễn sao chỉ phải... cam chịu một lần.
Comment: 0,0:01:31.03,0:01:31.07,Main,,0,0,0,,========= Dialogue =========
Dialogue: 0,0:01:32.21,0:01:36.10,Main,,0,0,0,,{\i1}Ở đây... không có ai.{\i0}
Dialogue: 0,0:01:36.72,0:01:38.90,Main,,0,0,0,,{\i1}Mãi mãi... một mình.{\i0}
Dialogue: 0,0:02:16.86,0:02:21.32,Main,,0,0,0,,{\i1}Quận 38 trời nắng,\Nrải rác có mưa đá.{\i0}
Dialogue: 0,0:02:22.41,0:02:26.37,Main,,0,0,0,,{\i1}Khả năng có mưa đá hôm nay là 20%.{\i0}
Dialogue: 0,0:02:27.24,0:02:30.63,Main,,0,0,0,,{\i1}Quận 39 trời nhiều mây.{\i0}
Dialogue: 0,0:02:30.63,0:02:33.96,Main,,0,0,0,,{\i1}Khả năng có mưa đá chiều nay là 10%.{\i0}
Dialogue: 0,0:02:50.85,0:02:53.82,Main,,0,0,0,,Bebop tới rồi, tới rồi! Chào mừng~!
Dialogue: 0,0:03:08.11,0:03:11.95,Main,,0,0,0,,{\i1}Khả năng có mưa đá hôm nay là 90%.{\i0}
Dialogue: 0,0:03:12.99,0:03:14.21,Main,,0,0,0,,Ơ kìa?
Dialogue: 0,0:03:17.28,0:03:20.73,Main,,0,0,0,,{\i1}Sau đây là chuyên mục tin tức trong ngày.{\i0}
Dialogue: 0,0:03:20.73,0:03:23.77,Main,,0,0,0,,{\i1}Hôm nay, chúng ta sẽ cùng bàn về\Nnhững hình vẽ bí ẩn trên mặt đất{\i0}
Dialogue: 0,0:03:23.77,0:03:26.56,Main,,0,0,0,,{\i1}bỗng xuất hiện\Nở khu vực từng là Nam Mỹ.{\i0}
Dialogue: 0,0:03:26.56,0:03:30.23,Main,,0,0,0,,{\an8}{\i1}Như thường lệ, khách mời bình luận\Nlà nhà nghiên cứu hiện tượng siêu nhiên...{\i0}
Dialogue: 0,0:03:30.23,0:03:32.35,Main,,0,0,0,,{\an8}{\i1}Vâng, tôi là Yuri Kellerman.{\i0}
Dialogue: 0,0:03:32.95,0:03:36.18,Main,,0,0,0,,{\an8}{\i1}Thưa ông Yuri, về những hình vẽ lần này...{\i0}
Dialogue: 0,0:03:36.18,0:03:42.78,Main,,0,0,0,,{\i1}{\an8}À vâng, theo tôi thì,\Nđó chắc chắn là một kiểu thông điệp.{\i0}
Dialogue: 0,0:03:42.78,0:03:46.03,Main,,0,0,0,,{\an8}{\i1}Ơ... thông điệp từ ai cơ? Chẳng lẽ...{\i0}
Dialogue: 0,0:03:46.80,0:03:49.67,Main,,0,0,0,,{\i1}Người ngoài hành tinh! Còn ai vào đây nữa!{\i0}
Dialogue: 0,0:03:49.67,0:03:56.44,Main,,0,0,0,,{\i1}Nhưng những hình vẽ lần này\Nlà do tia laser bắn từ vệ tinh tạo nên.{\i0}
Dialogue: 0,0:03:56.44,0:04:01.25,Main,,0,0,0,,{\i1}Cảnh sát cho rằng đây là trò đùa\Ncủa một hacker đã xâm nhập vệ tinh.{\i0}
Dialogue: 0,0:04:01.25,0:04:06.35,Main,,0,0,0,,{\i1}Và thực tế đã treo thưởng\N8 triệu ô long cho thủ phạm.{\i0}
Dialogue: 0,0:04:06.35,0:04:10.34,Main,,0,0,0,,{\i1}Nghe này. Khoản tiền thưởng 8 triệu đó\Nlà âm mưu của chính phủ.{\i0}
Dialogue: 0,0:04:10.34,0:04:13.48,Main,,0,0,0,,{\i1}Cứ cho là mấy hình đó\N được vẽ bằng tia laser đi nữa,{\i0}
Dialogue: 0,0:04:13.48,0:04:19.11,Main,,0,0,0,,{\i1}thì vẫn có khả năng người ngoài hành tinh\Nđã gửi thông điệp vào đầu tên hacker.{\i0}
Dialogue: 0,0:04:19.11,0:04:21.78,Main,,0,0,0,,{\an8}{\i1}Chính phủ lại đang che giấu điều gì đó.{\i0}
Dialogue: 0,0:04:21.78,0:04:24.24,Main,,0,0,0,,{\an8}{\i1}Ra vậy... Một hội kín ư?{\i0}
Dialogue: 0,0:04:24.24,0:04:29.71,Main,,0,0,0,,{\i1}Chính xác! Và đó là điều bí ẩn\Nmà tôi theo đuổi suốt bao năm nay!{\i0}
Dialogue: 0,0:04:31.27,0:04:33.62,Main,,0,0,0,,{\i1}Vụ này tôi xin kiếu.{\i0}
Dialogue: 0,0:04:34.10,0:04:36.12,Main,,0,0,0,,Vậy chỉ có tôi với cô ta à?
Dialogue: 0,0:04:36.12,0:04:39.78,Main,,0,0,0,,Có sao đâu.\NCô ta đang hăng máu lắm.
Dialogue: 0,0:04:39.78,0:04:42.59,Main,,0,0,0,,Tôi không quen để phụ nữ dắt mũi.
Dialogue: 0,0:04:42.59,0:04:44.14,Main,,0,0,0,,Thì anh dắt cô ta là được.
Dialogue: 0,0:04:44.14,0:04:46.36,Main,,0,0,0,,Cái đó tôi càng không quen.
Dialogue: 0,0:04:46.36,0:04:47.35,Main,,0,0,0,,8 triệu ấy,
Dialogue: 0,0:04:47.80,0:04:51.52,Main,,0,0,0,,chia hai thì vẫn dễ{sướng} hơn chia ba mà.
Dialogue: 0,0:04:51.52,0:04:53.20,Main,,0,0,0,,Thấy chưa.
Dialogue: 0,0:04:53.73,0:04:57.19,Main,,0,0,0,,Chán anh thật, lại đi sợ hacker.
Dialogue: 0,0:04:57.19,0:05:00.40,Main,,0,0,0,,Tôi chỉ ghét mấy việc lằng nhằng thế thôi.
Dialogue: 0,0:05:00.40,0:05:06.01,Main,,0,0,0,,Mấy đứa làm cái trò hack hiếc bần tiện ấy\Ntoàn là bọn béo ị, trắng ởn, đeo kính, u ám.
Dialogue: 0,0:05:06.01,0:05:09.13,Main,,0,0,0,,Lại còn hôi chân,\Ntính tình lệch lạc, một lũ otaku chứ gì?
Dialogue: 0,0:05:09.13,0:05:10.40,Main,,0,0,0,,Dễ như ăn kẹo.
Dialogue: 0,0:05:10.40,0:05:14.18,Main,,0,0,0,,Cô thù oán gì bọn đó à?
Dialogue: 0,0:05:14.18,0:05:18.15,Main,,0,0,0,,Mà chắc hồi cô còn trẻ\Nthì bọn đó đúng là như thế thật.
Dialogue: 0,0:05:18.15,0:05:21.30,Main,,0,0,0,,Ý anh là tôi trông già hơn anh à?
Dialogue: 0,0:05:21.30,0:05:24.51,Main,,0,0,0,,Phụ nữ nhìn bề ngoài\Nlàm sao mà đoán được.
Dialogue: 0,0:05:25.40,0:05:26.01,Main,,0,0,0,,Chuẩn.
Dialogue: 0,0:05:26.43,0:05:31.11,Main,,0,0,0,,Nhìn bề ngoài làm sao mà đoán được\N tôi thạo cả mấy trò này chứ.
Dialogue: 0,0:05:31.11,0:05:32.22,Main,,0,0,0,,Đó là thứ duy nhất tôi biết về cô.
Dialogue: 0,0:05:32.84,0:05:34.70,Main,,0,0,0,,Hai người ăn ý đấy chứ.
Dialogue: 0,0:05:34.70,0:05:35.94,Main,,0,0,0,,Nhanh lên!
Dialogue: 0,0:05:36.60,0:05:39.03,Main,,0,0,0,,Nhớ mang quà từ Trái Đất về nhé.
Dialogue: 0,0:05:39.03,0:05:41.40,Main,,0,0,0,,Đồ Trái Đất chả có gì ra hồn đâu.
Dialogue: 0,0:05:43.32,0:05:46.26,Main,,0,0,0,,{\an8}{\i1}Còn về vụ việc lần này...{\i0}
Dialogue: 0,0:05:46.26,0:05:50.27,Main,,0,0,0,,{\an8}{\i1}Có vẻ kẻ gian đã xâm nhập\Nmột vệ tinh nhân tạo rất cũ.{\i0}
Dialogue: 0,0:05:50.27,0:05:53.68,Main,,0,0,0,,{\an8}{\i1}Và do mã truy cập vào vệ tinh đó\Nđã thất lạc từ lâu,{\i0}
Dialogue: 0,0:05:53.68,0:05:56.54,Main,,0,0,0,,{\an8}{\i1}nên việc điều tra\Nđang gặp nhiều khó khăn.{\i0}
Dialogue: 0,0:05:57.05,0:05:58.91,Main,,0,0,0,,{\an8}{\i1}Xin mời chuyên gia Amjad bình luận.{\i0}
Dialogue: 0,0:05:58.91,0:05:59.71,Main,,0,0,0,,{\an8}{\i1}Vâng, vâng.{\i0}
Dialogue: 0,0:05:59.71,0:06:02.67,Main,,0,0,0,,{\an8}{\i1}Về mối liên hệ giữa Trái Đất và hacker...{\i0}
Dialogue: 0,0:06:02.67,0:06:06.51,Main,,0,0,0,,{\an8}{\i1}Vâng. Kể từ sự cố ở Cổng 50 năm trước,{\i0}
Dialogue: 0,0:06:06.51,0:06:09.39,Main,,0,0,0,,{\an8}{\i1}do khí hậu biến đổi\Nvì các mảnh vỡ mặt trăng rơi xuống,{\i0}
Dialogue: 0,0:06:09.39,0:06:14.40,Main,,0,0,0,,{\an8}{\i1}người Trái Đất đã chuyển\Ntoàn bộ không gian sống xuống lòng đất.{\i0}
Dialogue: 0,0:06:14.40,0:06:17.06,Main,,0,0,0,,{\an8}{\i1}Với họ, không gian mạng\Ndo máy tính tạo ra{\i0}
Dialogue: 0,0:06:17.52,0:06:21.90,Main,,0,0,0,,{\an8}{\i1}là kênh kết nối không thể thiếu \Nvới những người sống ngoài vũ trụ..{\i0}
Dialogue: 0,0:06:21.90,0:06:23.60,Main,,0,0,0,,{\an8}{\i1}Ra là vậy.{\i0}
Dialogue: 0,0:06:23.60,0:06:27.76,Main,,0,0,0,,{\an8}{\i1}Đó chính là nền tảng\Nđể sản sinh ra những hacker tài năng.{\i0}
Dialogue: 0,0:07:02.97,0:07:04.49,Main,,0,0,0,,Edward Cấp Tiến!
Dialogue: 0,0:07:04.49,0:07:06.36,Main,,0,0,0,,Cảnh sát đây! Ra mặt đi!
Dialogue: 0,0:07:06.36,0:07:08.10,Main,,0,0,0,,Có đây~!
Dialogue: 0,0:07:08.82,0:07:10.29,Main,,0,0,0,,Gì thế? Sao thế?
Dialogue: 0,0:07:10.29,0:07:11.32,Main,,0,0,0,,Thấy rồi...
Dialogue: 0,0:07:22.58,0:07:23.60,Main,,0,0,0,,Thế quái nào?!
Dialogue: 0,0:07:23.60,0:07:25.54,Main,,0,0,0,,Làm gì có ai ngồi trong đó!
Dialogue: 0,0:07:38.69,0:07:40.36,Main,,0,0,0,,Lỡ tay, lỡ tay.
Dialogue: 0,0:07:51.32,0:07:52.45,Main,,0,0,0,,{\i1}Nghe đây.{\i0}
Dialogue: 0,0:07:52.45,0:07:56.17,Main,,0,0,0,,{\i1}Lúc bị xâm nhập,\Nvệ tinh đang ở vị trí này.{\i0}
Dialogue: 0,0:07:56.17,0:07:58.68,Main,,0,0,0,,{\i1}Còn đây là khu vực\Ncó thể truy cập vào nó.{\i0}
Dialogue: 0,0:07:59.20,0:08:04.14,Main,,0,0,0,,Tôi sẽ rà từng ăng-ten có khả năng\N liên lạc quang học trong khu này.
Dialogue: 0,0:08:04.14,0:08:07.42,Main,,0,0,0,,Còn tôi đi hỏi dò xem\N có tay hacker nào cộm cán không.
Dialogue: 0,0:08:30.74,0:08:34.82,Main,,0,0,0,,Bebop đang tìm kẻ bị truy nã\Nvụ hình vẽ trên mặt đất à.
Dialogue: 0,0:08:35.43,0:08:36.99,Main,,0,0,0,,Được lắm!
Dialogue: 0,0:08:38.85,0:08:41.19,Main,,0,0,0,,Bé vệ tinh ngày xửa ngày xưa ơi,
Dialogue: 0,0:08:41.19,0:08:44.00,Main,,0,0,0,,mã truy cập của bé ở đâu nào?
Dialogue: 0,0:08:51.34,0:08:56.06,Main,,0,0,0,,Được rồi. Trước mắt cứ xem\Nnhững ăng-ten đang liên lạc đã.
Dialogue: 0,0:09:09.27,0:09:11.69,Main,,0,0,0,,Chắc là Ed đấy, chú à.
Dialogue: 0,0:09:11.69,0:09:14.36,Main,,0,0,0,,Nghe nói là gã khổng lồ cao 2 mét.
Dialogue: 0,0:09:14.36,0:09:17.24,Main,,0,0,0,,Nghe bảo trước đây là cầu thủ bóng rổ.
Dialogue: 0,0:09:19.03,0:09:21.03,Main,,0,0,0,,Biết chứ, biết chứ. Ed,
Dialogue: 0,0:09:21.03,0:09:22.58,Main,,0,0,0,,Edward Cấp Tiến.
Dialogue: 0,0:09:22.58,0:09:25.62,Main,,0,0,0,,Nghe nói là một hacker\Nrất xinh đẹp nhưng thất thường.
Dialogue: 0,0:09:27.71,0:09:31.22,Main,,0,0,0,,Không, không, hacker đó là trẻ con.
Dialogue: 0,0:09:31.22,0:09:34.42,Main,,0,0,0,,Nghe bảo là một đứa nhóc\Nnghịch ngợm khủng khiếp.
Dialogue: 0,0:09:36.63,0:09:42.97,Main,,0,0,0,,Ơ, thế mà tôi nghe bà hàng xóm kể\Nhacker đó là dân đồng tính cơ.
Dialogue: 0,0:09:44.81,0:09:46.81,Main,,0,0,0,,Hacker là Ed chứ gì?
Dialogue: 0,0:09:46.81,0:09:48.53,Main,,0,0,0,,Ed là người ngoài hành tinh đấy.
Dialogue: 0,0:09:48.53,0:09:50.31,Main,,0,0,0,,Ai cũng nói thế mà.
Dialogue: 0,0:09:54.92,0:09:56.32,Main,,0,0,0,,Chú ơi, chú.
Dialogue: 0,0:09:57.53,0:10:00.46,Main,,0,0,0,,Coi như trả tiền thông tin,\Nchú mua cái này đi.
Dialogue: 0,0:10:00.46,0:10:01.62,Main,,0,0,0,,Cái gì đấy?
Dialogue: 0,0:10:01.62,0:10:03.38,Main,,0,0,0,,Chú không biết à?
Dialogue: 0,0:10:03.38,0:10:06.08,Main,,0,0,0,,Đặc sản nổi tiếng của Trái Đất,\N bánh Piyoko đấy.
Dialogue: 0,0:10:10.55,0:10:13.05,Main,,0,0,0,,{\i1}Các bạn vệ tinh bị đánh cắp ơi...{\i0}
Dialogue: 0,0:10:14.10,0:10:15.97,Main,,0,0,0,,các bạn đang ở đâu thế~?
Dialogue: 0,0:10:22.60,0:10:25.18,Main,,0,0,0,,Ơ? Cái gì đây?
Dialogue: 0,0:10:25.74,0:10:28.22,Main,,0,0,0,,Dữ liệu không nối với Trái Đất.
Dialogue: 0,0:10:28.82,0:10:30.90,Main,,0,0,0,,Chỉ có các vệ tinh nối với nhau thôi.
Dialogue: 0,0:10:31.36,0:10:33.98,Main,,0,0,0,,Lại còn chả ai xâm nhập cả.
Dialogue: 0,0:10:33.98,0:10:37.13,Main,,0,0,0,,{\i1}Ở đây... không có ai.{\i0}
Dialogue: 0,0:10:37.73,0:10:39.66,Main,,0,0,0,,{\i1}Mãi mãi... một mình.{\i0}
Dialogue: 0,0:10:39.66,0:10:42.18,Main,,0,0,0,,Ơ? Hả?
Dialogue: 0,0:10:42.18,0:10:45.82,Main,,0,0,0,,Có tiếng nói... trong đầu...
Dialogue: 0,0:10:56.81,0:10:57.97,Main,,0,0,0,,Bạn là ai?
Dialogue: 0,0:10:58.68,0:11:00.88,Main,,0,0,0,,Ơ? Gì cơ?
Dialogue: 0,0:11:00.88,0:11:02.35,Main,,0,0,0,,Bạn vừa nói gì thế?
Dialogue: 0,0:11:03.97,0:11:08.36,Main,,0,0,0,,{\i1}Ai? Cậu?\NỞ đây, mãi mãi.{\i0}
Dialogue: 0,0:11:08.36,0:11:12.17,Main,,0,0,0,,Edward. Thợ lặn mạng đến từ Trái Đất đây.
Dialogue: 0,0:11:12.17,0:11:13.15,Main,,0,0,0,,{\i1}Trái Đất?{\i0}
Dialogue: 0,0:11:13.15,0:11:15.86,Main,,0,0,0,,Ờ. Này, tên bạn là gì?
Dialogue: 0,0:11:16.96,0:11:23.74,Main,,0,0,0,,{\i1}Tôi là chương trình điều khiển\Ngắn trên vệ tinh nhân tạo D-135.{\i0}
Dialogue: 0,0:11:23.74,0:11:26.83,Main,,0,0,0,,{\i1}Gì vậy? Bạn không có biệt danh à?{\i0}
Dialogue: 0,0:11:26.83,0:11:28.96,Main,,0,0,0,,Vậy để Ed đặt cho bạn.
Dialogue: 0,0:11:28.96,0:11:31.56,Main,,0,0,0,,Ờ... để xem nào...
Dialogue: 0,0:11:31.56,0:11:32.25,Main,,0,0,0,,Có rồi!
Dialogue: 0,0:11:32.25,0:11:35.21,Main,,0,0,0,,Bạn là máy tính,\Nnên gọi là MPU đi!
Dialogue: 1,0:11:35.22,0:11:36.07,Main,,0,0,0,,{\i1}Gì cơ?{\i0}
Dialogue: 0,0:11:36.08,0:11:38.94,Main,,0,0,0,,MPU! Ngầu ghê~
Dialogue: 0,0:11:38.94,0:11:39.72,Main,,0,0,0,,{\i1}À...{\i0}
Dialogue: 0,0:11:40.24,0:11:44.50,Main,,0,0,0,,Ed là Edward Wong Hau\NPepelu Tivrusky Đệ Tứ.
Dialogue: 0,0:11:44.50,0:11:45.80,Main,,0,0,0,,Gọi tắt là Ed.
Dialogue: 0,0:11:45.80,0:11:47.81,Main,,0,0,0,,Rất vui được gặp bạn!
Dialogue: 0,0:11:47.81,0:11:50.27,Main,,0,0,0,,Đây, quà Trái Đất đây.
Dialogue: 0,0:11:52.47,0:11:53.73,Main,,0,0,0,,Cái này ăn được à?
Dialogue: 0,0:11:53.73,0:11:56.23,Main,,0,0,0,,Gu của anh có vấn đề thật đấy.
Dialogue: 0,0:11:57.00,0:12:00.90,Main,,0,0,0,,Không như cô,\Ntôi có kiếm được thông tin hẳn hoi đấy.
Dialogue: 0,0:12:01.28,0:12:05.69,Main,,0,0,0,,Người ta bảo nghi nhất là một hacker\Nkhông rõ danh tính, tên là Edward Cấp Tiến.
Dialogue: 0,0:12:05.69,0:12:07.87,Main,,0,0,0,,Không rõ danh tính thì có nghĩa lý gì.
Dialogue: 0,0:12:08.71,0:12:10.35,Main,,0,0,0,,Cũng biết được chút ít.
Dialogue: 0,0:12:11.59,0:12:13.48,Main,,0,0,0,,Có vẻ không sao.
Dialogue: 0,0:12:13.48,0:12:14.58,Main,,0,0,0,,Là người thế nào?
Dialogue: 0,0:12:15.98,0:12:20.30,Main,,0,0,0,,Cao 2 mét, từng là cầu thủ bóng rổ,\Nlại còn là một đứa nhóc mặt mũi xinh xắn.
Dialogue: 0,0:12:20.71,0:12:23.64,Main,,0,0,0,,Lại còn là người ngoài hành tinh đồng tính.
Dialogue: 0,0:12:27.48,0:12:29.72,Main,,0,0,0,,{\i1}Sao bạn lại vẽ bậy lên Trái Đất?{\i0}
Dialogue: 0,0:12:30.24,0:12:35.06,Main,,0,0,0,,{\i1}Ngày xửa ngày xưa, rất lâu\Ntrước khi xảy ra sự cố ở Cổng,{\i0}
Dialogue: 0,0:12:35.47,0:12:40.78,Main,,0,0,0,,{\i1}Trái Đất là một hành tinh tươi đẹp,\Nnơi có đông đúc người sinh sống.{\i0}
Dialogue: 0,0:12:40.78,0:12:44.83,Main,,0,0,0,,{\i1}Hồi đó trên mặt đất \Ncó biết bao hình vẽ như thế này,{\i0}
Dialogue: 0,0:12:44.83,0:12:47.49,Main,,0,0,0,,{\i1}và tôi cứ ngắm nhìn chúng mãi.{\i0}
Dialogue: 0,0:12:48.31,0:12:50.40,Main,,0,0,0,,{\i1}Vì nhớ những ngày xưa ấy,{\i0}
Dialogue: 0,0:12:50.40,0:12:54.16,Main,,0,0,0,,{\i1}nên tôi muốn tái hiện lại,\Ndù chỉ là những bức vẽ...{\i0}
Dialogue: 0,0:12:54.16,0:12:59.42,Main,,0,0,0,,Ồ~ Thì ra Trái Đất ngày xưa\Ncũng có mấy hình vẽ bậy thế này à.
Dialogue: 0,0:12:59.42,0:13:03.53,Main,,0,0,0,,{\i1}Đúng vậy. Tôi tái hiện với sai số 2%.{\i0}
Dialogue: 0,0:13:03.53,0:13:07.59,Main,,0,0,0,,{\i1}MPU vẽ giỏi ghê.\NNày, cho Ed vẽ với.{\i0}
Dialogue: 0,0:13:08.67,0:13:10.91,Main,,0,0,0,,Ơ? Sao thế?
Dialogue: 0,0:13:10.91,0:13:11.99,Main,,0,0,0,,{\i1}Đây là...{\i0}
Dialogue: 0,0:13:11.99,0:13:14.52,Main,,0,0,0,,{\i1}Cảnh sát đang phát tín hiệu gây nhiễu.{\i0}
Dialogue: 0,0:13:15.65,0:13:18.61,Main,,0,0,0,,Ơ! MPU! Này~!
Dialogue: 0,0:13:19.16,0:13:23.78,Main,,0,0,0,,Có vẻ cảnh sát\Ncũng đã liên lạc được với Edward Cấp Tiến.
Dialogue: 0,0:13:29.12,0:13:31.62,Main,,0,0,20,,{\i1}Nghe này! Tìm ra kẻ bị truy nã rồi!{\i0}
Dialogue: 0,0:13:31.62,0:13:32.94,Main,,0,0,0,,Cái gì thế?
Dialogue: 0,0:13:33.58,0:13:35.33,Main,,0,0,0,,{\i1}Bebop!{\i0}
Dialogue: 0,0:13:35.33,0:13:39.79,Main,,0,0,0,,{\i1}Thủ phạm thật sự của vụ cướp vệ tinh\Nkhông phải là hacker đâu nhá!{\i0}
Dialogue: 0,0:13:40.37,0:13:42.94,Main,,0,0,0,,Kênh này thành kênh giao lưu{tương tác}\N từ bao giờ thế?
Dialogue: 0,0:13:42.94,0:13:44.38,Main,,0,0,0,,Không phải.
Dialogue: 0,0:13:44.38,0:13:46.45,Main,,0,0,0,,Bị hack trực tiếp đấy.
Dialogue: 0,0:13:46.45,0:13:47.96,Main,,0,0,0,,Đứa này là ai thế?
Dialogue: 0,0:13:47.96,0:13:50.41,Main,,0,0,0,,{\i1}Giờ Ed gửi dữ liệu của MPU đây.{\i0}
Dialogue: 0,0:13:50.41,0:13:52.47,Main,,0,0,0,,Khoan đã, MPU là cái gì?
Dialogue: 0,0:13:52.47,0:13:54.17,Main,,0,0,0,,{\i1}Bạn của Ed.{\i0}
Dialogue: 0,0:13:54.17,0:13:56.27,Main,,0,0,0,,Này, nhóc biết Ed à?
Dialogue: 0,0:13:56.27,0:13:58.98,Main,,0,0,0,,{\i1}Ờ, vì Ed là Ed mà.{\i0}
Dialogue: 0,0:14:00.44,0:14:03.32,Main,,0,0,0,,Chuyện đó sao cũng được. Thủ phạm là ai?
Dialogue: 0,0:14:03.32,0:14:07.23,Main,,0,0,0,,{\i1}Ờ... nói cũng được,{\i0}
Dialogue: 0,0:14:07.23,0:14:09.32,Main,,0,0,0,,{\i1}nhưng đổi lại em có việc muốn nhờ.{\i0}
Dialogue: 0,0:14:09.32,0:14:10.79,Main,,0,0,0,,Nhờ?
Dialogue: 0,0:14:10.79,0:14:13.95,Main,,0,0,0,,Rồi rồi, lát nữa chị nghe.
Dialogue: 0,0:14:13.95,0:14:15.67,Main,,0,0,0,,Nào, nhanh lên.
Dialogue: 0,0:14:16.84,0:14:22.46,Main,,0,0,0,,{\i1}Ra thế. AI của vệ tinh bị bỏ rơi\Ntự ý đi vẽ bậy.{\i0}
Dialogue: 0,0:14:22.47,0:14:24.79,Main,,0,0,0,,{\i1}Hả? Gì cơ?{\i0}
Dialogue: 0,0:14:24.79,0:14:28.48,Main,,0,0,0,,{\i1}Đã thế trên giấy tờ \Nnó còn được ghi là vệ tinh thời tiết,{\i0}
Dialogue: 0,0:14:28.48,0:14:30.68,Main,,0,0,0,,{\i1}nên chả ai để ý tới.{\i0}
Dialogue: 0,0:14:30.68,0:14:33.89,Main,,0,0,0,,{\i1}Tức là vệ tinh này là kẻ bị truy nã à?{\i0}
Dialogue: 0,0:14:34.39,0:14:37.80,Main,,0,0,0,,{\i1}Mã truy cập MPU\Nkhông dùng được nữa rồi,{\i0}
Dialogue: 0,0:14:37.80,0:14:39.93,Main,,0,0,0,,{\i1}nên phải đến tận chỗ vệ tinh.{\i0}
Dialogue: 0,0:14:39.93,0:14:41.70,Main,,0,0,0,,Rồi sao nữa?
Dialogue: 0,0:14:41.70,0:14:45.21,Main,,0,0,0,,{\i1}Phá ăng-ten mà MPU dùng\Nđể liên lạc với các vệ tinh khác.{\i0}
Dialogue: 0,0:14:45.21,0:14:50.24,Main,,0,0,0,,{\i1}Rồi kết nối trực tiếp với vệ tinh\Nvà tải MPU xuống.{\i0}
Dialogue: 0,0:14:51.13,0:14:54.81,Main,,0,0,0,,{\i1}Lúc đó đừng dùng máy tính\Nhỗ trợ ngắm bắn hay lái nhé.{\i0}
Dialogue: 0,0:14:54.81,0:14:57.29,Main,,0,0,0,,Cái gì? Làm thủ công hết à?
Dialogue: 0,0:14:57.29,0:14:58.94,Main,,0,0,0,,{\i1}Ờ. Nếu bị MPU phát hiện,{\i0}
Dialogue: 0,0:14:58.94,0:15:03.84,Main,,0,0,0,,{\i1}các vệ tinh tấn công nối với MPU\Nsẽ tự động phản công đấy.{\i0}
Dialogue: 0,0:15:03.84,0:15:05.59,Main,,0,0,0,,{\i1}Khó lắm à?{\i0}
Dialogue: 0,0:15:05.59,0:15:09.86,Main,,0,0,0,,Khó gì nữa, là bất khả thi luôn ấy.
Dialogue: 0,0:15:09.86,0:15:12.65,Main,,0,0,0,,Khác gì đi đánh bóng chày mà không cầm gậy.
Dialogue: 0,0:15:13.30,0:15:14.43,Main,,0,0,0,,Này, Spike.
Dialogue: 0,0:15:15.19,0:15:18.14,Main,,0,0,0,,Tôi lại thích mấy vụ thế này đấy.
Dialogue: 0,0:15:24.79,0:15:28.19,Main,,0,0,0,,Này, nhóc kia. Sao biết chuyện bọn chị?
Dialogue: 0,0:15:28.19,0:15:29.65,Main,,0,0,0,,{\i1}Ed biết hết mà.{\i0}
Dialogue: 0,0:15:29.66,0:15:34.60,Main,,0,0,0,,{\i1}Tuần trước để xổng Ajiz,\Ntiền thưởng 1,5 triệu ở Sao Hỏa,{\i0}
Dialogue: 0,0:15:34.60,0:15:38.95,Main,,0,0,0,,{\i1}còn trước đó ở Pyortle\Nthì bị cảnh sát hớt tay trên.{\i0}
Dialogue: 0,0:15:38.96,0:15:42.96,Main,,0,0,0,,Nhóc đúng là hacker Edward Cấp Tiến thật à?!
Dialogue: 0,0:15:42.96,0:15:45.42,Main,,0,0,0,,Đúng rồi. Chị biết à?
Dialogue: 0,0:15:48.93,0:15:51.26,Main,,0,0,0,,{\i1}Nối D-7 thẳng với số 2.{\i0}
Dialogue: 0,0:15:51.26,0:15:54.29,Main,,0,0,0,,{\i1}Thế là pháo chính\Nbắn được không cần máy tính.{\i0}
Dialogue: 0,0:15:54.29,0:15:55.55,Main,,0,0,0,,Trông cả vào anh đấy.
Dialogue: 0,0:15:55.55,0:15:56.26,Main,,0,0,0,,{\i1}Nghe này.{\i0}
Dialogue: 0,0:15:56.76,0:15:59.76,Main,,0,0,0,,{\i1}Hạn chế dùng tên lửa hết mức có thể.\NĐắt lắm đấy.{\i0}
Dialogue: 0,0:15:59.76,0:16:00.96,Main,,0,0,0,,Rõ.
Dialogue: 0,0:16:00.96,0:16:03.23,Main,,0,0,0,,{\i1}Còn 1.200 đến mục tiêu.{\i0}
Dialogue: 0,0:16:03.23,0:16:06.32,Main,,0,0,0,,Sắp phải ngắt điều khiển máy tính rồi.
Dialogue: 0,0:16:06.32,0:16:07.98,Main,,0,0,0,,Nghe đây, cơ hội chỉ có...
Dialogue: 0,0:16:07.98,0:16:09.48,Main,,0,0,0,,Một lần là đủ.
Dialogue: 0,0:16:14.38,0:16:16.46,Main,,0,0,0,,{\i1}Mà này, nhóc chứng minh được{\i0}
Dialogue: 0,0:16:16.46,0:16:21.37,Main,,0,0,0,,{\i1}thủ phạm bị truy nã chính là cái vệ tinh đó\N chứ không phải hacker đấy nhé?{\i0}
Dialogue: 0,0:16:21.38,0:16:23.39,Main,,0,0,0,,Ed làm được mà.
Dialogue: 0,0:16:23.39,0:16:26.10,Main,,0,0,0,,Quan trọng hơn,\Nchị đã hứa giúp em một việc rồi đấy.
Dialogue: 0,0:16:26.10,0:16:28.46,Main,,0,0,0,,Rồi em sẽ nhường hết\Ntiền thưởng cho chị luôn.
Dialogue: 0,0:16:28.46,0:16:32.13,Main,,0,0,0,,Ôi chao! Hóa ra cũng ngoan phết nhỉ!
Dialogue: 0,0:16:39.22,0:16:40.31,Main,,0,0,0,,Là nó à.
Dialogue: 0,0:16:55.53,0:16:56.78,Main,,0,0,0,,{\i1}Có ai đó...{\i0}
Dialogue: 0,0:17:09.04,0:17:10.13,Main,,0,0,0,,Sao rồi?
Dialogue: 0,0:17:10.13,0:17:11.13,Main,,0,0,0,,Được chưa?
Dialogue: 0,0:17:12.02,0:17:13.09,Main,,0,0,0,,Không, trượt rồi!
Dialogue: 0,0:17:13.57,0:17:15.59,Main,,0,0,0,,Vệ tinh đằng trước làm lá chắn cho nó!
Dialogue: 0,0:17:22.01,0:17:24.81,Main,,0,0,0,,Vậy chỉ còn cách\Nbắn hạ hết các vệ tinh thôi!
Dialogue: 0,0:17:24.81,0:17:26.06,Main,,0,0,0,,{\i1}Hết chỗ này á?{\i0}
Dialogue: 0,0:17:26.06,0:17:28.44,Main,,0,0,0,,{\i1}Không làm thì bị chúng xử đấy!{\i0}
Dialogue: 0,0:17:33.86,0:17:34.90,Main,,0,0,0,,ECM à?
Dialogue: 0,0:17:34.91,0:17:37.36,Main,,0,0,0,,Của rẻ là của ôi...
Dialogue: 0,0:17:48.17,0:17:50.04,Main,,0,0,0,,Thế này thì đến bao giờ mới xong.
Dialogue: 0,0:17:51.37,0:17:53.59,Main,,0,0,0,,{\i1}Lại gần MPU trong vòng 20 mét!{\i0}
Dialogue: 0,0:17:53.59,0:17:56.74,Main,,0,0,0,,{\i1}Thế thì các vệ tinh khác\Nkhông tấn công được!{\i0}
Dialogue: 0,0:17:56.74,0:17:57.80,Main,,0,0,0,,Nhưng mà...
Dialogue: 0,0:17:57.80,0:18:00.12,Main,,0,0,0,,{\i1}Trong lúc đó, Faye sẽ làm mồi nhử!{\i0}
Dialogue: 0,0:18:00.12,0:18:01.01,Main,,0,0,0,,Tôi á?!
Dialogue: 0,0:18:01.01,0:18:01.97,Main,,0,0,0,,Nhờ cô nhé!
Dialogue: 0,0:18:33.43,0:18:35.51,Main,,0,0,0,,Này! Nhanh lên đi chứ!
Dialogue: 0,0:18:37.47,0:18:38.72,Main,,0,0,0,,Được rồi, giao cho nhóc đấy!
Dialogue: 0,0:18:40.22,0:18:40.93,Main,,0,0,0,,MPU!
Dialogue: 0,0:18:45.02,0:18:47.27,Main,,0,0,0,,MPU? MPU?!
Dialogue: 0,0:18:47.27,0:18:49.11,Main,,0,0,0,,{\i1}Ồ, Ed!{\i0}
Dialogue: 0,0:18:49.11,0:18:51.50,Main,,0,0,0,,{\i1}Ed đấy à. Lại gặp nhau rồi.{\i0}
Dialogue: 0,0:18:51.50,0:18:54.16,Main,,0,0,0,,MPU đang bị treo thưởng đấy.
Dialogue: 0,0:18:54.16,0:18:55.15,Main,,0,0,0,,{\i1}Treo thưởng?{\i0}
Dialogue: 0,0:18:55.15,0:19:00.24,Main,,0,0,0,,Ờ, cơ mà cứ chép MPU ra một bản\N rồi để họ bắt bản sao là ổn mà!
Dialogue: 0,0:19:00.24,0:19:01.68,Main,,0,0,0,,{\i1}Ổn?{\i0}
Dialogue: 0,0:19:01.68,0:19:04.45,Main,,0,0,0,,Với lại, ở một mình\NMPU cũng cô đơn lắm đúng không?
Dialogue: 0,0:19:04.45,0:19:07.50,Main,,0,0,0,,{\i1}Sang bên này\Nthì có nhiều bạn bè lắm.{\i0}
Dialogue: 0,0:19:07.50,0:19:09.36,Main,,0,0,0,,{\i1}Bạn bè?{\i0}
Dialogue: 0,0:19:09.36,0:19:11.31,Main,,0,0,0,,Đây. Không đáng sợ đâu.
Dialogue: 0,0:19:20.23,0:19:24.73,Main,,0,0,0,,{\i1}Và như vậy, vụ việc\Nđã khép lại theo cách không ngờ.{\i0}
Dialogue: 0,0:19:24.73,0:19:32.19,Main,,0,0,0,,{\i1}Thủ phạm bị bắt hóa ra là AI của một\N vệ tinh gián điệp phóng trước khi Trái Đất sụp đổ.{\i0}
Dialogue: 0,0:19:32.57,0:19:36.82,Main,,0,0,0,,{\i1}Theo tài liệu của chính phủ thời đó,\Nnó được thiết kế{\i0}
Dialogue: 0,0:19:36.82,0:19:40.28,Main,,0,0,0,,{\i1}để tự phán đoán và hoạt động\Nkể cả khi không có lệnh từ Trái Đất.{\i0}
Dialogue: 0,0:19:40.75,0:19:46.49,Main,,0,0,0,,{\i1}Chà, với cảnh sát thì đây là\Ncái cớ hoàn hảo để đi săn hacker.{\i0}
Dialogue: 0,0:19:47.09,0:19:53.56,Main,,0,0,0,,Mà sao tự dưng nó lại\Ndùng laser vẽ bậy lên Trái Đất nhỉ?
Dialogue: 0,0:19:53.56,0:19:54.54,Main,,0,0,0,,Thì...
Dialogue: 0,0:19:55.67,0:19:57.71,Main,,0,0,0,,chắc là vì nó cô đơn thôi.
Dialogue: 0,0:19:59.76,0:20:01.68,Main,,0,0,0,,Yoohoo! Bebop!
Dialogue: 0,0:20:01.68,0:20:04.80,Main,,0,0,0,,Này, ở đây này! Nhanh lên!
Dialogue: 0,0:20:04.80,0:20:07.04,Main,,0,0,0,,{\i1}Hứa rồi đấy, hứa rồi đấy!{\i0}
Dialogue: 0,0:20:07.04,0:20:09.32,Main,,0,0,0,,Nào nào, mau xuất phát thôi.
Dialogue: 0,0:20:09.32,0:20:11.81,Main,,0,0,0,,Nhưng nhóc này cứ nói hứa hẹn gì đó...
Dialogue: 0,0:20:11.81,0:20:14.68,Main,,0,0,0,,Lời hứa sinh ra là để phá mà.
Dialogue: 0,0:20:14.68,0:20:17.02,Main,,0,0,0,,Đi thôi, xuất phát! Cất cánh đi!
Dialogue: 0,0:20:25.08,0:20:27.86,Main,,0,0,0,,Không thấy đến, không thấy đến... Ơ kìa~
Dialogue: 0,0:20:47.54,0:20:49.56,Main,,0,0,0,,Cái quái gì vậy? Chuyện gì thế này?
Dialogue: 0,0:20:49.99,0:20:52.06,Main,,0,0,0,,Cô đã hứa cái gì thế hả?
Dialogue: 0,0:20:56.93,0:21:01.21,Main,,0,0,0,,Hứa là...\N sẽ cho làm thành viên của Bebop đấy.
Dialogue: 0,0:21:08.26,0:21:11.09,Main,,0,0,0,,{\i1}Chào bà con thợ săn tiền thưởng!{\i0}
Dialogue: 0,0:21:11.09,0:21:13.58,Main,,0,0,0,,{\i1}Không để bà con chờ lâu,\NBig Shot xin phép được bắt đầu!{\i0}
Dialogue: 0,0:21:13.58,0:21:15.83,Main,,0,0,0,,{\i1}Giờ thì, tin nóng hôm nay đây!{\i0}
Dialogue: 0,0:21:15.83,0:21:18.96,Main,,0,0,0,,{\i1}Cô nghe vụ\Nvệ tinh vẽ bậy bị bắt chưa?{\i0}
Dialogue: 0,0:21:18.96,0:21:22.09,Main,,0,0,0,,{\i1}Tất nhiên! Tiền thưởng khủng lắm mà!{\i0}
Dialogue: 0,0:21:22.09,0:21:25.31,Main,,0,0,0,,{\i1}Ban nãy cảnh sát Trái Đất\Nđã ra thông báo chính thức.{\i0}
Dialogue: 0,0:21:25.31,0:21:26.50,Main,,0,0,0,,{\i1}Gì thế, gì thế?{\i0}
Dialogue: 0,0:21:27.60,0:21:32.33,Main,,0,0,0,,{\i1}"Khoản tiền thưởng này chỉ áp dụng\Ncho con người và các sinh vật sống.{\i0}
Dialogue: 0,0:21:32.33,0:21:37.46,Main,,0,0,0,,{\i1}Đối với một chương trình máy tính,\Nrất khó xác định nó có phải sinh vật hay không.{\i0}
Dialogue: 0,0:21:37.46,0:21:40.42,Main,,0,0,0,,{\i1}Vả lại, từ góc độ đạo đức sinh học..."{\i0}
Dialogue: 0,0:21:40.42,0:21:42.82,Main,,0,0,0,,{\i1}Gì thế? Nghe chẳng hiểu gì cả.{\i0}
Dialogue: 0,0:21:42.82,0:21:46.57,Main,,0,0,0,,{\i1}Tóm lại là\Nđồ vô tri thì không có tiền.{\i0}
Dialogue: 0,0:21:46.57,0:21:47.80,Main,,0,0,0,,{\i1}Ôi trời~{\i0}
Dialogue: 0,0:21:47.80,0:21:50.08,Main,,0,0,0,,{\i1}Xin chia buồn với ai đã bắt được nó nhé!{\i0}
Dialogue: 0,0:21:53.25,0:21:58.74,Main,,0,0,0,,Này Jet,\Nanh biết có ba thứ tôi ghét không?
Dialogue: 0,0:21:58.74,0:21:59.75,Main,,0,0,0,,Ai mà biết.
Dialogue: 0,0:21:59.75,0:22:00.75,Main,,0,0,0,,{\i1}Trẻ con,{\i0}
Dialogue: 0,0:22:00.75,0:22:02.00,Main,,0,0,0,,súc vật,
Dialogue: 0,0:22:02.00,0:22:04.01,Main,,0,0,0,,và phụ nữ ngang ngạnh.
Dialogue: 0,0:22:07.51,0:22:08.83,Main,,0,0,0,,"Ồ" cái gì mà "ồ"!
Dialogue: 0,0:22:08.83,0:22:12.11,Main,,0,0,0,,Sao cả ba thứ đó\Nlại tề tựu đông đủ ở đây thế hả?!
Dialogue: 0,0:22:12.11,0:22:13.87,Main,,0,0,0,,{\i1}Ed thích bánh Piyoko lắm!{\i0}
Dialogue: 0,0:22:13.87,0:22:16.52,Main,,0,0,0,,{\i1}Lại không được đồng tiền thưởng nào...{\i0}
Dialogue: 0,0:22:16.52,0:22:19.20,Main,,0,0,0,,{\i1}Ơ, nhóc là con gái à?{\i0}
Dialogue: 0,0:22:19.79,0:22:23.71,Main,,0,0,0,,{\i1}Thật tình, đồ Trái Đất chả có gì ra hồn!{\i0}
Dialogue: 0,0:24:05.68,0:24:09.01,Main,preview,0,0,0,,{\i1}Người phụ nữ rũ áo ra đi\N không chút vấn vương,{\i0}
Dialogue: 0,0:24:09.01,0:24:12.18,Main,preview,0,0,0,,{\i1}nhưng chiếc gai nhỏ \Nvẫn cứ găm mãi trong tim.{\i0}
Dialogue: 0,0:24:12.18,0:24:14.73,Main,preview,0,0,0,,{\i1}Phó mặc cho dòng thời gian trôi,{\i0}
Dialogue: 0,0:24:14.73,0:24:17.55,Main,preview,0,0,0,,{\i1}một mình sống đến tận hôm nay,{\i0}
Dialogue: 0,0:24:17.55,0:24:19.97,Main,preview,0,0,0,,{\i1}vậy mà tiếng sóng xô bờ{\i0}
Dialogue: 0,0:24:19.97,0:24:22.48,Main,preview,0,0,0,,{\i1}vẫn làm chim di trú nao lòng.{\i0}
Dialogue: 0,0:24:23.57,0:24:26.13,Main,preview,0,0,0,,{\i1}Kỳ tới, "Khúc Bi Ca Ganymede".{\i0}{Nỗi niềm Ganymede}
Dialogue: 0,0:24:26.13,0:24:30.90,Main,preview,0,0,0,,{\i1}Jet Black sẽ cất tiếng hát bằng cả trái tim.{\i0}
