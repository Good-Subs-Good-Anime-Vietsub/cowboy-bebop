Dialogue: 0,0:00:19.01,0:00:22.38,Main,,0,0,0,,Ngày hôm đó, trời cũng mưa...
Dialogue: 0,0:00:23.81,0:00:26.34,Main,,0,0,0,,Em không đến là vì mưa à?
Dialogue: 0,0:00:28.06,0:00:31.05,Main,,0,0,0,,Em đáng lẽ phải giết anh...
Dialogue: 0,0:00:33.87,0:00:34.81,Main,,0,0,0,,Hôm đó...
Dialogue: 0,0:00:35.98,0:00:38.02,Main,,0,0,0,,{\i1}nếu giết anh,{\i0}
Dialogue: 0,0:00:38.02,0:00:40.27,Main,,0,0,0,,{\i1}thì em đã được tự do.{\i0}
Dialogue: 0,0:00:44.30,0:00:45.73,Main,,0,0,0,,Sao em không làm?
Dialogue: 0,0:00:48.11,0:00:50.28,Main,,0,0,0,,Sao lại chọn con đường bị truy đuổi?
Dialogue: 0,0:00:51.30,0:00:52.53,Main,,0,0,0,,Thế sao...
Dialogue: 0,0:00:52.53,0:00:54.78,Main,,0,0,0,,{\i1}anh lại yêu em?{\i0}
Dialogue: 0,0:01:04.34,0:01:06.71,Main,,0,0,0,,Cứ thế này, mình trốn đi đâu đó đi.
Dialogue: 0,0:01:09.19,0:01:12.76,Main,,0,0,0,,Thật sự thoát khỏi thế giới này,
Dialogue: 0,0:01:12.76,0:01:14.23,Main,,0,0,0,,tới một nơi không có ai...
Dialogue: 0,0:01:17.33,0:01:18.55,Main,,0,0,0,,Chỉ hai ta thôi...
Dialogue: 0,0:01:40.73,0:01:41.99,Main,,0,0,0,,Hắn đâu?
Dialogue: 0,0:01:44.44,0:01:45.83,Main,,0,0,0,,Để hắn thoát mất rồi ạ.
Dialogue: 0,0:01:48.37,0:01:52.36,Main,,0,0,0,,Người bên ta bị hạ hết,\Nvũ khí cạn sạch, hết cách...
Dialogue: 0,0:01:52.36,0:01:54.09,Main,,0,0,0,,Sao còn quay về?
Dialogue: 0,0:01:55.59,0:01:57.63,Main,,0,0,0,,Julia ở đâu?
Dialogue: 0,0:01:58.76,0:01:59.86,Main,,0,0,0,,Tôi không...
Dialogue: 0,0:02:09.43,0:02:10.44,Main,,0,0,0,,Shin.
Dialogue: 0,0:02:11.16,0:02:13.30,Main,,0,0,0,,Đừng đi vào vết xe đổ của Lin.
Dialogue: 0,0:02:23.60,0:02:25.33,Main,,0,0,0,,Cứ thế đi qua luôn đi.
Dialogue: 0,0:02:32.47,0:02:33.39,Main,,0,0,0,,Sao thế?
Dialogue: 0,0:02:33.39,0:02:35.21,Main,,0,0,0,,Có khi chúng đã vây sẵn rồi.
Dialogue: 0,0:02:36.59,0:02:37.63,Main,,0,0,0,,Em đợi ở đây.
Dialogue: 0,0:02:45.29,0:02:46.06,Main,,0,0,0,,Annie?
Dialogue: 0,0:02:52.07,0:02:54.93,Main,,0,0,0,,Tôi đã bảo là cậu không đến,
Dialogue: 0,0:02:54.93,0:02:57.65,Main,,0,0,0,,rằng cậu chết rồi cơ mà...
Dialogue: 0,0:02:58.06,0:03:00.12,Main,,0,0,0,,Tôi đã nói thế rồi mà...
Dialogue: 0,0:03:00.12,0:03:01.00,Main,,0,0,0,,Đừng nói nữa.
Dialogue: 0,0:03:02.33,0:03:06.12,Main,,0,0,0,,Nghe đâu Vicious\Nđã giết sạch các trưởng lão.
Comment: 0,0:03:02.33,0:03:03.72,Main,,0,0,0,,Nghe đâu Vicious
Comment: 0,0:03:03.72,0:03:06.12,Main,,0,0,0,,đã giết sạch các trưởng lão.
Dialogue: 0,0:03:10.12,0:03:13.95,Main,,0,0,0,,Ai nấy như diều đứt dây,
Dialogue: 0,0:03:14.53,0:03:17.05,Main,,0,0,0,,chẳng còn biết đi đâu nữa.
Dialogue: 0,0:03:20.99,0:03:24.29,Main,,0,0,0,,Ra vậy... Cậu gặp được Julia rồi nhỉ.
Dialogue: 0,0:03:24.29,0:03:25.51,Main,,0,0,0,,Tốt quá...
Dialogue: 0,0:03:27.56,0:03:28.81,Main,,0,0,0,,Annie!
Dialogue: 0,0:03:29.41,0:03:34.80,Main,,0,0,0,,Hôm nay... sao lạnh thế...
Dialogue: 0,0:04:04.11,0:04:07.10,Main,,0,0,0,,Chạy trốn thì cần gì\Nvũ khí như thế.
Dialogue: 0,0:04:11.18,0:04:12.31,Main,,0,0,0,,Anh đi à?
Dialogue: 0,0:04:18.37,0:04:19.23,Main,,0,0,0,,Em sẽ đi cùng.
Dialogue: 0,0:04:21.04,0:04:23.34,Main,,0,0,0,,Cùng nhau đến phút cuối.
Dialogue: 0,0:04:30.50,0:04:31.16,Main,,0,0,0,,Xin lỗi nhé,
Dialogue: 0,0:04:31.83,0:04:33.17,Main,,0,0,0,,tôi sẽ làm ầm lên một chút đấy.
Dialogue: 0,0:04:50.88,0:04:52.80,Main,,0,0,0,,Cô đúng là gặp may nhỉ.
Dialogue: 0,0:04:52.80,0:04:54.09,Main,,0,0,0,,Đúng vậy.
Dialogue: 0,0:04:54.09,0:04:57.63,Main,,0,0,0,,Về đúng lúc thật, \Ntự dưng bị cuốn vào đủ thứ chuyện.
Dialogue: 0,0:04:58.15,0:04:59.84,Main,,0,0,0,,May thật đấy.
Dialogue: 0,0:04:59.84,0:05:02.15,Main,,0,0,0,,Red Tail sẽ không bay được một thời gian.
Dialogue: 0,0:05:02.81,0:05:05.24,Main,,0,0,0,,Anh cũng xui tận mạng nhỉ.
Dialogue: 0,0:05:05.24,0:05:07.26,Main,,0,0,0,,Toàn bị vạ lây.
Dialogue: 0,0:05:08.92,0:05:11.16,Main,,0,0,0,,Chắc anh ta không quay về nữa đâu.
Dialogue: 0,0:05:11.16,0:05:13.35,Main,,0,0,0,,Có khi đã bị xử ở đâu đó rồi.
Dialogue: 0,0:05:13.35,0:05:14.83,Main,,0,0,0,,Có thể lắm.
Dialogue: 0,0:05:15.32,0:05:16.80,Main,,0,0,0,,Thì sao?
Dialogue: 0,0:05:16.80,0:05:18.47,Main,,0,0,0,,Bảo tôi đi tìm à?
Dialogue: 0,0:05:18.47,0:05:22.05,Main,,0,0,0,,Đùa à!\NAnh ta đi vì quá khứ của mình cơ mà.
Dialogue: 0,0:05:24.14,0:05:26.31,Main,,0,0,0,,Chính anh để anh ta đi còn gì.
Dialogue: 0,0:05:26.82,0:05:29.20,Main,,0,0,0,,Chân bị bắn, đến tàu cũng hỏng.
Dialogue: 0,0:05:29.20,0:05:31.32,Main,,0,0,0,,Phải đấy! Toàn gây phiền phức!
Dialogue: 0,0:05:31.32,0:05:32.79,Main,,0,0,0,,Tôi mặc kệ!
Dialogue: 0,0:05:40.04,0:05:43.44,Main,,0,0,0,,Là người thế nào?\NCái cô Julia ấy.
Dialogue: 0,0:05:44.80,0:05:46.49,Main,,0,0,0,,Một phụ nữ bình thường.
Dialogue: 0,0:05:47.07,0:05:51.03,Main,,0,0,0,,Đẹp, nguy hiểm, không bỏ mặc được...\NMột phụ nữ bình thường.
Dialogue: 0,0:05:52.08,0:05:53.65,Main,,0,0,0,,Ra thế.
Dialogue: 0,0:05:53.65,0:05:55.96,Main,,0,0,0,,Một thiên thần như ác quỷ,
Dialogue: 0,0:05:56.38,0:05:58.18,Main,,0,0,0,,hay một ác quỷ như thiên thần.
Dialogue: 0,0:06:28.86,0:06:29.78,Main,,0,0,0,,Lối này!
Dialogue: 0,0:06:32.73,0:06:33.75,Main,,0,0,0,,Nằm xuống!
Dialogue: 0,0:07:23.86,0:07:24.46,Main,,0,0,0,,Julia!
Dialogue: 0,0:07:27.25,0:07:28.13,Main,,0,0,0,,Này!
Dialogue: 0,0:08:09.01,0:08:12.10,Main,,0,0,0,,Giờ Spike đang ở đâu?
Dialogue: 0,0:08:13.10,0:08:15.13,Main,,0,0,0,,Những kẻ đang sống,
Dialogue: 0,0:08:15.13,0:08:17.05,Main,,0,0,0,,mọi sinh linh mang sự sống,
Dialogue: 0,0:08:17.55,0:08:20.52,Main,,0,0,0,,đều có ngôi sao của riêng mình.
Dialogue: 0,0:08:22.43,0:08:25.26,Main,,0,0,0,,Khoảnh khắc sự sống ra đời,
Dialogue: 0,0:08:25.26,0:08:29.58,Main,,0,0,0,,một ngôi sao cũng ra đời,\Nvà trở thành sao hộ mệnh.
Dialogue: 0,0:08:30.40,0:08:33.42,Main,,0,0,0,,Hành tinh này cũng là\Nsao hộ mệnh của ai đó.
Dialogue: 0,0:08:33.42,0:08:37.57,Main,,0,0,0,,Cả ngôi sao đỏ kia, cả ngôi sao xanh kia.
Dialogue: 0,0:08:38.41,0:08:43.22,Main,,0,0,0,,Khi sự sống tàn,\Nngôi sao cũng sa xuống rồi biến mất.
Dialogue: 0,0:08:44.40,0:08:45.46,Main,,0,0,0,,Thôi đi.
Dialogue: 0,0:08:45.46,0:08:47.21,Main,,0,0,0,,Hỡi Đá Chạy.
Dialogue: 0,0:08:47.64,0:08:49.55,Main,,0,0,0,,Đừng gọi tôi bằng cái tên đó.
Dialogue: 0,0:08:49.55,0:08:52.63,Main,,0,0,0,,Ngôi sao của cậu ta sắp sửa sa xuống rồi.
Dialogue: 0,0:08:54.30,0:08:56.72,Main,,0,0,0,,Vớ vẩn. Ai mà tin được.
Dialogue: 0,0:08:56.72,0:08:58.35,Main,,0,0,0,,Đừng sợ cái chết.
Dialogue: 0,0:08:58.98,0:09:01.72,Main,,0,0,0,,Cái chết luôn ở bên cạnh.
Dialogue: 0,0:09:01.72,0:09:08.11,Main,,0,0,0,,Khoảnh khắc lộ ra nỗi sợ,\Nnó sẽ vồ tới nhanh hơn cả ánh sáng.
Dialogue: 0,0:09:08.11,0:09:13.82,Main,,0,0,0,,Nếu không sợ, nó sẽ chỉ\Ndịu dàng dõi theo mà thôi.
Dialogue: 0,0:09:24.00,0:09:26.03,Main,,0,0,0,,Thưa ngài Vicious, cái này...
Dialogue: 0,0:09:26.98,0:09:28.75,Main,,0,0,0,,Hộ chiếu của người phụ nữ đó\Nvẫn còn trong này.
Dialogue: 0,0:09:29.42,0:09:31.89,Main,,0,0,0,,Cô ta không thể dễ dàng\Nrời khỏi hành tinh này.
Dialogue: 0,0:09:33.36,0:09:36.09,Main,,0,0,0,,Một con thú mất chỗ dung thân.
Dialogue: 0,0:09:36.67,0:09:39.80,Main,,0,0,0,,Hắn chẳng còn nơi nào để quay về.
Dialogue: 0,0:09:40.59,0:09:42.48,Main,,0,0,0,,Hắn sẽ đến.
Dialogue: 0,0:10:00.03,0:10:02.28,Main,,0,0,0,,Spike, anh...
Dialogue: 0,0:10:02.97,0:10:04.75,Main,,0,0,0,,Có gì ăn không?
Dialogue: 0,0:10:06.35,0:10:07.75,Main,,0,0,0,,Đói meo rồi.
Dialogue: 0,0:10:17.18,0:10:20.83,Main,,0,0,0,,Đồ anh nấu vẫn dở như mọi khi.
Dialogue: 0,0:10:20.83,0:10:23.76,Main,,0,0,0,,Thế mà ăn nhiều ghê nhỉ.
Dialogue: 0,0:10:23.76,0:10:26.49,Main,,0,0,0,,Cái đói là gia vị tuyệt nhất mà.
Dialogue: 0,0:10:32.76,0:10:34.28,Main,,0,0,0,,Anh biết câu chuyện này không?
Dialogue: 0,0:10:35.76,0:10:37.53,Main,,0,0,0,,Có một con mèo mướp.
Dialogue: 0,0:10:37.53,0:10:42.72,Main,,0,0,0,,Nó lần lượt được bao nhiêu người chủ nuôi, \Nnhưng chẳng ưa một ai cả,
Dialogue: 0,0:10:42.72,0:10:46.33,Main,,0,0,0,,chết một triệu lần,\Nrồi sống lại một triệu lần.
Dialogue: 0,0:10:47.71,0:10:49.71,Main,,0,0,0,,Con mèo không sợ chết.
Dialogue: 0,0:10:53.66,0:10:57.01,Main,,0,0,0,,Có một kiếp, \Nnó là một con mèo hoang tự do.
Dialogue: 0,0:10:58.20,0:11:03.33,Main,,0,0,0,,Nó gặp một con mèo cái trắng,\Nvà cả hai sống hạnh phúc bên nhau.
Dialogue: 0,0:11:05.37,0:11:10.15,Main,,0,0,0,,Rồi năm tháng trôi qua,\Ncon mèo trắng già đi rồi chết.
Dialogue: 0,0:11:11.15,0:11:15.02,Main,,0,0,0,,Con mèo mướp khóc một triệu lần,\Nrồi cũng chết.
Dialogue: 0,0:11:15.82,0:11:18.00,Main,,0,0,0,,Và không bao giờ sống lại nữa.
Dialogue: 0,0:11:20.61,0:11:22.45,Main,,0,0,0,,Chuyện hay đấy.
Dialogue: 0,0:11:23.12,0:11:24.92,Main,,0,0,0,,Tôi ghét câu chuyện này.
Dialogue: 0,0:11:26.41,0:11:27.95,Main,,0,0,0,,Tôi ghét mèo.
Dialogue: 0,0:11:28.98,0:11:30.46,Main,,0,0,0,,Biết ngay mà.
Dialogue: 0,0:11:43.70,0:11:44.85,Main,,0,0,0,,Spike.
Dialogue: 0,0:11:46.50,0:11:48.70,Main,,0,0,0,,Cho tôi hỏi một câu thôi.
Dialogue: 0,0:11:48.70,0:11:49.81,Main,,0,0,0,,Gì thế?
Dialogue: 0,0:11:49.81,0:11:51.27,Main,,0,0,0,,Là vì người phụ nữ đó à?
Dialogue: 0,0:11:53.95,0:11:57.65,Main,,0,0,0,,{Vì một người phụ nữ đã chết\Nthì đâu làm được gì nữa.}Tôi có thể làm được gì\Ncho một người phụ nữ đã chết đây.
Dialogue: 0,0:12:09.05,0:12:10.08,Main,,0,0,0,,Anh đi đâu?
Dialogue: 0,0:12:13.08,0:12:14.16,Main,,0,0,0,,Sao lại đi?
Dialogue: 0,0:12:18.22,0:12:21.16,Main,,0,0,0,,Có lần anh đã nói,
Dialogue: 0,0:12:21.16,0:12:23.22,Main,,0,0,0,,"Quá khứ thế nào cũng được."
Dialogue: 0,0:12:25.79,0:12:27.93,Main,,0,0,0,,Chính anh mới là người\Nbị quá khứ trói buộc.
Dialogue: 0,0:12:31.40,0:12:32.31,Main,,0,0,0,,Nhìn đôi mắt này đi.
Dialogue: 0,0:12:35.03,0:12:38.48,Main,,0,0,0,,Một bên bị mất trong tai nạn,\Nnên là mắt giả.
Dialogue: 0,0:12:40.43,0:12:46.53,Main,,0,0,0,,Từ đó, tôi nhìn quá khứ bằng một mắt,\Nvà nhìn hiện tại bằng mắt kia.
Dialogue: 0,0:12:47.78,0:12:51.71,Main,,0,0,0,,Tôi từng nghĩ những gì mắt thấy\Nkhông phải là tất cả hiện thực.
Dialogue: 0,0:12:53.01,0:12:54.66,Main,,0,0,0,,Đừng nói chuyện đó với tôi.
Dialogue: 0,0:12:55.31,0:12:57.58,Main,,0,0,0,,Chưa từng kể gì về bản thân,
Dialogue: 0,0:12:58.24,0:13:00.05,Main,,0,0,0,,giờ đừng có kể những chuyện đó!
Dialogue: 0,0:13:00.71,0:13:03.63,Main,,0,0,0,,Tôi cứ ngỡ mình đang mơ\Nmột giấc mơ không bao giờ tỉnh.
Dialogue: 0,0:13:07.19,0:13:09.51,Main,,0,0,0,,Chẳng biết từ lúc nào\Nmà đã tỉnh mất rồi.
Dialogue: 0,0:13:12.40,0:13:15.27,Main,,0,0,0,,Tôi... nhớ lại hết rồi.
Dialogue: 0,0:13:17.18,0:13:17.95,Main,,0,0,0,,Nhưng...
Dialogue: 0,0:13:18.88,0:13:21.41,Main,,0,0,0,,chẳng có gì tốt đẹp cả.
Dialogue: 0,0:13:21.96,0:13:25.62,Main,,0,0,0,,Chẳng có nơi nào để quay về...
