Comment: 0,0:22:34.74,0:26:36.33,Main,,0,0,0,,========= ED =========
Dialogue: 0,0:22:46.64,0:22:52.10,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}Cứ mải than thân trách phận, cho mối tình xưa,
Dialogue: 0,0:22:52.10,0:22:57.52,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}dòng thời gian vẫn lẳng lặng trôi, đã bao lâu rồi?
Dialogue: 0,0:22:58.61,0:23:04.15,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}Vết bỏng hằn sâu trong tim, nào có nguôi đi,
Dialogue: 0,0:23:04.15,0:23:09.37,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}gió chẳng thể xoa dịu cho tôi, chỉ biết thổi thôi.
Dialogue: 0,0:23:10.58,0:23:19.88,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}Với con ngươi khô, với tròng mắt cạn, ai đó ơi, giúp tôi đổ lệ đi!
Dialogue: 0,0:23:21.50,0:23:25.05,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}Giai điệu Folk Blues đích thực!
Dialogue: 0,0:23:21.50,0:23:25.05,GT,,0,0,0,,{\fad(0,300)\bord0\shad0\blur0.67}(Blues còn có nghĩa là u sầu, buồn bã)
Dialogue: 0,0:23:25.05,0:23:28.60,ED-Vie,,0,0,0,,{\fad(300,0)\blur0.67}Đâu là thật đây?
Dialogue: 0,0:23:29.30,0:23:33.64,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}Tôi chỉ muốn biết đâu là u sầu thật sự.
Dialogue: 0,0:23:33.64,0:23:37.19,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}Toàn thân lấm lem phù sa.
Dialogue: 0,0:23:37.19,0:23:40.57,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}Ngụp lặn giữa sông.
Dialogue: 0,0:23:41.27,0:23:45.78,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}Sống như vậy cũng đâu đến nỗi tệ,
Dialogue: 0,0:23:45.78,0:23:54.62,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}miễn sao chỉ phải... cam chịu một lần.
Comment: 0,0:01:31.03,0:01:31.07,Main,,0,0,0,,========= Dialogue =========
Dialogue: 0,0:02:50.77,0:02:52.96,Main,,0,0,0,,VT! Xong ca rồi à?
Dialogue: 0,0:02:52.96,0:02:54.98,Main,,0,0,0,,Cuối cùng cũng xong. Còn anh?
Dialogue: 0,0:02:54.98,0:02:57.32,Main,,0,0,0,,Giờ tôi đi Europa đây.
Dialogue: 0,0:02:57.32,0:02:58.55,Main,,0,0,0,,Kiếm khá đấy nhỉ.
Dialogue: 0,0:02:58.55,0:02:59.99,Main,,0,0,0,,Sao bì được với chị.
Dialogue: 0,0:03:00.42,0:03:03.99,Main,,0,0,0,,Nghe đồn chị đi về Sao Kim\Nchỉ mất có 4 ngày à?
Dialogue: 0,0:03:04.40,0:03:05.37,Main,,0,0,0,,3 ngày.
Dialogue: 0,0:03:05.37,0:03:07.11,Main,,0,0,0,,Thế mới là chị chứ!
Dialogue: 0,0:03:07.11,0:03:09.03,Main,,0,0,0,,Thôi, nghỉ ngơi cho khỏe vào.
Dialogue: 0,0:03:09.03,0:03:10.64,Main,,0,0,0,,Cảm ơn.
Dialogue: 0,0:03:10.64,0:03:11.71,Main,,0,0,0,,À, suýt quên.
Dialogue: 0,0:03:12.96,0:03:13.81,Main,,0,0,0,,VT!
Dialogue: 0,0:03:16.00,0:03:17.68,Main,,0,0,0,,Vẫn chưa bỏ cuộc à?
Dialogue: 0,0:03:17.68,0:03:21.51,Main,,0,0,0,,Đương nhiên! Chị biết tôi đã\Nđổ vào đó bao nhiêu tiền rồi không?
Dialogue: 0,0:03:22.15,0:03:23.68,Main,,0,0,0,,Thôi, tùy anh.
Dialogue: 0,0:03:24.93,0:03:29.08,Main,,0,0,0,,Nhớ đấy nhá. Chỉ được đoán 1 lần,\Nkhông có gợi ý gì đâu.
Dialogue: 0,0:03:29.08,0:03:32.65,Main,,0,0,0,,Được! VT, tên của chị là...
Dialogue: 0,0:03:33.22,0:03:34.65,Main,,0,0,0,,Vivian Tillana.
Dialogue: 0,0:03:36.40,0:03:37.56,Main,,0,0,0,,Sai rồi.
Dialogue: 0,0:03:37.56,0:03:38.61,Main,,0,0,0,,Ái chà!
Dialogue: 0,0:03:38.61,0:03:40.92,Main,,0,0,0,,Xui thật...
Dialogue: 0,0:03:40.92,0:03:42.55,Main,,0,0,0,,Đi đường cẩn thận đấy.
Dialogue: 0,0:03:44.75,0:03:48.26,Main,,0,0,0,,Này, nhớ cái đầu 8 triệu\Nhôm nọ chứ?
Dialogue: 0,0:03:48.26,0:03:50.55,Main,,0,0,0,,Nói thật, người tóm Cookwife\Nchính là tôi đây!
Dialogue: 0,0:03:50.55,0:03:54.92,Main,,0,0,0,,Hôm nọ là hôm nào?\NChuyện 10 năm trước rồi, lão già!
Dialogue: 0,0:03:55.32,0:04:00.13,Main,,0,0,0,,Bọn ranh con thì biết cái gì!\NChính tôi đã dạy dỗ Telpsicorei đấy!
Dialogue: 0,0:04:00.13,0:04:02.18,Main,,0,0,0,,Thợ săn tiền thưởng huyền thoại ấy hả?
Dialogue: 0,0:04:02.18,0:04:06.46,Main,,0,0,0,,Ờ, chỉ cần nghe tên thôi là\N tên tội phạm nào cũng run như cầy sấy.
Dialogue: 0,0:04:06.46,0:04:08.35,Main,,0,0,0,,Chuyện đó thì ai chả biết.
Dialogue: 0,0:04:18.94,0:04:20.36,Main,,0,0,0,,Ô, Zeros.
Dialogue: 0,0:04:20.36,0:04:22.97,Main,,0,0,0,,Chào VT. Như mọi khi chứ?
Dialogue: 0,0:04:22.97,0:04:24.06,Main,,0,0,0,,Ờ.
Dialogue: 0,0:04:24.06,0:04:27.06,Main,,0,0,0,,Hôm nay có chuyện gì thế?\NBình thường vắng hoe cơ mà.
Dialogue: 0,0:04:27.06,0:04:28.80,Main,,0,0,0,,À, chuyện là...
Dialogue: 0,0:04:28.80,0:04:32.57,Main,,0,0,0,,Nghe nói có tên truy nã\N Decker gì đó sắp đi ngang đây.
Dialogue: 0,0:04:32.57,0:04:34.73,Main,,0,0,0,,Đám này toàn thợ săn tiền thưởng cả đấy.
Dialogue: 0,0:04:36.11,0:04:39.05,Main,,0,0,0,,Thảo nào toàn bản mặt rẻ tiền.
Dialogue: 0,0:04:39.61,0:04:41.68,Main,,0,0,0,,Tin "tuyệt mật" cái nỗi gì.
Dialogue: 0,0:04:41.68,0:04:44.20,Main,,0,0,0,,Cả quán chật ních dân cùng nghề.
Dialogue: 0,0:04:44.73,0:04:47.43,Main,,0,0,0,,Đã thế tôi còn đang vật vã vì say.
Dialogue: 0,0:04:48.17,0:04:52.77,Main,,0,0,0,,Mà mặt mũi hắn thế nào còn chả biết,\Nmỗi cái hình xăm rồng thì tìm kiểu gì.
Dialogue: 0,0:04:53.64,0:04:54.89,Main,,0,0,0,,Faye?
Dialogue: 0,0:04:55.45,0:04:58.08,Main,,0,0,0,,{\i1}Bên đó thì chắc gì đã khá hơn.{\i0}
Dialogue: 0,0:04:59.09,0:05:00.97,Main,,0,0,0,,{\i1}Chào mừng quý khách đến với Woody's!{\i0}
Dialogue: 0,0:05:00.97,0:05:04.04,Main,,0,0,0,,{\i1}Ngay bây giờ,\N tất cả các bé sinh nhật hôm nay{\i0}
Dialogue: 0,0:05:04.04,0:05:07.12,Main,,0,0,0,,{\i1}đều được chụp ảnh cùng Mackey và Mannie!{\i0}
Dialogue: 0,0:05:07.12,0:05:10.95,Main,,0,0,0,,{\i1}Bố mẹ các bé báo với nhân viên nhé!{\i0}
Dialogue: 0,0:05:17.76,0:05:19.25,Main,,0,0,0,,Chào~
Dialogue: 0,0:05:20.42,0:05:23.05,Main,,0,0,0,,Gì đây? Muốn bị "xử" à?
Dialogue: 0,0:05:23.05,0:05:26.55,Main,,0,0,0,,Đúng ra thì tôi thích "xử" người ta hơn.
Dialogue: 0,0:05:26.55,0:05:27.64,Main,,0,0,0,,Chiều luôn. Ơ...?
Dialogue: 0,0:05:28.49,0:05:30.43,Main,,0,0,0,,Giơ tay lên nào, Decker.
Dialogue: 0,0:05:34.81,0:05:35.69,Main,,0,0,0,,Em khó xử lắm!
Dialogue: 0,0:05:35.69,0:05:37.95,Main,,0,0,0,,Kệ đi, qua đây với anh nào~
Dialogue: 0,0:05:37.95,0:05:39.28,Main,,0,0,0,,Em còn phải làm việc...
Dialogue: 0,0:05:39.28,0:05:41.24,Main,,0,0,0,,Cứ thong thả đi mà~
Dialogue: 0,0:05:41.24,0:05:42.15,Main,,0,0,0,,Lại đây nào!
Dialogue: 0,0:05:42.15,0:05:44.01,Main,,0,0,0,,Đ-Đừng mà...
Dialogue: 0,0:05:44.01,0:05:45.80,Main,,0,0,0,,Anh cho em sướng nhé~
Dialogue: 0,0:05:46.40,0:05:47.92,Main,,0,0,0,,Đừng mà!
Dialogue: 0,0:05:47.92,0:05:49.37,Main,,0,0,0,,Cứu với!
Dialogue: 0,0:05:50.90,0:05:51.83,Main,,0,0,0,,Mụ là ai hả?!
Dialogue: 0,0:05:51.83,0:05:53.16,Main,,0,0,0,,VT!
Dialogue: 0,0:05:54.16,0:05:59.79,Main,,0,0,0,,Thợ săn tiền thưởng giờ không săn tiền\Nmà chuyển sang đi săn gái à?
Dialogue: 0,0:06:00.20,0:06:03.13,Main,,0,0,0,,Xin lỗi nhé, nghề của chị nó thế.
Dialogue: 0,0:06:03.13,0:06:04.14,Main,,0,0,0,,C-Cái gì—
Dialogue: 0,0:06:04.14,0:06:05.30,Main,,0,0,0,,Đừng có mà giả ngu.
Dialogue: 0,0:06:05.30,0:06:07.93,Main,,0,0,0,,Cái hình xăm rồng rành rành ra đây,\N chối thế nào được.
Dialogue: 0,0:06:09.18,0:06:11.66,Main,,0,0,0,,N-Nhầm người rồi...
Dialogue: 0,0:06:11.66,0:06:13.06,Main,,0,0,0,,Này, anh đằng kia!
Dialogue: 0,0:06:13.06,0:06:15.03,Main,,0,0,0,,Gọi cảnh sát đi!
Dialogue: 0,0:06:15.03,0:06:17.62,Main,,0,0,0,,Báo là tôi tóm được Decker rồi.
Dialogue: 0,0:06:33.74,0:06:34.93,Main,,0,0,0,,Đây là...
Dialogue: 0,0:06:35.67,0:06:37.75,Main,,0,0,0,,Bé lươn tám mắt Yakkun.
Dialogue: 0,0:06:37.75,0:06:39.83,Main,,0,0,0,,Xăm thế ai chả nhầm!
Dialogue: 0,0:06:54.47,0:06:55.39,Main,,0,0,0,,Con mụ này!
Dialogue: 0,0:07:14.65,0:07:15.82,Main,,0,0,0,,Mày...!
Dialogue: 0,0:07:16.41,0:07:17.62,Main,,0,0,0,,VT!
Dialogue: 0,0:07:18.67,0:07:20.68,Main,,0,0,0,,Mụ tưởng mụ ngon lắm hả?!
Dialogue: 0,0:07:25.24,0:07:27.17,Main,,0,0,0,,M-Mày là thằng nào?
Dialogue: 0,0:07:27.17,0:07:30.38,Main,,0,0,0,,Chưa nghe câu\Ntrời đánh tránh miếng ăn bao giờ à?
Dialogue: 0,0:07:32.04,0:07:34.30,Main,,0,0,0,,Cái đệch! \NĐập cả thằng này luôn cho tao!
Dialogue: 0,0:07:57.17,0:07:58.29,Main,,0,0,0,,Thấy rồi!
Dialogue: 0,0:08:12.13,0:08:14.09,Main,,0,0,0,,Bà mịa, nhớ mặt đấy!
Dialogue: 0,0:08:15.88,0:08:17.67,Main,,0,0,0,,Ấy, đùa thôi ạ.
Dialogue: 0,0:08:17.67,0:08:19.28,Main,,0,0,0,,Quên bọn em đi nhé!
Dialogue: 0,0:08:27.36,0:08:29.83,Main,,0,0,0,,12 triệu của tôi...
Dialogue: 0,0:08:32.42,0:08:37.39,Main,,0,0,0,,Đúng là bọn thợ săn tiền thưởng\Ntoàn một lũ đần với cặn bã.
Dialogue: 0,0:08:37.39,0:08:38.38,Main,,0,0,0,,Thế à?
Dialogue: 0,0:08:38.38,0:08:39.42,Main,,0,0,0,,Chứ sao!
Dialogue: 0,0:08:39.42,0:08:43.79,Main,,0,0,0,,Theo những gì tôi biết, bọn chúng \Ntoàn sống kiểu đem đời ra đánh bạc thôi.
Dialogue: 0,0:08:44.52,0:08:46.75,Main,,0,0,0,,Chà, chắc vậy.
Dialogue: 0,0:08:47.26,0:08:49.96,Main,,0,0,0,,Qua đây. Tôi mời cậu một cốc.
Dialogue: 0,0:08:55.01,0:08:58.30,Main,,0,0,0,,Muốn gì? Giá đỗ tốt cho sức khỏe đấy!
Dialogue: 0,0:09:00.64,0:09:04.08,Main,,0,0,0,,Tha cho tao đi! Nhà còn mỗi thế thôi!
Dialogue: 0,0:09:04.08,0:09:05.64,Main,,0,0,0,,Ồ, tới rồi tới rồi.
Dialogue: 0,0:09:06.18,0:09:08.34,Main,,0,0,0,,Ờ, Faye à. Nhanh thế.
Dialogue: 0,0:09:09.53,0:09:11.11,Main,,0,0,0,,Cái gì?!
Dialogue: 0,0:09:11.62,0:09:14.50,Main,,0,0,0,,Mà công nhận cách uống đó ghê thật.
Dialogue: 0,0:09:14.50,0:09:16.34,Main,,0,0,0,,Prairie oyster đấy.
Dialogue: 0,0:09:16.34,0:09:17.70,Main,,0,0,0,,Giải rượu tốt lắm.
Dialogue: 0,0:09:23.06,0:09:26.69,Main,,0,0,0,,Cậu là người thứ 2 tôi gặp\Nuống kiểu đó đấy.
Dialogue: 0,0:09:26.69,0:09:27.67,Main,,0,0,0,,Thế người thứ nhất?
Dialogue: 0,0:09:28.88,0:09:30.35,Main,,0,0,0,,Chồng tôi.
Dialogue: 0,0:09:30.88,0:09:32.51,Main,,0,0,0,,VT!
Dialogue: 0,0:09:32.51,0:09:34.35,Main,,0,0,0,,Lần này bọn tôi ăn chắc.
Dialogue: 0,0:09:34.35,0:09:34.97,Main,,0,0,0,,Tiền đây!
Dialogue: 0,0:09:35.60,0:09:37.18,Main,,0,0,0,,3 ông chung 1 lượt à?
Dialogue: 0,0:09:37.18,0:09:38.39,Main,,0,0,0,,Ờ!
Dialogue: 0,0:09:38.39,0:09:39.51,Main,,0,0,0,,Tùy thôi.
Dialogue: 0,0:09:41.39,0:09:43.64,Main,,0,0,0,,Được! Chơi luôn!
Dialogue: 0,0:09:44.19,0:09:47.29,Main,,0,0,0,,VT, tên của chị là...
Dialogue: 0,0:09:47.29,0:09:49.66,Main,,0,0,0,,Tôi thấy Adrienne được đấy.
Dialogue: 0,0:09:51.13,0:09:52.86,Main,,0,0,0,,Đâu có bắt đầu bằng chữ V.
Dialogue: 0,0:09:52.86,0:09:56.66,Main,,0,0,0,,Thế nên tôi đã bảo là\Nchọn Leticia rồi còn gì!
Dialogue: 0,0:09:56.66,0:09:57.44,Main,,0,0,0,,Thế à?
Dialogue: 0,0:09:57.44,0:10:00.76,Main,,0,0,0,,Đoán ra tên chị\Nlà được chỗ tiền đó à?
Dialogue: 0,0:10:00.76,0:10:02.00,Main,,0,0,0,,Ờ.
Dialogue: 0,0:10:02.00,0:10:04.99,Main,,0,0,0,,Tôi cũng chả nhớ ai bày ra trò này,
Dialogue: 0,0:10:04.99,0:10:07.33,Main,,0,0,0,,nhưng giờ tiền dồn lại\Nđược một đống thế này đây.
Dialogue: 0,0:10:07.94,0:10:09.24,Main,,0,0,0,,Tôi chơi được chứ?
Dialogue: 0,0:10:10.87,0:10:12.20,Main,,0,0,0,,{\i1}Spike! Tôi đây!{\i0}
Dialogue: 0,0:10:12.20,0:10:14.43,Main,,0,0,0,,{\i1}Faye để xổng Decker rồi!{\i0}
Dialogue: 0,0:10:14.43,0:10:15.66,Main,,0,0,0,,{\i1}Mau đuổi theo—{\i0}
Dialogue: 0,0:10:20.55,0:10:22.36,Main,,0,0,0,,Spike...
Dialogue: 0,0:10:22.36,0:10:23.28,Main,,0,0,0,,Biến đi!
Dialogue: 0,0:10:24.44,0:10:26.43,Main,,0,0,0,,Đồ đần, đồ cặn bã, đồ dối trá!
Dialogue: 0,0:10:26.43,0:10:27.85,Main,,0,0,0,,Không mời nữa!
Dialogue: 0,0:10:32.25,0:10:34.75,Main,,0,0,0,,Ơ, anh Spike!
Dialogue: 0,0:10:38.15,0:10:40.07,Main,,0,0,0,,Giời đất ơi...
Dialogue: 0,0:10:41.47,0:10:45.54,Main,,0,0,0,,À cái này hả, mấy anh \NBrothers ban nãy làm rồi bỏ đi đấy.
Dialogue: 0,0:10:46.02,0:10:47.45,Main,,0,0,0,,Cô thấy à?
Dialogue: 0,0:10:47.45,0:10:48.17,Main,,0,0,0,,Vâng.
Dialogue: 0,0:10:50.27,0:10:52.21,Main,,0,0,0,,Sao giờ mới nói?
Dialogue: 0,0:10:52.62,0:10:55.17,Main,,0,0,0,,Có im đâu, vừa nói đấy thôi.
Dialogue: 0,0:11:02.35,0:11:03.30,Main,,0,0,0,,Gì đấy?
Dialogue: 0,0:11:09.84,0:11:12.08,Main,,0,0,0,,Ơ, VT về à?
Dialogue: 0,0:11:12.08,0:11:14.32,Main,,0,0,0,,Không được à? Zeros, đi nào.
Dialogue: 0,0:11:20.69,0:11:21.87,Main,,0,0,0,,Làm trò gì thế?
Dialogue: 0,0:11:21.87,0:11:23.18,Main,,0,0,0,,Xin đi nhờ.
Dialogue: 0,0:11:23.69,0:11:25.87,Main,,0,0,0,,Tàu tôi bị chơi khăm rồi.
Dialogue: 0,0:11:27.00,0:11:29.12,Main,,0,0,0,,Cậu đúng là đồ đần...
Dialogue: 0,0:11:29.12,0:11:32.83,Main,,0,0,0,,...cặn bã, dối trá, lại còn là\Nthợ săn tiền thưởng mặt dày chứ gì.
Dialogue: 0,0:11:32.83,0:11:34.34,Main,,0,0,0,,Còn lải nhải nữa là...
Dialogue: 0,0:11:44.14,0:11:45.10,Main,,0,0,0,,Theo tôi.
Dialogue: 0,0:11:45.91,0:11:47.56,Main,,0,0,0,,Cho thêm một người nữa được không?
Dialogue: 0,0:11:54.55,0:11:57.48,Main,,0,0,0,,{\i1}Giời ạ! Bắt người ta\Nnói đi nói lại bao nhiêu lần nữa hả?!{\i0}
Dialogue: 0,0:11:57.48,0:12:00.26,Main,,0,0,0,,Hói, lùn, đeo kính,\Nlại còn Biện Tài Thiên...
Dialogue: 0,0:12:00.26,0:12:02.10,Main,,0,0,0,,Hả? Cái gì cơ?
Dialogue: 0,0:12:02.10,0:12:03.24,Main,,0,0,0,,Đã bảo là...
Dialogue: 0,0:12:03.24,0:12:07.49,Main,,0,0,0,,Giời ơi! Tắt cái thứ\Nâm thanh đinh tai nhức óc này đi!
Dialogue: 0,0:12:07.99,0:12:10.75,Main,,0,0,0,,Có nghe câu "Nhập gia tùy tục" chưa?
Dialogue: 0,0:12:12.45,0:12:15.07,Main,,0,0,0,,Với lại, nó không phải\N "thứ âm thanh đinh tai nhức óc",
Dialogue: 0,0:12:15.07,0:12:17.46,Main,,0,0,0,,nó là heavy metal!
Dialogue: 0,0:12:29.76,0:12:32.60,Main,,0,0,0,,Thật là, hai đứa y như nhau...
Dialogue: 0,0:12:32.60,0:12:35.54,Main,,0,0,0,,Rồi ai sửa đây hả giời?
Dialogue: 0,0:12:38.01,0:12:40.69,Main,,0,0,0,,Chừng ấy thông tin\Nthì bảo tôi làm ăn kiểu gì?
Dialogue: 0,0:12:41.27,0:12:44.42,Main,,0,0,0,,Cô nghĩ trong vũ trụ này\Ncó bao nhiêu gã hói đeo kính hả?
Dialogue: 0,0:12:44.42,0:12:47.16,Main,,0,0,0,,Thì đã bảo là hói, lùn, đeo kính,
Dialogue: 0,0:12:47.61,0:12:51.62,Main,,0,0,0,,lái xe tải lòe loẹt\Ncó vẽ hình Biện Tài Thiên kia mà!
Dialogue: 0,0:12:54.14,0:12:55.39,Main,,0,0,0,,{\i1}Nghe đây.{\i0}
Dialogue: 0,0:12:55.39,0:12:56.76,Main,,0,0,0,,{\i1}VT đấy hả?{\i0}
Dialogue: 0,0:12:56.76,0:12:58.59,Main,,0,0,0,,{\i1}À, Otto. Sao thế?{\i0}
Dialogue: 0,0:12:58.59,0:13:00.89,Main,,0,0,0,,{\i1}Tôi bị thằng nào đâm rồi chạy mất!{\i0}
Dialogue: 0,0:13:00.89,0:13:01.81,Main,,0,0,0,,Hả?
Dialogue: 0,0:13:01.81,0:13:05.18,Main,,0,0,0,,{\i1}Thằng đó chen ngang ở cổng vào,\Nđâm vào tôi rồi chuồn mất!{\i0}
Dialogue: 0,0:13:05.80,0:13:09.10,Main,,0,0,0,,{\i1}Mẹ nó! Không bắt nó đền\Nthì tôi tức chết mất!{\i0}
Dialogue: 0,0:13:09.10,0:13:10.89,Main,,0,0,0,,{\i1}Thấy nó thì báo tôi nhé.{\i0}
Dialogue: 0,0:13:10.89,0:13:12.44,Main,,0,0,0,,{\i1}Có đặc điểm gì không?{\i0}
Dialogue: 0,0:13:12.44,0:13:13.96,Main,,0,0,0,,Để xem...
Dialogue: 0,0:13:13.96,0:13:17.45,Main,,0,0,0,,Có hình một bà nữ thần\Nphương Đông gì gì đó...
Dialogue: 0,0:13:17.45,0:13:20.14,Main,,0,0,0,,{\i1}Khoan! Có phải Biện Tài Thiên không?{\i0}
Dialogue: 0,0:13:20.14,0:13:23.36,Main,,0,0,0,,Đúng đúng, chính nó! Sao chị biết?
Dialogue: 0,0:13:24.46,0:13:25.40,Main,,0,0,0,,Zeros.
Dialogue: 0,0:13:28.12,0:13:30.75,Main,,0,0,0,,{\i1}Gọi kênh 19, gọi kênh 19.{\i0}
Dialogue: 0,0:13:30.75,0:13:32.72,Main,,0,0,0,,{\i1}Gửi các tài xế vùng tiểu hành tinh,{\i0}
Dialogue: 0,0:13:32.72,0:13:34.86,Main,,0,0,0,,{\i1}Nữ Hoàng Heavy Metal đây.{\i0}
Dialogue: 0,0:13:34.86,0:13:37.46,Main,,0,0,0,,{\i1}Ai thấy chiếc xe tải lòe loẹt\Ncó vẽ Biện Tài Thiên,{\i0}
Dialogue: 0,0:13:37.46,0:13:39.54,Main,,0,0,0,,{\i1}thì báo tôi ngay nhé. Cảm ơn!{\i0}
Dialogue: 0,0:13:39.54,0:13:42.52,Main,,0,0,0,,{\i1}VT, Cỗ Máy Tình Yêu đây.{\i0}
Dialogue: 0,0:13:42.52,0:13:45.92,Main,,0,0,0,,{\i1}Có chuyện gì à? Trai bỏ trốn hả?{\i0}
Dialogue: 0,0:13:45.92,0:13:47.38,Main,,0,0,0,,{\i1}Đại loại vậy.{\i0}
Dialogue: 0,0:13:47.38,0:13:50.99,Main,,0,0,0,,Tôi thì chưa thấy, nhưng sẽ để mắt giúp.
Dialogue: 0,0:13:50.99,0:13:52.85,Main,,0,0,0,,{\i1}Cảm ơn, nhờ anh nhé.{\i0}
Dialogue: 0,0:13:52.85,0:13:56.94,Main,,0,0,0,,Rắn Lươn Lẹo đây.\NXe vẽ mặt hề hả?
Dialogue: 0,0:13:56.94,0:13:57.98,Main,,0,0,0,,{\i1}Không phải.{\i0}
Dialogue: 0,0:13:57.98,0:14:00.85,Main,,0,0,0,,{\i1}Mike Nhện đây, Báo Đen của Sao Mộc.{\i0}
Dialogue: 0,0:14:00.85,0:14:05.44,Main,,0,0,0,,{\i1}Tuy chưa gặp chị bao giờ, nhưng tôi\Nnghe danh Nữ Hoàng Heavy Metal nhiều rồi.{\i0}
Dialogue: 0,0:14:05.44,0:14:08.16,Main,,0,0,0,,Quá khen. Thế, có tin gì không?
Dialogue: 0,0:14:08.16,0:14:11.66,Main,,0,0,0,,Mới 10 phút trước, tôi chạy ngang\Nmột gã trông giống thế.
Dialogue: 0,0:14:11.66,0:14:13.87,Main,,0,0,0,,Chỗ quanh khu mỏ Linus.
Dialogue: 0,0:14:14.67,0:14:15.78,Main,,0,0,0,,{\i1}Có giúp được gì không?{\i0}
Dialogue: 0,0:14:16.52,0:14:18.83,Main,,0,0,0,,Cảm ơn, nợ anh lần này nhé.
Dialogue: 0,0:14:26.90,0:14:29.05,Main,,0,0,0,,Cái này cũng phải thay...
Dialogue: 0,0:14:42.48,0:14:43.36,Main,,0,0,0,,Thấy rồi.
Dialogue: 0,0:14:53.24,0:14:55.24,Main,,0,0,0,,Định cắt đuôi cơ à?
Dialogue: 0,0:14:57.91,0:14:59.37,Main,,0,0,0,,Còn non và xanh lắm!{Đợi trăm năm nữa đi!}
Dialogue: 0,0:15:10.52,0:15:14.39,Main,,0,0,0,,Thợ săn tiền thưởng đần độn, \Ncặn bã, dối trá, mặt dày có đó không?
Dialogue: 0,0:15:14.39,0:15:16.60,Main,,0,0,0,,Mỏ Linus á?!
Dialogue: 0,0:15:16.60,0:15:17.68,Main,,0,0,0,,Liều quá!
Dialogue: 0,0:15:17.68,0:15:19.34,Main,,0,0,0,,{\i1}Hả? Cậu nói gì?{\i0}
Dialogue: 0,0:15:19.34,0:15:20.99,Main,,0,0,0,,Đừng lại gần Decker!
Dialogue: 0,0:15:20.99,0:15:23.02,Main,,0,0,0,,Hàng của hắn nguy hiểm lắm!
Dialogue: 0,0:15:23.02,0:15:23.81,Main,,0,0,0,,Này!
Dialogue: 0,0:15:27.66,0:15:31.61,Main,,0,0,0,,Này, khoan đã! Tôi nhắm Decker \Ntrước rồi đấy nhá!
Dialogue: 0,0:15:39.73,0:15:41.27,Main,,0,0,0,,Cái gì đây? Thật luôn?
Dialogue: 0,0:15:41.27,0:15:42.83,Main,,0,0,0,,Gắn cái thứ quê mùa này á?
Dialogue: 0,0:15:43.40,0:15:46.09,Main,,0,0,0,,Giá mà hỏng được \Ncái mồm lắm điều của cô thì tốt.
Dialogue: 0,0:15:46.09,0:15:47.80,Main,,0,0,0,,Nghe hết rồi đấy nhá.
Dialogue: 0,0:15:47.80,0:15:49.63,Main,,0,0,0,,Tôi đi đây, Jet!
Dialogue: 0,0:15:49.63,0:15:53.09,Main,,0,0,0,,Spike! Súng chính bên đó\Ncũng chưa sửa xong đâu đấy!
Dialogue: 0,0:16:27.97,0:16:29.50,Main,,0,0,0,,Cũng có cố gắng đấy.
Dialogue: 0,0:16:52.61,0:16:56.02,Main,,0,0,0,,Cái gì đây? Có mạo hiểm quá không đấy?
Dialogue: 0,0:16:56.02,0:16:56.74,Main,,0,0,0,,Bên này!
Dialogue: 0,0:17:07.83,0:17:10.80,Main,,0,0,0,,12 triệu của mình...
Dialogue: 0,0:17:15.69,0:17:17.41,Main,,0,0,0,,{\i1}Này! Còn sống không?{\i0}
Dialogue: 0,0:17:17.41,0:17:18.89,Main,,0,0,0,,{\i1}Nghe thấy thì trả lời đi!{\i0}
Dialogue: 0,0:17:19.66,0:17:22.71,Main,,0,0,0,,{\i1}Không sao. Chừng này chưa chết được đâu.{\i0}
Dialogue: 0,0:17:22.71,0:17:23.77,Main,,0,0,0,,Ta phải đi ngay!
Dialogue: 0,0:17:24.52,0:17:26.44,Main,,0,0,0,,{\i1}Decker là dân chuyên thuốc nổ.{\i0}
Dialogue: 0,0:17:26.44,0:17:29.90,Main,,0,0,0,,{\i1}Thứ hắn đang chở là\Nnitro rắn hắn định đem đi bán đấy.{\i0}
Dialogue: 0,0:17:31.46,0:17:35.26,Main,,0,0,0,,Cả tàu á? Lượng đó đủ thổi bay\Ncả tiểu hành tinh này còn gì!
Dialogue: 0,0:17:35.26,0:17:37.57,Main,,0,0,0,,{\i1}Đã thế, đây còn là mỏ than excel.{\i0}
Dialogue: 0,0:17:37.57,0:17:40.08,Main,,0,0,0,,{\i1}Lò phản ứng nổ dây chuyền từ nãy rồi...{\i0}
Dialogue: 0,0:17:44.58,0:17:46.58,Main,,0,0,0,,Phải đưa xe tải ra khỏi đây.
Dialogue: 0,0:18:08.28,0:18:10.18,Main,,0,0,0,,{\i1}Chưa tới à? Lối ra ấy?{\i0}
Dialogue: 0,0:18:10.18,0:18:11.60,Main,,0,0,0,,{\i1}Sắp rồi.{\i0}
Dialogue: 0,0:18:11.60,0:18:13.07,Main,,0,0,0,,{\i1}Lệch trái 20 độ.{\i0}
Dialogue: 0,0:18:20.82,0:18:22.45,Main,,0,0,0,,Được, lối ra kia rồi.
Dialogue: 0,0:18:28.31,0:18:29.24,Main,,0,0,0,,Không được rồi.
Dialogue: 0,0:18:30.08,0:18:30.83,Main,,0,0,0,,Đằng sau!
Dialogue: 0,0:18:34.46,0:18:35.26,Main,,0,0,0,,Đằng trước kìa!
Dialogue: 0,0:18:38.76,0:18:41.48,Main,,0,0,0,,{\i1}Cái gì thế?! Như muối bỏ bể!{\i0}
Dialogue: 0,0:18:41.48,0:18:43.12,Main,,0,0,0,,Súng chính hỏng rồi!
Dialogue: 0,0:18:43.12,0:18:44.26,Main,,0,0,0,,Có mỗi thế này thôi!
Dialogue: 0,0:18:44.26,0:18:46.81,Main,,0,0,0,,{\i1}Tôi cũng chỉ có thế này thôi!{\i0}
Dialogue: 0,0:18:46.81,0:18:49.76,Main,,0,0,0,,Tính sao đây? Không còn cách nào khác à?
Dialogue: 0,0:18:49.76,0:18:51.27,Main,,0,0,0,,{\i1}Có đấy chứ.{\i0}
Dialogue: 0,0:18:51.75,0:18:54.90,Main,,0,0,0,,Sau thùng xe kia một đống luôn!
Dialogue: 0,0:19:00.50,0:19:02.26,Main,,0,0,0,,{\i1}Tôi không chịu đâu.{\i0}
Dialogue: 0,0:19:02.26,0:19:04.83,Main,,0,0,0,,{\i1}Tôi không hợp\N với mấy việc cần tỉ mỉ như này!{\i0}
Dialogue: 0,0:19:04.83,0:19:06.92,Main,,0,0,0,,Đừng có lèm bèm.
Dialogue: 0,0:19:06.92,0:19:08.33,Main,,0,0,0,,Làm một phát cho ra trò nào!
Dialogue: 0,0:19:14.22,0:19:16.64,Main,,0,0,0,,{\i1}Được, lấy một thỏi đi.{\i0}
Dialogue: 0,0:19:16.64,0:19:18.38,Main,,0,0,0,,Nói thì dễ lắm.
Dialogue: 0,0:19:22.32,0:19:24.25,Main,,0,0,0,,{\i1}Hình như có cái gì đang rỉ ra...{\i0}
Dialogue: 0,0:19:24.25,0:19:25.84,Main,,0,0,0,,{\i1}Chắc là chất ổn định.{\i0}
Dialogue: 0,0:19:25.84,0:19:26.81,Main,,0,0,0,,{\i1}Thế nghĩa là...{\i0}
Dialogue: 0,0:19:27.34,0:19:28.72,Main,,0,0,0,,{\i1}Chạm nhẹ là nổ.{\i0}
Dialogue: 0,0:19:28.72,0:19:29.48,Main,,0,0,0,,{\i1}Khoan đã!{\i0}
Dialogue: 0,0:19:33.77,0:19:36.00,Main,,0,0,0,,{\i1}Làm hỏng thì cùng lắm là chết thôi.{\i0}
Dialogue: 0,0:19:42.24,0:19:45.37,Main,,0,0,0,,{\i1}Lấy được rồi. Giờ làm gì với nó đây?{\i0}
Dialogue: 0,0:19:46.44,0:19:50.56,Main,,0,0,0,,{\i1}40 giây nữa, cái pod này\Nsẽ lao về phía lối ra rồi tự hủy.{\i0}
Dialogue: 0,0:19:51.12,0:19:55.13,Main,,0,0,0,,{\i1}Trong 40 giây đó,\Nnhét cái đó vào pod hộ tôi.{\i0}
Dialogue: 0,0:19:55.60,0:19:56.96,Main,,0,0,0,,Thế còn anh thì sao?
Dialogue: 0,0:19:56.96,0:19:58.54,Main,,0,0,0,,Tôi sẽ... làm thế này.
Dialogue: 0,0:20:11.99,0:20:13.27,Main,,0,0,0,,Zeros, mở cửa nào!
Dialogue: 0,0:20:49.89,0:20:50.85,Main,,0,0,0,,Bingo!
Dialogue: 0,0:21:14.41,0:21:15.73,Main,,0,0,0,,Mở rồi!
Dialogue: 0,0:21:33.08,0:21:34.67,Main,,0,0,0,,Quê chết đi được~
Dialogue: 0,0:21:46.88,0:21:47.78,Main,,0,0,0,,Thật tình...
Dialogue: 0,0:21:52.14,0:21:53.85,Main,,0,0,0,,Nhờ chị cả đấy,
Dialogue: 0,0:21:53.85,0:21:55.75,Main,,0,0,0,,Victoria Telpsicorei.
Dialogue: 0,0:21:56.88,0:21:58.95,Main,,0,0,0,,Gửi lời cảm ơn tới chồng chị nhé.
Dialogue: 0,0:21:58.95,0:22:01.03,Main,,0,0,0,,Nhờ cái này mà tôi biết được tên chị.
Dialogue: 0,0:22:02.95,0:22:05.55,Main,,0,0,0,,Trừ phi là dân ngoại đạo,\Nchứ ai mà chả biết
Dialogue: 0,0:22:06.23,0:22:10.15,Main,,0,0,0,,{\an8}danh tiếng thợ săn tiền thưởng huyền thoại,\N Telpsicorei.
Dialogue: 0,0:22:12.99,0:22:14.91,Main,,0,0,0,,Chắc phải lâu lắm đấy.
Dialogue: 0,0:22:16.26,0:22:19.48,Main,,0,0,0,,Chồng tôi giờ chuyển\N lên thiên đường làm ăn rồi.
Dialogue: 0,0:22:19.48,0:22:20.73,Main,,0,0,0,,Vậy à...
Dialogue: 0,0:22:23.54,0:22:25.36,Main,,0,0,0,,Phần còn lại gửi cho anh nhà.
Dialogue: 0,0:22:25.36,0:22:27.45,Main,,0,0,0,,Chắc giờ anh ấy đang vật vã vì say.
Dialogue: 0,0:22:29.38,0:22:31.32,Main,,0,0,0,,Để tôi mời anh ấy\Nmột cốc prairie oyster.
Dialogue: 0,0:24:13.51,0:24:16.18,Main,preview,0,0,0,,{\i1}Thi thoảng, tôi sẽ làm phần\Ngiới thiệu tập sau một mình.{\i0}
Dialogue: 0,0:24:16.69,0:24:18.18,Main,preview,0,0,0,,{\i1}Jet Black, 36 tuổi.{\i0}
Dialogue: 0,0:24:19.06,0:24:22.20,Main,preview,0,0,0,,{\i1}Ai cũng bảo nhìn tôi \Nchẳng giống 36 chút nào,{\i0}
Dialogue: 0,0:24:22.20,0:24:25.61,Main,preview,0,0,0,,{\i1}nhưng đừng có trông mặt \Nhay nhìn đầu tóc mà bắt hình dong.{\i0}
Dialogue: 0,0:24:25.61,0:24:28.27,Main,preview,0,0,0,,{\i1}Mọi thứ chẳng như vẻ bề ngoài đâu.{\i0}
Dialogue: 0,0:24:28.27,0:24:29.78,Main,preview,0,0,0,,{\i1}Tập sau cũng là một câu chuyện như thế.{\i0}
Dialogue: 0,0:24:29.78,0:24:32.99,Main,preview,0,0,0,,{\i1}Một câu chuyện cổ tích cảm động \Nchả mang chút phong cách Bebop nào.{\i0}
Dialogue: 0,0:24:32.99,0:24:36.28,Main,preview,0,0,0,,{\i1}Kỳ tới, "Điệu Waltz cho Sao Kim".{\i0}
Dialogue: 0,0:24:36.28,0:24:38.54,Main,preview,0,0,0,,{\i1}Thi thoảng thế này cũng hay nhỉ.{\i0}
