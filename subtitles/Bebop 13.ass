Comment: 0,0:01:31.03,0:01:31.07,Main,,0,0,0,,========= Dialogue =========
Dialogue: 0,0:01:33.95,0:01:35.07,Main,,0,0,0,,Tôi đi tìm.
Dialogue: 0,0:01:35.07,0:01:36.03,Main,,0,0,0,,Cái gì?
Dialogue: 0,0:01:36.45,0:01:38.16,Main,,0,0,0,,Tôi đi tìm người phụ nữ của tôi.
Dialogue: 0,0:01:38.71,0:01:40.78,Main,,0,0,0,,Anh cứ đi mà tìm người phụ nữ kia.
Dialogue: 0,0:01:45.29,0:01:47.58,Main,,0,0,0,,Giấu tao đi hẹn hò với Julia à?
Dialogue: 0,0:01:50.00,0:01:52.59,Main,,0,0,0,,Cứ như đang ở phòng xưng tội ấy.
Dialogue: 0,0:01:52.59,0:01:55.09,Main,,0,0,0,,Anh từng làm mục sư à?
Dialogue: 0,0:01:55.09,0:01:58.09,Main,,0,0,0,,Ăn mảnh vốn là sở trường của mày mà.
Dialogue: 0,0:02:00.39,0:02:02.93,Main,,0,0,0,,Vụ lần trước vẫn chưa phân thắng bại đâu.
Dialogue: 0,0:02:04.59,0:02:06.06,Main,,0,0,0,,Lúc nào cũng được.
Dialogue: 0,0:02:06.06,0:02:06.81,Main,,0,0,0,,Lin!
Dialogue: 0,0:02:11.23,0:02:12.98,Main,,0,0,0,,Này, tránh ra! Lin!
Dialogue: 0,0:02:15.19,0:02:16.19,Main,,0,0,0,,Lin...
Dialogue: 0,0:02:44.67,0:02:47.85,Main,,0,0,0,,{\i1}Tôi và Vicious từng ở\Ncùng một đơn vị trên Titan.{\i0}
Dialogue: 0,0:02:48.86,0:02:51.08,Main,,0,0,0,,Cô bảo "đồng đội gì chứ,\Ntôi không cần",
Dialogue: 0,0:02:52.42,0:02:54.82,Main,,0,0,0,,nhưng tôi lại say mê\Nhai chữ "chiến hữu".
Dialogue: 0,0:02:56.06,0:02:57.71,Main,,0,0,0,,Đến mức muốn rơi nước mắt.
Dialogue: 0,0:02:59.32,0:03:01.93,Main,,0,0,0,,Trên Titan, ai cũng là chiến hữu.
Dialogue: 0,0:03:53.60,0:03:54.54,Main,,0,0,0,,Bài gì thế?
Dialogue: 0,0:03:58.64,0:04:00.13,Main,,0,0,0,,"Julia".
Dialogue: 0,0:04:00.75,0:04:01.81,Main,,0,0,0,,Giai điệu hay thật.
Dialogue: 0,0:04:05.67,0:04:08.76,Main,,0,0,0,,Về nước rồi, tôi thổi bài đó\Nbằng sax có được không?
Dialogue: 0,0:04:52.45,0:04:55.48,Main,,0,0,0,,{\i1}Từ chiến trường trở về, tôi bị tống giam.{\i0}
Dialogue: 0,0:04:56.48,0:04:58.23,Main,,0,0,0,,Với tội danh gián điệp.
Dialogue: 0,0:04:58.96,0:05:01.19,Main,,0,0,0,,Tôi nghe nói Vicious đã làm chứng.
Dialogue: 0,0:05:02.94,0:05:07.26,Main,,0,0,0,,Trong tù, tôi mất ngủ\Nđến hỏng cả thần kinh,
Dialogue: 0,0:05:07.26,0:05:08.78,Main,,0,0,0,,rồi thành con nghiện thuốc.
Dialogue: 0,0:05:09.34,0:05:10.97,Main,,0,0,0,,Đó là tác dụng phụ.
Dialogue: 0,0:05:10.97,0:05:13.83,Main,,0,0,0,,Cân bằng nội tiết tố bị đảo lộn,\Nrồi thành ra thế này.
Dialogue: 0,0:05:15.25,0:05:20.12,Main,,0,0,0,,Từ khi đến đây, cô là người thứ hai \Ntôi gặp có biết Vicious.
Dialogue: 0,0:05:21.30,0:05:22.80,Main,,0,0,0,,Cũng là người thứ hai\N được tôi kể chuyện này.
Dialogue: 0,0:05:23.75,0:05:25.51,Main,,0,0,0,,Sao anh lại đi gặp Vicious?
Dialogue: 0,0:05:26.22,0:05:28.63,Main,,0,0,0,,Không phải anh bị hắn gài bẫy sao?
Dialogue: 0,0:05:29.91,0:05:31.48,Main,,0,0,0,,Tôi muốn xác nhận điều đó.
Dialogue: 0,0:05:31.48,0:05:32.85,Main,,0,0,0,,Anh sẽ chết đấy.
Dialogue: 0,0:05:33.32,0:05:34.73,Main,,0,0,0,,Tôi không sợ chết.
Dialogue: 0,0:05:34.73,0:05:35.85,Main,,0,0,0,,Nói dối.
Dialogue: 0,0:05:37.69,0:05:39.36,Main,,0,0,0,,Đằng nào tôi cũng\Nchả sống được bao lâu nữa.
Dialogue: 0,0:05:41.82,0:05:43.80,Main,,0,0,0,,Sao lại đưa tôi về đây?
Dialogue: 0,0:05:46.68,0:05:49.53,Main,,0,0,0,,Có lẽ vì tôi muốn ở bên ai đó.
Dialogue: 0,0:05:50.20,0:05:53.49,Main,,0,0,0,,Tự tiện cứu người ta,\Nrồi lại tự tiện đưa người ta về,
Dialogue: 0,0:05:54.03,0:05:55.62,Main,,0,0,0,,còn bản thân thì đi chết à?
Dialogue: 0,0:06:08.97,0:06:11.01,Main,,0,0,0,,Đúng là cô này chứ?
Dialogue: 0,0:06:11.58,0:06:15.33,Main,,0,0,0,,Ờ. Nửa năm rồi mới thấy\Nmột phụ nữ bằng xương bằng thịt,
Dialogue: 0,0:06:15.33,0:06:18.59,Main,,0,0,0,,còn phụ nữ đẹp cỡ đó\Nthì phải hai năm rồi.
Dialogue: 0,0:06:18.59,0:06:20.35,Main,,0,0,0,,Làm sao mà nhìn nhầm được?
Dialogue: 0,0:06:21.09,0:06:23.83,Main,,0,0,0,,Tôi chả bao giờ muốn sống ở đây đâu...
Dialogue: 0,0:06:23.83,0:06:26.99,Main,,0,0,0,,Cô ấy ngồi đằng kia\Nnói chuyện với Gren.
Dialogue: 0,0:06:28.03,0:06:30.20,Main,,0,0,0,,Julia cũng hay ngồi chỗ đó.
Dialogue: 0,0:06:30.64,0:06:31.75,Main,,0,0,0,,Julia?
Dialogue: 0,0:06:32.42,0:06:37.41,Main,,0,0,0,,Hai năm trước, tự dưng xuất hiện,\Nchưa đầy một tháng đã biến mất.
Dialogue: 0,0:06:37.41,0:06:38.54,Main,,0,0,0,,Cô ta là người thế nào?
Dialogue: 0,0:06:40.23,0:06:42.34,Main,,0,0,0,,Một người phụ nữ tuyệt vời.
Dialogue: 0,0:06:46.57,0:06:49.21,Main,,0,0,0,,{\i1}Người duy nhất giữ được mạng mày là tao.{\i0}
Dialogue: 0,0:06:50.60,0:06:53.12,Main,,0,0,0,,{\i1}Và người duy nhất\Ngiết được mày cũng là tao.{\i0}
Dialogue: 0,0:06:54.06,0:06:57.31,Main,ep5@15:33,0,0,0,,{\i1}Tao chỉ đang mê man\Nmột giấc mơ không hồi kết mà thôi.{\i0}
Dialogue: 0,0:06:57.31,0:06:59.98,Main,,0,0,0,,{\i1}Cứ như đang mơ vậy.{\i0}
Dialogue: 0,0:06:59.98,0:07:02.76,Main,,0,0,0,,{\i1}Coi chừng người phụ nữ đó.{\i0}
Dialogue: 0,0:07:03.59,0:07:06.19,Main,,0,0,0,,{\i1}Phụ nữ ai cũng dối trá cả.{\i0}
Dialogue: 0,0:07:08.11,0:07:11.11,Main,,0,0,0,,{\i1}Xong vụ này,\Nanh sẽ rửa tay gác kiếm.{\i0}
Dialogue: 0,0:07:12.66,0:07:14.37,Main,,0,0,0,,{\i1}Rồi... em sẽ đi cùng anh chứ?{\i0}
Dialogue: 0,0:07:17.54,0:07:20.21,Main,,0,0,0,,{\i1}Mày định phản bội tao à?{\i0}
Dialogue: 0,0:07:20.66,0:07:23.76,Main,,0,0,0,,{\i1}Anh sẽ bị giết đấy.{\i0}
Dialogue: 0,0:07:24.50,0:07:26.46,Main,,0,0,0,,{\i1}Cuối cùng cũng tỉnh.{\i0}
Dialogue: 0,0:07:26.46,0:07:28.51,Main,,0,0,0,,{\i1}Anh ngủ li bì những ba ngày đấy.{\i0}
Dialogue: 0,0:07:30.89,0:07:33.55,Main,,0,0,0,,{\i1}Mắt trái với mắt phải\Ncủa anh khác màu nhỉ.{\i0}
Dialogue: 0,0:07:34.33,0:07:36.68,Main,,0,0,0,,{\i1}Con mắt trái này nhìn thấy quá khứ.{\i0}
Dialogue: 0,0:07:36.68,0:07:39.46,Main,,0,0,0,,{\i1}Vậy còn mắt phải thì sao...?{\i0}
Dialogue: 0,0:07:55.56,0:07:57.45,Main,,0,0,0,,Chưa chết nổi đâu...
Dialogue: 0,0:08:12.59,0:08:14.00,Main,,0,0,0,,Hướng tây là hướng nào?
Dialogue: 0,0:08:17.63,0:08:18.88,Main,,0,0,0,,Cảm ơn nhé.
Dialogue: 0,0:08:24.11,0:08:27.13,Main,,0,0,0,,Thuốc mê à? Bị coi thường quá rồi.{Coi thường nhau quá đấy.}
Dialogue: 0,0:08:54.92,0:08:57.98,Main,,0,0,0,,Xin lỗi, cho tôi hỏi chút.
Dialogue: 0,0:08:57.98,0:09:00.26,Main,,0,0,0,,Tòa chung cư màu xanh\Ntên Orlando ở đâu thế?
Dialogue: 0,0:09:00.26,0:09:03.39,Main,,0,0,0,,Đừng hỏi tôi! Tôi chả biết gì hết!
Dialogue: 0,0:09:03.39,0:09:04.89,Main,,0,0,0,,Ơ kìa, này...
Dialogue: 0,0:09:05.48,0:09:08.73,Main,,0,0,0,,Từ giờ tôi không muốn\Ndây dưa với dân ngoại lai nữa.
Dialogue: 0,0:09:08.73,0:09:10.36,Main,,0,0,0,,Tôi chỉ hỏi thôi mà!
Dialogue: 0,0:09:11.28,0:09:13.84,Main,,0,0,0,,Tôi đi kiếm việc gì tử tế làm đây.
Dialogue: 0,0:09:19.31,0:09:21.03,Main,,0,0,0,,Gì vậy?
Dialogue: 0,0:09:28.42,0:09:30.19,Main,,0,0,0,,Ngay đây chứ đâu.
Dialogue: 0,0:09:58.16,0:09:58.78,Main,,0,0,0,,Này!
Dialogue: 0,0:09:59.32,0:10:00.57,Main,,0,0,0,,Này, tỉnh lại đi!
Dialogue: 0,0:10:04.49,0:10:05.50,Main,,0,0,0,,Jet?
Dialogue: 0,0:10:05.50,0:10:07.64,Main,,0,0,0,,Cô đang làm cái gì đấy?
Dialogue: 0,0:10:09.92,0:10:11.47,Main,,0,0,0,,Cái gì thế này?
Dialogue: 0,0:10:11.47,0:10:13.67,Main,,0,0,0,,{\i0}Gã đó có sở thích kiểu này à?
Dialogue: 0,0:10:14.25,0:10:15.92,Main,,0,0,0,,Anh nói gì thế?
Dialogue: 0,0:10:15.92,0:10:18.88,Main,,0,0,0,,Gren không phải như thế.
Dialogue: 0,0:10:19.51,0:10:20.89,Main,,0,0,0,,Gren?
Dialogue: 0,0:10:26.22,0:10:28.56,Main,,0,0,0,,"Mangan với Uradora"...
Dialogue: 0,0:10:29.13,0:10:31.24,Main,,0,0,0,,Dùng mật mã cũ.
Dialogue: 0,0:10:34.78,0:10:38.20,Main,,0,0,0,,Julia đã từng ở đây.\NỞ chính thị trấn này.
Dialogue: 0,0:10:42.85,0:10:43.60,Main,,0,0,0,,{\i1}Này.{\i0}
Dialogue: 0,0:10:44.20,0:10:45.16,Main,,0,0,0,,Ờ.
Dialogue: 0,0:10:45.16,0:10:46.66,Main,,0,0,0,,{\i1}Có thu hoạch gì không?{\i0}
Dialogue: 0,0:10:46.66,0:10:47.68,Main,,0,0,0,,Chả có.
Dialogue: 0,0:10:47.68,0:10:49.12,Main,,0,0,0,,{\i1}Tôi có tin hay đây.{\i0}
Dialogue: 0,0:10:49.12,0:10:50.62,Main,,0,0,0,,{\i1}Tự đi mà bắt.{\i0}
Dialogue: 0,0:10:50.63,0:10:53.59,Main,,0,0,0,,Là gã có mật danh Julia ấy.
Dialogue: 0,0:10:54.01,0:10:55.83,Main,,0,0,0,,{\i1}Một gã tên Gren.{\i0}
Dialogue: 0,0:10:55.83,0:11:00.04,Main,,0,0,0,,{\i1}Hắn là tù vượt ngục\Nvà đang bị treo thưởng kha khá.{\i0}
Dialogue: 0,0:11:00.04,0:11:02.88,Main,,0,0,0,,{\i1}Bắt được hắn thì\Nanh được quay về đấy.{\i0}
Dialogue: 0,0:11:14.64,0:11:15.73,Main,,0,0,0,,A lô?
Dialogue: 0,0:11:16.26,0:11:17.64,Main,,0,0,0,,{\i1}Tôi đang ở ngay phía trên cậu.{\i0}
Dialogue: 0,0:11:18.25,0:11:21.33,Main,,0,0,0,,{\i1}Lên sân thượng\Ntòa nhà cao nhất đi.{\i0}
Dialogue: 0,0:11:21.98,0:11:23.64,Main,,0,0,0,,{\i1}Sẽ có một phụ nữ mang đến.{\i0}
Dialogue: 0,0:11:24.30,0:11:25.84,Main,,0,0,0,,{\i1}Không sao.{\i0}
Dialogue: 0,0:11:25.84,0:11:28.35,Main,,0,0,0,,{\i1}Nhưng tôi cũng muốn gặp cậu...{\i0}
Dialogue: 0,0:11:32.49,0:11:39.04,Main,,0,0,0,,Phá hỏng Bebop, nhưng lại để\NSwordfish với Hammerhead vẫn chạy được,
Dialogue: 0,0:11:39.04,0:11:41.88,Main,,0,0,0,,{\i1}là có ý nhắn "Đến tìm tôi đi" đấy à?{\i0}
Dialogue: 0,0:11:42.71,0:11:44.30,Main,,0,0,0,,{\i1}Đừng có nói nhảm.{\i0}
Dialogue: 0,0:11:44.75,0:11:46.49,Main,,0,0,0,,Không phải cô thử chúng tôi à?
Dialogue: 0,0:11:47.76,0:11:49.06,Main,,0,0,0,,Sao anh lại đến đây?
Dialogue: 0,0:11:49.80,0:11:51.50,Main,,0,0,0,,Trả tiền đây.
Dialogue: 0,0:11:51.50,0:11:52.40,Main,,0,0,0,,Két sắt...
Dialogue: 0,0:11:53.77,0:11:56.02,Main,,0,0,0,,chỉ có 20.000 thôi mà.
Dialogue: 0,0:11:56.02,0:11:57.79,Main,,0,0,0,,Thế à?
Dialogue: 0,0:11:57.79,0:11:58.86,Main,,0,0,0,,Giả nai vừa.
Dialogue: 0,0:11:59.93,0:12:01.11,Main,,0,0,0,,Này...
Dialogue: 0,0:12:01.11,0:12:03.17,Main,,0,0,0,,Julia là ai thế?
Dialogue: 0,0:12:03.17,0:12:07.37,Main,,0,0,0,,Chịu. Có điều hình như\Ncó dây mơ rễ má với Spike.
Dialogue: 0,0:12:07.37,0:12:08.97,Main,,0,0,0,,Tôi chỉ biết thế.
Dialogue: 0,0:12:34.97,0:12:37.69,Main,,0,0,0,,Quà, quà ơi, có chưa~?
Dialogue: 0,0:13:21.67,0:13:24.75,Main,,0,0,0,,Hạng EX+. Hàng thật.
Dialogue: 0,0:13:24.75,0:13:25.65,Main,,0,0,0,,Mang qua đây.
Dialogue: 0,0:13:28.17,0:13:30.39,Main,,0,0,0,,Đây là viên Opal Titan cô yêu cầu.
Dialogue: 0,0:13:31.78,0:13:34.26,Main,,0,0,0,,Cho tôi gửi lời hỏi thăm Gren.
Dialogue: 0,0:13:36.41,0:13:38.63,Main,,0,0,0,,Hồi đó anh cứu tôi khỏi con bọ cạp,
Dialogue: 0,0:13:39.41,0:13:41.59,Main,,0,0,0,,vậy mà lại bán đứng tôi.
Dialogue: 0,0:14:01.48,0:14:02.32,Main,,0,0,0,,Gren.
Dialogue: 0,0:14:04.10,0:14:05.32,Main,,0,0,0,,Lâu rồi không gặp.
Dialogue: 0,0:14:05.77,0:14:07.16,Main,,0,0,0,,Cậu đang giở trò gì vậy?
Dialogue: 0,0:14:07.77,0:14:09.90,Main,,0,0,0,,Anh đưa tôi chiếc hộp nhạc đó
Dialogue: 0,0:14:10.50,0:14:13.83,Main,,0,0,0,,là vì nghĩ tôi sẽ không\Nmở ra kiểm tra sao?
Dialogue: 0,0:14:14.47,0:14:16.65,Main,,0,0,0,,Phát hiện ra máy truyền tin rồi à?
Dialogue: 0,0:14:16.65,0:14:18.25,Main,,0,0,0,,Người phát hiện là Julia.
Dialogue: 0,0:14:19.27,0:14:22.67,Main,,0,0,0,,Nghe nói là quà của anh,\NJulia liền nhận ra.
Dialogue: 0,0:14:22.67,0:14:24.69,Main,,0,0,0,,Thì sao?
Dialogue: 0,0:14:25.92,0:14:28.18,Main,,0,0,0,,Anh lại định giết tôi lần nữa à?
Dialogue: 0,0:14:30.00,0:14:31.78,Main,,0,0,0,,Anh từng là đồng đội của tôi.
Dialogue: 0,0:14:32.64,0:14:34.14,Main,,0,0,0,,Là chiến hữu.
Dialogue: 0,0:14:37.40,0:14:41.61,Main,,0,0,0,,Ta từng sát cánh bên nhau\N trên chiến trường sa mạc.
Dialogue: 0,0:14:44.00,0:14:45.32,Main,,0,0,0,,Tôi từng rất ngưỡng mộ anh.
Dialogue: 0,0:14:48.32,0:14:50.07,Main,,0,0,0,,Từng hết lòng tin tưởng anh!
Dialogue: 0,0:14:53.83,0:14:55.79,Main,,0,0,0,,Chẳng có gì để tin cả.
Dialogue: 0,0:14:57.54,0:15:00.00,Main,,0,0,0,,Cũng chẳng cần phải tin.
Dialogue: 0,0:15:02.42,0:15:03.67,Main,,0,0,0,,Ngài Vicious!
Dialogue: 0,0:15:22.69,0:15:25.27,Main,,0,0,0,,Trên đời này, chẳng có gì để tin cả...
Dialogue: 0,0:15:33.74,0:15:34.74,Main,,0,0,0,,Vicious!
Dialogue: 0,0:15:37.13,0:15:41.50,Main,,0,0,0,,Lin mà chết vì bảo vệ loại như mày\Nthì cậu ta cũng chẳng được siêu thoát!
Dialogue: 0,0:15:42.09,0:15:44.04,Main,,0,0,0,,Thứ nó bảo vệ không phải tao.
Dialogue: 0,0:15:44.05,0:15:45.47,Main,,0,0,0,,{\i1}Mà là luật lệ!{\i0}
Dialogue: 0,0:16:06.77,0:16:07.77,Main,,0,0,0,,Cản đường à!
Dialogue: 0,0:17:45.58,0:17:47.29,Main,,0,0,0,,Này! Tỉnh lại đi! Này!
Dialogue: 0,0:17:47.77,0:17:50.29,Main,,0,0,0,,Julia đâu? Cô ấy đi đâu rồi?
Dialogue: 0,0:17:53.52,0:17:55.26,Main,,0,0,0,,Anh biết cô ấy à?
Dialogue: 0,0:17:55.76,0:17:57.59,Main,,0,0,0,,Giờ cô ấy ở đâu?
Dialogue: 0,0:18:04.50,0:18:06.29,Main,,0,0,0,,Bị thương nội tạng rồi.
Dialogue: 0,0:18:06.98,0:18:10.38,Main,,0,0,0,,Cái đệch, xe cứu thương\Ncó đến tận chỗ thế này không?
Dialogue: 0,0:18:14.62,0:18:18.57,Main,,0,0,0,,Đưa tôi lên khoang lái\Nlần nữa được không?
Dialogue: 0,0:18:20.23,0:18:22.40,Main,,0,0,0,,Tôi muốn đến Titan...
Dialogue: 0,0:18:22.40,0:18:24.65,Main,,0,0,0,,Thân thể thế này thì trụ sao nổi!
Dialogue: 0,0:18:24.65,0:18:26.10,Main,,0,0,0,,Mất thời gian quá!
Dialogue: 0,0:18:27.16,0:18:29.95,Main,,0,0,0,,Đằng nào tôi cũng\Nchả sống được lâu nữa.
Dialogue: 0,0:18:29.95,0:18:32.59,Main,,0,0,0,,Chết giữa hành trình cũng hay mà.
Dialogue: 0,0:18:33.58,0:18:37.67,Main,,0,0,0,,Tôi muốn quay về...\Nnơi đó thêm lần nữa.
Dialogue: 0,0:18:38.90,0:18:40.72,Main,,0,0,0,,Dù chỉ gần hơn một chút thôi.
Dialogue: 0,0:18:41.64,0:18:42.80,Main,,0,0,0,,Xin anh...
Dialogue: 0,0:18:56.32,0:18:57.50,Main,,0,0,0,,Ra vậy.
Dialogue: 0,0:18:58.90,0:19:00.49,Main,,0,0,0,,Anh là Spike.
Dialogue: 0,0:19:01.67,0:19:03.95,Main,,0,0,0,,Julia lúc nào cũng nhắc về anh.
Dialogue: 0,0:19:04.74,0:19:07.71,Main,,0,0,0,,"Đôi mắt anh ấy mỗi bên một màu"...
Dialogue: 0,0:19:08.52,0:19:09.92,Main,,0,0,0,,Cô ấy đã nói vậy.
Dialogue: 0,0:19:10.66,0:19:15.42,Main,,0,0,0,,"Cứ nhìn vào mắt anh ấy\Nlà lại thấy một cảm giác thật lạ".
Dialogue: 0,0:19:16.07,0:19:17.52,Main,,0,0,0,,Cô ấy thế nào?
Dialogue: 0,0:19:18.61,0:19:22.18,Main,,0,0,0,,Ở ghế trong góc quầy bar...
Dialogue: 0,0:19:23.25,0:19:26.35,Main,,0,0,0,,cô ấy cứ lặng lẽ ngồi đó\Ntừ lúc nào không hay.
Dialogue: 0,0:19:27.76,0:19:31.17,Main,,0,0,0,,Lúc nào cũng yêu cầu cùng một bản nhạc,
Dialogue: 0,0:19:32.29,0:19:34.02,Main,,0,0,0,,và mỉm cười.
Dialogue: 0,0:19:35.26,0:19:36.98,Main,,0,0,0,,Cô ấy cười...
Dialogue: 0,0:19:37.73,0:19:39.04,Main,,0,0,0,,nụ cười rất buồn.
Dialogue: 0,0:20:48.11,0:20:49.96,Main,,0,0,0,,Thu hoạch gì không?
Dialogue: 0,0:20:49.96,0:20:50.89,Main,,0,0,0,,{\i1}Chả có.{\i0}
Dialogue: 0,0:20:52.52,0:20:55.15,Main,,0,0,0,,{\i1}Mau vào đi. Cất cánh đây.{\i0}
Dialogue: 0,0:21:05.76,0:21:06.78,Main,,0,0,0,,Julia...
Dialogue: 0,0:21:06.79,0:21:08.36,Main,,0,0,0,,Gì cơ?
Dialogue: 0,0:21:08.36,0:21:12.45,Main,,0,0,0,,Ờ, không có gì.\NNgười lớn lẩm bẩm một mình thôi.
Dialogue: 0,0:21:12.45,0:21:14.35,Main,,0,0,0,,Mọi người đi đâu về thế?
Dialogue: 0,0:21:14.91,0:21:16.04,Main,,0,0,0,,Một nơi hay ho.
Dialogue: 0,0:21:16.04,0:21:18.64,Main,,0,0,0,,Chỉ mỗi Ed là không biết~
Dialogue: 0,0:21:18.64,0:21:20.71,Main,,0,0,0,,Rồi hôm nào kể cho mà nghe.
Dialogue: 0,0:21:21.97,0:21:23.76,Main,,0,0,0,,Thôi, khỏi cần.
Dialogue: 0,0:21:24.87,0:21:26.76,Main,,0,0,0,,Chả dễ thương gì cả.
Dialogue: 0,0:21:43.08,0:21:45.12,Main,,0,0,0,,Sao rơi rồi kìa, ông Bò.
Dialogue: 0,0:21:45.81,0:21:48.52,Main,,0,0,0,,Đó không phải ngôi sao bình thường.
Dialogue: 0,0:21:48.52,0:21:50.91,Main,,0,0,0,,Đó là nước mắt của một chiến binh.
Dialogue: 0,0:21:50.91,0:21:52.88,Main,,0,0,0,,Chiến binh là gì ạ?
Dialogue: 0,0:21:52.88,0:21:56.83,Main,,0,0,0,,Là người đã chiến đấu đến cùng\Nở nơi nào đó trên hành tinh này.
Dialogue: 0,0:21:59.19,0:22:04.54,Main,,0,0,0,,Một linh hồn đáng thương\Nkhông thể tin vào Thần Linh Vĩ Đại.
Dialogue: 0,0:24:12.68,0:24:15.41,Main,preview,0,0,0,,{\i1}Thế giới này rốt cuộc là sao đây?{\i0}
Dialogue: 0,0:24:15.41,0:24:17.68,Main,preview,0,0,0,,{\i1}Đời người, chả biết phía trước là gì.{\i0}
Dialogue: 0,0:24:18.27,0:24:20.60,Main,preview,0,0,0,,{\i1}Thế gian này đúng là sai bét cả.{\i0}
Dialogue: 0,0:24:20.60,0:24:22.69,Main,preview,0,0,0,,{\i1}{\i1}Đã vậy thì ta cứ rời bỏ cuộc chơi,{\i0}
Dialogue: 0,0:24:23.10,0:24:26.15,Main,preview,0,0,0,,{\i1}{\i1}sống một đời bên ngoài lề xã hội.{\i0}
Dialogue: 0,0:24:26.15,0:24:31.45,Main,preview,0,0,0,,{\i1}{\i1}Xin gửi tặng những người như bạn\Nmột khúc rhapsody đầy ảo giác.{\i0}
Dialogue: 0,0:24:31.45,0:24:35.17,Main,preview,0,0,0,,{\i1}Kỳ tới, "Khúc Rhapsody phiêu bạt".{\i0}
Dialogue: 0,0:24:35.17,0:24:39.55,Main,preview,0,0,0,,{\i1}Nào, bạn có muốn cùng chúng tôi\Nphung phí cả cuộc đời không?{\i0}
