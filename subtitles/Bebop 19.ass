Comment: 0,0:22:23.43,0:26:24.96,Main,,0,0,0,,========= ED =========
Dialogue: 0,0:22:35.12,0:22:40.54,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}Cứ mải than thân trách phận, cho mối tình xưa,
Dialogue: 0,0:22:40.54,0:22:45.96,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}dòng thời gian vẫn lẳng lặng trôi, đã bao lâu rồi?
Dialogue: 0,0:22:47.05,0:22:52.59,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}Vết bỏng hằn sâu trong tim, nào có nguôi đi,
Dialogue: 0,0:22:52.59,0:22:57.81,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}gió chẳng thể xoa dịu cho tôi, chỉ biết thổi thôi.
Dialogue: 0,0:22:59.06,0:23:08.32,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}Với con ngươi khô, với tròng mắt cạn, ai đó ơi, giúp tôi đổ lệ đi!
Dialogue: 0,0:23:09.94,0:23:13.49,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}Giai điệu Folk Blues đích thực!
Dialogue: 0,0:23:09.94,0:23:13.49,GT,,0,0,0,,{\fad(0,300)\bord0\shad0\blur0.67}(Blues còn có nghĩa là u sầu, buồn bã)
Dialogue: 0,0:23:13.49,0:23:17.03,ED-Vie,,0,0,0,,{\fad(300,0)\blur0.67}Đâu là thật đây?
Dialogue: 0,0:23:17.74,0:23:22.08,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}Tôi chỉ muốn biết đâu là u sầu thật sự.
Dialogue: 0,0:23:22.08,0:23:25.63,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}Toàn thân lấm lem phù sa.
Dialogue: 0,0:23:25.63,0:23:29.05,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}Ngụp lặn giữa sông.
Dialogue: 0,0:23:29.71,0:23:34.22,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}Sống như vậy cũng đâu đến nỗi tệ,
Dialogue: 0,0:23:34.22,0:23:43.10,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}miễn sao chỉ phải... cam chịu một lần.
Comment: 0,0:01:31.03,0:01:31.07,Main,,0,0,0,,========= Dialogue =========
Dialogue: 0,0:02:00.22,0:02:02.68,Main,,0,0,0,,{\i1}Nói chung là chả hợp tính tôi,{\i0}
Dialogue: 0,0:02:03.10,0:02:05.39,Main,,0,0,0,,cái kiểu cứ ngồi chờ suông thế này.
Dialogue: 0,0:02:05.84,0:02:08.65,Main,,0,0,0,,{\i1}Chọn đúng điểm, rồi kiên nhẫn chờ.{\i0}
Dialogue: 0,0:02:08.65,0:02:10.86,Main,,0,0,0,,{\i1}Đó là bí quyết câu cá.{\i0}
Dialogue: 0,0:02:10.86,0:02:14.59,Main,,0,0,0,,{\i1}Ngay từ đầu chọn sai điểm\Nthì sao hả?{\i0}
Dialogue: 0,0:02:14.59,0:02:16.95,Main,,0,0,0,,Mồi thì đừng có kêu ca.
Dialogue: 0,0:02:17.49,0:02:18.74,Main,,0,0,0,,Câu gì thế?
Dialogue: 0,0:02:19.23,0:02:23.12,Main,,0,0,0,,"Starship Pirates".\NTự xưng là "hải tặc".
Dialogue: 0,0:02:23.12,0:02:24.55,Main,,0,0,0,,Hải tặc?
Dialogue: 0,0:02:24.55,0:02:28.46,Main,,0,0,0,,Là bọn tấn công tàu\Nrồi cuỗm sạch mọi thứ.
Dialogue: 0,0:02:29.06,0:02:31.42,Main,,0,0,0,,Ăn cướp~ ăn cướp~ ăn nhậu à?
Dialogue: 0,0:02:34.54,0:02:37.61,Main,,0,0,0,,{\i1}Mà Spike biến đâu mất rồi?{\i0}
Dialogue: 0,0:02:37.61,0:02:40.05,Main,,0,0,0,,{\i1}Đi đại tu tàu xong\Nchả thấy về...{\i0}
Dialogue: 0,0:02:43.28,0:02:44.78,Main,,0,0,0,,Cảm ơn.
Dialogue: 0,0:02:45.63,0:02:47.48,Main,,0,0,0,,Nhưng cái tay Spike này...
Dialogue: 0,0:02:48.49,0:02:51.33,Main,,0,0,0,,{\i1}Chả liên lạc gì,\Nkhông biết đang làm cái gì nữa?{\i0}
Dialogue: 0,0:03:10.74,0:03:12.39,Main,,0,0,0,,Chậm quá đấy, Doohan.
Dialogue: 0,0:03:12.39,0:03:15.34,Main,,0,0,0,,Được! Được được được!
Dialogue: 0,0:03:16.34,0:03:16.94,Main,,0,0,0,,Này.
Dialogue: 0,0:03:18.68,0:03:19.30,Main,,0,0,0,,Này!
Dialogue: 0,0:03:20.23,0:03:22.42,Main,,0,0,0,,{\i1}Strike! Người đánh bị loại!{\i0}
Dialogue: 0,0:03:22.42,0:03:25.47,Main,,0,0,0,,{\i1}Đứng nhìn ăn đủ ba strike,\Ntrận đấu kết thúc!{\i0}
Dialogue: 0,0:03:26.84,0:03:27.85,Main,,0,0,0,,Chậc!
Dialogue: 0,0:03:27.85,0:03:30.30,Main,,0,0,0,,Sao chỗ đó không cho\Nngười đánh thay vào chứ!
Dialogue: 0,0:03:30.30,0:03:33.02,Main,,0,0,0,,Eightwood cũng già rồi còn gì.
Dialogue: 0,0:03:33.39,0:03:34.98,Main,,0,0,0,,Anh thấy đúng không?
Dialogue: 0,0:03:37.29,0:03:38.45,Main,,0,0,0,,Doohan đâu?
Dialogue: 0,0:03:39.20,0:03:41.44,Main,,0,0,0,,Ông chủ đang bận tay.
Dialogue: 0,0:03:41.44,0:03:43.55,Main,,0,0,0,,Tôi là trợ lý Miles. Rất hân hạnh.
Dialogue: 0,0:03:51.86,0:03:55.33,Main,,0,0,0,,Lúc vô địch 14 năm trước\Nthì mạnh lắm đấy.
Dialogue: 0,0:03:55.33,0:03:58.89,Main,,0,0,0,,Đánh cứ gọi là tới tấp,\Nlật ngược bao nhiêu trận thua.
Dialogue: 0,0:03:58.89,0:04:03.68,Main,,0,0,0,,Nhất là ba cú home run liên tiếp\Ncủa Randy, Blanket với Hills, phải biết!
Dialogue: 0,0:04:03.68,0:04:06.14,Main,,0,0,0,,Tiếc là anh không được xem.
Dialogue: 0,0:04:06.14,0:04:07.27,Main,,0,0,0,,Mà còn nữa...
Dialogue: 0,0:04:09.26,0:04:13.23,Main,,0,0,0,,Này, chắc ai cũng bảo\N anh ít nói lắm nhỉ?
Dialogue: 0,0:04:13.60,0:04:17.58,Main,,0,0,0,,Còn cậu thì hay bị kêu \Nlà lắm mồm chứ gì.
Dialogue: 0,0:04:17.58,0:04:18.60,Main,,0,0,0,,Thì cũng có.
Dialogue: 0,0:04:19.25,0:04:20.69,Main,,0,0,0,,Swordfish phải không nhỉ?
Dialogue: 0,0:04:21.21,0:04:22.59,Main,,0,0,0,,Chiếc phi cơ phía sau ấy.
Dialogue: 0,0:04:23.18,0:04:24.34,Main,,0,0,0,,Ờ.
Dialogue: 0,0:04:24.34,0:04:27.91,Main,,0,0,0,,Là tàu đua mono siêu đỉnh\Ndo ông chủ chế tạo, đúng không?
Dialogue: 0,0:04:27.91,0:04:31.20,Main,,0,0,0,,Chỉ là con tàu cũ thôi.\NCái duyên nợ dứt không ra ấy mà.
Dialogue: 0,0:04:31.20,0:04:32.76,Main,,0,0,0,,Hiểu chứ.
Dialogue: 0,0:04:32.76,0:04:36.14,Main,,0,0,0,,Fan Blue Sox bọn tôi cũng\Nnhư phải lòng một cô ả khó chiều.
Dialogue: 0,0:04:36.14,0:04:39.34,Main,,0,0,0,,Thật đấy, chả biết bao lần\Nđịnh thôi không làm fan nữa.
Dialogue: 0,0:04:57.69,0:05:00.15,Main,,0,0,0,,Ái chà... lại nữa à.
Dialogue: 0,0:05:01.78,0:05:03.63,Main,,0,0,0,,Ông già ơi!
Dialogue: 0,0:05:11.57,0:05:13.33,Main,,0,0,0,,Chào, lâu rồi không gặp.
Dialogue: 0,0:05:13.33,0:05:14.41,Main,,0,0,0,,Ờ.
Dialogue: 0,0:05:14.41,0:05:16.30,Main,,0,0,0,,Miles, danh sách kiểm tra đâu?
Dialogue: 0,0:05:16.30,0:05:17.40,Main,,0,0,0,,Ở đó đấy.
Dialogue: 0,0:05:17.40,0:05:19.19,Main,,0,0,0,,Tôi treo trên thân máy rồi.
Dialogue: 0,0:05:20.67,0:05:23.86,Main,,0,0,0,,Sửa cái đồ cổ đó à?
Dialogue: 0,0:05:23.86,0:05:26.20,Main,,0,0,0,,Chắc là không được đâu.
Dialogue: 0,0:05:26.20,0:05:28.96,Main,,0,0,0,,Máy tính không tương thích\Nvới hệ thống mono mà.
Dialogue: 0,0:05:28.96,0:05:33.41,Main,,0,0,0,,Miles! Bộ truyền EV\Nvới bộ giảm chấn của càng chính,
Dialogue: 0,0:05:33.41,0:05:36.41,Main,,0,0,0,,thêm ống khí nén 3-8 nữa!
Dialogue: 0,0:05:36.41,0:05:39.27,Main,,0,0,0,,3-8 á?\NLàm gì có loại đặc biệt thế.
Dialogue: 0,0:05:39.28,0:05:42.73,Main,,0,0,0,,Đặt bên Reggie. Chỗ hắn có đấy.
Dialogue: 0,0:05:42.74,0:05:46.96,Main,,0,0,0,,Vâng vâng.\NSai người như sai trâu, thật tình.
Dialogue: 0,0:05:50.10,0:05:51.70,Main,,0,0,0,,Đúng là thú chơi.
Dialogue: 0,0:05:58.87,0:05:59.88,Main,,0,0,0,,Cắn câu chưa?
Dialogue: 0,0:05:59.88,0:06:01.84,Main,,0,0,0,,Không phải tôi. Ở đâu?
Dialogue: 0,0:06:01.84,0:06:04.55,Main,,0,0,0,,Gần lắm. Tổ sư, mồi tồi quá.
Dialogue: 0,0:06:04.55,0:06:05.30,Main,,0,0,0,,Này!
Dialogue: 0,0:06:10.64,0:06:12.99,Main,,0,0,0,,Đi con hàng xịn đấy nhỉ.
Dialogue: 0,0:06:12.99,0:06:16.81,Main,,0,0,0,,Phải cướp của những kẻ sung sướng thế này\Nđem cho những kẻ thiệt thòi,
Dialogue: 0,0:06:16.81,0:06:19.29,Main,,0,0,0,,{\i1}thì mới gọi là nhân loại bình đẳng.{\i0}
Dialogue: 0,0:06:19.29,0:06:20.52,Main,,0,0,0,,{\i1}Mày thấy có đúng không?{\i0}
Dialogue: 0,0:06:20.90,0:06:24.28,Main,,0,0,0,,Hề hề, ra thế.\NTức là thay trời hành đạo đây mà.
Dialogue: 0,0:06:24.28,0:06:28.99,Main,,0,0,0,,{\i1}Phải. Bọn tao thiệt thòi\Nthì lấy là đương nhiên.{\i0}
Dialogue: 0,0:06:30.32,0:06:31.72,Main,,0,0,0,,Có gì tới kìa!
Dialogue: 0,0:06:31.72,0:06:32.45,Main,,0,0,0,,Cảnh sát à?
Dialogue: 0,0:06:34.29,0:06:35.12,Main,,0,0,0,,Rồi,
Dialogue: 0,0:06:35.12,0:06:36.62,Main,,0,0,0,,{\i1}dừng ở đó thôi.{\i0}
Dialogue: 0,0:06:36.63,0:06:39.07,Main,,0,0,0,,Thợ săn tiền thưởng à?
Dialogue: 0,0:06:39.07,0:06:39.95,Main,,0,0,0,,Herman.
Dialogue: 0,0:06:39.95,0:06:41.84,Main,,0,0,0,,Ngoan nào, lại đây...
Dialogue: 0,0:06:45.30,0:06:46.80,Main,,0,0,0,,Faye, phía trên!
Dialogue: 0,0:06:52.30,0:06:54.60,Main,,0,0,0,,Này, đùa à...
Dialogue: 0,0:06:58.14,0:06:59.77,Main,,0,0,0,,Đâu phải tôi chứ!
Dialogue: 0,0:07:01.08,0:07:02.98,Main,,0,0,0,,Ruth! Phía sau còn một chiếc!
Dialogue: 0,0:07:02.99,0:07:04.50,Main,,0,0,0,,{\i1}To tướng luôn!{\i0}
Dialogue: 0,0:07:04.50,0:07:05.44,Main,,0,0,0,,Biết rồi.
Dialogue: 0,0:07:06.54,0:07:08.15,Main,,0,0,0,,Tàu gì mà nát thế.
Dialogue: 0,0:07:08.15,0:07:09.40,Main,,0,0,0,,Mặc xác tôi!
Dialogue: 0,0:07:28.71,0:07:32.87,Main,,0,0,0,,{\i1}Hệ thống phát sinh lỗi.\NKhởi động chương trình bay khẩn cấp.{\i0}
Dialogue: 0,0:07:36.97,0:07:39.60,Main,,0,0,0,,{\i1}Này, dừng lại đi!{\i0}
Dialogue: 0,0:07:40.27,0:07:41.89,Main,,0,0,0,,{\i1}Ai mà biết!{\i0}
Dialogue: 0,0:08:27.44,0:08:30.00,Main,,0,0,0,,Bị cậu ta quăng quật\Nghê lắm nhỉ.
Dialogue: 0,0:08:30.80,0:08:31.57,Main,,0,0,0,,Tắt đi.
Dialogue: 0,0:08:37.22,0:08:39.82,Main,,0,0,0,,Bơm tăng tốc mòn hết rồi đấy.
Dialogue: 0,0:08:39.82,0:08:40.83,Main,,0,0,0,,Biết rồi.
Dialogue: 0,0:08:40.83,0:08:44.73,Main,,0,0,0,,Kim phun nhiên liệu\Ncũng không có bộ giảm thanh...
Dialogue: 0,0:08:44.73,0:08:45.63,Main,,0,0,0,,Không cần.
Dialogue: 0,0:08:45.63,0:08:47.74,Main,,0,0,0,,Hả? Nhưng ồn lắm, lại còn rung...
Dialogue: 0,0:08:47.74,0:08:50.71,Main,,0,0,0,,Lắp thứ đó vào thì\Nsao biết máy nó đang thế nào.
Dialogue: 0,0:08:52.35,0:08:54.43,Main,,0,0,0,,Mau nối kim phun đi.
Dialogue: 0,0:08:55.40,0:08:58.64,Main,,0,0,0,,Mà thời này ai còn\Ndùng loại 3-8 nữa đâu.
Dialogue: 0,0:08:59.02,0:09:02.10,Main,,0,0,0,,Đổi sang loại 5-0 đời mới\Nchả tốt hơn à?
Dialogue: 0,0:09:02.10,0:09:03.10,Main,,0,0,0,,Miles.
Dialogue: 0,0:09:03.10,0:09:04.86,Main,,0,0,0,,Định vị mà để tự động hoàn toàn
Dialogue: 0,0:09:04.86,0:09:06.81,Main,,0,0,0,,thì thả tay vẫn bay vèo vèo...
Dialogue: 0,0:09:09.32,0:09:12.97,Main,,0,0,0,,Cậu muốn bị máy móc sai khiến,\Nhay muốn sai khiến máy móc?
Dialogue: 0,0:09:12.97,0:09:13.82,Main,,0,0,0,,Đằng nào?
Dialogue: 0,0:09:15.21,0:09:16.09,Main,,0,0,0,,Tôi có định...
Dialogue: 0,0:09:16.09,0:09:16.99,Main,,0,0,0,,Đi đi.
Dialogue: 0,0:09:22.32,0:09:24.20,Main,,0,0,0,,Ông vẫn chả khác gì nhỉ.
Dialogue: 0,0:09:24.20,0:09:27.25,Main,,0,0,0,,Cứ thế này thì\Nlại có trợ lý bỏ chạy cho xem.
Dialogue: 0,0:09:29.83,0:09:34.22,Main,,0,0,0,,Cậu mới đúng đấy.\NSwordfish đang muốn chạy khỏi cậu đấy.
Dialogue: 0,0:09:35.18,0:09:36.43,Main,,0,0,0,,Lần đầu nghe đấy.
Dialogue: 0,0:09:36.43,0:09:41.60,Main,,0,0,0,,Cứ bắt nó làm liều mãi\Nthì có ngày nó hất cậu xuống thật đấy.
Dialogue: 0,0:09:41.60,0:09:44.68,Main,,0,0,0,,Tiếc là tôi vụng mấy\Nchuyện nâng niu tinh tế lắm.
Dialogue: 0,0:09:50.86,0:09:52.23,Main,,0,0,0,,Để ông chờ lâu nhé.
Dialogue: 0,0:09:52.23,0:09:55.65,Main,,0,0,0,,Ống khí nén 3-8 đây,\Nhiếm có khó tìm đấy.
Dialogue: 0,0:10:01.55,0:10:04.11,Main,,0,0,0,,Vâng, a lô~
Dialogue: 0,0:10:04.11,0:10:07.12,Main,,0,0,0,,Ồ, anh chàng mất tích đấy à.\NGiờ đang ở đâu?
Dialogue: 0,0:10:07.13,0:10:10.10,Main,,0,0,0,,Vẫn ở chỗ Doohan. Jet đâu?
Dialogue: 0,0:10:10.10,0:10:11.88,Main,,0,0,0,,{\i1}Bảo đang bận tay rồi.{\i0}
Dialogue: 0,0:10:12.49,0:10:15.13,Main,,0,0,0,,Nghe đâu vi khuẩn gì đó\Nlàm sao làm sao...
Dialogue: 0,0:10:15.62,0:10:16.38,Main,,0,0,0,,Vi khuẩn?
Dialogue: 0,0:10:16.79,0:10:19.64,Main,,0,0,0,,Virus! Virus máy tính!
Dialogue: 0,0:10:20.05,0:10:21.90,Main,,0,0,0,,Thì cũng na ná nhau.
Dialogue: 0,0:10:23.10,0:10:26.19,Main,,0,0,0,,Từ hệ thống mono, đến tính quỹ đạo,
Dialogue: 0,0:10:26.19,0:10:29.81,Main,,0,0,0,,chọn hành trình,\Nđiều khiển động cơ, mạch liên lạc,
Dialogue: 0,0:10:29.82,0:10:31.98,Main,,0,0,0,,{\i1}tất cả hỏng sạch.{\i0}
Dialogue: 0,0:10:31.98,0:10:34.44,Main,,0,0,0,,Chả hiểu gì. Nói ngắn gọn đi.
Dialogue: 0,0:10:34.89,0:10:38.90,Main,,0,0,0,,Máy tính hỏng rồi,\Nbọn em đang trôi dạt.
Dialogue: 0,0:10:40.45,0:10:41.80,Main,,0,0,0,,Hiểu rõ lắm rồi.
Dialogue: 0,0:10:41.80,0:10:43.71,Main,,0,0,0,,Thế nào? Mẫu mới nhất đấy.
Dialogue: 0,0:10:43.71,0:10:45.91,Main,,0,0,0,,Chỗ khác chưa có hàng đâu.
Dialogue: 0,0:10:45.91,0:10:47.99,Main,,0,0,0,,Máy tính mono à.
Dialogue: 0,0:10:47.99,0:10:51.38,Main,,0,0,0,,Thế nào? 150 nghìn...\NThôi, 100 nghìn cũng được.
Dialogue: 0,0:10:51.88,0:10:53.56,Main,,0,0,0,,Giá hời quá nhỉ.
Dialogue: 0,0:10:53.56,0:10:55.89,Main,,0,0,0,,Giá đó thì bán sắt vụn còn lỗ.
Dialogue: 0,0:10:55.89,0:10:57.50,Main,,0,0,0,,Rồi, bên bán là ai?
Dialogue: 0,0:10:57.50,0:10:58.84,Main,,0,0,0,,Lấy ở đâu ra thế?
Dialogue: 0,0:10:58.85,0:11:00.97,Main,,0,0,0,,Xe tải? Đặc điểm thế nào?
Dialogue: 0,0:11:00.97,0:11:01.72,Main,,0,0,0,,Chim cánh cụt...
Dialogue: 0,0:11:01.72,0:11:02.47,Main,,0,0,0,,in trên logo...
Dialogue: 0,0:11:02.47,0:11:03.90,Main,,0,0,0,,xe giao hàng á?!
Comment: 0,0:11:00.97,0:11:01.72,Main,,0,0,0,,Chim cánh cụt... {\alpha&ff&}in trên logo... xe giao hàng á?!
Comment: 0,0:11:01.72,0:11:02.47,Main,,0,0,0,,Chim cánh cụt... in trên logo... {\alpha&ff&}xe giao hàng á?!
Comment: 0,0:11:02.47,0:11:03.90,Main,,0,0,0,,Chim cánh cụt... in trên logo... xe giao hàng á?!
Dialogue: 0,0:11:16.32,0:11:18.60,Main,,0,0,0,,{\i1}Tin chắc chắn chứ?{\i0}
Dialogue: 0,0:11:18.60,0:11:21.56,Main,,0,0,0,,{\i1}Ờ. Nghe nói chúng giao dịch\Nở trạm dừng chân trên quỹ đạo.{\i0}
Dialogue: 0,0:11:21.56,0:11:26.67,Main,,0,0,0,,{\i1}Ra thế. Xe giao hàng có lượn lờ\Nquanh đó cũng chả ai nghi.{\i0}
Dialogue: 0,0:11:28.34,0:11:30.42,Main,,0,0,0,,{\i1}Rồi, phòng hack thế nào?{\i0}
Dialogue: 0,0:11:30.89,0:11:32.42,Main,,0,0,0,,Đừng để chúng phóng lao móc vào!
Dialogue: 0,0:11:37.21,0:11:37.88,Main,,0,0,0,,Rồi sao?
Dialogue: 0,0:11:37.88,0:11:39.38,Main,,0,0,0,,Thế thôi à?
Dialogue: 0,0:11:39.39,0:11:42.34,Main,,0,0,0,,Bọn chúng dám chê\Ncon tàu này là đồ cũ nát.
Dialogue: 0,0:11:42.91,0:11:45.60,Main,,0,0,0,,{\i1}Lại còn làm Hammerhead của tôi\Nra nông nỗi đó!{\i0}
Dialogue: 0,0:11:46.31,0:11:50.03,Main,,0,0,0,,{\i0}Tôi không như ai kia,\Nnợ thì nhất định phải trả.
Dialogue: 0,0:11:50.03,0:11:52.27,Main,,0,0,0,,Nguyên tắc cao đẹp ghê cơ.
Dialogue: 0,0:11:52.91,0:11:54.73,Main,,0,0,0,,Chả hứng thú lắm.
Dialogue: 0,0:11:55.62,0:11:58.95,Main,,0,0,0,,Hóa đơn của Doohan\Ngửi tới rồi đây này.
Dialogue: 0,0:12:05.08,0:12:08.50,Main,,0,0,0,,{\i1}Chúng phải bắn lao móc \Nđể truyền trực tiếp virus vào tàu như thế,{\i0}
Dialogue: 0,0:12:08.50,0:12:10.74,Main,,0,0,0,,{\i1}tức là vẫn chưa có vaccine.{\i0}
Dialogue: 0,0:12:10.74,0:12:11.88,Main,,0,0,0,,{\i1}Thế nên,{\i0}
Dialogue: 0,0:12:11.88,0:12:14.75,Main,,0,0,0,,đến lúc cho \Nvũ khí bí mật này xuất trận rồi.
Dialogue: 0,0:12:14.76,0:12:18.41,Main,,0,0,0,,Gì chứ, cái bộ đàm mọi khi thôi mà.
Dialogue: 0,0:12:18.41,0:12:22.36,Main,,0,0,0,,Nếu bị nhiễm virus thì\Ncắt luôn cả hệ thống mono.
Dialogue: 0,0:12:22.36,0:12:24.11,Main,,0,0,0,,Thế thì định vị với liên lạc\Nchết hết còn gì...
Dialogue: 0,0:12:24.11,0:12:28.25,Main,,0,0,0,,Nên tôi mới dùng cái này\Nđể dẫn đường cho các người.
Dialogue: 0,0:12:28.25,0:12:31.93,Main,,0,0,0,,Cái này chỉnh theo tần số\Ncủa vệ tinh liên lạc đời cũ,
Dialogue: 0,0:12:31.93,0:12:34.31,Main,,0,0,0,,{\i1}nên chả liên quan gì\Nđến hệ thống mono.{\i0}
Dialogue: 0,0:12:37.36,0:12:44.11,Main - Alt,,0,0,0,,{\i1}Bóng lọt qua giữa chốt ba và chốt ngắn,\Nlăn ra phía sân trái...{\i0}
Dialogue: 0,0:12:42.15,0:12:44.11,Main,,0,0,0,,Vũ khí bí mật ghê gớm thật.
Comment: 1,0:12:47.87,0:12:50.96,Main,,0,0,0,,{\i1}Nào, Bush chuẩn bị ném quả thứ ba...{\i0}
Comment: 1,0:12:50.96,0:12:52.33,Main,,0,0,0,,{\i1}Ném rồi!{\i0}
Comment: 1,0:12:52.33,0:12:53.37,Main,,0,0,0,,{\i1}Ball!{\i0}
Comment: 1,0:12:53.37,0:12:55.53,Main,,0,0,0,,{\i1}Vậy là ba ball, chưa có strike nào...{\i0}
Dialogue: 0,0:13:13.57,0:13:15.73,Main,,0,0,0,,{\i1}Chim cánh cụt nhỉ?{\i0}
Dialogue: 0,0:13:15.73,0:13:18.44,Main,,0,0,0,,Ờ, chim cánh cụt màu tím.
Dialogue: 0,0:13:25.28,0:13:27.04,Main,,0,0,0,,Hai chiếc á?
Dialogue: 0,0:13:27.04,0:13:30.33,Main,,0,0,0,,Khoan, khoan,\Nbiết đâu là xe giao hàng thật.
Dialogue: 0,0:13:30.33,0:13:32.66,Main,,0,0,0,,Vấn đề là kiểm tra kiểu gì...
Dialogue: 0,0:13:32.66,0:13:34.52,Main,,0,0,0,,Dễ ợt.
Dialogue: 0,0:13:34.52,0:13:36.92,Main,,0,0,0,,Cứ nã một phát,\Nđứa nào chạy là thủ phạm.
Dialogue: 0,0:13:36.92,0:13:39.42,Main,,0,0,0,,Lần đầu tôi với cô\Ncùng ý kiến đấy.
Dialogue: 0,0:13:40.47,0:13:41.67,Main,,0,0,0,,C-các người!
Dialogue: 0,0:13:45.01,0:13:47.89,Main,,0,0,0,,Cả hai đều là xe thật\Nthì định làm thế nào hả!
Dialogue: 0,0:13:53.15,0:13:54.85,Main,,0,0,0,,{\i1}Cả hai đều chạy.{\i0}
Dialogue: 0,0:13:54.85,0:13:57.23,Main,,0,0,0,,{\i1}Vụ này thì không tính tới thật.{\i0}
Dialogue: 0,0:13:58.98,0:14:00.48,Main,,0,0,0,,Bên đó giao cho cô.
Dialogue: 0,0:14:00.48,0:14:03.19,Main,,0,0,0,,Còn phải trả món nợ hôm qua nữa.
Dialogue: 0,0:14:21.74,0:14:22.96,Main,,0,0,0,,Ối, tha cho tôi!
Dialogue: 0,0:14:22.96,0:14:25.67,Main,,0,0,0,,Tôi sẽ trả phí đỗ xe\Nđàng hoàng mà!
Dialogue: 0,0:14:30.58,0:14:31.35,Main,,0,0,0,,Bên này à.
Dialogue: 0,0:14:31.87,0:14:34.18,Main,,0,0,0,,{\i1}Spike, lôi chúng ra ngoài!{\i0}
Dialogue: 0,0:14:34.86,0:14:37.19,Main,,0,0,0,,{\i1}Chúng mà rải virus\Nở trong thì to chuyện...{\i0}
Dialogue: 0,0:14:37.19,0:14:38.16,Main,,0,0,0,,{\i1}Biết rồi.{\i0}
Comment: 1,0:14:38.16,0:14:40.13,Main,,0,0,0,,{\i1}31 lượt đánh chưa có cú hit nào...{\i0}
Dialogue: 0,0:14:44.16,0:14:45.61,Main,,0,0,0,,Để xem tay nghề thế nào.
Dialogue: 0,0:14:49.07,0:14:50.48,Main,,0,0,0,,Tới rồi.
Dialogue: 0,0:14:51.03,0:14:51.83,Main,,0,0,0,,Vô ích thôi.
Dialogue: 0,0:15:03.25,0:15:04.76,Main,,0,0,0,,Nó nhắm vào cánh tay máy.
Dialogue: 0,0:15:04.76,0:15:06.71,Main,,0,0,0,,Dám coi thường bọn tao. Ruth!
Dialogue: 0,0:15:06.72,0:15:08.22,Main,,0,0,0,,Lúc nào cũng sẵn sàng.
Dialogue: 0,0:15:09.72,0:15:11.45,Main,,0,0,0,,{\i1}Cho mày sợ!{\i0}
Dialogue: 0,0:15:13.39,0:15:14.64,Main,,0,0,0,,Mời vào...
Dialogue: 0,0:15:18.30,0:15:19.14,Main,,0,0,0,,Được lắm.
Dialogue: 0,0:15:22.73,0:15:23.36,Main,,0,0,0,,Trúng rồi!
Dialogue: 0,0:15:27.07,0:15:28.15,Main,,0,0,0,,Cũng có cố gắng đấy.
Dialogue: 0,0:15:36.04,0:15:37.74,Main,,0,0,0,,Cắt hệ thống mono đi!
Dialogue: 0,0:15:37.74,0:15:38.92,Main,,0,0,0,,Đang cắt đây!
Dialogue: 0,0:15:43.67,0:15:47.01,Main,,0,0,0,,Thằng đần đó cắt luôn\Nhệ thống mono rồi kìa.
Dialogue: 0,0:15:47.01,0:15:48.38,Main,,0,0,0,,Này, George...
Dialogue: 0,0:15:48.38,0:15:50.67,Main,,0,0,0,,Đang ở trong vùng trọng lực\Ncủa Trái Đất cơ mà.
Comment: 1,0:15:56.27,0:15:57.26,Main - Alt,,0,0,0,,{\i1}Đánh bóng thành công!{\i0}
Dialogue: 0,0:15:57.26,0:16:00.27,Main,,0,0,0,,Ông chủ! Cái này, cái này!\NGay to rồi!
Dialogue: 0,0:15:58.83,0:16:01.70,Main - Alt,,0,0,0,,{\i1\}Chỉnh D7 đi. Trước làm rồi còn gì?
Dialogue: 0,0:16:01.70,0:16:02.73,Main - Alt,,0,0,0,,{\i1}Ai mà nhớ.
Dialogue: 0,0:16:03.80,0:16:05.54,Main,,0,0,0,,Không xong rồi, hết cách...
Dialogue: 0,0:16:08.47,0:16:11.73,Main,,0,0,0,,Thằng đần!\NMau làm gì đi chứ!
Dialogue: 0,0:16:11.73,0:16:14.43,Main,,0,0,0,,Tổ sư... Chạy đi, chạy đi chứ!
Dialogue: 0,0:16:15.09,0:16:16.85,Main,,0,0,0,,Rơi... Rơi mất!
Dialogue: 0,0:16:20.77,0:16:22.35,Main,,0,0,0,,Spike, tôi tới ngay.
Dialogue: 0,0:16:22.35,0:16:24.90,Main,,0,0,0,,{\i1}Tôi đang tính đường bay chặn đầu.{\i0}
Dialogue: 0,0:16:24.90,0:16:27.60,Main,,0,0,0,,{\i1}Trong lúc đó cố mà\Nđiều khiển bằng tay đi.{\i0}
Dialogue: 0,0:16:28.15,0:16:31.42,Main,,0,0,0,,{\i1}Bình thường đi qua\Nchỗ này đã khó rồi đấy.{\i0}
Dialogue: 0,0:16:32.78,0:16:34.26,Main,,0,0,0,,Nhìn là biết mà.
Dialogue: 0,0:16:38.92,0:16:41.10,Main,,0,0,0,,Vừa mới đại tu xong cơ mà...
Dialogue: 0,0:16:45.26,0:16:47.46,Main,,0,0,0,,Thôi, tới đâu hay tới đó.
Dialogue: 0,0:16:57.32,0:16:59.01,Main,,0,0,0,,{\i1}Spike, ở trên.{\i0}
Dialogue: 0,0:17:00.55,0:17:03.01,Main,,0,0,0,,{\i1}Con tàu cũ nát\Ngiờ nhìn chẳng khác gì nữ thần.{\i0}
Dialogue: 0,0:17:15.61,0:17:17.19,Main,,0,0,0,,Tổ sư, virus...
Dialogue: 0,0:17:20.41,0:17:21.59,Main,,0,0,0,,Spike!
Dialogue: 0,0:17:21.59,0:17:22.37,Main,,0,0,0,,{\i1}{\i1}Vẫn sống đây.{\i0}
Dialogue: 0,0:17:22.37,0:17:24.14,Main,,0,0,0,,{\i1}Làm lại từ đầu thôi.{\i0}
Dialogue: 0,0:17:31.44,0:17:33.82,Main,,0,0,0,,Không phải chứ?\NÔng đùa à, ông chủ?
Dialogue: 0,0:17:33.82,0:17:35.84,Main,,0,0,0,,Định lái thứ đồ cổ này thật à?
Dialogue: 0,0:17:36.53,0:17:38.80,Main,,0,0,0,,Đùa mà làm được thế này à?
Dialogue: 0,0:17:43.74,0:17:45.21,Main,,0,0,0,,Đừng đứng đực ra đó!
Dialogue: 0,0:17:45.21,0:17:47.52,Main,,0,0,0,,Mau đi gom nhiên liệu về đây!
Dialogue: 0,0:17:47.52,0:17:48.48,Main,,0,0,0,,Có ngay!
Dialogue: 0,0:17:49.39,0:17:52.41,Main,,0,0,0,,Spike, nghe thấy không?\NTính xong rồi.
Dialogue: 0,0:17:52.82,0:17:56.11,Main,,0,0,0,,Phải mất 7 tiếng nữa \Nmới tiếp cận được chỗ anh.
Dialogue: 0,0:17:56.11,0:17:58.40,Main,,0,0,0,,Này, đùa đấy à?
Dialogue: 0,0:17:58.40,0:18:02.09,Main,,0,0,0,,{\i1}Đang quá gần Trái Đất\Nnên đường bay bị hạn chế.{\i0}
Dialogue: 0,0:18:02.09,0:18:04.18,Main,,0,0,0,,{\i1}Không có cách nào\Nđến nhanh hơn à?{\i0}
Dialogue: 0,0:18:04.18,0:18:06.12,Main,,0,0,0,,{\i1}Lao vào ở góc đó thì{\i0}
Dialogue: 0,0:18:06.12,0:18:08.87,Main,,0,0,0,,{\i1}cả Bebop lẫn Swordfish\Nđều cháy rụi hết.{\i0}
Dialogue: 0,0:18:25.87,0:18:26.95,Main,,0,0,0,,Jet.
Dialogue: 0,0:18:28.82,0:18:31.31,Main,,0,0,0,,{\i1}Sau tủ lạnh có giấu rượu đấy.{\i0}
Dialogue: 0,0:18:31.86,0:18:32.83,Main,,0,0,0,,{\i1}Uống đi.{\i0}
Dialogue: 0,0:18:33.84,0:18:34.71,Main,,0,0,0,,Có vấn đề gì à?
Dialogue: 0,0:18:35.86,0:18:37.61,Main,,0,0,0,,Hết nhiên liệu rồi.
Dialogue: 0,0:18:37.61,0:18:38.71,Main,,0,0,0,,Làm được gì nữa đâu.
Dialogue: 0,0:18:39.71,0:18:43.53,Main,,0,0,0,,{\i1}Lấy chai rượu đó\N trả công cho tôi đi kéo cậu về, thế nào?{\i0}
Dialogue: 0,0:18:44.05,0:18:48.30,Main,,0,0,0,,Tôi nghe hết rồi.\NCho tôi tọa độ của Swordfish.
Dialogue: 0,0:18:48.75,0:18:49.76,Main,,0,0,0,,Doohan?
Dialogue: 0,0:18:50.37,0:18:51.51,Main,,0,0,0,,Sao ông lại...?
Dialogue: 0,0:19:13.88,0:19:17.83,Main,,0,0,0,,{\i1}Spike, làm gì cũng được,\Nphanh khí lại mà giảm tốc.{\i0}
Dialogue: 0,0:19:17.83,0:19:18.58,Main,,0,0,0,,Giảm tốc?
Dialogue: 0,0:19:18.58,0:19:21.36,Main,,0,0,0,,Giảm tốc trong khí quyển Trái Đất
Dialogue: 0,0:19:21.36,0:19:24.05,Main,,0,0,0,,thì trọng lực sẽ kéo\Nngược lại làm cậu tăng tốc,
Dialogue: 0,0:19:24.59,0:19:26.71,Main,,0,0,0,,{\i1}rồi lại đạt tốc độ thoát ly.{\i0}
Dialogue: 0,0:19:26.71,0:19:29.30,Main,,0,0,0,,{\i1}Có điều, phải giữ\Nđúng một góc nhất định.{\i0}
Dialogue: 0,0:19:29.30,0:19:32.51,Main,,0,0,0,,{\i1}{\i1}Nông quá hay sâu quá\Nđều bị văng ra tận cùng vũ trụ.{\i0}
Dialogue: 0,0:19:32.52,0:19:35.74,Main,,0,0,0,,Tiếc là tôi vụng mấy\Nchuyện nâng niu tinh tế lắm.
Dialogue: 0,0:19:36.45,0:19:37.43,Main,,0,0,0,,{\i1}Spike...{\i0}
Dialogue: 0,0:19:38.73,0:19:40.87,Main,,0,0,0,,Cậu làm được mà.
Dialogue: 0,0:19:40.87,0:19:43.48,Main,,0,0,0,,Tôi giao Swordfish cho cậu\Nđâu phải cho vui.
Dialogue: 0,0:19:46.40,0:19:48.95,Main,,0,0,0,,Ông cũng đừng có\Nrơi giữa đường đấy.
Dialogue: 0,0:20:05.04,0:20:06.46,Main,,0,0,0,,Lực đẩy tối đa.
Dialogue: 0,0:20:08.06,0:20:10.22,Main,,0,0,0,,Không cần cố đi cùng tôi đâu.
Dialogue: 0,0:20:11.05,0:20:13.68,Main,,0,0,0,,Fan Blue Sox ưa náo nhiệt lắm!
Dialogue: 0,0:20:16.48,0:20:17.14,Main,,0,0,0,,Đi thôi.
Dialogue: 0,0:20:17.83,0:20:18.48,Main,,0,0,0,,Có ngay!
Dialogue: 0,0:20:41.85,0:20:42.94,Main,,0,0,0,,Bay rồi...
Dialogue: 0,0:20:44.54,0:20:46.29,Main,,0,0,0,,Bay thật rồi này!
Dialogue: 0,0:20:56.77,0:20:58.66,Main,,0,0,0,,{\i1}Hạ mũi 0,6 độ.{\i0}
Dialogue: 0,0:21:06.85,0:21:08.30,Main,,0,0,0,,{\i1}Góc sâu quá!{\i0}
Dialogue: 0,0:21:08.30,0:21:10.19,Main,,0,0,0,,{\i1}Cháy rụi bây giờ, Spike!{\i0}
Dialogue: 0,0:21:15.41,0:21:17.14,Main,,0,0,0,,{\i1}Cơ hội cuối cùng đấy!{\i0}
Dialogue: 0,0:21:36.61,0:21:38.95,Main,,0,0,0,,Vào rồi! Vào được rồi!
Dialogue: 0,0:21:38.95,0:21:39.93,Main,,0,0,0,,Hoàn hảo luôn!
Dialogue: 0,0:21:42.16,0:21:43.53,Main,,0,0,0,,Doohan, nhờ ông cả đấy.
Dialogue: 0,0:21:43.53,0:21:44.69,Main,,0,0,0,,{\i1}Chưa hẳn đâu.{\i0}
Dialogue: 0,0:21:44.69,0:21:47.52,Main,,0,0,0,,Gạch chịu nhiệt bong gần hết rồi,
Dialogue: 0,0:21:47.52,0:21:48.65,Main,,0,0,0,,nhiệt độ đang tăng.
Dialogue: 0,0:21:48.65,0:21:51.14,Main,,0,0,0,,{\i1}Á! B-bánh xe cũng không ra!{\i0}
Dialogue: 0,0:21:51.14,0:21:53.12,Main,,0,0,0,,{\i1}Thật ra vòi phun số 2 cũng chết rồi.{\i0}
Dialogue: 0,0:21:53.12,0:21:56.33,Main,,0,0,0,,{\i1}Hả, thật á?\NGiờ tính sao đây?{\i0}
Dialogue: 0,0:21:56.33,0:21:58.37,Main,,0,0,0,,{\i1}Thế này thì hạ cánh kiểu gì!{\i0}
Dialogue: 0,0:21:57.60,0:22:00.77,Main - Alt,,0,0,0,,Thôi, tới đâu hay tới đó.
Dialogue: 0,0:21:58.37,0:22:04.03,Main,,0,0,0,,{\i1}Tôi mới 18 thôi mà!\NTôi chưa muốn chết đâu!{\i0}
