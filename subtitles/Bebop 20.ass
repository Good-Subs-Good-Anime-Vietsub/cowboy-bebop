Comment: 0,0:22:33.07,0:26:34.40,Main,,0,0,0,,========= ED =========
Dialogue: 0,0:22:44.76,0:22:50.18,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}Cứ mải than thân trách phận, cho mối tình xưa,
Dialogue: 0,0:22:50.18,0:22:55.60,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}dòng thời gian vẫn lẳng lặng trôi, đã bao lâu rồi?
Dialogue: 0,0:22:56.69,0:23:02.24,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}Vết bỏng hằn sâu trong tim, nào có nguôi đi,
Dialogue: 0,0:23:02.24,0:23:07.45,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}gió chẳng thể xoa dịu cho tôi, chỉ biết thổi thôi.
Dialogue: 0,0:23:08.70,0:23:17.96,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}Với con ngươi khô, với tròng mắt cạn, ai đó ơi, giúp tôi đổ lệ đi!
Dialogue: 0,0:23:19.59,0:23:23.13,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}Giai điệu Folk Blues đích thực!
Dialogue: 0,0:23:19.59,0:23:23.13,GT,,0,0,0,,{\fad(0,300)\bord0\shad0\blur0.67}(Blues còn có nghĩa là u sầu, buồn bã)
Dialogue: 0,0:23:23.13,0:23:26.68,ED-Vie,,0,0,0,,{\fad(300,0)\blur0.67}Đâu là thật đây?
Dialogue: 0,0:23:27.39,0:23:31.72,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}Tôi chỉ muốn biết đâu là u sầu thật sự.
Dialogue: 0,0:23:31.72,0:23:35.27,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}Toàn thân lấm lem phù sa.
Dialogue: 0,0:23:35.27,0:23:38.69,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}Ngụp lặn giữa sông.
Dialogue: 0,0:23:39.36,0:23:43.86,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}Sống như vậy cũng đâu đến nỗi tệ,
Dialogue: 0,0:23:43.86,0:23:52.70,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}miễn sao chỉ phải... cam chịu một lần.
Comment: 0,0:01:31.03,0:01:31.07,Main,,0,0,0,,========= Dialogue =========
Dialogue: 0,0:03:00.99,0:03:02.49,Main,,0,0,0,,Xin chào các quý ông.
Dialogue: 0,0:03:04.40,0:03:07.70,Main,,0,0,0,,Ta đến lấy mạng ngươi đây.
Dialogue: 0,0:04:23.80,0:04:25.87,Main,,0,0,0,,Chào chàng trai.
Dialogue: 0,0:06:33.33,0:06:36.68,Main,,0,0,0,,Cộng sự của anh\Nđúng là xui tận mạng, Jet.
Dialogue: 0,0:06:36.68,0:06:40.17,Main,,0,0,0,,Thì vốn dĩ cậu ta\Ncũng chả phải người may mắn gì...
Dialogue: 0,0:06:40.17,0:06:41.71,Main,,0,0,0,,Vụ này không ổn đâu.
Dialogue: 0,0:06:41.71,0:06:43.91,Main,,0,0,0,,Riêng vụ này\Nthì đừng nên nhúng tay vào.
Dialogue: 0,0:06:43.91,0:06:46.46,Main,,0,0,0,,Thôi khỏi, trả lời mau đi.
Dialogue: 0,0:06:46.47,0:06:48.68,Main,,0,0,0,,Tôi nghĩ cho anh nên mới nói thôi.
Dialogue: 0,0:06:48.68,0:06:53.63,Main,,0,0,0,,Với lại, đào sâu vào vụ này thêm nữa\N là đến tôi cũng vạ lây đấy.
Dialogue: 0,0:06:57.81,0:06:59.52,Main,,0,0,0,,Này, Bob.
Dialogue: 0,0:06:59.95,0:07:03.05,Main,,0,0,0,,Chuyện thế này\Nchỉ nhờ được mỗi anh thôi.
Dialogue: 0,0:07:03.05,0:07:05.65,Main,,0,0,0,,Tôi sẽ không để anh thiệt đâu.\NNên là...
Dialogue: 0,0:07:05.65,0:07:08.11,Main,,0,0,0,,Lần nào anh chả nói câu đó?
Dialogue: 0,0:07:08.11,0:07:11.62,Main,,0,0,0,,Thật tình, từ xưa đã là\Ncái loại thích dây vào rắc rối.
Dialogue: 0,0:07:13.06,0:07:16.16,Main,,0,0,0,,Nghe đây,\Nđây chỉ là tin đồn thôi nhé...
Dialogue: 0,0:07:16.17,0:07:19.79,Main,,0,0,0,,Đã nghe cái tên\N"Gã Hề Điên" bao giờ chưa?
Dialogue: 0,0:07:35.05,0:07:38.10,Main,,0,0,0,,Đây rồi đây rồi,\Nanh xác ướp trong lời đồn.
Dialogue: 0,0:07:38.10,0:07:41.63,Main,,0,0,0,,Nghe đâu bị một ông chú\Nquái dị nào đó nện cho à?
Dialogue: 0,0:07:43.24,0:07:46.44,Main,,0,0,0,,Hồi trước anh cũng liệt giường\Nvới bộ dạng y hệt thế này nhỉ.
Dialogue: 0,0:07:46.44,0:07:48.86,Main,,0,0,0,,Đúng là chả tiến bộ tí nào.
Dialogue: 0,0:07:49.35,0:07:51.39,Main,,0,0,0,,Mà, cũng chả liên quan gì đến tôi.
Dialogue: 0,0:07:53.36,0:07:57.45,Main,,0,0,0,,Chắc tại ngày thường ăn ở không ra gì\Nnên mới gặp cảnh này đấy.
Dialogue: 0,0:07:58.05,0:08:00.40,Main,,0,0,0,,Mà, cũng chả liên quan gì đến tôi.
Dialogue: 0,0:08:02.21,0:08:06.20,Main,,0,0,0,,Thế nên người chả liên quan như tôi\N xin phép chuồn trước nhá~
Dialogue: 0,0:08:06.20,0:08:07.42,Main,,0,0,0,,Mau khỏe nhé.
Dialogue: 0,0:08:10.37,0:08:13.32,Main,,0,0,0,,Kẻ bị giết\Nlà một quan chức cấp cao của ISSP.
Dialogue: 0,0:08:13.32,0:08:14.76,Main,,0,0,0,,Đây là người thứ bảy rồi.
Dialogue: 0,0:08:14.77,0:08:16.26,Main,,0,0,0,,Cái gì?
Dialogue: 0,0:08:16.26,0:08:20.08,Main,,0,0,0,,Anh không biết cũng phải.\NVụ này là tuyệt mật.
Dialogue: 0,0:08:20.08,0:08:24.83,Main,,0,0,0,,Hình như cấp trên\Nkhông muốn chuyện này lọt ra ngoài.
Dialogue: 0,0:08:24.83,0:08:25.98,Main,,0,0,0,,Sao thế?
Dialogue: 0,0:08:25.99,0:08:28.15,Main,,0,0,0,,Cộng sự của anh gay go rồi.
Dialogue: 0,0:08:29.66,0:08:32.84,Main,,0,0,0,,{\i1}Hắn là cỗ máy giết người hoàn hảo.{\i0}
Dialogue: 0,0:08:32.84,0:08:37.41,Main,,0,0,0,,{\i1}Nghe nói đến giờ chưa ai\Nthấy mặt hắn mà còn sống sót.{\i0}
Dialogue: 0,0:08:37.84,0:08:41.62,Main,,0,0,0,,{\i1}Kẻ nào may mắn thoát khỏi hiện trường,\Nhắn cũng truy tìm đến cùng{\i0}
Dialogue: 0,0:08:41.63,0:08:44.75,Main,,0,0,0,,{\i1}và nhất định phải lấy mạng bằng được.{\i0}
Dialogue: 0,0:08:44.75,0:08:47.51,Main,,0,0,0,,Nghe nói lúc xuất hiện hắn cũng cười,
Dialogue: 0,0:08:47.51,0:08:49.88,Main,,0,0,0,,mà lúc bỏ đi trên môi vẫn nở nụ cười đấy.
Dialogue: 0,0:09:08.63,0:09:09.78,Main,,0,0,0,,Đúng thế.
Dialogue: 0,0:09:09.78,0:09:14.49,Main,,0,0,0,,Hắn chính là sát thủ bóng ma\Nmang tên Gã Hề Điên,
Dialogue: 0,0:09:14.49,0:09:15.31,Main,,0,0,0,,{\i1}Tongpu.{\i0}
Dialogue: 0,0:09:59.55,0:10:00.87,Main,,0,0,0,,Faye Faye~!
Dialogue: 0,0:10:00.87,0:10:03.08,Main,,0,0,0,,Phì phèo, Faye Faye~!
Dialogue: 0,0:10:03.48,0:10:06.04,Main,,0,0,0,,Phì phèo, Faye Faye~
Dialogue: 0,0:10:06.04,0:10:10.48,Main,,0,0,0,,Này nhóc, thôi gọi\N"Faye Faye" hai lần thế được không?
Dialogue: 0,0:10:10.48,0:10:13.28,Main,,0,0,0,,Faye Faye,\Ncó mail lạ tới tới rồi~
Dialogue: 0,0:10:13.28,0:10:14.59,Main,,0,0,0,,Này này này này!
Dialogue: 0,0:10:14.97,0:10:19.09,Main,,0,0,0,,Thật tình,\Nchút nữa là chị cũng xong rồi...
Dialogue: 0,0:10:19.09,0:10:20.64,Main,,0,0,0,,Thế này sao đọc được!
Dialogue: 0,0:10:22.43,0:10:26.60,Main,,0,0,0,,"Chào chàng trai.\NTa mời cậu đến một bữa tiệc tuyệt vời."
Dialogue: 0,0:10:27.05,0:10:29.22,Main,,0,0,0,,Khoan đã, cái này là...
Dialogue: 0,0:10:29.22,0:10:33.14,Main,,0,0,0,,Nghe đây, chuyện có mail này\Nphải giữ bí mật với Spike đấy.
Dialogue: 0,0:10:33.14,0:10:34.60,Main,,0,0,0,,Bí mật?
Dialogue: 0,0:10:34.60,0:10:35.56,Main,,0,0,0,,Tại sao?
Dialogue: 0,0:10:35.56,0:10:36.94,Main,,0,0,0,,Bí mật tại sao?
Dialogue: 0,0:10:36.94,0:10:38.63,Main,,0,0,0,,Không thì cái tên ngốc đó...
Dialogue: 0,0:10:38.63,0:10:40.57,Main,,0,0,0,,sẽ lao đi ngay chứ gì?
Dialogue: 0,0:10:42.91,0:10:45.80,Main,,0,0,0,,Mail bí mật bí mật đó~
Dialogue: 0,0:10:47.83,0:10:49.79,Main,,0,0,0,,"Vùng Đất Không Gian" à.
Dialogue: 0,0:10:49.79,0:10:52.12,Main,,0,0,0,,Chọn chỗ tổ chức tiệc\Nkhéo đấy chứ.
Dialogue: 0,0:10:52.12,0:10:53.92,Main,,0,0,0,,Định đi với bộ dạng đó à?
Dialogue: 0,0:10:53.92,0:10:56.92,Main,,0,0,0,,Mà, nếu là tiệc hóa trang\Nthì hợp quá rồi.
Dialogue: 0,0:10:59.45,0:11:03.30,Main,,0,0,0,,Lần này có khi\Ntôi tới số thật rồi...
Dialogue: 0,0:11:04.60,0:11:08.27,Main,,0,0,0,,Nói thế thì\Ncô có đến cứu tôi không nhỉ?
Dialogue: 0,0:11:10.70,0:11:11.77,Main,,0,0,0,,Đồ ngốc.
Dialogue: 0,0:11:11.77,0:11:14.18,Main,,0,0,0,,Đồ ngốc, đồ ngốc, đồ ngốc~!
Dialogue: 0,0:11:25.84,0:11:26.81,Main,,0,0,0,,{\i1}Này...{\i0}
Dialogue: 0,0:11:27.98,0:11:29.75,Main,,0,0,0,,{\i1}Ed à. Spike đâu?{\i0}
Dialogue: 0,0:11:29.75,0:11:31.27,Main,,0,0,0,,{\i1}Đi đâu mất rồi~{\i0}
Dialogue: 0,0:11:31.27,0:11:32.50,Main,,0,0,0,,Cái gì?
Dialogue: 0,0:11:32.50,0:11:36.09,Main,,0,0,0,,{\i1}Chuyện này chả mới mẻ gì,\Nnhưng cái tên ngốc đó...{\i0}
Dialogue: 0,0:11:36.09,0:11:37.72,Main,,0,0,0,,Tên ngốc, tên ngốc?
Dialogue: 0,0:11:37.72,0:11:39.43,Main,,0,0,0,,{\i1}Ed, chú nhờ nhóc một việc.{\i0}
Dialogue: 0,0:11:39.43,0:11:40.97,Main,,0,0,0,,Gì thế, gì thế?
Dialogue: 0,0:13:07.27,0:13:08.21,Main,,0,0,0,,Xin chào!
Dialogue: 0,0:13:08.21,0:13:09.30,Main,,0,0,0,,Chào mừng!
Dialogue: 0,0:13:09.79,0:13:11.06,Main,,0,0,0,,Chào.
Dialogue: 0,0:13:13.81,0:13:16.42,Main,,0,0,0,,Tiệc tùng thôi!
Dialogue: 0,0:13:43.66,0:13:45.26,Main,,0,0,0,,{\i1}Không được vào đây đâu.{\i0}
Dialogue: 0,0:13:46.60,0:13:48.76,Main,,0,0,0,,{\i1}Ở đây nguy hiểm lắm.\NMau ra ngoài chơi đi.{\i0}
Dialogue: 0,0:13:48.77,0:13:51.45,Main,,0,0,0,,{\i1}Ở đây nguy hiểm lắm.\NMau ra ngoài chơi đi.{\i0}
Dialogue: 0,0:13:51.45,0:13:52.27,Main,,0,0,0,,Im mồm!
Dialogue: 0,0:13:52.27,0:13:54.91,Main,,0,0,0,,{\i1}Ở đây nguy hiểm lắm.\NMau ra ngoài chơi đi.{\i0}
Dialogue: 0,0:13:54.91,0:13:56.35,Main,,0,0,0,,{\i1}Ở đây nguy hiểm lắm.{\i0}
Dialogue: 0,0:14:01.28,0:14:03.86,Main,,0,0,0,,{\i1}Ở đây nguy hiểm lắm.\NMau ra ngoài chơi đi.{\i0}
Dialogue: 0,0:14:05.33,0:14:06.11,Main,,0,0,0,,Chào!
Dialogue: 0,0:14:17.75,0:14:19.14,Main,,0,0,0,,{\i1}Nghe đây, Ed.{\i0}
Dialogue: 0,0:14:19.86,0:14:25.30,Main,,0,0,0,,{\i1}Trước hết, xâm nhập máy chủ của ISSP\Nrồi tìm "Bộ phận 13" cho chú.{\i0}
Dialogue: 0,0:14:25.96,0:14:27.67,Main,,0,0,0,,Rõ rõ~!
Dialogue: 0,0:14:28.80,0:14:33.18,Main,,0,0,0,,Bộ phận đó không hề tồn tại chính thức.
Dialogue: 0,0:14:33.19,0:14:35.80,Main,,0,0,0,,{\i1}Khá là hóc búa đấy, làm được không?{\i0}
Dialogue: 0,0:14:35.80,0:14:37.02,Main,,0,0,0,,Rõ~!
Dialogue: 0,0:15:07.80,0:15:09.22,Main,,0,0,0,,{\i1}Xin chào!{\i0}
Dialogue: 0,0:15:24.73,0:15:26.61,Main,,0,0,0,,Thấy rồi ạ~!
Dialogue: 0,0:15:27.24,0:15:31.57,Main,,0,0,0,,{\i1}Mở ra rồi thì tìm hồ sơ\Nmật danh "Tongpu" cho chú.{\i0}
Dialogue: 0,0:15:31.57,0:15:32.67,Main,,0,0,0,,Rõ~
Dialogue: 0,0:16:16.37,0:16:17.95,Main,,0,0,0,,Đâu rồi... đâu rồi...
Dialogue: 0,0:16:17.95,0:16:19.40,Main,,0,0,0,,Ú òa!
Dialogue: 0,0:17:46.95,0:17:50.83,Main,,0,0,0,,{\i1}Thí nghiệm nâng cao\Nnăng lực ám sát của ISSP.{\i0}
Dialogue: 0,0:17:50.83,0:17:54.00,Main,,0,0,0,,{\i1}Đối tượng thí nghiệm,\Nhồ sơ số 46.{\i0}
Dialogue: 0,0:17:54.00,0:17:56.14,Main,,0,0,0,,{\i1}Mật danh "Tongpu".{\i0}
Dialogue: 0,0:17:56.14,0:18:00.52,Main,,0,0,0,,{\i1}Trong lúc thí nghiệm, phát hiện\Ntâm lý thoái lui nghiêm trọng.{\i0}
Dialogue: 0,0:18:00.52,0:18:02.81,Main,,0,0,0,,{\i1}Từ đó, thí nghiệm bị đình chỉ.{\i0}
Dialogue: 0,0:18:02.81,0:18:05.72,Main,,0,0,0,,{\i1}Đối tượng bị giam vĩnh viễn\Ntại cơ sở cách ly.{\i0}
Dialogue: 0,0:18:31.77,0:18:36.34,Main,,0,0,0,,{\i1}Ban đầu chắc hắn trốn trại\Nđể báo thù,{\i0}
Dialogue: 0,0:18:36.34,0:18:40.02,Main,,0,0,0,,{\i1}nhưng giờ có khi hắn chỉ đơn thuần\Nlấy việc giết chóc làm thú vui.{\i0}
Dialogue: 0,0:18:40.02,0:18:43.58,Main,,0,0,0,,{\i1}Tâm lý của hắn\N chắc vẫn đang tiếp tục thoái lui.{\i0}
Dialogue: 0,0:18:44.43,0:18:49.19,Main,,0,0,0,,Tức là một đứa trẻ\Ncó sức chiến đấu siêu phàm à.
Dialogue: 0,0:18:49.19,0:18:50.50,Main,,0,0,0,,Thật tình...
Dialogue: 0,0:18:51.04,0:18:54.40,Main,,0,0,0,,Chả có gì vừa ngây thơ\Nvừa tàn nhẫn bằng trẻ con.
Dialogue: 0,0:18:59.40,0:19:02.35,Main,,0,0,0,,Đến giờ diễn rồi!
Dialogue: 0,0:19:10.26,0:19:11.58,Main,,0,0,0,,Ai mượn cơ chứ!
Dialogue: 0,0:19:36.33,0:19:38.94,Main,,0,0,0,,{\i1}Xin chào, xin chào...{\i0}
Dialogue: 0,0:19:38.94,0:19:41.38,Main,,0,0,0,,{\i1}Xin chào! Xin chào!{\i0}
Dialogue: 0,0:19:41.38,0:19:42.95,Main,,0,0,0,,Xin chào...
Dialogue: 0,0:21:01.12,0:21:02.47,Main,,0,0,0,,Đau quá đi...
Dialogue: 0,0:21:07.95,0:21:09.74,Main,,0,0,0,,Đau quá!
Dialogue: 0,0:21:10.77,0:21:12.67,Main,,0,0,0,,Đau quá!
Dialogue: 0,0:21:16.01,0:21:18.63,Main,,0,0,0,,Đau quá!
Dialogue: 0,0:21:18.63,0:21:19.82,Main,,0,0,0,,Đau...
Dialogue: 0,0:21:19.82,0:21:25.01,Main,,0,0,0,,Mẹ ơi, đau quá!
Dialogue: 0,0:21:26.40,0:21:28.51,Main,,0,0,0,,Mẹ ơi!
Dialogue: 0,0:21:32.83,0:21:38.03,Main,,0,0,0,,Đau quá... Mẹ ơi!
Dialogue: 0,0:22:03.32,0:22:04.79,Main,,0,0,0,,{\i1}Spike, nghe đây,{\i0}
Dialogue: 0,0:22:04.79,0:22:06.83,Main,,0,0,0,,{\i1}biết được hắn là ai rồi! Hắn là...{\i0}
Dialogue: 0,0:22:06.83,0:22:07.50,Main,,0,0,0,,Thôi.
Dialogue: 0,0:22:08.35,0:22:10.36,Main,,0,0,0,,Không cần nữa đâu.
Dialogue: 0,0:22:15.99,0:22:18.80,Main,,0,0,0,,Vừa mới xong rồi.
Dialogue: 0,0:24:11.18,0:24:14.18,Main,preview,0,0,0,,{\i1}Gần đây tôi đã thấy\Ncó gì đó là lạ mà.{\i0}
Dialogue: 0,0:24:14.18,0:24:16.01,Main,preview,0,0,0,,{\i1}Hóa ra là vậy~{\i0}
Dialogue: 0,0:24:16.48,0:24:19.02,Main,preview,0,0,0,,{\i1}Hửm? Nói chuyện gì thế?{\i0}
Dialogue: 0,0:24:19.02,0:24:21.60,Main,preview,0,0,0,,{\i1}Đúng là không thể\Nnhìn mặt mà bắt hình dong.{\i0}
Dialogue: 0,0:24:21.60,0:24:23.10,Main,preview,0,0,0,,{\i1}Kinh tởm thật.{\i0}
Dialogue: 0,0:24:23.10,0:24:25.61,Main,preview,0,0,0,,{\i1}Này này, nói chuyện gì thế hả?{\i0}
Dialogue: 0,0:24:26.04,0:24:28.35,Main,preview,0,0,0,,{\i1}Ai ngờ lại đi cặp với\Ncon bé mới mười mấy tuổi.{\i0}
Dialogue: 0,0:24:28.35,0:24:30.28,Main,preview,0,0,0,,{\i1}Đúng là đáng khinh thật đấy.{\i0}
Dialogue: 0,0:24:30.28,0:24:31.78,Main,preview,0,0,0,,{\i1}Nói về ai thế hả!{\i0}
Dialogue: 0,0:24:32.23,0:24:34.32,Main,preview,0,0,0,,{\i1}Kỳ tới, "Điệu Boogie Woogie phong thủy".{\i0}
Dialogue: 0,0:24:34.32,0:24:36.28,Main,preview,0,0,0,,{\i1}Tôi có làm cái gì đâu!{\i0}
