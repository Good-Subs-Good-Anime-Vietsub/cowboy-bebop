Comment: 0,0:22:34.74,0:26:36.25,Main,,0,0,0,,========= ED =========
Dialogue: 0,0:22:46.60,0:22:52.02,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}Cứ mải than thân trách phận, cho mối tình xưa,
Dialogue: 0,0:22:52.02,0:22:57.44,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}dòng thời gian vẫn lẳng lặng trôi, đã bao lâu rồi?
Dialogue: 0,0:22:58.52,0:23:04.07,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}Vết bỏng hằn sâu trong tim, nào có nguôi đi,
Dialogue: 0,0:23:04.07,0:23:09.28,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}gió chẳng thể xoa dịu cho tôi, chỉ biết thổi thôi.
Dialogue: 0,0:23:10.54,0:23:19.79,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}Với con ngươi khô, với tròng mắt cạn, ai đó ơi, giúp tôi đổ lệ đi!
Dialogue: 0,0:23:21.42,0:23:24.97,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}Giai điệu Folk Blues đích thực!
Dialogue: 0,0:23:21.42,0:23:24.97,GT,,0,0,0,,{\fad(0,300)\bord0\shad0\blur0.67}(Blues còn có nghĩa là u sầu, buồn bã)
Dialogue: 0,0:23:24.97,0:23:28.51,ED-Vie,,0,0,0,,{\fad(300,0)\blur0.67}Đâu là thật đây?
Dialogue: 0,0:23:29.22,0:23:33.56,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}Tôi chỉ muốn biết đâu là u sầu thật sự.
Dialogue: 0,0:23:33.56,0:23:37.10,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}Toàn thân lấm lem phù sa.
Dialogue: 0,0:23:37.10,0:23:40.52,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}Ngụp lặn giữa sông.
Dialogue: 0,0:23:41.19,0:23:45.70,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}Sống như vậy cũng đâu đến nỗi tệ,
Dialogue: 0,0:23:45.70,0:23:54.54,ED-Vie,,0,0,0,,{\fad(0,300)\blur0.67}miễn sao chỉ phải... cam chịu một lần.
Comment: 0,0:01:31.03,0:01:31.07,Main,,0,0,0,,========= Dialogue =========
Dialogue: 0,0:01:43.06,0:01:47.64,Main,,0,0,0,,{\i1}Vụ việc kỳ lạ này bắt đầu\Nvào một ngày nóng như thiêu.{\i0}
Dialogue: 0,0:01:48.38,0:01:52.05,Main,,0,0,0,,{\i1}Một người quen cũ\Nbỗng gửi tới một bức mail,{\i0}
Dialogue: 0,0:01:52.05,0:01:54.64,Main,,0,0,0,,{\i1}nhưng nội dung chỉ có thế này:{\i0}
Dialogue: 0,0:01:55.67,0:01:58.44,Main,,0,0,0,,{\i1}"Hãy tìm ra các Thánh Thú ở vùng Án Sơn.{\i0}
Dialogue: 0,0:01:58.44,0:02:01.68,Main,,0,0,0,,{\i1}{\i1}Ta đang ở nơi Tứ Thần Tương Ứng."{\i0}
Dialogue: 0,0:02:15.73,0:02:18.51,Main,,0,0,0,,{\i1}Người gửi là Pao, quen biết thì có,{\i0}
Dialogue: 0,0:02:18.51,0:02:20.73,Main,,0,0,0,,{\i1}nhưng cũng chả thân thiết gì.{\i0}
Dialogue: 0,0:02:21.41,0:02:25.24,Main,,0,0,0,,{\i1}Thấy đáng ngờ,\Ntôi quyết định điều tra tung tích của Pao.{\i0}
Dialogue: 0,0:02:25.76,0:02:30.50,Main,,0,0,0,,{\i1}Nghe nói ở Sao Hỏa này, Pao là\Nmột trong ba thầy phong thủy giỏi nhất,{\i0}
Dialogue: 0,0:02:31.00,0:02:35.95,Main,,0,0,0,,{\i1}nhưng lúc tôi lần ra tung tích,\Nông ta đã không còn trên đời.{\i0}
Dialogue: 0,0:02:43.67,0:02:47.00,Main,,0,0,0,,Không phải ông là người\Ngửi mail cho tôi sao?
Dialogue: 0,0:02:47.00,0:02:49.19,Main,,0,0,0,,"Người tìm đến từ hướng tây nam đại hung,
Dialogue: 0,0:02:49.73,0:02:53.31,Main,,0,0,0,,nhận tiếng nói của trời,\Nsẽ dẫn ngươi tới đá mặt trời."
Dialogue: 0,0:02:54.29,0:02:55.65,Main,,0,0,0,,Đúng như quẻ bát quái đã phán!
Dialogue: 0,0:02:57.65,0:02:58.65,Main,,0,0,0,,Cẩn thận!
Dialogue: 0,0:03:00.54,0:03:02.41,Main,,0,0,0,,Mày bắn đi đâu thế hả?
Dialogue: 0,0:03:07.11,0:03:09.30,Main,,0,0,0,,Lũ không sợ trời phạt.
Dialogue: 0,0:03:12.32,0:03:13.27,Main,,0,0,0,,Theo đường sinh lộ!
Dialogue: 0,0:03:14.42,0:03:15.42,Main,,0,0,0,,Này?
Dialogue: 0,0:03:16.17,0:03:17.05,Main,,0,0,0,,Này, này!
Dialogue: 0,0:03:20.76,0:03:21.38,Main,,0,0,0,,Đồ đần!
Dialogue: 0,0:03:21.38,0:03:22.01,Main,,0,0,0,,Tổ sư!
Dialogue: 0,0:03:24.30,0:03:25.76,Main,,0,0,0,,Này này này!
Dialogue: 0,0:03:35.78,0:03:37.02,Main,,0,0,0,,Sinh lộ!
Dialogue: 0,0:03:46.16,0:03:47.33,Main,,0,0,0,,Địa khí!
Dialogue: 0,0:04:04.52,0:04:06.97,Main,,0,0,0,,Đúng là ngàn cân treo sợi tóc nhỉ.
Dialogue: 0,0:04:09.44,0:04:11.23,Main,,0,0,0,,May quá, chú không sao.
Dialogue: 0,0:04:26.44,0:04:27.67,Main,,0,0,0,,Làm cái gì thế?
Dialogue: 0,0:04:27.67,0:04:29.83,Main,,0,0,0,,Này này, ai kia kìa?
Dialogue: 0,0:04:33.53,0:04:35.58,Main,,0,0,0,,Bồ mới chăng?
Dialogue: 0,0:04:35.58,0:04:37.30,Main,,0,0,0,,Bạn gái gì mà trẻ thế.
Dialogue: 0,0:04:37.30,0:04:39.52,Main,,0,0,0,,Dị nhân, nhân sâm, tình nhân~
Dialogue: 0,0:04:39.52,0:04:41.26,Main,,0,0,0,,Hay là con rơi?
Dialogue: 0,0:04:41.26,0:04:42.81,Main,,0,0,0,,Con gái gì mà già thế.
Dialogue: 0,0:04:42.81,0:04:45.22,Main,,0,0,0,,Con rơi, con rối, con rồng~
Dialogue: 0,0:04:47.31,0:04:49.35,Main,,0,0,0,,Nhưng chú bất ngờ thật đấy.
Dialogue: 0,0:04:49.35,0:04:53.19,Main,,0,0,0,,Con gái Pao mà đã lớn thế này rồi.
Dialogue: 0,0:04:53.70,0:04:56.04,Main,,0,0,0,,Chắc cháu không nhớ đâu,
Dialogue: 0,0:04:56.04,0:04:59.02,Main,,0,0,0,,nhưng hồi cháu mới bé tí thế này,\Nchú từng gặp một lần.
Dialogue: 0,0:05:00.72,0:05:03.24,Main,,0,0,0,,Chú quen bố cháu thế nào ạ?
Dialogue: 0,0:05:03.24,0:05:05.73,Main,,0,0,0,,Thế nào à...
Dialogue: 0,0:05:05.73,0:05:08.93,Main,,0,0,0,,Chỉ là người quen thôi.\NCũng mười năm trước rồi.
Dialogue: 0,0:05:09.46,0:05:13.66,Main,,0,0,0,,Mà bố cháu gặp tai nạn giao thông\Nthì đúng là xui thật.
Dialogue: 0,0:05:14.16,0:05:20.04,Main,,0,0,0,,Trên đường đến Sao Mộc, không-thời gian\Ntrong không gian chuyển pha bỗng bị méo...
Dialogue: 0,0:05:23.04,0:05:24.10,Main,,0,0,0,,Mời chị.
Dialogue: 0,0:05:24.70,0:05:25.60,Main,,0,0,0,,Cảm ơn.
Dialogue: 0,0:05:28.92,0:05:30.05,Main,,0,0,0,,Chị là người tình ạ?
Dialogue: 0,0:05:32.01,0:05:33.39,Main,,0,0,0,,Hay là con rơi ạ~?
Dialogue: 0,0:05:40.82,0:05:43.23,Main,,0,0,0,,Tan tành rồi~
Dialogue: 0,0:05:47.29,0:05:49.20,Main,,0,0,0,,Chú Jet, sao chú lại ở nghĩa trang?
Dialogue: 0,0:05:50.18,0:05:53.35,Main,,0,0,0,,Chuyện bố cháu gặp tai nạn,\Nngoài người nhà ra đâu có ai...
Dialogue: 0,0:06:00.46,0:06:03.13,Main,,0,0,0,,"Hãy tìm ra các Thánh Thú ở vùng Án Sơn.
Dialogue: 0,0:06:03.13,0:06:06.10,Main,,0,0,0,,Ta đang ở nơi Tứ Thần Tương Ứng."
Dialogue: 0,0:06:07.11,0:06:08.09,Main,,0,0,0,,Đây là?
Dialogue: 0,0:06:08.75,0:06:11.39,Main,,0,0,0,,Pao gửi đến chỗ chú đấy.
Dialogue: 0,0:06:11.39,0:06:12.44,Main,,0,0,0,,Khi nào ạ?
Dialogue: 0,0:06:12.44,0:06:13.87,Main,,0,0,0,,Ba ngày trước.
Dialogue: 0,0:06:13.87,0:06:15.39,Main,,0,0,0,,Ngay trước vụ tai nạn...
Dialogue: 0,0:06:17.56,0:06:20.52,Main,,0,0,0,,Cháu xin chú, hãy giúp cháu!
Dialogue: 0,0:06:22.19,0:06:24.53,Main,,0,0,0,,Đây chắc chắn là\Nchỗ cất giấu đá mặt trời!
Dialogue: 0,0:06:24.53,0:06:26.24,Main,,0,0,0,,Đá mặt trời?
Dialogue: 0,0:06:26.24,0:06:31.70,Main,,0,0,0,,Hướng, ngày, giờ chú xuất hiện\Nlà tốt nhất xét theo phong thủy!
Dialogue: 0,0:06:32.36,0:06:34.21,Main,,0,0,0,,Nhất là khi đi tìm đồ!
Dialogue: 0,0:06:34.85,0:06:35.95,Main,,0,0,0,,Thế à?
Dialogue: 0,0:06:35.95,0:06:37.38,Main,,0,0,0,,Đúng thế!
Dialogue: 0,0:06:37.38,0:06:38.85,Main,,0,0,0,,Cháu xin chú, chú Jet!
Dialogue: 0,0:06:40.86,0:06:43.72,Main,,0,0,0,,Dạ! Sắp rồi ạ!
Dialogue: 0,0:06:43.72,0:06:45.68,Main,,0,0,0,,Dạ, em hiểu rồi!
Dialogue: 0,0:06:45.68,0:06:47.35,Main,,0,0,0,,Tâm trạng đại ca sao?
Dialogue: 0,0:06:47.35,0:06:48.82,Main,,0,0,0,,Thì...
Dialogue: 0,0:06:48.82,0:06:50.20,Main,,0,0,0,,Làm sao mà tốt được nhỉ.
Dialogue: 0,0:06:50.20,0:06:51.86,Main,,0,0,0,,Còn phải nói.
Dialogue: 0,0:06:51.86,0:06:53.10,Main,,0,0,0,,Đi thôi!
Dialogue: 0,0:06:54.89,0:06:58.95,Main,,0,0,0,,{\i1}Tôi chả nợ Pao hay cô bé này\Nân nghĩa gì,{\i0}
Dialogue: 0,0:06:58.95,0:07:01.78,Main,,0,0,0,,{\i1}nhưng trước mắt tôi quyết định giúp.{\i0}
Dialogue: 0,0:07:01.78,0:07:04.96,Main,,0,0,0,,{\i1}Có quá nhiều điều\Nkhiến tôi không thể bỏ mặc.{\i0}
Dialogue: 0,0:07:05.55,0:07:09.19,Main,,0,0,0,,{\i1}Vì sao trước khi chết,\NPao lại gửi mail cho tôi?{\i0}
Dialogue: 0,0:07:09.19,0:07:12.01,Main,,0,0,0,,{\i1}Mấy dòng đó có ý nghĩa gì?{\i0}
Dialogue: 0,0:07:12.01,0:07:14.78,Main,,0,0,0,,{\i1}Bọn tấn công chúng tôi là ai?{\i0}
Dialogue: 0,0:07:15.90,0:07:20.00,Main,,0,0,0,,{\i1}Rồi cả cô bé tên Meifa này\Ncũng có điều khiến tôi bận tâm.{\i0}
Dialogue: 0,0:07:35.05,0:07:38.15,Main,,0,0,0,,Vũ trụ này\Nđược tạo nên từ ba loại khí.
Dialogue: 0,0:07:38.15,0:07:42.98,Main,,0,0,0,,Đó là thiên khí,\Ntức năng lượng đến từ mặt trời,
Dialogue: 0,0:07:42.98,0:07:47.82,Main,,0,0,0,,địa khí, tức năng lượng\Ntrào lên từ mặt đất của hành tinh,
Dialogue: 0,0:07:48.24,0:07:53.07,Main,,0,0,0,,và từ khí, tức khí tỏa ra\Ntừ chính các sinh vật chúng ta.
Dialogue: 0,0:07:53.07,0:07:55.07,Main,,0,0,0,,Khí của sinh vật?
Dialogue: 0,0:07:55.08,0:07:59.22,Main,,0,0,0,,Cơ thể con người\Nluôn sinh ra từ trường.
Dialogue: 0,0:07:59.79,0:08:02.36,Main,,0,0,0,,Từ trường đó và từ trường của Trái Đất
Dialogue: 0,0:08:02.36,0:08:04.79,Main,,0,0,0,,tác động qua lại lẫn nhau.
Dialogue: 0,0:08:05.42,0:08:07.96,Main,,0,0,0,,Kỹ thuật đọc được\Nnăng lượng của đại tự nhiên ấy
Dialogue: 0,0:08:07.96,0:08:10.87,Main,,0,0,0,,rồi vận dụng vào đời sống,\Nchính là phong thủy vũ trụ.
Dialogue: 0,0:08:14.96,0:08:15.72,Main,,0,0,0,,Kem.
Dialogue: 0,0:08:18.94,0:08:21.20,Main,,0,0,0,,Phong thủy vũ trụ...
Dialogue: 0,0:08:21.72,0:08:23.90,Main,,0,0,0,,Không giống mấy trò bói toán à?
Dialogue: 0,0:08:24.32,0:08:28.22,Main,,0,0,0,,Các môn bói khác cùng lắm\Nchỉ dự đoán hay tiên tri.
Dialogue: 0,0:08:28.22,0:08:32.62,Main,,0,0,0,,Nhưng phong thủy vũ trụ\Ncó sức mạnh biến hung thành cát đấy.
Dialogue: 0,0:08:32.62,0:08:36.66,Main,,0,0,0,,Ví dụ như một thầy phong thủy\Ncó năng lực như bố cháu...
Dialogue: 0,0:08:39.60,0:08:40.29,Main,,0,0,0,,Sao thế?
Dialogue: 0,0:08:41.80,0:08:45.76,Main,,0,0,0,,Cháu chợt nghĩ, chưa bao giờ\Ncháu được ở bên bố thế này.
Dialogue: 0,0:08:45.76,0:08:47.29,Main,,0,0,0,,Này này.
Dialogue: 0,0:08:47.29,0:08:49.66,Main,,0,0,0,,Nói trước nhé,\Nchú không già đến thế đâu.
Dialogue: 0,0:08:49.66,0:08:52.21,Main,,0,0,0,,Cùng lắm thì coi như người yêu...
Dialogue: 0,0:08:53.72,0:08:56.57,Main,,0,0,0,,Không, người yêu thì không ổn.
Dialogue: 0,0:08:56.57,0:08:59.28,Main,,0,0,0,,Ơ... Mình đang nói cái gì thế này?
Dialogue: 0,0:08:59.28,0:09:01.94,Main,,0,0,0,,Ít ra cũng là anh trai gì đó chứ...
Dialogue: 0,0:09:02.82,0:09:03.72,Main,,0,0,0,,Kem.
Dialogue: 0,0:09:04.87,0:09:05.90,Main,,0,0,0,,Kem cơ mà.
Dialogue: 0,0:09:12.26,0:09:14.32,Main,,0,0,0,,Đi thôi, chú Jet!
Dialogue: 0,0:09:19.21,0:09:22.29,Main,,0,0,0,,Án Sơn có lẽ là chỗ này,
Dialogue: 0,0:09:22.29,0:09:24.10,Main,,0,0,0,,tòa nhà khách sạn Mountain.
Dialogue: 0,0:09:26.68,0:09:27.75,Main,,0,0,0,,Kia rồi!
Dialogue: 0,0:09:34.34,0:09:35.61,Main,,0,0,0,,Thanh Long!
Dialogue: 0,0:09:44.68,0:09:45.86,Main,,0,0,0,,Bạch Hổ!
Dialogue: 0,0:09:49.05,0:09:50.11,Main,,0,0,0,,Huyền Vũ!
Dialogue: 0,0:09:53.52,0:09:54.57,Main,,0,0,0,,Chu Tước!
Dialogue: 0,0:09:54.57,0:09:56.28,Main,,0,0,0,,Này...
Dialogue: 0,0:09:56.28,0:09:58.70,Main,,0,0,0,,Đúng rồi!\NPhép Thập Tự Thiên Tâm!
Dialogue: 0,0:10:06.04,0:10:08.03,Main,,0,0,0,,Đá mặt trời ở đây!
Dialogue: 0,0:10:08.03,0:10:09.75,Main,,0,0,0,,Thật không đấy?
Dialogue: 0,0:10:20.46,0:10:22.48,Main,,0,0,0,,Thấy rồi, thấy rồi,\Nchúng ở kia kìa.
Dialogue: 0,0:10:22.48,0:10:23.47,Main,,0,0,0,,Được.
Dialogue: 0,0:10:48.66,0:10:49.96,Main,,0,0,0,,Cuối cùng cũng tìm thấy.
Dialogue: 0,0:10:50.98,0:10:52.71,Main,,0,0,0,,Đây là đá mặt trời.
Dialogue: 0,0:10:52.71,0:10:54.51,Main,,0,0,0,,Thứ này mà là...?
Dialogue: 0,0:11:05.11,0:11:06.44,Main,,0,0,0,,Chú Jet?
Dialogue: 0,0:11:15.91,0:11:17.33,Main,,0,0,0,,Tránh ra.
Dialogue: 0,0:11:17.33,0:11:19.19,Main,,0,0,0,,Làm gì thế!
Dialogue: 0,0:11:19.19,0:11:22.20,Main,,0,0,0,,Một chai lão tửu. Khỏi cần ly.
Dialogue: 0,0:11:33.59,0:11:35.79,Main,,0,0,0,,Này thì!
Dialogue: 0,0:11:42.97,0:11:45.28,Main,,0,0,0,,Này, chúng mày là ai?
Dialogue: 0,0:11:45.28,0:11:49.13,Main,,0,0,0,,Hừ, tưởng bọn tao\Ndễ khai thế à...
Dialogue: 0,0:11:49.99,0:11:53.44,Main,,0,0,0,,B-bọn em là người\Nbang Thanh Xà ạ...
Dialogue: 0,0:11:53.44,0:11:55.48,Main,,0,0,0,,Biết ngay là người của tổ chức mà.
Dialogue: 0,0:11:55.96,0:11:57.86,Main,,0,0,0,,Sao lại bám theo bọn tao?
Dialogue: 0,0:11:57.86,0:12:01.99,Main,,0,0,0,,C-cái đó thì\Ncó giết em cũng không nói được.
Dialogue: 0,0:12:03.28,0:12:05.91,Main,,0,0,0,,Vì không xử được lão Pao,
Dialogue: 0,0:12:05.91,0:12:09.37,Main,,0,0,0,,nên bọn em được lệnh\Nbắt người nhận mail của lão...
Dialogue: 0,0:12:11.20,0:12:12.68,Main,,0,0,0,,Th-thật đấy ạ!
Dialogue: 0,0:12:12.68,0:12:16.13,Main,,0,0,0,,Bọn em chỉ là tép riu,\Nngoài ra không biết gì nữa đâu!
Dialogue: 0,0:12:17.42,0:12:19.17,Main,,0,0,0,,Chắc vậy.
Dialogue: 0,0:12:24.95,0:12:26.04,Main,,0,0,0,,Chú Jet...
Dialogue: 0,0:12:27.06,0:12:29.96,Main,,0,0,0,,Bố cháu... còn sống ư?
Dialogue: 0,0:12:33.07,0:12:37.06,Main,,0,0,0,,{\i1}Lời của Pao\Nđã chỉ ra nơi giấu viên đá này.{\i0}
Dialogue: 0,0:12:37.06,0:12:40.82,Main,,0,0,0,,{\i1}Rốt cuộc Pao vẫn còn sống ở đâu đó?{\i0}
Dialogue: 0,0:12:40.82,0:12:45.49,Main,,0,0,0,,{\i1}Ông ta muốn tôi tìm viên đá này\Nđể làm gì?{\i0}
Dialogue: 0,0:12:45.49,0:12:49.62,Main,,0,0,0,,{\i1}Bí ẩn chẳng những chưa có lời giải\N mà còn chồng chất thêm.{\i0}
Dialogue: 0,0:12:50.35,0:12:55.58,Main,,0,0,0,,{\i1}Trước mắt, tôi quyết định điều tra\Nmanh mối duy nhất, viên đá này.{\i0}
Dialogue: 0,0:13:01.39,0:13:06.01,Main,,0,0,0,,Thì ra là mảnh vỡ mặt trăng\Ntừ vụ nổ Cổng 50 năm trước.
Dialogue: 0,0:13:06.01,0:13:10.26,Main,,0,0,0,,Giới thầy phong thủy chúng cháu\Ngọi nó là đá mặt trời.
Dialogue: 0,0:13:10.74,0:13:12.88,Main,,0,0,0,,Nó hấp thụ sự bóp méo không-thời gian
Dialogue: 0,0:13:12.88,0:13:15.23,Main,,0,0,0,,và chứa đựng nguồn năng lượng khổng lồ.
Dialogue: 0,0:13:17.63,0:13:20.55,Main,,0,0,0,,Nhìn thì chỉ như hòn đá cuội thôi...
Dialogue: 0,0:13:20.55,0:13:23.42,Main,,0,0,0,,Thế? Bán thì được bao nhiêu?
Dialogue: 0,0:13:23.42,0:13:24.82,Main,,0,0,0,,Này, hai người.
Dialogue: 0,0:13:24.83,0:13:27.28,Main,,0,0,0,,Hút thuốc thì ra ngoài mà hút.
Dialogue: 0,0:13:27.28,0:13:28.67,Main,,0,0,0,,Hả?
Dialogue: 0,0:13:28.67,0:13:30.80,Main,,0,0,0,,Chính anh lúc nào cũng hút ở đây còn gì?
Dialogue: 0,0:13:30.80,0:13:33.05,Main,,0,0,0,,Từ hôm nay, chỗ này cấm hút thuốc.
Dialogue: 0,0:13:33.05,0:13:34.75,Main,,0,0,0,,Này này, đùa à?
Dialogue: 0,0:13:35.38,0:13:39.13,Main,,0,0,0,,{\i0}Con tàu này là tàu của tôi.\NBiết chưa hả?
Dialogue: 0,0:13:50.84,0:13:54.18,Main,,0,0,0,,Thế, viên đá này để làm gì?
Dialogue: 0,0:13:54.18,0:13:56.95,Main,,0,0,0,,Cái đó thì cháu không biết.
Dialogue: 0,0:13:57.67,0:14:00.21,Main,,0,0,0,,Rốt cuộc bố cháu định làm gì...
Dialogue: 0,0:14:02.16,0:14:03.69,Main,,0,0,0,,Ơ? Này này, đợi đã!
Dialogue: 0,0:14:03.69,0:14:05.30,Main,,0,0,0,,Ein! Đứng lại!
Dialogue: 0,0:14:12.57,0:14:13.87,Main,,0,0,0,,La bàn!
Dialogue: 0,0:14:13.87,0:14:14.97,Main,,0,0,0,,Sao thế?
Dialogue: 0,0:14:14.97,0:14:17.71,Main,,0,0,0,,Không thể nào!\NCháu đã tháo nam châm ra rồi mà.
Dialogue: 0,0:14:19.55,0:14:22.55,Main,,0,0,0,,Ra vậy... Phải rồi...
Dialogue: 0,0:14:23.30,0:14:24.80,Main,,0,0,0,,Đúng là thế.
Comment: 1,0:14:25.15,0:14:26.30,Main,,0,0,0,,Hả?
Dialogue: 0,0:14:26.30,0:14:27.67,Main,,0,0,0,,Chính là thế!
Dialogue: 0,0:14:38.97,0:14:41.86,Main,,0,0,0,,Nếu cháu nhớ không nhầm,\Nbố cháu cũng có một viên đá mặt trời.
Dialogue: 0,0:14:42.53,0:14:45.34,Main,,0,0,0,,Chắc chắn là hai viên đá hút lẫn nhau,
Dialogue: 0,0:14:45.34,0:14:47.51,Main,,0,0,0,,và đang chỉ ra nơi bố cháu ở.
Dialogue: 0,0:14:47.51,0:14:51.25,Main,,0,0,0,,Vậy nên Pao mới\Nbắt cháu đi tìm viên đá này à.
Dialogue: 0,0:14:51.90,0:14:52.66,Main,,0,0,0,,Nhưng...
Dialogue: 0,0:14:53.57,0:14:56.48,Main,,0,0,0,,Sao bố lại gửi mail cho chú Jet,
Dialogue: 0,0:14:57.93,0:15:00.33,Main,,0,0,0,,chứ không phải cho cháu...
Dialogue: 0,0:15:16.21,0:15:17.50,Main,,0,0,0,,Anh thấy sao?
Dialogue: 0,0:15:17.50,0:15:19.23,Main,,0,0,0,,Hợp cạ đấy chứ.
Dialogue: 0,0:15:19.23,0:15:21.62,Main,,0,0,0,,Kiểu đó mới nguy hiểm đấy.
Dialogue: 0,0:15:21.62,0:15:22.91,Main,,0,0,0,,Cái gì?
Dialogue: 0,0:15:22.91,0:15:25.69,Main,,0,0,0,,Đàn ông hồi trẻ mà đứng đắn,
Dialogue: 0,0:15:25.69,0:15:29.41,Main,,0,0,0,,thì về già hay mê mẩn\Nmấy cô gái trẻ lắm đấy.
Dialogue: 0,0:15:29.41,0:15:30.59,Main,,0,0,0,,Thế cơ à?
Dialogue: 0,0:15:30.59,0:15:33.24,Main,,0,0,0,,Đàn ông cũng đâu có nói lý được.
Dialogue: 0,0:15:34.62,0:15:35.70,Main,,0,0,0,,Bố cháu...
Dialogue: 0,0:15:36.13,0:15:41.14,Main,,0,0,0,,chỉ tin vào phong thủy vũ trụ,\Nkhông tin con người. Bố là người như thế.
Dialogue: 0,0:15:41.92,0:15:45.44,Main,,0,0,0,,Vì vậy mẹ đã dắt cháu bỏ nhà đi.
Dialogue: 0,0:15:46.01,0:15:47.44,Main,,0,0,0,,Từ bảy năm trước.
Dialogue: 0,0:15:50.16,0:15:55.37,Main,,0,0,0,,Bố cháu thừa sức tìm ra\Nmẹ con cháu ở đâu,
Dialogue: 0,0:15:56.01,0:15:58.94,Main,,0,0,0,,vậy mà bố chưa từng đi tìm.
Dialogue: 0,0:15:59.37,0:16:01.69,Main,,0,0,0,,Chắc chắn là có lý do.
Dialogue: 0,0:16:02.13,0:16:04.86,Main,,0,0,0,,Sao bố cháu lại bị\Nbọn người đó nhắm tới?
Dialogue: 0,0:16:06.29,0:16:08.82,Main,,0,0,0,,Vì bố là người của bọn tội phạm sao?
Dialogue: 0,0:16:09.58,0:16:12.22,Main,,0,0,0,,Cháu xin chú,\Nhãy cho cháu biết sự thật.
Dialogue: 0,0:16:14.03,0:16:16.29,Main,,0,0,0,,Con người thật của bố cháu...
Dialogue: 0,0:16:18.51,0:16:20.25,Main,,0,0,0,,Pao...
Dialogue: 0,0:16:20.25,0:16:23.30,Main,,0,0,0,,từng làm cố vấn cho tổ chức.
Dialogue: 0,0:16:23.30,0:16:24.84,Main,,0,0,0,,Đó là sự thật.
Dialogue: 0,0:16:25.40,0:16:30.19,Main,,0,0,0,,Hồi chú còn là cảnh sát hình sự,\NPao đã chuyển thông tin tổ chức cho chú.
Dialogue: 0,0:16:30.19,0:16:34.00,Main,,0,0,0,,Từ hồi đó,\NPao đã muốn rời khỏi tổ chức.
Dialogue: 0,0:16:34.00,0:16:38.32,Main,,0,0,0,,Nhưng một kẻ biết\Nnhững bí mật quan trọng của tổ chức,
Dialogue: 0,0:16:38.32,0:16:41.27,Main,,0,0,0,,thì không đời nào rút ra được.
Dialogue: 0,0:16:44.31,0:16:49.99,Main,,0,0,0,,Chắc Pao sợ\Ngia đình gặp thêm tai họa.
Dialogue: 0,0:16:49.99,0:16:54.95,Main,,0,0,0,,Thôi, gặp ông ấy rồi\Ncháu tự hỏi cho rõ.
Dialogue: 0,0:17:10.16,0:17:11.26,Main,,0,0,0,,Đây!
Dialogue: 0,0:17:11.26,0:17:12.34,Main,,0,0,0,,Ở quanh đây!
Dialogue: 0,0:17:19.02,0:17:21.06,Main,,0,0,0,,Có gì đâu.
Dialogue: 0,0:17:21.06,0:17:22.16,Main,,0,0,0,,Radar thì sao?
Dialogue: 0,0:17:22.16,0:17:23.14,Main,,0,0,0,,Không có phản ứng.
Dialogue: 0,0:17:23.14,0:17:26.39,Main,,0,0,0,,Không thể nào!\NChắc chắn là chỗ này mà...
Dialogue: 0,0:17:27.20,0:17:28.52,Main,,0,0,0,,Hửm? Không...
Dialogue: 0,0:17:29.12,0:17:29.87,Main,,0,0,0,,Khoan đã.
Dialogue: 0,0:17:35.09,0:17:35.95,Main,,0,0,0,,Có khách à?
Dialogue: 0,0:17:35.95,0:17:37.76,Main,,0,0,0,,Lũ này dai thật.
Dialogue: 0,0:17:37.76,0:17:39.43,Main,,0,0,0,,Spike! Faye! Nhờ hai người!
Dialogue: 0,0:17:39.43,0:17:41.27,Main,,0,0,0,,{\i0}Khách của anh chứ\Ncó phải của tôi đâu?
Dialogue: 0,0:17:43.26,0:17:46.50,Main,,0,0,0,,Không muốn chết chung với con tàu này\Nthì hợp tác đi.
Dialogue: 0,0:17:52.26,0:17:54.21,Main,,0,0,0,,Đúng là rút phải thăm xui.
Dialogue: 0,0:17:55.62,0:17:57.60,Main,,0,0,0,,{\i1}Thỉnh thoảng không tính thiệt hơn\Ncũng hay mà.{\i0}
Dialogue: 0,0:17:57.60,0:18:00.73,Main,,0,0,0,,Coi như mình là tiên\Nđi thực hiện ước mơ của công chúa.
Dialogue: 0,0:18:00.73,0:18:01.81,Main,,0,0,0,,{\i1}Anh mà là tiên?{\i0}
Dialogue: 0,0:18:08.07,0:18:09.56,Main,,0,0,0,,Máy bay không người lái à.
Dialogue: 0,0:18:09.57,0:18:12.57,Main,,0,0,0,,Thế thì đây là bảy chú lùn rồi.
Dialogue: 0,0:18:17.22,0:18:19.30,Main,,0,0,0,,Tổ sư... Bắn rơi hết cho xem!
Dialogue: 0,0:18:19.30,0:18:20.74,Main,,0,0,0,,Biết rồi~!
Dialogue: 0,0:18:34.59,0:18:36.41,Main,,0,0,0,,{\i1}Spike, quay về đi!{\i0}
Dialogue: 0,0:18:36.41,0:18:37.05,Main,,0,0,0,,Gì thế?
Dialogue: 0,0:18:37.57,0:18:40.36,Main,,0,0,0,,{\i1}Hình như nếu tác động\Nnăng lượng lớn vào viên đá đó,{\i0}
Dialogue: 0,0:18:40.36,0:18:43.48,Main,,0,0,0,,{\i1}có thể giải phóng\Nsức mạnh bị phong ấn bên trong.{\i0}
Dialogue: 0,0:18:43.48,0:18:45.27,Main,,0,0,0,,Rồi phải làm gì?
Dialogue: 0,0:18:45.27,0:18:47.98,Main,,0,0,0,,Kế này được ăn cả ngã về không, nhưng...
Dialogue: 0,0:18:53.82,0:18:55.90,Main,,0,0,0,,Gì cũng được, nhanh lên đi!
Dialogue: 0,0:18:58.73,0:18:59.78,Main,,0,0,0,,Cho vào rồi~!
Dialogue: 0,0:18:59.78,0:19:00.74,Main,,0,0,0,,Được!
Dialogue: 0,0:19:05.75,0:19:08.66,Main,,0,0,0,,{\i1}Dùng pháo plasma\Nbắn xuyên viên đá này!{\i0}
Dialogue: 0,0:19:08.66,0:19:11.17,Main,,0,0,0,,Kế hay ghê nhỉ.
Dialogue: 0,0:20:09.03,0:20:11.06,Main,,0,0,0,,{\i1}Kịp lúc rồi, Jet.{\i0}
Dialogue: 0,0:20:12.06,0:20:14.28,Main,,0,0,0,,Pao! Ông...
Dialogue: 0,0:20:14.28,0:20:17.27,Main,,0,0,0,,{\i1}Meifa... lâu rồi không gặp.{\i0}
Dialogue: 0,0:20:24.53,0:20:28.83,Main,,0,0,0,,Pao, chỗ ông là vùng bất ổn định.\NTôi không lại gần hơn được.
Dialogue: 0,0:20:29.40,0:20:33.33,Main,,0,0,0,,{\i1}Tôi biết.\NĐằng nào cũng hết oxy rồi.{\i0}
Dialogue: 0,0:20:34.96,0:20:40.82,Main,,0,0,0,,{\i1}Tôi gửi mail cho anh,\Nlà vì muốn anh đưa con gái tôi tới đây.{\i0}
Dialogue: 0,0:20:41.57,0:20:47.51,Main,,0,0,0,,Vậy chuyện bọn tôi tới đây thế này\Ncũng là do ông xem phong thủy tính trước?
Dialogue: 0,0:20:48.02,0:20:49.26,Main,,0,0,0,,{\i1}Phải.{\i0}
Dialogue: 0,0:20:57.73,0:20:59.88,Main,,0,0,0,,Không phải đâu, Pao.
Dialogue: 0,0:20:59.88,0:21:01.98,Main,,0,0,0,,Không phải do ông sắp đặt.
Dialogue: 0,0:21:02.67,0:21:04.40,Main,,0,0,0,,Meifa có mặt ở đây
Dialogue: 0,0:21:05.40,0:21:08.12,Main,,0,0,0,,{\i0}là vì chính con bé muốn đến.
Dialogue: 0,0:21:09.98,0:21:11.51,Main,,0,0,0,,{\i1}Có lẽ vậy.{\i0}
Dialogue: 0,0:21:12.52,0:21:15.62,Main,,0,0,0,,{\i1}Có lẽ tôi đã quá tự phụ.{\i0}
Dialogue: 0,0:21:18.63,0:21:20.07,Main,,0,0,0,,{\i1}{\i1}Meifa...{\i0}
Dialogue: 0,0:21:20.91,0:21:23.77,Main,,0,0,0,,{\i1}Được gặp con lần cuối, bố vui lắm.{\i0}
Dialogue: 0,0:21:24.82,0:21:28.97,Main,,0,0,0,,Suốt bao năm nay, \Nlúc nào con cũng oán trách bố.
Dialogue: 0,0:21:30.75,0:21:33.25,Main,,0,0,0,,Suốt bao năm nay, \Nlúc nào con cũng căm giận bố.
Dialogue: 0,0:21:38.04,0:21:39.56,Main,,0,0,0,,Vậy mà...
Dialogue: 0,0:21:49.18,0:21:49.96,Main,,0,0,0,,Bố ơi...
Dialogue: 0,0:22:02.51,0:22:08.47,Main,,0,0,0,,{\i1}Đưa cô bé theo là đúng hay sai,\Nđến giờ tôi vẫn không biết.{\i0}
Dialogue: 0,0:22:09.06,0:22:12.66,Main,,0,0,0,,{\i1}Dù sao thì, vụ việc kỳ lạ này\Ncũng khép lại như thế,{\i0}
Dialogue: 0,0:22:12.66,0:22:14.94,Main,,0,0,0,,{\i1}và cô bé trở về Sao Hỏa.{\i0}
Dialogue: 0,0:22:15.56,0:22:18.65,Main,,0,0,0,,{\i1}Lệnh cấm hút thuốc ở phòng khách\Ncũng được bãi bỏ,{\i0}
Dialogue: 0,0:22:18.65,0:22:23.07,Main,,0,0,0,,{\i1}nhịp sống thường ngày \Nchẳng có gì thay đổi lại tiếp diễn như xưa.{\i0}
Dialogue: 0,0:22:23.07,0:22:25.32,Main,,0,0,0,,{\i1}Nếu có điều gì khác trước,{\i0}
